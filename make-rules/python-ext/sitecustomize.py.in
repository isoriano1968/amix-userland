# Cross builds only (build/amixpy): sysconfig's include paths name the AMIX
# Python headers in the sysroot, not the build machine's.
import sysconfig

_get_paths = sysconfig.get_paths


def get_paths(*args, **kwargs):
    paths = _get_paths(*args, **kwargs)
    for name in ("include", "platinclude"):
        paths[name] = "@PYINC@"
    return paths


sysconfig.get_paths = get_paths
sysconfig.get_path = lambda name, *args, **kwargs: get_paths(*args, **kwargs)[name]

# AMIX's CPython installs with the plain posix_prefix scheme
# (lib/python3.11/site-packages); a Debian build machine's 3.11 would give its
# own (deb_system, posix_local: dist-packages) to Meson.
_scheme_names = sysconfig.get_scheme_names
sysconfig.get_scheme_names = lambda: tuple(
    n for n in _scheme_names() if not n.startswith("deb_") and n != "posix_local")
sysconfig.get_default_scheme = lambda: "posix_prefix"
sysconfig._get_default_scheme = sysconfig.get_default_scheme
