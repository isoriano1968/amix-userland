#!/bin/sh

XSETROOT=$TOP/programs/xsetroot/xsetroot
XCLOCK=$TOP/programs/xclock/xclock
XTERM=$TOP/programs/xterm/xterm
XMODMAP=$TOP/programs/xmodmap/xmodmap
TWM=$TOP/programs/twm/twm
TWMRC=$TOP/config/util/twmrc.zz9000
DE_KEYMAP=${ZZ9K_XMODMAP-$TOP/config/util/Xmodmap.de}
ZZ9K_SHELL=${ZZ9K_SHELL-${SHELL-/bin/sh}}
ROOT_COLOR=${ZZ9K_ROOT_COLOR-'#1b365d'}
export ZZ9K_SHELL

for file in "$XSETROOT" "$XCLOCK" "$XTERM" "$TWM" "$TWMRC"
do
    if test -f "$file"
    then
        :
    else
        echo "xinitrc.zz9000: missing $file" >&2
        exit 1
    fi
done

if test -f "$DE_KEYMAP" && test -x "$XMODMAP"
then
    "$XMODMAP" "$DE_KEYMAP"
fi

"$TWM" -f "$TWMRC" &
TWM_PID=$!

sleep ${ZZ9K_TWM_DELAY-2}

"$XSETROOT" -solid "$ROOT_COLOR"
"$XCLOCK" -geometry 220x220-20+20 &
"$XTERM" -geometry 100x30+40+40 -title 'AMIX X11R6.3 on ZZ9000' -e "$ZZ9K_SHELL" &

wait "$TWM_PID"
