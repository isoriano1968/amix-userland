XCOMM AMIX / Amiga UNIX System V Release 4 configuration for X11R6.3
XCOMM Keep this conservative: first make stock X11R6 build, then add ZZ9000 RTG.

#define OSMajorVersion 4
#define OSMinorVersion 0
#define OSTeenyVersion 0
#define OSName Amiga UNIX System V Release 4.0
#define OSVendor "Commodore-Amiga"
#define OSDefines -DAMIX -Dm68k
#define OSRelease -DSVR4

XCOMM operating system: OSName OSVendor

#define SystemV4 YES

#define BootstrapCFlags OSDefines OSRelease
#define StandardDefines OSDefines OSRelease
#define StandardCppDefines OSDefines OSRelease

#define ProjectRulesFile <X11.rules>
#define ProjectTmplFile <X11.tmpl>

#define ProjectRoot /usr/x11r6
#define UsrLibDir /usr/x11r6/lib
#define LibDir /usr/x11r6/lib/X11
#define IncRoot /usr/x11r6/include
#define BinDir /usr/x11r6/bin
#define ManDirectoryRoot /usr/x11r6/man

#define HasGcc YES
#define HasGcc2 YES
#define HasGcc2ForCplusplus NO
#define HasSharedLibraries YES
#define ForceNormalLib NO
#define SeparateSharedCompile YES
#define PositionIndependentCFlags -fpic
/* Match the working X11R5 AMIX shared-library ABI. */
#define SharedLibraryLoadFlags -G
#define SharedDataSeparation YES
#define SharedCodeDef -DSHAREDCODE
#define SharedLibraryDef -DSUNSHLIB
/* MIT-SHM is independent of shared libraries and is unsafe on AMIX. */
#define HasShm NO
#define CcCmd gcc
#define ServerCcCmd gcc
#define DefaultCCOptions -ansi -finline-functions
#define DefaultCDebugFlags -O
#define OptimizedCDebugFlags -O
#define CppCmd /usr/public/lib/gcc-cpp
#define PreProcessCmd gcc -E
#define UnixCpp YES

/*
 * X11.tmpl assumes SystemV4 has wctype.h/widec.h and defaults Xaw to
 * -DHAS_WCTYPE_H.  AMIX does not provide those headers; use Xlib's internal
 * wide-char helpers, as several contemporary non-widechar ports do.
 */
#define XawI18nDefines -DUSE_XWCHAR_STRING -DUSE_XMBTOWC

#define ArCmdBase ar
#define AsCmd as
#define LdCmd ld
#define LexCmd lex
#define MakeCmd make
#define YaccCmd yacc

#define ConnectionFlags -DTCPCONN -DUNIXCONN
#define HasSockets YES
#define NeedBerklib YES
#define SocketLibraries -lsocket -lnsl
#define ExtraLibraries SocketLibraries
#define ServerExtraSysLibs SocketLibraries -ldbm -lscreen
#define LdPreLib -L$(BUILDLIBDIR)
#define LdPostLib /**/
#define HasSecureRPC NO
#define HasPutenv YES
#define HasStrcasecmp NO
#ifdef StrcasecmpDefines
#undef StrcasecmpDefines
#endif
#define StrcasecmpDefines -DNEED_STRCASECMP
#define StripInstalledPrograms YES

/* Keep the stock X11R6 dependency graph; only PEX remains deferred. */
#define BuildPexExt NO
#define BuildXKB YES
#define BuildXKBlib YES
#define XAmixServer YES

#include <amix.rules>
#include <sv4Lib.rules>
