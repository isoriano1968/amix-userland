#!/usr/bin/env python3
"""amix-pyext-check [-p PYTHON] [-s SYSROOT] MODULE.so...

Checks C extension modules (or other shared objects dlopened by a program)
for AMIX before they go to the box:

  undefined  every undefined, non-weak symbol of a module must be defined by
             the program (PYTHON, default SYSROOT/usr/local/bin/python3.11,
             which exports its C API with -Wl,-E), by a library the program
             or the module NEEDs (found in SYSROOT/usr/lib, /usr/local/lib,
             /usr/local/gnu/lib, /usr/x11r6/lib), or by the module itself;
             ld.so.1 would fail on the first call otherwise
  init       a module with .init_array (DT_INIT_ARRAY) needs a DT_INIT that
             runs it: AMIX's ld.so.1 (1991) only calls DT_INIT
  tls        no TLS (PT_TLS): ld.so.1 has no TLS relocations
  fpu        tools/amix-fpu-scan, without its false hits in gcc's switch
             tables: a table after `jmp %pc@(T,%dN:w)` (or %aN) is read from the file
             (word offsets from T, up to the lowest case address) and hits
             inside it are dropped, and so are hits right after a table that
             are not there when the code is decoded again from its end

Prints what fails per module, and a summary; exit 1 if anything fails.
Also lists text relocations (TEXTREL: non-PIC archive members, accepted by
ld.so.1) as information.
"""
import os, re, struct, subprocess, sys

TOOLS = os.path.dirname(os.path.abspath(__file__))
CROSS = os.environ.get("AMIX_TOOLS", os.path.expanduser("~/opt/m68k-amix/bin"))
READELF = os.path.join(CROSS, "m68k-elf-readelf")
OBJDUMP = os.path.join(CROSS, "m68k-elf-objdump")
LIBDIRS = ["/usr/lib", "/usr/local/lib", "/usr/local/gnu/lib", "/usr/x11r6/lib"]


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def dynamic(path):
    needed, tags = [], set()
    for line in run(READELF, "-d", "-W", path).splitlines():
        m = re.match(r"\s*0x[0-9a-f]+ \((\w+)\)\s+(.*)", line)
        if not m:
            continue
        tags.add(m.group(1))
        if m.group(1) == "NEEDED":
            needed.append(re.search(r"\[(.*)\]", m.group(2)).group(1))
    return needed, tags


def dynsyms(path):
    """(defined, undefined strong) dynamic symbol names; AMIX's own 1991
    libraries (libc.so.1) have no .dynsym, their .symtab is the dynamic one"""
    defined, undef = set(), set()
    out = run(READELF, "--dyn-syms", "-W", path)
    if "Symbol table" not in out:
        out = run(READELF, "-s", "-W", path)
    for line in out.splitlines():
        f = line.split()
        if len(f) < 8 or not f[0].endswith(":") or f[7] == "Name":
            continue
        name = f[7].split("@")[0]
        if f[6] == "UND":
            if f[4] != "WEAK" and name:
                undef.add(name)
        elif f[4] in ("GLOBAL", "WEAK"):
            defined.add(name)
    return defined, undef


def find_lib(sysroot, name):
    if name.startswith("/"):
        p = sysroot + name
        return p if os.path.exists(p) else None
    for d in LIBDIRS:
        p = sysroot + d + "/" + name
        if os.path.exists(p):
            return p
    return None


def provided(sysroot, start, cache):
    """symbols defined by START's NEEDED libraries, transitively"""
    out, todo, seen = set(), list(start), set()
    while todo:
        n = todo.pop()
        if n in seen:
            continue
        seen.add(n)
        p = find_lib(sysroot, n)
        if p is None:
            out.add("?missing-library:" + n)
            continue
        if p not in cache:
            cache[p] = (dynsyms(p)[0], dynamic(p)[0])
        out |= cache[p][0]
        todo += cache[p][1]
    return out


def sections(path):
    """[(addr, size, file offset)] of the PROGBITS sections"""
    data = open(path, "rb").read()
    assert data[:4] == b"\x7fELF" and data[4] == 1 and data[5] == 2, path
    shoff, = struct.unpack_from(">I", data, 32)
    shentsize, shnum = struct.unpack_from(">HH", data, 46)
    out = []
    for i in range(shnum):
        _, typ, _, addr, off, size = struct.unpack_from(">IIIIII", data, shoff + i * shentsize)
        if typ == 1 and addr:
            out.append((addr, size, off))
    return data, out


def word_at(data, secs, addr):
    for a, size, off in secs:
        if a <= addr < a + size - 1:
            return struct.unpack_from(">h", data, off + addr - a)[0]
    return None


def fpu_hits(path):
    try:
        out = subprocess.run([os.path.join(TOOLS, "amix-fpu-scan"), path], capture_output=True,
                             text=True, env=dict(os.environ, PATH=CROSS + ":" + os.environ["PATH"])).stdout
    except OSError:
        return ["amix-fpu-scan did not run"]
    hits = [l for l in out.splitlines() if ": <" in l]   # not the counts at the end
    if not hits:
        return []
    # switch tables: jmp %pc@(T,%dN:w) with T = the table
    data, secs = sections(path)
    tables = []
    dis = run(OBJDUMP, "-d", "--no-show-raw-insn", path)
    for m in re.finditer(r"jmp %pc@\(([0-9a-f]+) <[^>]*>,%[ad]\d:w\)", dis):
        t = int(m.group(1), 16)
        low, i = None, 0
        while low is None or t + 2 * i < low:
            w = word_at(data, secs, t + 2 * i)
            if w is None or i > 4096:
                break
            target = t + w
            if target > t and (low is None or target < low):
                low = target
            i += 1
        tables.append((t, t + 2 * i))
    # the addresses of the hits: objdump again, with addresses
    bad = []
    insn = {}
    fn = None
    for line in dis.splitlines():
        m = re.match(r"^([0-9a-f]+) <(.*)>:$", line)
        if m:
            fn = m.group(2)
            continue
        m = re.match(r"^\s*([0-9a-f]+):\t(\S+)\s*(.*)$", line)
        if m:
            insn.setdefault((fn, m.group(2) + (" " + m.group(3) if m.group(3) else "")), []).append(int(m.group(1), 16))
    for h in hits:
        m = re.match(r"^.*?: <(.*)>: (.*)$", h)
        if not m:
            bad.append(h)
            continue
        addrs = insn.get((m.group(1), m.group(2).strip()), [])
        if not addrs or any(not in_table(x, tables, path, m.group(2).split()[0]) for x in addrs):
            bad.append(h)
    return bad


def in_table(x, tables, path, mnemonic):
    """x inside a switch table, or just after one where objdump, having read
    the table as code, is still out of step with the real instructions
    (decoded again from the table's end, x is not that instruction)"""
    if any(a <= x < b for a, b in tables):
        return True
    for a, b in tables:
        if b <= x < b + 64:
            again = run(OBJDUMP, "-d", "--no-show-raw-insn", "--start-address=0x%x" % b,
                        "--stop-address=0x%x" % (x + 16), path)
            for line in again.splitlines():
                m = re.match(r"^\s*([0-9a-f]+):\t(\S+)", line)
                if m and int(m.group(1), 16) == x:
                    return m.group(2) != mnemonic
            return True
    return False


def main(argv):
    sysroot = os.environ.get("AMIX_SYSROOT", os.path.expanduser("~/opt/m68k-amix-sysroot"))
    python = None
    mods = []
    i = 0
    while i < len(argv):
        if argv[i] == "-p":
            python = argv[i + 1]; i += 2
        elif argv[i] == "-s":
            sysroot = argv[i + 1]; i += 2
        else:
            mods.append(argv[i]); i += 1
    if not mods:
        sys.exit(__doc__)
    python = python or sysroot + "/usr/local/bin/python3.11"
    if not os.path.exists(python):
        sys.exit("amix-pyext-check: no %s (install runtime/python3 into the sysroot, or -p)" % python)
    cache = {}
    pyneed, _ = dynamic(python)
    base = dynsyms(python)[0] | provided(sysroot, pyneed, cache)
    failed = 0
    textrel = []
    for mod in mods:
        need, tags = dynamic(mod)
        own, undef = dynsyms(mod)
        have = base | own | provided(sysroot, need, cache)
        problems = []
        missing = sorted(undef - have)
        if missing:
            problems.append("undefined: " + " ".join(missing))
        libs = sorted(x for x in have if x.startswith("?missing-library:"))
        if libs:
            problems.append("NEEDED not in the sysroot: " + " ".join(l.split(":", 1)[1] for l in libs))
        if "INIT_ARRAY" in tags and "INIT" not in tags:
            problems.append(".init_array but no DT_INIT: ld.so.1 would not run its constructors")
        if "TLS" in run(READELF, "-l", "-W", mod):
            problems.append("TLS segment")
        if "TEXTREL" in tags or "TEXTREL" in run(READELF, "-d", mod):
            textrel.append(os.path.basename(mod))
        problems += ["fpu: " + h for h in fpu_hits(mod)]
        if problems:
            failed += 1
            print("%s:" % mod)
            for p in problems:
                print("  " + p)
    if textrel:
        print("text relocations (accepted by ld.so.1): %d modules" % len(textrel))
    print("amix-pyext-check: %d modules, %d failed" % (len(mods), failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
