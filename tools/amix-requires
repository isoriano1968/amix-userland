#!/usr/bin/env python3
"""amix-requires DIR -- check the requirements in a component's manifest.

A manifest is NAME.manifest in the component.  Lines:
  name     area/component     as its place under components/
  version  1.2.3
  summary  one line
  require  area/component [>= VERSION]
                              another component, which must have a manifest
                              (and at least that version, when one is given)
  build    area/component [>= VERSION]
                              the same, but only to build this one (a tool of
                              the build machine): not a requirement on AMIX,
                              so amix-p5m leaves it out of the IPS package
  host     yes                a program of the PC (OI, Linux), never an AMIX
                              package: amix-p5m refuses it
  provide  PKG                a pkg-config name it installs
  file     /path [devel]      a path on AMIX it installs (checked in its stage
                              by $(manifest_files)); "devel" marks a development
                              file (headers, .so links, .pc, link stubs), which
                              an IPS package tags facet.devel; mode=4755,
                              owner=root, group=sys set those attributes (a
                              setuid helper), else root:bin 0555/0444

Every require must be a component, all the way down, without a cycle, and what
it provides must be in the sysroot.  What is missing is built from its component
and installed there, as a package system would pull it in; we have no repository
of built packages, so the source is the package.  Prints the order; exit 1 if it fails.
"""
import glob, os, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
COMPONENTS = os.path.join(ROOT, "components")


def vkey(v):
    """1.10.2 -> (1, 10, 2); letters after a number ("2.2.4a") sort after it"""
    out = []
    for part in v.split("."):
        num = "".join(c for c in part if c.isdigit())
        out.append((int(num) if num else 0, part[len(num):]))
    return tuple(out)


def read(path):
    m = {"require": [], "provide": [], "file": [], "minver": {}}
    for n, line in enumerate(open(path), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, _, value = line.partition(" ")
        value = value.strip()
        if key in ("require", "build"):
            w = value.split()
            if len(w) == 3 and w[1] == ">=":
                m["minver"][w[0]] = w[2]
            elif len(w) != 1:
                sys.exit("%s:%d: require/build takes a component and an optional >= VERSION: %s" % (path, n, line))
            m["require"].append(w[0])
        elif key == "file":
            w = value.split()
            if not w or any(x != "devel" and not (x.startswith(("mode=", "owner=", "group="))
                                                  and len(x.split("=", 1)[1]) > 0) for x in w[1:]):
                sys.exit("%s:%d: file takes a path, an optional devel and mode=/owner=/group=: %s"
                         % (path, n, line))
            m["file"].append(w[0])
        elif key == "provide":
            m[key].append(value)
        elif key in ("name", "version", "summary"):
            m[key] = value
        elif key in ("cpu-allow", "cpu-skip"):
            # 68040/060 code the CPU gate lets pass, with the reason after it
            if len(value.split()) < 2:
                sys.exit("%s:%d: %s takes what and a reason: %s" % (path, n, key, line))
        elif key == "uses":
            # a file it needs at run time (amix-p5m, tools/amix_needed.py)
            if not value.startswith("/") or len(value.split()) != 1:
                sys.exit("%s:%d: uses takes one absolute path: %s" % (path, n, line))
        elif key == "hw":
            # the board it needs (amix-p5m): z3660, z3660-core1 or zz9000,
            # alternatives with |
            if not value or any(x not in ("z3660", "z3660-core1", "zz9000") for x in value.split("|")):
                sys.exit("%s:%d: hw takes z3660, z3660-core1 or zz9000 (alternatives with |): %s"
                         % (path, n, line))
        elif key == "host":
            # a program of the PC, never an AMIX package (amix-p5m refuses it)
            if value != "yes":
                sys.exit("%s:%d: host takes yes: %s" % (path, n, line))
            m[key] = value
        elif key == "cpu":
            # the CPU the code needs: 68020 (the baseline) or 68060 (amix-p5m)
            if value not in ("68020", "68060"):
                sys.exit("%s:%d: cpu takes 68020 or 68060: %s" % (path, n, line))
            m[key] = value
        elif key == "source-only":
            # no package of its own: the components that use it build it in
            # (amix-p5m refuses it); the value says what it is part of
            if not value:
                sys.exit("%s:%d: source-only takes what the source is built into: %s" % (path, n, line))
            m[key] = value
        else:
            sys.exit("%s:%d: unknown line: %s" % (path, n, line))
    return m


def manifest(comp):
    found = glob.glob(os.path.join(COMPONENTS, comp, "*.manifest"))
    if len(found) != 1:
        return None
    m = read(found[0])
    if m.get("name") != comp:
        sys.exit("%s: name is %s, it is at %s" % (found[0], m.get("name"), comp))
    return m


def present(pkg):
    tool = os.path.join(ROOT, "tools", "amix-pkg-config")
    return subprocess.call([tool, "--exists", pkg], stderr=subprocess.DEVNULL) == 0


def walk(comp, path, order, bad):
    if comp in path:
        bad.append("cycle: " + " -> ".join(path + [comp]))
        return
    if comp in order:
        return
    m = manifest(comp)
    if m is None:
        bad.append("%s: no such component, or no manifest (needed by %s)" % (comp, path[-1] if path else "?"))
        return
    for r in m["require"]:
        want = m["minver"].get(r)
        if want:
            rm = manifest(r)
            if rm is not None and vkey(rm.get("version", "0")) < vkey(want):
                bad.append("%s needs %s >= %s, the component is %s" % (comp, r, want, rm.get("version")))
        walk(r, path + [comp], order, bad)
    order.append(comp)
    if not path:
        return
    missing = [p for p in m["provide"] if not present(p)]
    if missing and os.environ.get("AMIX_REQUIRES_NO_BUILD"):
        # a build from packages (the AMIX Installer's): the sysroot holds the
        # requirements, unpacked from the repository; nothing is built here
        bad.append("%s needs %s (%s): not in the sysroot %s" % (path[-1], comp, " ".join(missing),
                                                                  os.environ.get("AMIX_SYSROOT", "")))
        return
    if missing:
        print("amix-requires: %s needs %s: building %s" % (path[-1], " ".join(missing), comp), file=sys.stderr)
        d = os.path.join(COMPONENTS, comp)
        if subprocess.call([os.environ.get("MAKE", "make"), "-C", d, "-n", "stage"], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL) != 0:
            bad.append("%s: cannot be built here, see its README (needed by %s)" % (comp, path[-1]))
        elif subprocess.call([os.environ.get("MAKE", "make"), "-C", d, "build", "sysroot-install"], stdout=sys.stderr) != 0:
            bad.append("%s: build failed (needed by %s)" % (comp, path[-1]))
        elif not all(present(p) for p in missing):
            bad.append("%s: built, but %s still missing" % (comp, " ".join(missing)))


def main():
    here = os.path.abspath(sys.argv[1])
    comp = os.path.relpath(here, COMPONENTS)
    order, bad = [], []
    walk(comp, [], order, bad)
    for b in bad:
        print("amix-requires:", b, file=sys.stderr)
    if bad:
        return 1
    print(" ".join(order))
    return 0


sys.exit(main())
