#!/bin/sh
# amix-mkshlib [-init] ARCHIVE SONAME OUTDIR [LINK-ARGS...]
#
# A shared library for AMIX from a static archive built -fPIC, for components
# whose own build cannot make one for this target: OUTDIR/SONAME with all of
# ARCHIVE, naming the libraries in LINK-ARGS (-L, -l, -Wl,-R) as NEEDED, and
# the lib<name>.so link beside it.  The GOT check (gcc 14's -fPIC bug) runs on
# the archive first; afterwards it is stripped, exported data is named again
# (amix-fix-data-relocs) and the NEEDED names go first in .dynstr
# (amix-fix-needed).  -init: the library has constructors, which ld.so.1 runs
# only through its _init (so-init/).
T=`dirname "$0"`
CC=${CC:-m68k-elf-gcc}
init=
if [ "$1" = -init ]; then init=1; shift; fi
a=$1; so=$2; out=$3; shift 3
[ -f "$a" ] || { echo "amix-mkshlib: no archive $a" >&2; exit 1; }
"$T/amix-got-check" "$a" || exit 1
begin= end=
if [ -n "$init" ]; then
	w=$out/so-init; mkdir -p "$w"
	$CC -c "$T/so-init/begin.s" -o "$w/begin.o" &&
	$CC -c "$T/so-init/end.s" -o "$w/end.o" &&
	$CC -O2 -m68060 -fPIC -c "$T/so-init/init.c" -o "$w/init.o" &&
	"$T/amix-got-check" "$w/init.o" || exit 1
	begin=$w/begin.o; end="$w/init.o $w/end.o"
fi
rm -f "$out/$so"
# ld warns that /usr/lib/libc.so.1 is not on this machine: it is on AMIX
$CC -shared -Wl,-h,"$so" $begin -Wl,--whole-archive "$a" -Wl,--no-whole-archive $end \
	"$@" -o "$out/$so" 2>&1 | grep -v '/usr/lib/libc.so.1, needed by' >&2
[ -f "$out/$so" ] || exit 1
${STRIP:-m68k-elf-strip} "$out/$so" || exit 1
"$T/amix-fix-data-relocs" "$out/$so" || exit 1
"$T/amix-fix-needed" "$out/$so" > /dev/null || exit 1
ln -sf "$so" "$out/`echo $so | sed 's/\.so\..*/.so/'`"
