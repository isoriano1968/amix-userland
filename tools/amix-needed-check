#!/usr/bin/env python3
"""amix-needed-check REPO [STEM...] -- the shared library dependency gate of
tools/amix-publish (tools/amix_needed.py) over the newest version of every
package in the IPS repository REPO, or of the STEMs: exit 1 with one line per
DT_NEEDED that neither the package nor its requirements nor the AMIX base
system delivers, and per path that two packages deliver."""
import os
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import amix_needed  # noqa: E402


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: amix-needed-check REPO [STEM...]")
    repo = sys.argv[1]
    pk = os.path.join(repo, "publisher", amix_needed.PUBLISHER, "pkg")
    stems = sys.argv[2:] or sorted(urllib.parse.unquote(s) for s in os.listdir(pk))
    base = amix_needed.base_libs()
    bad = []
    for s in stems:
        bad += amix_needed.check_published(repo, s, base)
    bad += amix_needed.path_conflicts(repo, None if len(sys.argv) < 3 else stems)
    for b in bad:
        print(b)
    print("amix-needed-check: %d packages, %d problems" % (len(stems), len(bad)))
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
