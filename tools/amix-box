#!/bin/sh
# amix-box -- every command that touches the A3000 (ssh, scp, tests,
# measurements) goes through this, from every session: one at a time, and
# never while the user plays something.
#
#   amix-box [-w seconds] [-m "what"] command [args...]
#   amix-box -s            who holds the box now (and is a player running?)
#   amix-box -u [minutes]  the user reserves the box (default 30 minutes, or
#                          until Ctrl-C): no session starts anything meanwhile
#
# - Takes an exclusive lock on the PC (/tmp/amix-box.lock).  Held by another
#   session: says who and what since when, waits up to -w seconds (default 0),
#   then exits 75.  So copies, builds' installs and tests of different
#   sessions never overlap, and no measurement runs beside someone's load.
# - With the lock, asks the box whether a player runs (ffplay, vplay, mikmod,
#   quake, pt2): if one does, exits 75 without running anything.
# - Runs the command with the lock held; its exit status is ours.  While it
#   runs, the box is asked every 5 s for a player: if the user starts one,
#   the command's processes are stopped (SIGSTOP, so an scp's transfer halts
#   at once) until the player is gone, then continued.
# Exit 75 (EX_TEMPFAIL): not now -- wait for the user or the other session,
# never work around it.
LOCK=/tmp/amix-box.lock
INFO=/tmp/amix-box.who
BOX=root@192.168.0.133
KEY="-i $HOME/.ssh/id_ed25519_amix -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=60"
PLAYERS='[f]fplay|[v]play |[m]ikmod|[q]uake|[p]t2'
wait=0
what=""

players() {
	# shellcheck disable=SC2086
	timeout 120 ssh $KEY "$BOX" "ps -ef | /usr/gnu/bin/grep -E '$PLAYERS'"
}

case "$1" in
-u)
	min=${2:-30}
	exec 9>>"$LOCK"
	echo "waiting for the box (held: $(cat "$INFO" 2>/dev/null))"
	flock 9
	echo "pid $$ (the user): reserved for $min minutes since $(date +%H:%M:%S)" > "$INFO"
	trap ': > "$INFO"; exit 0' INT TERM EXIT
	echo "the box is yours for $min minutes (Ctrl-C ends it)"
	sleep $((min * 60))
	exit 0 ;;
-s)
	if [ -s "$INFO" ] && ! flock -n "$LOCK" true 2>/dev/null; then
		echo "held: $(cat "$INFO")"
	else
		echo "free"
	fi
	players >/dev/null
	case $? in
	0) echo "a player runs on the box" ;;
	1) echo "no player on the box" ;;
	*) echo "cannot ask the box (ssh failed)" ;;
	esac
	exit 0 ;;
esac
while [ $# -gt 0 ]; do
	case "$1" in
	-w) wait=$2; shift 2 ;;
	-m) what=$2; shift 2 ;;
	--) shift; break ;;
	*) break ;;
	esac
done
[ $# -gt 0 ] || { echo "usage: amix-box [-w seconds] [-m what] command [args...] | amix-box -s" >&2; exit 2; }

exec 9>>"$LOCK"
if ! flock -w "$wait" 9; then
	echo "amix-box: the box is busy: $(cat "$INFO" 2>/dev/null) -- not now" >&2
	exit 75
fi
echo "pid $$ (${CLAUDE_SESSION_NAME:-$(basename "$PWD")}): ${what:-$*} since $(date +%H:%M:%S)" > "$INFO"
trap ': > "$INFO"' EXIT
players >/dev/null
case $? in
0)	echo "amix-box: a player runs on the box -- nothing is done until the user has stopped" >&2
	exit 75 ;;
1)	;;
*)	echo "amix-box: cannot ask the box whether a player runs (ssh failed) -- not now" >&2
	exit 75 ;;
esac
# the command in its own process group, paused while the user plays (dash's
# kill cannot signal a group: /bin/kill)
setsid "$@" &
child=$!
stopped=0
while kill -0 $child 2>/dev/null; do
	sleep 5
	kill -0 $child 2>/dev/null || break
	players >/dev/null
	r=$?
	if [ $r = 0 ] && [ $stopped = 0 ]; then
		/bin/kill -s STOP -- -$child 2>/dev/null && stopped=1
		echo "amix-box: a player started: ${what:-$*} paused" >&2
		echo "pid $$: ${what:-$*} -- PAUSED while the user plays" > "$INFO"
	elif [ $r = 1 ] && [ $stopped = 1 ]; then
		/bin/kill -s CONT -- -$child 2>/dev/null
		stopped=0
		echo "amix-box: the player is gone: ${what:-$*} goes on" >&2
		echo "pid $$: ${what:-$*} since $(date +%H:%M:%S) (resumed)" > "$INFO"
	fi
done
wait $child
