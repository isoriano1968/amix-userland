#!/usr/bin/env python3
"""amix-link-stub LIB OUT.s: what AMIX's own ld needs to link against LIB.

The 1991 ld crashes on a library from current binutils.  This writes assembler
that defines LIB's exported symbols with their types and sizes; on the box
`as` and `ld -G -h <soname>` turn it into libX.so, for links only.  A program
linked to it asks for the soname, so it runs with the real library.  What LIB
wants from archives, which no shared library has (pow, regcmp), is named in the
stub so that a link pulls it into the program: -k OTHER.so... lists the shared
libraries whose symbols do not count.  The arguments LIB was linked with can be
given instead (-Ldir -lname, as in SHLIB_ARGS): each -lname found as a shared
library in a -L directory counts, an archive does not.  -n DIR instead: the
libraries LIB names as NEEDED, found by soname in the DIRs, count.  AMIX's
libc, libnsl and libsocket in $AMIX_SYSROOT always count.  STUB_ONLY=regex keeps the names
matching it, for a library that exports far more than its API: as has little
memory.
"""
import os, re, subprocess, sys

SKIP = {"_init", "_fini", "_etext", "_edata", "_end", "__bss_start", "_DYNAMIC",
	"_GLOBAL_OFFSET_TABLE_", "_PROCEDURE_LINKAGE_TABLE_"}
lib, out = sys.argv[1:3]
only = re.compile(os.environ["STUB_ONLY"]) if "STUB_ONLY" in os.environ else None
sysroot = os.environ.get("AMIX_SYSROOT", os.path.expanduser("~/opt/m68k-amix-sysroot"))
others = [os.path.join(sysroot, "usr/lib", n) for n in ("libc.so.1", "libnsl.so", "libsocket.so")]
args = sys.argv[3:]
dirs = [a[2:] for a in args if a.startswith("-L")]
ndirs = [args[i + 1] for i, a in enumerate(args) if a == "-n"]
args = [a for i, a in enumerate(args) if a != "-n" and (i == 0 or args[i - 1] != "-n")]
if ndirs:
	for l in subprocess.check_output(["readelf", "-d", lib], text=True).splitlines():
		m = re.search(r"\(NEEDED\).*\[(.+)\]", l)
		if m and not m.group(1).startswith("/"):
			others += [p for p in (os.path.join(d, m.group(1)) for d in ndirs) if os.path.exists(p)][:1]
for a in args:
	if a.startswith("-l"):
		others += [p for p in (os.path.join(d, "lib%s.so" % a[2:]) for d in dirs) if os.path.exists(p)][:1]
	elif not a.startswith("-"):
		others.append(a)
known = set()
for k in others:
	for l in subprocess.check_output(["readelf", "-W", "--dyn-syms", "--syms", k], text=True).splitlines():
		p = l.split()
		if len(p) == 8 and p[0].rstrip(":").isdigit() and p[6] != "UND":
			known.add(p[7].split("@")[0])
funcs, objs, needs = [], [], []
for l in subprocess.check_output(["readelf", "-W", "--dyn-syms", lib], text=True).splitlines():
	p = l.split()
	if len(p) == 8 and p[0].rstrip(":").isdigit() and p[6] == "UND" and p[4] != "WEAK" and p[7].split("@")[0] not in known:
		needs.append(p[7].split("@")[0])
	if len(p) != 8 or not p[0].rstrip(":").isdigit() or p[6] == "UND" or p[4] == "LOCAL":
		continue
	name = p[7].split("@")[0]
	if name in SKIP or (only and not only.match(name)):
		continue
	if p[3] == "OBJECT":
		objs.append((name, int(p[2], 0) or 4))
	elif p[3] in ("FUNC", "NOTYPE"):
		funcs.append(name)
with open(out, "w") as f:
	f.write("\t.text\n")
	for n in funcs:
		f.write("\t.globl %s\n\t.type %s,@function\n%s:\n" % (n, n, n))
	f.write("\trts\n\t.data\n")
	for n, s in objs:
		f.write("\t.globl %s\n\t.type %s,@object\n\t.size %s,%d\n\t.align 4\n%s:\n\t.space %d\n" % (n, n, n, s, n, s))
	for n in needs:
		f.write("\t.long %s\n" % n)
print("%s: needs %s" % (lib.split("/")[-1], " ".join(needs) or "nothing"))
