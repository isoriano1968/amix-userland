#!/usr/bin/env python3
"""amix-fix-xtinherit PROGRAM...: one _XtInherit for a program with its own widget classes.

A class record in a program holds the PLT stub's address as _XtInherit, and
ld.so.1 passes over undefined symbols, so libXt compares with its real function
and inheritance fails.  Mark the stub as the definition; everybody then binds
to it.  Stopgap: the stub then calls itself if a class really is unresolved.
"""
import struct, sys

def fix(path):
    d = bytearray(open(path, "rb").read())
    shoff, = struct.unpack(">I", d[32:36])
    shentsize, shnum, shstrndx = struct.unpack(">HHH", d[46:52])
    sh = [struct.unpack(">10I", d[shoff + i * shentsize:shoff + i * shentsize + 40]) for i in range(shnum)]
    strs = sh[shstrndx][4]
    name = lambda n, base: bytes(d[base + n:d.index(0, base + n)]).decode()
    plt = next(i for i, s in enumerate(sh) if name(s[0], strs) == ".plt")
    for s in sh:
        if s[1] == 11:
            str_off = sh[s[6]][4]
            for i in range(s[5] // 16):
                o = s[4] + i * 16
                n, value, size, info, other, shndx = struct.unpack(">IIIBBH", d[o:o + 16])
                if name(n, str_off) == "_XtInherit" and value and not shndx:
                    d[o + 14:o + 16] = struct.pack(">H", plt)
                    print("%s: _XtInherit is the stub at %#x" % (path, value))
    open(path, "wb").write(d)

for p in sys.argv[1:]:
    fix(p)
