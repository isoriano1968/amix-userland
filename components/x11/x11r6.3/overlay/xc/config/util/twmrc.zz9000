NoGrabServer
RestartPreviousState
DecorateTransients
RandomPlacement
ShowIconManager
UsePPosition "on"
NoDefaults
IconDirectory "/usr/x11r6/xc/include/bitmaps"
TitleFont "fixed"
ResizeFont "fixed"
MenuFont "fixed"
IconFont "fixed"
IconManagerFont "fixed"
BorderWidth 2
ButtonIndent 0
FramePadding 2
TitlePadding 4

LeftTitleButton "menu12" = f.menu "window"
RightTitleButton "icon" = f.iconify
RightTitleButton "xlogo11" = f.delete

Color
{
    BorderColor "gray40"
    DefaultBackground "#1b365d"
    DefaultForeground "gray90"
    TitleBackground "#1b365d"
    TitleForeground "white"
    MenuBackground "gray15"
    MenuForeground "gray90"
    MenuTitleBackground "#1b365d"
    MenuTitleForeground "white"
    IconBackground "gray15"
    IconForeground "gray90"
    IconManagerBackground "gray15"
    IconManagerForeground "gray90"
}

Button1 = : root : f.menu "main"
Button2 = : root : f.menu "windows"
Button3 = : root : f.menu "main"

Button1 = : title : f.move
Button2 = : title : f.raise
Button3 = : title : f.menu "window"

menu "main"
{
    "AMIX ZZ9000"       f.title
    "xterm"            f.exec "/usr/x11r6/xc/programs/xterm/xterm -geometry 100x30+60+60 -title 'AMIX X11R6.3 on ZZ9000' -e ${ZZ9K_SHELL-/bin/sh} &"
    "xclock"           f.exec "/usr/x11r6/xc/programs/xclock/xclock -geometry 220x220-20+20 &"
    "Mesa gears"       f.exec "sh /usr/x11r6/xc/config/util/gears.zz9000 &"
    "blue background"  f.exec "/usr/x11r6/xc/programs/xsetroot/xsetroot -solid '#1b365d' &"
    ""                 f.nop
    "refresh"          f.refresh
    "restart twm"      f.restart
    "exit X session"   f.quit
}

menu "window"
{
    "Window"           f.title
    "raise"            f.raise
    "lower"            f.lower
    "move"             f.move
    "resize"           f.resize
    "iconify"          f.iconify
    "delete"           f.delete
    "destroy"          f.destroy
}

menu "windows"
{
    "Windows"          f.title
    "icon manager"     f.showiconmgr
    "refresh"          f.refresh
}
