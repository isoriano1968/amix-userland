OBJS = amixMono.o amixCursor.o amixIo.o amixKbd.o amixMouse.o amixKeyMap.o

STD_DEFINES = ServerDefines -DRTG -DZZ9000
   INCLUDES = -I. -I../../mfb -I../../mi -I../../include -I$(XINCLUDESRC) -I$(FONTINCSRC) -I/usr/amiga/include

   RTGDIRS = rtg
   SUBDIRS = $(RTGDIRS)

