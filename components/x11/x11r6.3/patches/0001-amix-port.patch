+/* ------------------------------------------------------------------ */
+/* GCFuncs and GCOps default tables                                   */
+
+static GCFuncs ZZ9000gcFuncs =
+{
+    ZZ9000ValidateGC,
+    ZZ9000ChangeGC,
+    ZZ9000CopyGC,
+    ZZ9000DestroyGC,
+    ZZ9000ChangeClip,
+    ZZ9000DestroyClip,
+    ZZ9000CopyClip,
+};
