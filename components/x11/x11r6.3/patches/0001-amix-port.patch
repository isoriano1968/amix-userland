+    pScreen->MarkUnrealizedWindow   = miMarkUnrealizedWindow;
+
+    /* Block/Wakeup and cursor are installed by rtgInit.c after this returns */
+
+    ZZ9000Soft3DInit(pRTG);         /* zz9000draw.c: 3D clients' swaps */
+    return TRUE;
+}
