+keycode  24 = i I
+keycode  25 = o O
+keycode  26 = p P
+keycode  27 = udiaeresis Udiaeresis
+keycode  28 = plus asterisk asciitilde
+
+keycode  33 = a A
+keycode  34 = s S
+keycode  35 = d D
+keycode  36 = f F
+keycode  37 = g G
+keycode  38 = h H
+keycode  39 = j J
+keycode  40 = k K
+keycode  41 = l L
+keycode  42 = odiaeresis Odiaeresis
