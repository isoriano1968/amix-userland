+/*-
+ *-----------------------------------------------------------------------
+ * SetTimeSinceLastInputEvent --
+ *	Set the lastEventTime to now.
+ *
+ * Results:
+ *	None.
+ *
+ * Side Effects:
+ *	lastEventTime is altered.
+ *
+ *-----------------------------------------------------------------------
+ */
+void
+SetTimeSinceLastInputEvent()
+{
+    struct timeval now;
+
+    gettimeofday (&now, (struct timezone *)0);
+    lastEventTime = TVTOMILLI(now);
+}
