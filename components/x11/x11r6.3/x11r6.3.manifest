# name, version and what building and running it needs
name     x11/x11r6.3
version  6.3
# the 68020..68060 baseline (-mcpu=68020 -mtune=68060), tools/amix-cpu-scan clean
cpu      68020
summary  X11R6.3 client libraries (shared, libX*.so.7), headers, .pc files, xauth, xinit, xset, xsetroot, xrdb, xterm and xmodmap in /usr/x11r6
# x11.pc requires amixc99 (what current libraries want from libc beyond AMIX's)
require  library/amixc99 >= 1
# xterm's termcap
require  library/ncurses
provide  x11
provide  xt
provide  xext
provide  xmu
provide  xaw
provide  ice
provide  sm
provide  xi
provide  xau
provide  xdmcp
# every file the stage installs; "devel": headers, .so links, .pc, link stubs
file     /usr/local/share/amix-stubs/x11r6.3/LIST devel
file     /usr/local/share/amix-stubs/x11r6.3/libICE.so.7.s devel
