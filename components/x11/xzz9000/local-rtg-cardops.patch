diff --git a/programs/Xserver/hw/amix/rtg/zz9000/zz9000accel.c b/programs/Xserver/hw/amix/rtg/zz9000/zz9000accel.c
new file mode 100644
index 0000000..4d68c68
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/zz9000/zz9000accel.c
@@ -0,0 +1,134 @@
+/*
+** zz9000accel.c - the ZZ9000 / Z3660 blitter for the RTG core (P-5 fix 3):
+** the card's solidFill, copyRect and waitIdle.
+**
+** The core decides what goes to the blitter (-blitmin, pRTG->accelMin) and
+** cuts it into bands (-blitmax, pRTG->accelMax); see rtgdraw.c.  Here the
+** operations are queued as ZZ9KIOC_BLITS records and sent in batches.  The
+** queue keeps drawing order; the core calls waitIdle (a flush) before any
+** CPU drawing in its blitter paths and before each entry point returns, so
+** no other code ever finds it non-empty.  The CPU sits in the stalled
+** register write for the whole of one card operation; the driver runs a
+** batch record by record at base priority, so interrupts are taken between
+** the core's bands.
+**
+** If the driver refuses (no blitter on this board or in this mode: ENXIO; a
+** kernel without the ioctl: EINVAL), blitting stays off for the life of the
+** server (pRTG->accelMin 0) and the refused records are drawn by the core's
+** CPU code.  The driver refuses a batch before running any of it, and
+** records made from clip boxes always lie on the screen, so nothing is
+** drawn twice.
+*/
+
+#include <errno.h>
+#include "../../amix.h"
+#include "../rtg.h"
+#include "zz9000.h"
+
+#define BLITQ   64
+
+static struct zz9k_blit blitQ[BLITQ];
+static int              blitN;
+static rtgScreenPtr     blitRTG;
+static int              blitSaid;       /* the server log has the first batch */
+
+static void
+blitFlush()
+{
+    struct zz9k_blits bs;
+    struct zz9k_blit *b;
+    int               i, n;
+
+    if (blitN == 0)
+        return;
+    bs.recs = blitQ;
+    bs.n    = blitN;
+    if (ioctl(GetZZ9000Screen(blitRTG)->fd, ZZ9KIOC_BLITS, &bs) >= 0)
+    {
+        if (!blitSaid)
+            ZZErr("zz9000: card blitter in use from %d pixels\n",
+                  blitRTG->accelMin);
+        blitSaid = 1;
+        blitN = 0;
+        return;
+    }
+    ZZErr("zz9000: the driver refused the card blitter (errno %d); -blitmin %d off\n",
+          errno, blitRTG->accelMin);
+    ZZErr("zz9000: screen %dx%d, %d records:\n", blitRTG->width, blitRTG->height,
+          blitN);
+    for (i = 0, b = blitQ; i < blitN; i++, b++)
+        ZZErr("zz9000:  %d op %d at %d,%d %dx%d from %d,%d\n", i, b->op,
+              b->x, b->y, b->width, b->height, b->src_x, b->src_y);
+    blitRTG->accelMin = 0;
+    n = blitN;
+    blitN = 0;
+    for (i = 0, b = blitQ; i < n; i++, b++)
+    {
+        if (b->op == ZZ9K_BLIT_FILL)
+            (*zz9000Core->cpuFill)(blitRTG, b->x, b->y, b->width, b->height,
+                                   b->color);
+        else
+            (*zz9000Core->cpuCopy)(blitRTG, b->src_x, b->src_y, b->x, b->y,
+                                   b->width, b->height);
+    }
+}
+
+/* Run the queued records now: before the card's mode changes (RandR). */
+void
+zz9000BlitFlush()
+{
+    if (blitN)
+        blitFlush();
+}
+
+/* Append one record to the queue; FALSE = refused (draw it yourself). */
+static Bool
+blitRecord(pRTG, op, x, y, w, h, sx, sy, color)
+rtgScreenPtr  pRTG;
+int           op, x, y, w, h, sx, sy;
+unsigned long color;
+{
+    struct zz9k_blit *b;
+
+    if (blitN == BLITQ)
+        blitFlush();
+    if (pRTG->accelMin <= 0)            /* that flush was refused */
+        return FALSE;
+    b = &blitQ[blitN++];
+    b->op     = op;
+    b->x      = x;
+    b->y      = y;
+    b->width  = w;
+    b->height = h;
+    b->src_x  = sx;
+    b->src_y  = sy;
+    b->pad    = 0;
+    b->color  = color;
+    blitRTG   = pRTG;
+    return TRUE;
+}
+
+Bool
+zz9000SolidFill(pRTG, x, y, w, h, pixel)
+rtgScreenPtr  pRTG;
+int           x, y, w, h;
+unsigned long pixel;
+{
+    return blitRecord(pRTG, ZZ9K_BLIT_FILL, x, y, w, h, 0, 0, pixel);
+}
+
+Bool
+zz9000CopyRect(pRTG, sx, sy, dx, dy, w, h)
+rtgScreenPtr pRTG;
+int          sx, sy, dx, dy, w, h;
+{
+    return blitRecord(pRTG, ZZ9K_BLIT_COPY, dx, dy, w, h, sx, sy, 0UL);
+}
+
+void
+zz9000WaitIdle(pRTG)
+rtgScreenPtr pRTG;
+{
+    if (blitN)
+        blitFlush();
+}
