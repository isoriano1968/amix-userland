+/*
+** RTG_CARD_FILE: its first line that is not blank or a # comment holds the
+** card's name and, optionally, the depth ("zz9000 16").  Into rtgFileCard
+** and rtgFileDepth; FALSE if there is no such file or line.
+*/
+static Bool
+rtgCardFile()
+{
+    FILE *f;
+    char  line[128], *p;
+    int   n;
+
+    if ((f = fopen(RTG_CARD_FILE, "r")) == (FILE *)0)
+        return FALSE;
+    while (fgets(line, sizeof(line), f)) {
+        for (p = line; *p && isspace((unsigned char)*p); p++)
+            ;
+        if (!*p || *p == '#')
+            continue;
+        for (n = 0; p[n] && !isspace((unsigned char)p[n]) &&
+                    n < sizeof(rtgFileCard) - 1; n++)
+            rtgFileCard[n] = p[n];
+        rtgFileCard[n] = '\0';
+        rtgFileDepth = atoi(p + n);
+        if (rtgFileDepth != 8 && rtgFileDepth != 16 && rtgFileDepth != 24) {
+            if (rtgFileDepth)
+                ErrorF("rtg: %s: depth %d ignored (8, 16 or 24)\n",
+                       RTG_CARD_FILE, rtgFileDepth);
+            rtgFileDepth = 0;
+        }
+        fclose(f);
+        return TRUE;
+    }
+    fclose(f);
+    return FALSE;
+}
