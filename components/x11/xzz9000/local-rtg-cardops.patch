diff --git a/programs/Xserver/hw/amix/rtg/rtgwin.c b/programs/Xserver/hw/amix/rtg/rtgwin.c
new file mode 100644
index 0000000..0bbe8e2
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgwin.c
@@ -0,0 +1,315 @@
+/*
+** rtgwin.c - the RTG core's windows.
+**
+** Window lifecycle hooks of the 16-bit layer: a plain framebuffer has no
+** hardware window support, so they are no-ops that return TRUE (the 8-bit
+** screen keeps cfb's).
+**
+** PaintWindow and CopyWindow are the same for every depth: solid fills and
+** copies go to the card's blitter (rtgFillBox, rtgCopyBox) or to the CPU;
+** a 16-bit background tile is drawn here, an 8-bit one by cfb.
+*/
+
+#include "X.h"
+#include "Xmd.h"
+#include "scrnintstr.h"
+#include "regionstr.h"
+#include "windowstr.h"
+#include "pixmapstr.h"
+#include "../amix.h"
+#include "rtg.h"
+#include "rtgrun.h"
+
+/* ---------------------------------------------------------------------- */
+/* Lifecycle hooks (16-bit layer)                                          */
+
+Bool
+rtgCreateWindow(pWin)
+WindowPtr pWin;
+{
+    return TRUE;
+}
+
+Bool
+rtgDestroyWindow(pWin)
+WindowPtr pWin;
+{
+    return TRUE;
+}
+
+Bool
+rtgPositionWindow(pWin, x, y)
+WindowPtr pWin;
+int       x, y;
+{
+    return TRUE;
+}
+
+Bool
+rtgChangeWindowAttributes(pWin, mask)
+WindowPtr     pWin;
+unsigned long mask;
+{
+    return TRUE;
+}
+
+Bool
+rtgRealizeWindow(pWin)
+WindowPtr pWin;
+{
+    return TRUE;
+}
+
+Bool
+rtgUnrealizeWindow(pWin)
+WindowPtr pWin;
+{
+    return TRUE;
+}
+
+/* ---------------------------------------------------------------------- */
+/* rtgPaintWindow                                                          */
+
+/*
+** tileBoxes - fill the boxes from a 16-bit tile, the tile's origin at
+** (xorg, yorg) as X requires (a window background's origin is the window's).
+** A large box goes to the card's patternFill if it has one; otherwise row
+** by row through the CPU mapping: one copyRun per tile-wide stretch.
+** Queued blits are waited for first so they cannot land on top of these
+** writes.
+*/
+static void
+tileBoxes(pRTG, pbox, nbox, pTile, xorg, yorg)
+rtgScreenPtr pRTG;
+BoxPtr       pbox;
+int          nbox;
+PixmapPtr    pTile;
+int          xorg, yorg;
+{
+    unsigned short *fb = (unsigned short *) pRTG->fbBase;
+    int             stride = pRTG->pitch / 2;
+    unsigned short *tbase = (unsigned short *) pTile->devPrivate.ptr;
+    int             tstride = (int) pTile->devKind / 2;
+    int             tw = pTile->drawable.width, th = pTile->drawable.height;
+    int             x, y, tx, ty, w, n;
+    unsigned short *dst, *trow;
+
+    for (; nbox-- > 0; pbox++)
+    {
+        if (pbox->x1 >= pbox->x2 || pbox->y1 >= pbox->y2)
+            continue;
+        if (RTG_ACCEL_WANT(pRTG, pbox->x2 - pbox->x1, pbox->y2 - pbox->y1) &&
+            pRTG->card->patternFill &&
+            (*pRTG->card->patternFill)(pRTG, pbox->x1, pbox->y1,
+                                       pbox->x2 - pbox->x1, pbox->y2 - pbox->y1,
+                                       (unsigned char *) tbase,
+                                       (int) pTile->devKind, tw, th, xorg, yorg))
+        {
+            pRTG->accelPending = 1;
+            continue;
+        }
+        RTG_SYNC(pRTG);
+        ty = (pbox->y1 - yorg) % th;
+        if (ty < 0)
+            ty += th;
+        for (y = pbox->y1; y < pbox->y2; y++)
+        {
+            trow = tbase + (long) ty * tstride;
+            dst = fb + (unsigned long) y * stride + pbox->x1;
+            tx = (pbox->x1 - xorg) % tw;
+            if (tx < 0)
+                tx += tw;
+            for (w = pbox->x2 - pbox->x1; w > 0; w -= n, dst += n, tx = 0)
+            {
+                n = tw - tx;
+                if (n > w)
+                    n = w;
+                copyRun(dst, trow + tx, n);
+            }
+            if (++ty == th)
+                ty = 0;
+        }
+    }
+}
+
+/*
+** rtgPaintWindow - paint window background (PW_BACKGROUND) or border
+** (PW_BORDER).
+**
+** A solid pixel is a VRAM fill; a pixmap background or border is tiled from
+** the window's origin (tileBoxes; cfb's PaintWindow at 8 bit).
+** ParentRelative takes the nearest ancestor's background, with that
+** ancestor's origin.  This used to fill pixmap backgrounds with the tile's
+** first pixel, which made every CDE backdrop (a full-screen window with a
+** background tile) a plain colour.
+*/
+void
+rtgPaintWindow(pWin, prgn, what)
+WindowPtr pWin;
+RegionPtr prgn;
+int       what;
+{
+    rtgScreenPtr    pRTG   = GetRTGScreen(pWin->drawable.pScreen);
+    unsigned long   pixel;
+    PixmapPtr       pTile = NullPixmap;
+    WindowPtr       pOrg = pWin;        /* whose origin the tile starts at */
+    BoxPtr          pbox;
+    int             nbox;
+
+    if (what == PW_BACKGROUND)
+    {
+        WindowPtr p = pWin;
+
+        while (p && p->backgroundState == ParentRelative)
+            p = p->parent;
+        if (!p)
+            p = pWin;
+        switch (p->backgroundState)
+        {
+        case None:
+            if (p == pWin)
+                return;
+            pixel = pWin->drawable.pScreen->blackPixel;
+            break;
+        case BackgroundPixel:
+            pixel = p->background.pixel;
+            break;
+        case BackgroundPixmap:
+            pTile = p->background.pixmap;
+            pOrg = p;
+            break;
+        default:
+            pixel = pWin->drawable.pScreen->blackPixel;
+            break;
+        }
+    }
+    else /* PW_BORDER */
+    {
+        if (pWin->borderIsPixel)
+            pixel = pWin->border.pixel;
+        else
+            pTile = pWin->border.pixmap;
+    }
+
+    nbox = REGION_NUM_RECTS(prgn);
+    pbox = REGION_RECTS(prgn);
+
+    if (pTile)
+    {
+        if (pRTG->bitsPerPixel != 16)
+        {
+            (*pRTG->fbPaintWindow)(pWin, prgn, what);
+            return;
+        }
+        if (pTile->drawable.depth == 16 && pTile->devPrivate.ptr &&
+            pTile->drawable.width > 0 && pTile->drawable.height > 0)
+        {
+            tileBoxes(pRTG, pbox, nbox, pTile,
+                      (int) pOrg->drawable.x, (int) pOrg->drawable.y);
+            RTG_SYNC(pRTG);
+            return;
+        }
+        pixel = pWin->drawable.pScreen->blackPixel;
+    }
+
+    while (nbox--)
+    {
+        if (pbox->x1 < pbox->x2 && pbox->y1 < pbox->y2)
+            rtgFillBox(pRTG, pbox->x1, pbox->y1,
+                       pbox->x2 - pbox->x1, pbox->y2 - pbox->y1, pixel);
+        pbox++;
+    }
+    RTG_SYNC(pRTG);
+}
+
+/* ---------------------------------------------------------------------- */
+/* rtgCopyWindow                                                           */
+
+/*
+** copyBoxesOrdered - copy the boxes of a YX-banded region, each from (box + dx,dy),
+** in an order that never overwrites a source pixel before it is read: bands
+** bottom-up when the copy moves down (dy < 0: the source lies above), boxes
+** within a band right-to-left when it moves right (dx < 0) -- as cfb does and
+** as rtg16CopyArea walks its bands.  rtgCopyBox orders rows and columns
+** inside one box.  (CopyWindow used to choose the order from the sign of
+** old - new the wrong way round, which smeared a partly covered window's
+** contents into itself on every move.)
+*/
+static void
+copyBoxesOrdered(pRTG, pbox, nbox, dx, dy)
+rtgScreenPtr pRTG;
+BoxPtr       pbox;
+int          nbox, dx, dy;
+{
+    BoxPtr pboxEnd = pbox + nbox, pboxBand, pboxNext, first, last, b;
+    int    bandsUp = (dy < 0), boxesLeft = (dx < 0);
+
+    pboxBand = bandsUp ? pboxEnd : pbox;
+    while (bandsUp ? (pboxBand > pbox) : (pboxBand < pboxEnd))
+    {
+        if (bandsUp)
+        {
+            last  = pboxBand - 1;
+            first = last;
+            while (first > pbox && (first - 1)->y1 == last->y1)
+                first--;
+            pboxNext = first;
+        }
+        else
+        {
+            first = pboxBand;
+            last  = first;
+            while (last + 1 < pboxEnd && (last + 1)->y1 == first->y1)
+                last++;
+            pboxNext = last + 1;
+        }
+        for (b = boxesLeft ? last : first;
+             boxesLeft ? (b >= first) : (b <= last);
+             b += boxesLeft ? -1 : 1)
+            rtgCopyBox(pRTG, b->x1 + dx, b->y1 + dy, b->x1, b->y1,
+                       b->x2 - b->x1, b->y2 - b->y1);
+        pboxBand = pboxNext;
+    }
+}
+
+/*
+** rtgCopyWindow - move window contents after the window is repositioned.
+**
+** Modelled on cfbCopyWindow:
+**   1. Compute the destination region by intersecting prgnSrc (translated
+**      to the new position) with pWin->borderClip.
+**   2. Copy the boxes in direction-aware order (bottom-to-top for
+**      downward moves, reverse for rightward moves) to handle VRAM overlap.
+*/
+void
+rtgCopyWindow(pWin, ptOldOrg, prgnSrc)
+WindowPtr   pWin;
+DDXPointRec ptOldOrg;
+RegionPtr   prgnSrc;
+{
+    rtgScreenPtr  pRTG = GetRTGScreen(pWin->drawable.pScreen);
+    ScreenPtr     pScreen = pWin->drawable.pScreen;
+    RegionPtr     prgnDst;
+    int           nbox;
+    int           dx, dy;
+
+    dx = ptOldOrg.x - pWin->drawable.x;
+    dy = ptOldOrg.y - pWin->drawable.y;
+
+    prgnDst = (*pScreen->RegionCreate)(NULL, 1);
+
+    (*pScreen->TranslateRegion)(prgnSrc, -dx, -dy);
+    (*pScreen->Intersect)(prgnDst, &pWin->borderClip, prgnSrc);
+
+    nbox = REGION_NUM_RECTS(prgnDst);
+    if (nbox == 0)
+    {
+        (*pScreen->RegionDestroy)(prgnDst);
+        return;
+    }
+
+    copyBoxesOrdered(pRTG, REGION_RECTS(prgnDst), nbox, dx, dy);
+
+    RTG_SYNC(pRTG);
+    (*pScreen->RegionDestroy)(prgnDst);
+}
