diff --git a/programs/Xserver/hw/amix/rtg/rtgcfb32.c b/programs/Xserver/hw/amix/rtg/rtgcfb32.c
new file mode 100644
index 0000000..df7a8c2
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgcfb32.c
@@ -0,0 +1,111 @@
+/*
+** rtgcfb32.c - the RTG core's 24-bit TrueColor screen in 32-bit pixels, on
+** R6.3's cfb32.
+**
+** cfb32 draws everything with the CPU into the mapped framebuffer (its
+** stride is pRTG->pitch / 4 pixels).  The core adds:
+**   - the TrueColor visual's channel masks from the card (initHW fills
+**     pRTG->red/green/blueMask): a frame need not be 0x00RRGGBB -- the
+**     ZZ9000's, seen from the 68k, is 0xBBGGRRAA;
+**   - the colormap bookkeeping (rtgcmap.c; TrueColor has no table);
+**   - window fills and copies on the card's blitter where it has one
+**     (rtgPaintWindow, rtgCopyWindow), cfb32's PaintWindow for tiles;
+**   - RandR: the screen pixmap follows a new frame (rtg24FrameChanged).
+*/
+
+#define PSZ 32                  /* cfb.h: the 32-bit names (cfb32Xxx) */
+
+#include "X.h"
+#include "Xmd.h"
+#include "scrnintstr.h"
+#include "pixmapstr.h"
+#include "windowstr.h"
+#include "cfb.h"
+#include "../amix.h"
+#include "rtg.h"
+
+/* the lowest set bit of a channel mask */
+static int
+rtgMaskShift(mask)
+unsigned long mask;
+{
+    int i;
+
+    for (i = 0; i < 32 && !(mask & (1UL << i)); i++)
+        ;
+    return i;
+}
+
+Bool
+rtg24ScreenInit(pScreen, pRTG, dpix, dpiy)
+ScreenPtr    pScreen;
+rtgScreenPtr pRTG;
+int          dpix, dpiy;
+{
+    rtgCardPtr card = pRTG->card;
+    VisualPtr  v;
+    int        i;
+
+    if (!pRTG->redMask || !pRTG->greenMask || !pRTG->blueMask)
+    {
+        ErrorF("rtg24ScreenInit: card %s gave no channel masks\n", card->name);
+        return FALSE;
+    }
+    if (!cfbSetupScreen(pScreen, (pointer) pRTG->fbBase,
+                        pRTG->width, pRTG->height, dpix, dpiy,
+                        pRTG->pitch / 4))
+        return FALSE;
+
+    /* before cfbFinishScreenInit, so that what mi wraps is already ours */
+    pRTG->fbPaintWindow = pScreen->PaintWindowBackground;
+    if (card->solidFill)
+    {
+        pScreen->PaintWindowBackground = rtgPaintWindow;
+        pScreen->PaintWindowBorder     = rtgPaintWindow;
+    }
+    if (card->copyRect)
+        pScreen->CopyWindow = rtgCopyWindow;
+
+    pScreen->InstallColormap        = rtgInstallColormap;
+    pScreen->UninstallColormap      = rtgUninstallColormap;
+    pScreen->ListInstalledColormaps = rtgListInstalledColormaps;
+    pScreen->StoreColors            = rtgStoreColors;
+
+    if (!cfbSetVisualTypes(24, 1 << TrueColor, 8))
+        return FALSE;
+    if (!cfbFinishScreenInit(pScreen, (pointer) pRTG->fbBase,
+                             pRTG->width, pRTG->height, dpix, dpiy,
+                             pRTG->pitch / 4))
+        return FALSE;
+
+    /* cfb's TrueColor visual is 0x00RRGGBB; the frame's is the card's */
+    for (i = 0, v = pScreen->visuals; i < pScreen->numVisuals; i++, v++)
+    {
+        if (v->class != TrueColor || v->nplanes != 24)
+            continue;
+        v->redMask        = pRTG->redMask;
+        v->greenMask      = pRTG->greenMask;
+        v->blueMask       = pRTG->blueMask;
+        v->offsetRed      = rtgMaskShift(pRTG->redMask);
+        v->offsetGreen    = rtgMaskShift(pRTG->greenMask);
+        v->offsetBlue     = rtgMaskShift(pRTG->blueMask);
+        v->bitsPerRGBValue = 8;
+        v->ColormapEntries = 256;
+    }
+    return TRUE;
+}
+
+/*
+** RandR changed the frame (size, stride, maybe base): cfb32 draws windows
+** through the screen pixmap, so it gets the new geometry.
+*/
+void
+rtg24FrameChanged(pScreen, pRTG)
+ScreenPtr    pScreen;
+rtgScreenPtr pRTG;
+{
+    PixmapPtr pPix = cfbGetScreenPixmap(pScreen);
+
+    (*pScreen->ModifyPixmapHeader)(pPix, pRTG->width, pRTG->height, 24, 32,
+                                   pRTG->pitch, (pointer) pRTG->fbBase);
+}
diff --git a/programs/Xserver/hw/amix/rtg/rtgcfb8.c b/programs/Xserver/hw/amix/rtg/rtgcfb8.c
new file mode 100644
index 0000000..59143b5
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgcfb8.c
@@ -0,0 +1,86 @@
+/*
+** rtgcfb8.c - the RTG core's 8-bit PseudoColor screen, on R6.3's cfb.
+**
+** cfb (PSZ 8) draws everything with the CPU into the mapped framebuffer
+** (its stride is pRTG->pitch, bytes = pixels).  The core adds:
+**   - the colormap functions (rtgcmap.c): installing a map and storing
+**     colours load the card's colour table through its setColors op;
+**   - window fills and copies on the card's blitter where it has one
+**     (rtgPaintWindow, rtgCopyWindow: the same code as at 16 bit), with
+**     cfb's PaintWindow for background tiles;
+**   - RandR: the screen pixmap follows a new frame (rtg8FrameChanged).
+** GC drawing on the blitter at 8 bit (cfb's GC ops wrapped, as XFree86 3.3
+** wraps cfb) comes with the first 8-bit card.
+*/
+
+#define PSZ 8                   /* cfb.h: the 8-bit names (cfbXxx) */
+
+#include "X.h"
+#include "Xmd.h"
+#include "scrnintstr.h"
+#include "pixmapstr.h"
+#include "windowstr.h"
+#include "cfb.h"
+#include "../amix.h"
+#include "rtg.h"
+
+extern Bool cfbSetupScreen();
+extern Bool cfbFinishScreenInit();
+extern Bool cfbSetVisualTypes();
+
+/* the classes whose pixel is a colour table index */
+#define RTG8_VISUALS ((1 << StaticGray) | (1 << GrayScale) | \
+                      (1 << StaticColor) | (1 << PseudoColor))
+
+Bool
+rtg8ScreenInit(pScreen, pRTG, dpix, dpiy)
+ScreenPtr    pScreen;
+rtgScreenPtr pRTG;
+int          dpix, dpiy;
+{
+    rtgCardPtr card = pRTG->card;
+
+    if (!cfbSetupScreen(pScreen, (pointer) pRTG->fbBase,
+                        pRTG->width, pRTG->height, dpix, dpiy, pRTG->pitch))
+        return FALSE;
+
+    /*
+    ** Before cfbFinishScreenInit, so that what miScreenInit and the backing
+    ** store wrap is already ours.  cfb's PaintWindow stays for tiles.
+    */
+    pRTG->fbPaintWindow = pScreen->PaintWindowBackground;
+    if (card->solidFill)
+    {
+        pScreen->PaintWindowBackground = rtgPaintWindow;
+        pScreen->PaintWindowBorder     = rtgPaintWindow;
+    }
+    if (card->copyRect)
+        pScreen->CopyWindow = rtgCopyWindow;
+
+    pScreen->InstallColormap        = rtgInstallColormap;
+    pScreen->UninstallColormap      = rtgUninstallColormap;
+    pScreen->ListInstalledColormaps = rtgListInstalledColormaps;
+    pScreen->StoreColors            = rtgStoreColors;
+
+    if (!cfbSetVisualTypes(8, RTG8_VISUALS,
+                           card->dacBits > 0 ? card->dacBits : 8))
+        return FALSE;
+    return cfbFinishScreenInit(pScreen, (pointer) pRTG->fbBase,
+                               pRTG->width, pRTG->height, dpix, dpiy,
+                               pRTG->pitch);
+}
+
+/*
+** RandR changed the frame (size, stride, maybe base): cfb draws windows
+** through the screen pixmap, so it gets the new geometry.
+*/
+void
+rtg8FrameChanged(pScreen, pRTG)
+ScreenPtr    pScreen;
+rtgScreenPtr pRTG;
+{
+    PixmapPtr pPix = cfbGetScreenPixmap(pScreen);
+
+    (*pScreen->ModifyPixmapHeader)(pPix, pRTG->width, pRTG->height, 8, 8,
+                                   pRTG->pitch, (pointer) pRTG->fbBase);
+}
