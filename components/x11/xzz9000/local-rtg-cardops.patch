+            ErrorF("rtg: no card %s in this server\n", rtgOptCard);
+            return (rtgCardPtr)0;
+        }
+        c = rtgCardAt(i);
+        if (!(*c->probe)()) {
+            ErrorF("rtg: -card %s: no such board found\n", c->name);
+            return (rtgCardPtr)0;
+        }
+        return c;
+    }
+    if (rtgFileCard[0]) {
