diff --git a/programs/Xserver/hw/amix/rtg/rtgcpu.c b/programs/Xserver/hw/amix/rtg/rtgcpu.c
new file mode 100644
index 0000000..646efbd
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgcpu.c
@@ -0,0 +1,90 @@
+/*
+** rtgcpu.c - what the CPU offers the RTG core, and the row copies built on
+** it: move16 (68040/68060 only) and a movem.l block copy (every CPU).
+**
+** The CPU type comes from the kernel through uname(2), a documented system
+** call.  The 040/060 port kernel tags utsname.machine with the CPU it runs
+** on, from its cputype (amix-gate port/src/inituname040.s: "Amiga
+** (Unlimited) 68040-<build>", the '4' flipped to '6' when cputype is 60;
+** unix_boot pokes cputype from AmigaOS's AttnFlags).  Only those two tags
+** allow move16.  Any other machine string -- the stock 68030 kernel says
+** "Amiga (Unlimited)" -- means no move16, unless -move16 says otherwise.
+** move16 is never executed to find out: on the 528 MB m6-msp kernel a
+** move16 on user pages can hang the machine.
+**
+** rtgMovemCopy moves 32-byte blocks with movem.l (eight data and address
+** registers each way): no FPU, no move16, so it runs on a 68020/030 with
+** or without an FPU, on a 68LC040/LC060, and wherever move16 is not
+** allowed.  The instructions are spelled as words, as the move16 in
+** rtgdraw.c: the AMIX assembler's syntax is not relied on.
+*/
+
+#include <string.h>
+#include <sys/utsname.h>
+#include "misc.h"
+#include "os.h"                 /* ErrorF */
+#include "scrnintstr.h"
+#include "rtg.h"
+
+/* "68040-" or "68060-" as a word of the machine string */
+static int
+rtgMachineCpu(machine)
+char *machine;
+{
+    char *p;
+
+    for (p = machine; (p = strstr(p, "680")) != (char *)0; p++)
+        if ((p == machine || p[-1] == ' ') &&
+            (p[3] == '4' || p[3] == '6') && p[4] == '0' && p[5] == '-')
+            return p[3] == '4' ? 40 : 60;
+    return 0;
+}
+
+/* TRUE if the kernel says this is a 68040 or 68060 */
+int
+rtgHaveMove16()
+{
+    struct utsname u;
+    int            cpu;
+
+    if (uname(&u) < 0) {
+        ErrorF("rtg: uname failed; no move16 (-move16 forces it)\n");
+        return 0;
+    }
+    cpu = rtgMachineCpu(u.machine);
+    if (!cpu) {
+        ErrorF("rtg: \"%s\" names no 68040/68060; no move16 (-move16 forces it)\n",
+               u.machine);
+        return 0;
+    }
+    ErrorF("rtg: kernel says 680%d: move16 allowed\n", cpu);
+    return 1;
+}
+
+/*
+** Copy blocks * 32 bytes from src to dst, both long-aligned, forward.
+**
+**   loop: movem.l (a0)+,d1-d7/a2       4cd8 04fe
+**         movem.l d1-d7/a2,(a1)        48d1 04fe
+**         lea     32(a1),a1            43e9 0020
+**         subq.l  #1,d0                5380
+**         bne.s   loop                 66f0   (back 16 bytes from pc+2)
+*/
+void
+rtgMovemCopy(dst, src, blocks)
+unsigned char *dst;
+unsigned char *src;
+unsigned long  blocks;
+{
+    register unsigned char *s __asm__("a0") = src;
+    register unsigned char *d __asm__("a1") = dst;
+    register unsigned long  n __asm__("d0") = blocks;
+
+    if (n == 0)
+        return;
+    __asm__ volatile (".word 0x4cd8,0x04fe,0x48d1,0x04fe,0x43e9,0x0020,0x5380,0x66f0"
+                      : "=a" (s), "=a" (d), "=d" (n)
+                      : "0" (s), "1" (d), "2" (n)
+                      : "d1", "d2", "d3", "d4", "d5", "d6", "d7", "a2",
+                        "memory", "cc");
+}
diff --git a/programs/Xserver/hw/amix/rtg/rtgcursor.c b/programs/Xserver/hw/amix/rtg/rtgcursor.c
new file mode 100644
index 0000000..65a043d
--- /dev/null
+++ b/programs/Xserver/hw/amix/rtg/rtgcursor.c
@@ -0,0 +1,100 @@
+/*
+** rtgcursor.c - a card's hardware cursor under mi's pointer code.
+**
+** Used when the card has cursorLoad, cursorMove and cursorShow
+** (rtgScreenInit); otherwise the screen keeps the mi software cursor
+** (miDCInitialize), as on the ZZ9000/Z3660.  miPointer tracks the pointer
+** and calls the sprite functions below; the card gets the cursor's source
+** and mask bitmaps (MSB first, PixmapBytePad rows) with its colours, and the
+** screen position of the image's top left corner.
+*/
+
+#include "X.h"
+#include "Xmd.h"
+#include "scrnintstr.h"
+#include "cursorstr.h"
+#include "servermd.h"
+#include "mipointer.h"
+#include "../amix.h"
+#include "rtg.h"
+
+extern miPointerScreenFuncRec amixPointerScreenFuncs;
+
+static Bool
+rtgRealizeCursor(pScreen, pCursor)
+ScreenPtr pScreen;
+CursorPtr pCursor;
+{
+    return TRUE;
+}
+
+static Bool
+rtgUnrealizeCursor(pScreen, pCursor)
+ScreenPtr pScreen;
+CursorPtr pCursor;
+{
+    return TRUE;
+}
+
+/* A new cursor (NULL: none) at hot spot (x, y). */
+static void
+rtgSetCursor(pScreen, pCursor, x, y)
+ScreenPtr pScreen;
+CursorPtr pCursor;
+int       x, y;
+{
+    rtgScreenPtr   pRTG = GetRTGScreen(pScreen);
+    rtgCardPtr     card = pRTG->card;
+    CursorBitsPtr  bits;
+    unsigned short rgb[6];
+
+    if (!pCursor)
+    {
+        (*card->cursorShow)(pRTG, FALSE);
+        return;
+    }
+    bits = pCursor->bits;
+    rgb[0] = pCursor->foreRed;
+    rgb[1] = pCursor->foreGreen;
+    rgb[2] = pCursor->foreBlue;
+    rgb[3] = pCursor->backRed;
+    rgb[4] = pCursor->backGreen;
+    rgb[5] = pCursor->backBlue;
+    RTG_SYNC(pRTG);
+    if (!(*card->cursorLoad)(pRTG, bits->width, bits->height,
+                             bits->source, bits->mask,
+                             PixmapBytePad(bits->width, 1), rgb))
+    {
+        (*card->cursorShow)(pRTG, FALSE);
+        return;
+    }
+    pRTG->cursorXhot = bits->xhot;
+    pRTG->cursorYhot = bits->yhot;
+    (*card->cursorMove)(pRTG, x - pRTG->cursorXhot, y - pRTG->cursorYhot);
+    (*card->cursorShow)(pRTG, TRUE);
+}
+
+static void
+rtgMoveCursor(pScreen, x, y)
+ScreenPtr pScreen;
+int       x, y;
+{
+    rtgScreenPtr pRTG = GetRTGScreen(pScreen);
+
+    (*pRTG->card->cursorMove)(pRTG, x - pRTG->cursorXhot, y - pRTG->cursorYhot);
+}
+
+static miPointerSpriteFuncRec rtgSpriteFuncs = {
+    rtgRealizeCursor,
+    rtgUnrealizeCursor,
+    rtgSetCursor,
+    rtgMoveCursor,
+};
+
+Bool
+rtgCursorInit(pScreen)
+ScreenPtr pScreen;
+{
+    return miPointerInitialize(pScreen, &rtgSpriteFuncs,
+                               &amixPointerScreenFuncs, FALSE);
+}
