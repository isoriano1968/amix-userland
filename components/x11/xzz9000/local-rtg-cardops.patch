+        if (++i >= argc) UseMsg();
+        rtgOptCard = argv[i];
+        return 2;
+    }
+    if (!strcmp(argv[i], "-rtgdepth")) {        /* 8 or 16 */
+        if (++i >= argc) UseMsg();
+        rtgOptDepth = atoi(argv[i]);
+        if (rtgOptDepth != 8 && rtgOptDepth != 16 && rtgOptDepth != 24) {
+            ErrorF("-rtgdepth: 8, 16 or 24, not %s\n", argv[i]);
+            UseMsg();
+        }
+        return 2;
+    }
+    if (!strcmp(argv[i], "-mode")) {    /* RTG mode: WxH (e.g. 1024x768) */
+        if (++i >= argc) UseMsg();
+        if (sscanf(argv[i], "%dx%d%c", &rtgOptWidth, &rtgOptHeight, &c) != 2 ||
+            rtgOptWidth <= 0 || rtgOptHeight <= 0) {
+            ErrorF("-mode: WxH (e.g. 1024x768), not %s\n", argv[i]);
+            UseMsg();
