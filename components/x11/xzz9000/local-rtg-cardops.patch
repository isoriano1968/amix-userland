+        return 2;
+    }
+    if (!strcmp(argv[i], "-blitmax")) { /* largest area per blitter op */
+        if (++i >= argc) UseMsg();
+        rtgOptBlitMax = atoi(argv[i]);
+        if (rtgOptBlitMax < 0)
+            rtgOptBlitMax = 0;
+        return 2;
+    }
+    if (!strcmp(argv[i], "-nomove16")) {        /* no 68040/060 line bursts */
+        rtgOptMove16 = 0;
+        return 1;
+    }
+    if (!strcmp(argv[i], "-move16")) {  /* line bursts whatever uname says */
+        rtgOptMove16 = 1;
+        return 1;
+    }
+    return 0;
+}
