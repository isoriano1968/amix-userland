+/*
+** The mode table for RandR: entry i, or NULL past the end.
+*/
+ZZ9000ModePtr
+ZZ9000ModeAt(i)
+int i;
+{
+    ZZ9000ModePtr m;
+
+    for (m = zz9000_modes; m->name && i > 0; m++, i--)
+        ;
+    return m->name ? m : (ZZ9000ModePtr)0;
+}
+
+/*
+** RandR: does a w x h frame fit the card's framebuffer, below soft3D's back
+** buffer?  libs3d (components/library/soft3d) puts it at row BACK_ROW 1100
+** of the current stride, so a frame taller than 1100 rows (1600x1200,
+** 1920x1200) would show it and be overwritten by it.
+*/
+#define ZZ9000_SOFT3D_BACK_ROW 1100
+
+Bool
+ZZ9000SizeFits(pRTG, w, h)
+rtgScreenPtr pRTG;
+int w, h;
+{
+    ZZ9000ScreenPtr pZZ = GetZZ9000Screen(pRTG);
+
+    return pZZ && h <= ZZ9000_SOFT3D_BACK_ROW &&
+           (unsigned long)w * h * ZZ9000_BYTES_PER_PIXEL <= pZZ->fbSize;
+}
+
+/*
+** RandR: switch the running screen to w x h (a mode of the table).  The
+** framebuffer stays where it is (same fb_offset, same mapping); only the
+** stride changes, so every drawing path picks the new geometry up from
+** pRTG.  The blitter needs no wait: the Z3660 acknowledges FILLRECT and
+** COPYRECT only when they are done.  The new frame is cleared to black; the
+** caller exposes every window again.
+*/
+Bool
+ZZ9000SetSize(pRTG, w, h)
+rtgScreenPtr pRTG;
+int w, h;
+{
+    ZZ9000ScreenPtr pZZ = GetZZ9000Screen(pRTG);
+    ZZ9000ModePtr m, old = ZZ9000_selected_mode;
+    struct zz9k_mode mode;
+    struct zz9k_fbinfo fbi;
+    struct zz9k_fill fill;
+
+    for (m = zz9000_modes; m->name; m++)
+        if (m->w == w && m->h == h)
+            break;
+    if (!m->name || !pZZ || !ZZ9000SizeFits(pRTG, w, h))
+        return FALSE;
+    ZZ9000BlitFlush();          /* queued records belong to the old size */
+
+    mode.width = (unsigned short)w;
+    mode.height = (unsigned short)h;
+    mode.color_mode = ZZ9K_COLOR_16BIT565;
+    mode.scale_mode = 0;
+    if (ioctl(pZZ->fd, ZZ9KIOC_SETMODE, &mode) < 0) {
+        ErrorF("ZZ9000SetSize: SETMODE %dx%d failed (%s)\n",
+               w, h, strerror(errno));
+        return FALSE;
+    }
+    if (ioctl(pZZ->fd, ZZ9KIOC_GETFBINFO, &fbi) < 0 ||
+        fbi.width != w || fbi.height != h ||
+        fbi.fb_offset != pZZ->fbOffset) {
+        ErrorF("ZZ9000SetSize: GETFBINFO after %dx%d failed, back to %dx%d\n",
+               w, h, old->w, old->h);
+        mode.width = (unsigned short)old->w;
+        mode.height = (unsigned short)old->h;
+        (void) ioctl(pZZ->fd, ZZ9KIOC_SETMODE, &mode);
+        return FALSE;
+    }
+
+    fill.offset = 0;
+    fill.bytes = (unsigned long)fbi.height * fbi.stride;
+    fill.value = 0;
+    (void) ioctl(pZZ->fd, ZZ9KIOC_FILL, &fill);
+
+    ZZ9000_selected_mode = m;
+    pRTG->width  = fbi.width;
+    pRTG->height = fbi.height;
+    pRTG->pitch  = fbi.stride;
+    ErrorF("ZZ9000SetSize: %dx%d stride %d\n", pRTG->width, pRTG->height,
+           pRTG->pitch);
+    return TRUE;
+}
