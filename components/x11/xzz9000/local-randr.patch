diff -ruN a/programs/Xserver/hw/amix/rtg/rtgRandR.c b/programs/Xserver/hw/amix/rtg/rtgRandR.c
--- a/programs/Xserver/hw/amix/rtg/rtgRandR.c	1970-01-01 01:00:00.000000000 +0100
+++ b/programs/Xserver/hw/amix/rtg/rtgRandR.c	2026-11-07 15:46:28.620124220 +0100
@@ -0,0 +1,265 @@
+/*
+** rtgRandR.c - RandR 1.1 for the RTG screen: live resolution change.
+**
+** The DIX side is the RandR extension backported from xorg-server 1.0.2
+** (programs/Xserver/randr).  This file is the DDX side:
+**
+**   rtgRRGetInfo    registers every mode of the card's table that fits its
+**                   framebuffer, one 60 Hz rate each, no rotation, and marks
+**                   the current one.  The physical size keeps the server's
+**                   dpi (-dpi, XmonitorResolution), as at start-up.
+**   rtgRRSetConfig  sets the new mode on the card (ZZ9000SetSize), updates
+**                   the ScreenRec, and resizes the root window.  The old
+**                   frame's pixels are useless after a stride change, so the
+**                   root clip goes off and on again: every window is exposed
+**                   and repaints itself, like a VT switch back to X.
+**
+** The pointer is confined to the new root by the DIX (ScreenRestructured).
+** Window managers that do not listen for RRScreenChangeNotify (dtwm, mwm)
+** keep their own idea of the screen; the CDE display panel restarts them.
+**
+** rtgSetRootClip follows xf86SetRootClip of xorg-server 1.0.2
+** (hw/xfree86/common/xf86Helper.c).  That one breaks the root's clipList
+** (REGION_BREAK), and xorg's miValidateTree then rebuilds the children's
+** clips from the root's borderClip alone.  X11R6.3 has neither: its
+** miValidateTree hands out the marked children's old borderClips plus the
+** root's clipList.  So here the children's borderClips are emptied when the
+** screen goes off (else they keep the old size's area, draw past the new
+** screen -- the kernel refuses such blits -- and get no exposures), and
+** the root's clipList becomes the whole screen when it comes back.  The
+** root's own exposure is then its whole new clipList.
+*/
+
+#include "../amix.h"
+#include "scrnintstr.h"
+#include "windowstr.h"
+#include "pixmapstr.h"
+#include "regionstr.h"
+#include "validate.h"
+#include "mi.h"
+#include "mivalidate.h"
+#include "rtg.h"
+#include "zz9000/zz9000.h"
+#include "randrstr.h"
+
+extern int  XmonitorResolution;
+extern int  YmonitorResolution;
+extern fbFd amixFbs[];
+extern WindowPtr *WindowTable;
+
+#define RTG_RR_RATE 60
+
+static int
+rtgMM(pixels, dpi)
+int pixels, dpi;
+{
+    if (dpi <= 0)
+        dpi = 90;
+    return (pixels * 254 + dpi * 5) / (dpi * 10);
+}
+
+/* ANSI definitions: randrstr.h's callback types are prototyped (Rotation is
+   an unsigned short) */
+static Bool
+rtgRRGetInfo(ScreenPtr pScreen, Rotation *rotations)
+{
+    rtgScreenPtr    pRTG = GetRTGScreen(pScreen);
+    ZZ9000ModePtr   m;
+    RRScreenSizePtr pSize;
+    int             i;
+
+    *rotations = RR_Rotate_0;
+    for (i = 0; (m = ZZ9000ModeAt(i)) != (ZZ9000ModePtr)0; i++) {
+        if (!ZZ9000SizeFits(pRTG, m->w, m->h))
+            continue;
+        pSize = RRRegisterSize(pScreen, m->w, m->h,
+                               rtgMM(m->w, XmonitorResolution),
+                               rtgMM(m->h, YmonitorResolution));
+        if (!pSize)
+            return FALSE;
+        if (!RRRegisterRate(pScreen, pSize, RTG_RR_RATE))
+            return FALSE;
+        if (m->w == pScreen->width && m->h == pScreen->height)
+            RRSetCurrentConfig(pScreen, RR_Rotate_0, RTG_RR_RATE, pSize);
+    }
+    return TRUE;
+}
+
+/*
+** Enable or disable drawing to the screen by setting the root clip and
+** revalidating every window (xf86SetRootClip).
+*/
+static void
+rtgSetRootClip(pScreen, enable)
+ScreenPtr pScreen;
+Bool      enable;
+{
+    WindowPtr   pWin = WindowTable[pScreen->myNum];
+    WindowPtr   pChild;
+    Bool        WasViewable = (Bool)(pWin->viewable);
+    Bool        anyMarked = FALSE;
+    RegionPtr   pOldClip = NULL, bsExposed;
+#ifdef DO_SAVE_UNDERS
+    Bool        dosave = FALSE;
+#endif
+    WindowPtr   pLayerWin;
+    BoxRec      box;
+
+    if (WasViewable)
+    {
+        for (pChild = pWin->firstChild; pChild; pChild = pChild->nextSib)
+            (void) (*pScreen->MarkOverlappedWindows)(pChild, pChild,
+                                                     &pLayerWin);
+        (*pScreen->MarkWindow)(pWin);
+        anyMarked = TRUE;
+        if (pWin->valdata)
+        {
+            if (HasBorder(pWin))
+            {
+                RegionPtr borderVisible;
+
+                borderVisible = REGION_CREATE(pScreen, NullBox, 1);
+                REGION_SUBTRACT(pScreen, borderVisible,
+                                &pWin->borderClip, &pWin->winSize);
+                pWin->valdata->before.borderVisible = borderVisible;
+            }
+            pWin->valdata->before.resized = TRUE;
+        }
+    }
+
+    if (enable)
+    {
+        box.x1 = 0;
+        box.y1 = 0;
+        box.x2 = pScreen->width;
+        box.y2 = pScreen->height;
+        REGION_RESET(pScreen, &pWin->winSize, &box);
+        REGION_RESET(pScreen, &pWin->borderSize, &box);
+        if (WasViewable)
+            REGION_RESET(pScreen, &pWin->borderClip, &box);
+        pWin->drawable.width = pScreen->width;
+        pWin->drawable.height = pScreen->height;
+        REGION_RESET(pScreen, &pWin->clipList, &box);
+    }
+    else
+    {
+        REGION_EMPTY(pScreen, &pWin->borderClip);
+        REGION_EMPTY(pScreen, &pWin->clipList);
+        for (pChild = pWin->firstChild; pChild; pChild = pChild->nextSib)
+            REGION_EMPTY(pScreen, &pChild->borderClip);
+    }
+
+    ResizeChildrenWinSize(pWin, 0, 0, 0, 0);
+
+    if (WasViewable)
+    {
+        if (pWin->backStorage)
+        {
+            pOldClip = REGION_CREATE(pScreen, NullBox, 1);
+            REGION_COPY(pScreen, pOldClip, &pWin->clipList);
+        }
+
+        if (pWin->firstChild)
+            anyMarked |= (*pScreen->MarkOverlappedWindows)(pWin->firstChild,
+                                                           pWin->firstChild,
+                                                           (WindowPtr *)NULL);
+        else
+        {
+            (*pScreen->MarkWindow)(pWin);
+            anyMarked = TRUE;
+        }
+
+#ifdef DO_SAVE_UNDERS
+        if (DO_SAVE_UNDERS(pWin))
+            dosave = (*pScreen->ChangeSaveUnder)(pLayerWin, pLayerWin);
+#endif
+
+        if (anyMarked)
+            (*pScreen->ValidateTree)(pWin, NullWindow, VTOther);
+        if (enable && pWin->valdata)    /* the root's part is all new */
+            REGION_COPY(pScreen, &pWin->valdata->after.exposed,
+                        &pWin->clipList);
+    }
+
+    if (pWin->backStorage &&
+        ((pWin->backingStore == Always) || WasViewable))
+    {
+        if (!WasViewable)
+            pOldClip = &pWin->clipList; /* a convenient empty region */
+        bsExposed = (*pScreen->TranslateBackingStore)
+                        (pWin, 0, 0, pOldClip,
+                         pWin->drawable.x, pWin->drawable.y);
+        if (WasViewable)
+            REGION_DESTROY(pScreen, pOldClip);
+        if (bsExposed)
+        {
+            RegionPtr valExposed = NullRegion;
+
+            if (pWin->valdata)
+                valExposed = &pWin->valdata->after.exposed;
+            (*pScreen->WindowExposures)(pWin, valExposed, bsExposed);
+            if (valExposed)
+                REGION_EMPTY(pScreen, valExposed);
+            REGION_DESTROY(pScreen, bsExposed);
+        }
+    }
+    if (WasViewable)
+    {
+        if (anyMarked)
+            (*pScreen->HandleExposures)(pWin);
+#ifdef DO_SAVE_UNDERS
+        if (dosave)
+            (*pScreen->PostChangeSaveUnder)(pLayerWin, pLayerWin);
+#endif
+        if (anyMarked && pScreen->PostValidateTree)
+            (*pScreen->PostValidateTree)(pWin, NullWindow, VTOther);
+    }
+    if (pWin->realized)
+        WindowsRestructured();
+}
+
+static Bool
+rtgRRSetConfig(ScreenPtr pScreen, Rotation rotation, int rate,
+               RRScreenSizePtr pSize)
+{
+    rtgScreenPtr pRTG = GetRTGScreen(pScreen);
+
+    if (rotation != RR_Rotate_0)
+        return FALSE;
+    if (pSize->width == pScreen->width && pSize->height == pScreen->height)
+        return TRUE;
+
+    ErrorF("rtgRRSetConfig: %dx%d -> %dx%d\n", pScreen->width,
+           pScreen->height, pSize->width, pSize->height);
+
+    rtgSetRootClip(pScreen, FALSE);
+    if (!ZZ9000SetSize(pRTG, pSize->width, pSize->height))
+    {
+        rtgSetRootClip(pScreen, TRUE);  /* old mode, old size: repaint */
+        return FALSE;
+    }
+
+    pScreen->width    = pRTG->width;
+    pScreen->height   = pRTG->height;
+    pScreen->mmWidth  = pSize->mmWidth;
+    pScreen->mmHeight = pSize->mmHeight;
+    amixFbs[pScreen->myNum].bp.width  = pRTG->width;
+    amixFbs[pScreen->myNum].bp.height = pRTG->height;
+
+    rtgSetRootClip(pScreen, TRUE);
+    return TRUE;
+}
+
+Bool
+rtgRandRInit(pScreen)
+ScreenPtr pScreen;
+{
+    rrScrPrivPtr pScrPriv;
+
+    if (!RRScreenInit(pScreen))
+        return FALSE;
+    pScrPriv = rrGetScrPriv(pScreen);
+    pScrPriv->rrGetInfo   = rtgRRGetInfo;
+    pScrPriv->rrSetConfig = rtgRRSetConfig;
+    return TRUE;
+}
