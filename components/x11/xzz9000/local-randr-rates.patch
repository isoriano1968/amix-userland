 /*
+** RandR rates: the kernel's rows (ZZ9KIOC_GETMODES), asked again each time,
+** since the CURRENT flag follows every switch.  RandR rates are whole Hz:
+** a row's is its hz100 rounded (1080p: 61 and 51).
+*/
+static struct zz9k_moderow zz9000_rows[ZZ9K_MODES_MAX];
+static int zz9000_nrows;
+
+static void
+ZZ9000GetModes(pZZ)
+ZZ9000ScreenPtr pZZ;
+{
+    struct zz9k_modelist ml;
+
+    ml.rows = zz9000_rows;
+    ml.n = ZZ9K_MODES_MAX;
+    if (!pZZ || ioctl(pZZ->fd, ZZ9KIOC_GETMODES, &ml) < 0)
+        zz9000_nrows = 0;               /* older kernel: 60 Hz only */
+    else
+        zz9000_nrows = ml.n < ZZ9K_MODES_MAX ? (int)ml.n : ZZ9K_MODES_MAX;
+}
+
+#define ZZ9000_RR_RATE(hz100) (((hz100) + 50) / 100)
+#define ZZ9000_RR_DEFAULT 60
+
+/* the rates of size w x h into rates[] (at most max), in table order */
+int
+ZZ9000RatesOf(pRTG, w, h, rates, max)
+rtgScreenPtr pRTG;
+int w, h, max;
+short *rates;
+{
+    int i, j, n = 0, r;
+
+    ZZ9000GetModes(GetZZ9000Screen(pRTG));
+    for (i = 0; i < zz9000_nrows && n < max; i++) {
+        if (zz9000_rows[i].width != w || zz9000_rows[i].height != h ||
+            !zz9000_rows[i].hz100)
+            continue;
+        r = ZZ9000_RR_RATE(zz9000_rows[i].hz100);
+        for (j = 0; j < n && rates[j] != r; j++)
+            ;
+        if (j == n)
+            rates[n++] = (short)r;
+    }
+    if (n == 0 && max > 0)
+        rates[n++] = ZZ9000_RR_DEFAULT;
+    return n;
+}
+
+/* the rate the board shows now for w x h */
+int
+ZZ9000CurrentRate(pRTG, w, h)
+rtgScreenPtr pRTG;
+int w, h;
+{
+    int i;
+
+    ZZ9000GetModes(GetZZ9000Screen(pRTG));
+    for (i = 0; i < zz9000_nrows; i++)
+        if (zz9000_rows[i].width == w && zz9000_rows[i].height == h &&
+            (zz9000_rows[i].flags & ZZ9K_MF_CURRENT) && zz9000_rows[i].hz100)
+            return ZZ9000_RR_RATE(zz9000_rows[i].hz100);
+    return ZZ9000_RR_DEFAULT;
+}
+
+/* the hz100 of the row of w x h whose RandR rate is rate; 0 if none */
+static int
+ZZ9000Hz100(pZZ, w, h, rate)
+ZZ9000ScreenPtr pZZ;
+int w, h, rate;
+{
+    int i;
+
+    if (rate <= 0)
+        return 0;
+    ZZ9000GetModes(pZZ);
+    for (i = 0; i < zz9000_nrows; i++)
+        if (zz9000_rows[i].width == w && zz9000_rows[i].height == h &&
+            zz9000_rows[i].hz100 && ZZ9000_RR_RATE(zz9000_rows[i].hz100) == rate)
+            return zz9000_rows[i].hz100;
+    return 0;
+}
+
+/* the hz100 the board shows now (0: not known) */
+static int
+ZZ9000CurrentHz100(pZZ)
+ZZ9000ScreenPtr pZZ;
+{
+    int i;
+
+    ZZ9000GetModes(pZZ);
+    for (i = 0; i < zz9000_nrows; i++)
+        if (zz9000_rows[i].flags & ZZ9K_MF_CURRENT)
+            return zz9000_rows[i].hz100;
+    return 0;
+}
+
+/* SETMODE, or SETMODEHZ when hz100 is known; the ioctl's result */
+static int
+ZZ9000SetTiming(pZZ, w, h, hz100)
+ZZ9000ScreenPtr pZZ;
+int w, h, hz100;
+{
+    struct zz9k_mode mode;
+    struct zz9k_modehz mhz;
+
+    if (hz100 > 0) {
+        mhz.width = (unsigned short)w;
+        mhz.height = (unsigned short)h;
+        mhz.hz100 = (unsigned short)hz100;
+        mhz.color_mode = ZZ9K_COLOR_16BIT565;
+        mhz.scale_mode = 0;
+        mhz.pad = 0;
+        return ioctl(pZZ->fd, ZZ9KIOC_SETMODEHZ, &mhz);
+    }
+    mode.width = (unsigned short)w;
+    mode.height = (unsigned short)h;
+    mode.color_mode = ZZ9K_COLOR_16BIT565;
+    mode.scale_mode = 0;
+    return ioctl(pZZ->fd, ZZ9KIOC_SETMODE, &mode);
+}
+
+/*
+** RandR: the same size at another rate.  Only the timing changes (same
+** stride, same pixels: no clear, no exposures).  FALSE leaves the old rate.
+*/
+Bool
+ZZ9000SetRate(pRTG, rate)
+rtgScreenPtr pRTG;
+int rate;
+{
+    ZZ9000ScreenPtr pZZ = GetZZ9000Screen(pRTG);
+    struct zz9k_fbinfo fbi;
+    int hz, old;
+
+    if (!pZZ)
+        return FALSE;
+    hz = ZZ9000Hz100(pZZ, pRTG->width, pRTG->height, rate);
+    if (!hz)
+        return FALSE;
+    old = ZZ9000CurrentHz100(pZZ);
+    ZZ9000BlitFlush();
+    if (ZZ9000SetTiming(pZZ, pRTG->width, pRTG->height, hz) < 0) {
+        ErrorF("ZZ9000SetRate: SETMODEHZ %dx%d %d failed (%s)\n",
+               pRTG->width, pRTG->height, hz, strerror(errno));
+        return FALSE;
+    }
+    if (ioctl(pZZ->fd, ZZ9KIOC_GETFBINFO, &fbi) < 0 ||
+        fbi.width != pRTG->width || fbi.height != pRTG->height ||
+        fbi.stride != pRTG->pitch || fbi.fb_offset != pZZ->fbOffset) {
+        ErrorF("ZZ9000SetRate: the frame changed, back to the old rate\n");
+        (void) ZZ9000SetTiming(pZZ, pRTG->width, pRTG->height, old);
+        return FALSE;
+    }
+    ErrorF("ZZ9000SetRate: %dx%d at %d.%02d Hz\n", pRTG->width, pRTG->height,
+           hz / 100, hz % 100);
+    return TRUE;
+}
+
