@@ -23,6 +23,38 @@
 #define ZZ9KIOC_FILLRECT    (ZZ9K_IOC | 12)
 #define ZZ9KIOC_COPYRECT    (ZZ9K_IOC | 13)
 #define ZZ9KIOC_BLITS       (ZZ9K_IOC | 16)
+#define ZZ9KIOC_GETMODES    (ZZ9K_IOC | 19)
+#define ZZ9KIOC_SETMODEHZ   (ZZ9K_IOC | 20)
+
+/* ZZ9KIOC_GETMODES / SETMODEHZ (the driver's zz9000.h, amix-gate 32e04d7):
+   the kernel's mode table with the refresh of each firmware timing.  An
+   older kernel answers EINVAL: one rate, 60, per size, as before. */
+#define ZZ9K_MODES_MAX      64
+#define ZZ9K_MF_CURRENT     0x0002
+
+struct zz9k_moderow {
+    unsigned short width;
+    unsigned short height;
+    unsigned short hz100;           /* 1/100 Hz; 0 = not known */
+    unsigned short id;
+    unsigned long  pixclk;
+    unsigned short flags;
+    unsigned short pad;
+};
+
+struct zz9k_modelist {
+    struct zz9k_moderow *rows;
+    unsigned long        n;
+};
+
+struct zz9k_modehz {
+    unsigned short width;
+    unsigned short height;
+    unsigned short hz100;           /* in: wanted; out: chosen */
+    unsigned short color_mode;
+    unsigned short scale_mode;
+    unsigned short pad;
+};
 
