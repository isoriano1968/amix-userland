+static void
+zz_blit(struct pipe_context *c, const struct pipe_blit_info *b)
+{
+   uint32_t *p = ccmd(c, ZP_BLIT, 20);
+
+   p[0] = zr(b->dst.resource)->id; p[1] = b->dst.level; p[2] = b->dst.format;
+   p[3] = b->dst.box.x; p[4] = b->dst.box.y; p[5] = b->dst.box.z;
+   p[6] = b->dst.box.width; p[7] = b->dst.box.height; p[8] = b->dst.box.depth;
+   p[9] = zr(b->src.resource)->id; p[10] = b->src.level; p[11] = b->src.format;
+   p[12] = b->src.box.x; p[13] = b->src.box.y; p[14] = b->src.box.z;
+   p[15] = b->src.box.width; p[16] = b->src.box.height; p[17] = b->src.box.depth;
+   p[18] = b->mask; p[19] = b->filter;
+   zr(b->dst.resource)->gpu_wrote = TRUE;
+}
