diff --git a/src/gallium/drivers/softpipe/sp_fs_fast.c b/src/gallium/drivers/softpipe/sp_fs_fast.c
new file mode 100644
index 0000000..23146e4
--- /dev/null
+++ b/src/gallium/drivers/softpipe/sp_fs_fast.c
@@ -0,0 +1,694 @@
+/*
+ * sp_fs_fast.c -- see sp_fs_fast.h.
+ *
+ * Registers are vec[4]: one vector per channel, lane i = pixel i of the
+ * quad (tgsi_exec's order).  The register file is part of the program
+ * (one shader runs at a time): inputs, temporaries, outputs, immediates
+ * (broadcast once) and the constants of buffer 0 (broadcast per quad).
+ */
+#include "sp_context.h"
+#include "sp_quad.h"
+#include "sp_fs_fast.h"
+#include "pipe/p_shader_tokens.h"
+#include "tgsi/tgsi_exec.h"
+#include "tgsi/tgsi_info.h"
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_scan.h"
+#include "tgsi/tgsi_util.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+
+#ifdef __ARM_NEON
+#include <arm_neon.h>
+#endif
+
+typedef float vec __attribute__((vector_size(16), aligned(16)));
+typedef int32_t ivec __attribute__((vector_size(16), aligned(16)));
+typedef uint32_t uvec __attribute__((vector_size(16), aligned(16)));
+
+#define FSF_MAX_REGS 512
+
+/* the pixels of a quad (tgsi_exec.c's TILE_x) */
+#define TILE_TOP_LEFT     0
+#define TILE_BOTTOM_LEFT  2
+#define TILE_BOTTOM_RIGHT 3
+
+struct fsf_src {
+   unsigned short reg;
+   unsigned char swz[4];
+   unsigned char neg, abs;
+};
+
+struct fsf_op {
+   unsigned short opcode;
+   unsigned char wmask, sat;
+   unsigned short dst;
+   unsigned char nsrc;
+   unsigned char unit;           /* TEX: sampler unit */
+   unsigned char dim;            /* TEX: coordinates used */
+   unsigned char modifier;       /* TEX: 0, projected, bias, explicit lod */
+   struct fsf_src src[3];
+};
+
+struct fsf_input {
+   unsigned short reg;
+   unsigned char interp;         /* TGSI_INTERPOLATE_x */
+   unsigned char face;
+   unsigned char mask;           /* channels used */
+};
+
+struct sp_fs_fast {
+   struct fsf_op *ops;
+   unsigned nops;
+   struct fsf_input in[PIPE_MAX_SHADER_INPUTS];
+   unsigned nin;
+   unsigned out_base;
+   unsigned const_base, nconsts;
+   vec (*r)[4];                  /* the register file */
+};
+
+enum { MOD_NONE, MOD_PROJ, MOD_BIAS, MOD_LOD };
+
+static boolean
+float_op(unsigned op)
+{
+   switch (op) {
+   case TGSI_OPCODE_MOV: case TGSI_OPCODE_ADD: case TGSI_OPCODE_MUL: case TGSI_OPCODE_MAD:
+   case TGSI_OPCODE_DP2: case TGSI_OPCODE_DP3: case TGSI_OPCODE_DP4: case TGSI_OPCODE_MIN:
+   case TGSI_OPCODE_MAX: case TGSI_OPCODE_RCP: case TGSI_OPCODE_RSQ: case TGSI_OPCODE_SQRT:
+   case TGSI_OPCODE_EX2: case TGSI_OPCODE_LG2: case TGSI_OPCODE_POW: case TGSI_OPCODE_SIN:
+   case TGSI_OPCODE_COS: case TGSI_OPCODE_FLR: case TGSI_OPCODE_FRC: case TGSI_OPCODE_CEIL:
+   case TGSI_OPCODE_TRUNC: case TGSI_OPCODE_LRP: case TGSI_OPCODE_CMP: case TGSI_OPCODE_SLT:
+   case TGSI_OPCODE_SGE: case TGSI_OPCODE_SEQ: case TGSI_OPCODE_SNE: case TGSI_OPCODE_DDX:
+   case TGSI_OPCODE_DDY: case TGSI_OPCODE_KILL_IF: case TGSI_OPCODE_KILL:
+   case TGSI_OPCODE_TEX: case TGSI_OPCODE_TXP: case TGSI_OPCODE_TXB: case TGSI_OPCODE_TXL:
+   case TGSI_OPCODE_FSLT: case TGSI_OPCODE_FSGE: case TGSI_OPCODE_FSEQ: case TGSI_OPCODE_FSNE:
+   case TGSI_OPCODE_I2F: case TGSI_OPCODE_U2F: case TGSI_OPCODE_F2I: case TGSI_OPCODE_F2U:
+   case TGSI_OPCODE_NOP:
+      return TRUE;
+   default:
+      return FALSE;
+   }
+}
+
+/* integer and bit ops: sources without modifiers only */
+static boolean
+int_op(unsigned op)
+{
+   switch (op) {
+   case TGSI_OPCODE_AND: case TGSI_OPCODE_OR: case TGSI_OPCODE_XOR: case TGSI_OPCODE_NOT:
+   case TGSI_OPCODE_UCMP: case TGSI_OPCODE_UADD: case TGSI_OPCODE_UMUL: case TGSI_OPCODE_ISLT:
+   case TGSI_OPCODE_ISGE: case TGSI_OPCODE_USEQ: case TGSI_OPCODE_USNE: case TGSI_OPCODE_IMAX:
+   case TGSI_OPCODE_IMIN: case TGSI_OPCODE_INEG:
+      return TRUE;
+   default:
+      return FALSE;
+   }
+}
+
+struct sp_fs_fast *
+sp_fs_fast_compile(const struct tgsi_token *tokens, const struct tgsi_shader_info *info)
+{
+   struct sp_fs_fast *p;
+   struct tgsi_parse_context parse;
+   unsigned nimm = 0, nregs, temp_base, imm_base, i;
+   boolean ok = TRUE;
+
+   if (debug_get_bool_option("SOFTPIPE_NO_FAST_FS", FALSE))
+      return NULL;
+   if (info->num_system_values || info->indirect_files || info->const_buffers_declared > 1 ||
+       info->file_max[TGSI_FILE_ADDRESS] >= 0 || info->file_max[TGSI_FILE_IMAGE] >= 0 ||
+       info->file_max[TGSI_FILE_BUFFER] >= 0 || info->file_max[TGSI_FILE_MEMORY] >= 0 ||
+       info->num_outputs > PIPE_MAX_SHADER_OUTPUTS || info->uses_doubles)
+      return NULL;
+
+   p = CALLOC_STRUCT(sp_fs_fast);
+   if (!p)
+      return NULL;
+   temp_base = info->file_max[TGSI_FILE_INPUT] + 1;
+   p->out_base = temp_base + info->file_max[TGSI_FILE_TEMPORARY] + 1;
+   imm_base = p->out_base + info->file_max[TGSI_FILE_OUTPUT] + 1;
+   p->const_base = imm_base + info->immediate_count;
+   p->nconsts = info->file_max[TGSI_FILE_CONSTANT] + 1;
+   nregs = p->const_base + p->nconsts;
+   p->ops = CALLOC(info->num_instructions ? info->num_instructions : 1, sizeof(*p->ops));
+   p->r = align_malloc(nregs * sizeof(*p->r) + 16, 16);
+   if (!p->ops || !p->r || nregs > FSF_MAX_REGS) {
+      sp_fs_fast_destroy(p);
+      return NULL;
+   }
+   memset(p->r, 0, nregs * sizeof(*p->r));
+
+   tgsi_parse_init(&parse, tokens);
+   while (ok && !tgsi_parse_end_of_tokens(&parse)) {
+      tgsi_parse_token(&parse);
+      switch (parse.FullToken.Token.Type) {
+      case TGSI_TOKEN_TYPE_DECLARATION: {
+         const struct tgsi_full_declaration *d = &parse.FullToken.FullDeclaration;
+
+         if (d->Declaration.File == TGSI_FILE_INPUT) {
+            for (i = d->Range.First; i <= d->Range.Last && ok; i++) {
+               struct fsf_input *in = &p->in[p->nin++];
+
+               if (p->nin > PIPE_MAX_SHADER_INPUTS) {
+                  ok = FALSE;
+                  break;
+               }
+               in->reg = (unsigned short)i;
+               in->interp = d->Interp.Interpolate;
+               in->face = d->Semantic.Name == TGSI_SEMANTIC_FACE;
+               in->mask = d->Declaration.UsageMask;
+            }
+         }
+         break;
+      }
+      case TGSI_TOKEN_TYPE_IMMEDIATE: {
+         const struct tgsi_full_immediate *imm = &parse.FullToken.FullImmediate;
+         unsigned c;
+
+         if (nimm >= info->immediate_count) {
+            ok = FALSE;
+            break;
+         }
+         /* the bits as they are: float or integer */
+         for (c = 0; c < imm->Immediate.NrTokens - 1 && c < 4; c++) {
+            const uint32_t u = imm->u[c].Uint;
+
+            p->r[imm_base + nimm][c] = (vec)(uvec){ u, u, u, u };
+         }
+         nimm++;
+         break;
+      }
+      case TGSI_TOKEN_TYPE_INSTRUCTION: {
+         const struct tgsi_full_instruction *inst = &parse.FullToken.FullInstruction;
+         const unsigned opc = inst->Instruction.Opcode;
+         struct fsf_op *op;
+         unsigned s, c, nsrc = inst->Instruction.NumSrcRegs;
+         boolean isint = int_op(opc), tex;
+
+         if (opc == TGSI_OPCODE_END)
+            break;
+         if ((!float_op(opc) && !isint) || inst->Instruction.NumDstRegs > 1 ||
+             p->nops >= info->num_instructions || inst->Instruction.Saturate > 1) {
+            ok = FALSE;
+            break;
+         }
+         op = &p->ops[p->nops++];
+         op->opcode = opc;
+         op->sat = inst->Instruction.Saturate;
+         tex = opc == TGSI_OPCODE_TEX || opc == TGSI_OPCODE_TXP || opc == TGSI_OPCODE_TXB ||
+               opc == TGSI_OPCODE_TXL;
+         if (inst->Instruction.NumDstRegs) {
+            if (inst->Dst[0].Register.Indirect || inst->Dst[0].Register.Dimension) {
+               ok = FALSE;
+               break;
+            }
+            op->wmask = inst->Dst[0].Register.WriteMask;
+            switch (inst->Dst[0].Register.File) {
+            case TGSI_FILE_TEMPORARY: op->dst = temp_base + inst->Dst[0].Register.Index; break;
+            case TGSI_FILE_OUTPUT: op->dst = p->out_base + inst->Dst[0].Register.Index; break;
+            default: ok = FALSE;
+            }
+         }
+         if (tex) {
+            const unsigned target = inst->Texture.Texture;
+
+            if (nsrc != 2 || inst->Src[1].Register.File != TGSI_FILE_SAMPLER ||
+                inst->Src[1].Register.Indirect || inst->Texture.NumOffsets ||
+                tgsi_util_get_shadow_ref_src_index(target) >= 0 ||
+                (target != TGSI_TEXTURE_1D && target != TGSI_TEXTURE_2D &&
+                 target != TGSI_TEXTURE_RECT && target != TGSI_TEXTURE_3D &&
+                 target != TGSI_TEXTURE_CUBE)) {
+               ok = FALSE;
+               break;
+            }
+            op->unit = (unsigned char)inst->Src[1].Register.Index;
+            op->dim = (unsigned char)tgsi_util_get_texture_coord_dim(target);
+            op->modifier = opc == TGSI_OPCODE_TXP ? MOD_PROJ : opc == TGSI_OPCODE_TXB ? MOD_BIAS :
+                           opc == TGSI_OPCODE_TXL ? MOD_LOD : MOD_NONE;
+            nsrc = 1;
+         }
+         op->nsrc = (unsigned char)nsrc;
+         for (s = 0; ok && s < nsrc; s++) {
+            const struct tgsi_full_src_register *src = &inst->Src[s];
+            struct fsf_src *d = &op->src[s];
+            const int idx = src->Register.Index;
+
+            if (src->Register.Indirect ||
+                (src->Register.Dimension && (src->Dimension.Indirect || src->Dimension.Index != 0)) ||
+                (isint && (src->Register.Negate || src->Register.Absolute))) {
+               ok = FALSE;
+               break;
+            }
+            switch (src->Register.File) {
+            case TGSI_FILE_INPUT: d->reg = (unsigned short)idx; break;
+            case TGSI_FILE_TEMPORARY: d->reg = temp_base + idx; break;
+            case TGSI_FILE_OUTPUT: d->reg = p->out_base + idx; break;
+            case TGSI_FILE_IMMEDIATE: d->reg = imm_base + idx; break;
+            case TGSI_FILE_CONSTANT: d->reg = p->const_base + idx; break;
+            default: ok = FALSE;
+            }
+            for (c = 0; c < 4; c++)
+               d->swz[c] = (unsigned char)tgsi_util_get_full_src_register_swizzle(src, c);
+            d->neg = src->Register.Negate;
+            d->abs = src->Register.Absolute;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   tgsi_parse_free(&parse);
+   if (!ok) {
+      sp_fs_fast_destroy(p);
+      return NULL;
+   }
+   return p;
+}
+
+void
+sp_fs_fast_destroy(struct sp_fs_fast *p)
+{
+   if (!p)
+      return;
+   FREE(p->ops);
+   if (p->r)
+      align_free(p->r);
+   FREE(p);
+}
+
+
+static inline vec
+splat(float f)
+{
+   return (vec){ f, f, f, f };
+}
+
+static inline vec
+vabs(vec v)
+{
+   return (vec)((uvec)v & 0x7fffffffu);
+}
+
+static inline vec
+vsel(ivec m, vec a, vec b)
+{
+   return (vec)(((uvec)m & (uvec)a) | (~(uvec)m & (uvec)b));
+}
+
+static inline ivec
+isel(ivec m, ivec a, ivec b)
+{
+   return (a & m) | (b & ~m);
+}
+
+/* 1.0 where m, else 0.0 */
+static inline vec
+bool_f(ivec m)
+{
+   return (vec)((uvec)m & 0x3f800000u);
+}
+
+static inline vec
+vfloor(vec x)
+{
+   const vec t = __builtin_convertvector(__builtin_convertvector(x, ivec), vec);
+
+   return t - bool_f(t > x);
+}
+
+static inline vec
+vceil(vec x)
+{
+   const vec t = __builtin_convertvector(__builtin_convertvector(x, ivec), vec);
+
+   return t + bool_f(t < x);
+}
+
+/* sin(2 pi y), as tgsi_exec's sin_turns() */
+static inline vec
+vsin_turns(vec y)
+{
+   vec z;
+
+   y -= vfloor(y + 0.5f);
+   y = vsel(y > 0.25f, 0.5f - y, vsel(y < -0.25f, -0.5f - y, y));
+   z = y * y;
+   return y * (6.28318531f + z * (-41.3417022f + z * (81.6052492f + z * (-76.7058597f + z * 42.0586940f))));
+}
+
+static inline vec
+vrcp(vec x)
+{
+   return splat(1.0f) / x;
+}
+
+static inline vec
+vsqrt(vec x)
+{
+   return (vec){ sqrtf(x[0]), sqrtf(x[1]), sqrtf(x[2]), sqrtf(x[3]) };
+}
+
+static inline vec
+fetch(const struct sp_fs_fast *p, const struct fsf_src *s, unsigned c)
+{
+   vec v = p->r[s->reg][s->swz[c]];
+
+   if (s->abs)
+      v = vabs(v);
+   if (s->neg)
+      v = -v;
+   return v;
+}
+
+#define A(c) fetch(p, &op->src[0], c)
+#define B(c) fetch(p, &op->src[1], c)
+#define C(c) fetch(p, &op->src[2], c)
+#define AI(c) ((ivec)p->r[op->src[0].reg][op->src[0].swz[c]])
+#define BI(c) ((ivec)p->r[op->src[1].reg][op->src[1].swz[c]])
+#define CI(c) ((ivec)p->r[op->src[2].reg][op->src[2].swz[c]])
+
+static void
+texture(struct sp_fs_fast *p, const struct fsf_op *op, struct tgsi_exec_machine *mach, vec res[4])
+{
+   vec coord[3], extra = splat(0.0f);
+   const vec zero = splat(0.0f);
+   float rgba[4][TGSI_QUAD_SIZE];
+   const int8_t offsets[3] = { 0, 0, 0 };
+   enum tgsi_sampler_control control = TGSI_SAMPLER_LOD_NONE;
+   unsigned i;
+
+   for (i = 0; i < 3; i++)
+      coord[i] = i < op->dim ? A(i) : zero;
+   if (op->modifier != MOD_NONE)
+      extra = A(3);
+   if (op->modifier == MOD_PROJ) {
+      for (i = 0; i < op->dim; i++)
+         coord[i] = coord[i] / extra;
+      extra = zero;
+   } else if (op->modifier == MOD_BIAS) {
+      control = TGSI_SAMPLER_LOD_BIAS;
+   } else if (op->modifier == MOD_LOD) {
+      control = TGSI_SAMPLER_LOD_EXPLICIT;
+   }
+   mach->Sampler->get_samples(mach->Sampler, op->unit, op->unit, (const float *)&coord[0],
+                              (const float *)&coord[1], (const float *)&coord[2],
+                              (const float *)&zero, (const float *)&extra, NULL, offsets, control,
+                              rgba);
+   for (i = 0; i < 4; i++)
+      res[i] = (vec){ rgba[i][0], rgba[i][1], rgba[i][2], rgba[i][3] };
+}
+
+unsigned
+sp_fs_fast_run(struct sp_fs_fast *p, struct tgsi_exec_machine *mach, struct quad_header *quad,
+               boolean early_depth_test, const struct tgsi_shader_info *info)
+{
+   const float x = (float)quad->input.x0, y = (float)quad->input.y0;
+   const struct tgsi_interp_coef *coef = quad->coef;
+   const struct tgsi_interp_coef *pc = quad->posCoef;
+   const vec lx = { 0.0f, 1.0f, 0.0f, 1.0f }, ly = { 0.0f, 0.0f, 1.0f, 1.0f };
+   const struct fsf_op *op, *end = p->ops + p->nops;
+   unsigned kill = 0, i, c;
+   vec w;
+
+   /* the quad's 1/w (tgsi_exec's QuadPos.w), then the inputs */
+   {
+      const float a = pc->a0[3] + pc->dadx[3] * x + pc->dady[3] * y;
+
+      w = splat(a) + lx * pc->dadx[3] + ly * pc->dady[3];
+   }
+   for (i = 0; i < p->nin; i++) {
+      const struct fsf_input *in = &p->in[i];
+      const struct tgsi_interp_coef *k = &coef[in->reg];
+      unsigned interp = in->interp;
+
+      if (in->face) {
+         p->r[in->reg][0] = splat((float)(quad->input.facing * -2 + 1));
+         continue;
+      }
+      if (interp == TGSI_INTERPOLATE_COLOR)
+         interp = mach->flatshade_color ? TGSI_INTERPOLATE_CONSTANT : TGSI_INTERPOLATE_PERSPECTIVE;
+      for (c = 0; c < 4; c++) {
+         float a;
+         vec v;
+
+         if (!(in->mask & (1 << c)))
+            continue;
+         if (interp == TGSI_INTERPOLATE_CONSTANT) {
+            p->r[in->reg][c] = splat(k->a0[c]);
+            continue;
+         }
+         a = k->a0[c] + k->dadx[c] * x + k->dady[c] * y;
+         v = splat(a) + lx * k->dadx[c] + ly * k->dady[c];
+         p->r[in->reg][c] = interp == TGSI_INTERPOLATE_PERSPECTIVE ? v / w : v;
+      }
+   }
+   /* the constants of buffer 0 (0 beyond its end, as tgsi_exec) */
+   if (p->nconsts) {
+      const float *cb = (const float *)mach->Consts[0];
+      const unsigned have = cb ? mach->ConstsSize[0] / (4 * sizeof(float)) : 0;
+
+      for (i = 0; i < p->nconsts; i++)
+         for (c = 0; c < 4; c++)
+            p->r[p->const_base + i][c] = splat(i < have ? cb[i * 4 + c] : 0.0f);
+   }
+
+   for (op = p->ops; op < end; op++) {
+      vec res[4];
+      const unsigned m = op->wmask;
+
+      switch (op->opcode) {
+      case TGSI_OPCODE_NOP:
+         continue;
+      case TGSI_OPCODE_MOV:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = A(c);
+         break;
+      case TGSI_OPCODE_ADD:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = A(c) + B(c);
+         break;
+      case TGSI_OPCODE_MUL:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = A(c) * B(c);
+         break;
+      case TGSI_OPCODE_MAD:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = A(c) * B(c) + C(c);
+         break;
+      case TGSI_OPCODE_LRP:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = A(c) * (B(c) - C(c)) + C(c);
+         break;
+      case TGSI_OPCODE_MIN:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const vec a = A(c), b = B(c); res[c] = vsel(a < b, a, b); }
+         break;
+      case TGSI_OPCODE_MAX:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const vec a = A(c), b = B(c); res[c] = vsel(a > b, a, b); }
+         break;
+      case TGSI_OPCODE_CMP:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = vsel(A(c) < 0.0f, B(c), C(c));
+         break;
+      case TGSI_OPCODE_SLT:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = bool_f(A(c) < B(c));
+         break;
+      case TGSI_OPCODE_SGE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = bool_f(A(c) >= B(c));
+         break;
+      case TGSI_OPCODE_SEQ:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = bool_f(A(c) == B(c));
+         break;
+      case TGSI_OPCODE_SNE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = bool_f(A(c) != B(c));
+         break;
+      case TGSI_OPCODE_FSLT:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(A(c) < B(c));
+         break;
+      case TGSI_OPCODE_FSGE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(A(c) >= B(c));
+         break;
+      case TGSI_OPCODE_FSEQ:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(A(c) == B(c));
+         break;
+      case TGSI_OPCODE_FSNE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(A(c) != B(c));
+         break;
+      case TGSI_OPCODE_FLR:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = vfloor(A(c));
+         break;
+      case TGSI_OPCODE_CEIL:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = vceil(A(c));
+         break;
+      case TGSI_OPCODE_TRUNC:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = __builtin_convertvector(__builtin_convertvector(A(c), ivec), vec);
+         break;
+      case TGSI_OPCODE_FRC:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const vec a = A(c); res[c] = a - vfloor(a); }
+         break;
+      case TGSI_OPCODE_I2F:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = __builtin_convertvector((ivec)A(c), vec);
+         break;
+      case TGSI_OPCODE_U2F:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = __builtin_convertvector((uvec)A(c), vec);
+         break;
+      case TGSI_OPCODE_F2I:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)__builtin_convertvector(A(c), ivec);
+         break;
+      case TGSI_OPCODE_F2U:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)__builtin_convertvector(A(c), uvec);
+         break;
+      case TGSI_OPCODE_DDX:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const vec a = A(c); res[c] = splat(a[TILE_BOTTOM_RIGHT] - a[TILE_BOTTOM_LEFT]); }
+         break;
+      case TGSI_OPCODE_DDY:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const vec a = A(c); res[c] = splat(a[TILE_BOTTOM_LEFT] - a[TILE_TOP_LEFT]); }
+         break;
+      /* replicated scalars: src.x (after swizzle) */
+      case TGSI_OPCODE_DP2:
+         res[0] = A(0) * B(0) + A(1) * B(1);
+         goto replicate;
+      case TGSI_OPCODE_DP3:
+         res[0] = A(0) * B(0) + A(1) * B(1) + A(2) * B(2);
+         goto replicate;
+      case TGSI_OPCODE_DP4:
+         res[0] = A(0) * B(0) + A(1) * B(1) + A(2) * B(2) + A(3) * B(3);
+         goto replicate;
+      case TGSI_OPCODE_RCP:
+         res[0] = vrcp(A(0));
+         goto replicate;
+      case TGSI_OPCODE_SQRT:
+         res[0] = vsqrt(A(0));
+         goto replicate;
+      case TGSI_OPCODE_RSQ:
+         res[0] = vrcp(vsqrt(A(0)));
+         goto replicate;
+      case TGSI_OPCODE_SIN:
+         res[0] = vsin_turns(A(0) * 0.159154943f);
+         goto replicate;
+      case TGSI_OPCODE_COS:
+         res[0] = vsin_turns(A(0) * 0.159154943f + 0.25f);
+         goto replicate;
+      case TGSI_OPCODE_EX2: {
+         const vec a = A(0);
+
+         res[0] = (vec){ powf(2.0f, a[0]), powf(2.0f, a[1]), powf(2.0f, a[2]), powf(2.0f, a[3]) };
+         goto replicate;
+      }
+      case TGSI_OPCODE_LG2: {
+         const vec a = A(0);
+
+         res[0] = (vec){ logf(a[0]), logf(a[1]), logf(a[2]), logf(a[3]) } * 1.442695f;
+         goto replicate;
+      }
+      case TGSI_OPCODE_POW: {
+         const vec a = A(0), b = B(0);
+
+         res[0] = (vec){ powf(a[0], b[0]), powf(a[1], b[1]), powf(a[2], b[2]), powf(a[3], b[3]) };
+         goto replicate;
+      }
+      case TGSI_OPCODE_TEX: case TGSI_OPCODE_TXP: case TGSI_OPCODE_TXB: case TGSI_OPCODE_TXL:
+         texture(p, op, mach, res);
+         break;
+      case TGSI_OPCODE_KILL_IF: {
+         ivec any = { 0, 0, 0, 0 };
+
+         for (c = 0; c < 4; c++)
+            any |= A(c) < 0.0f;
+         for (i = 0; i < 4; i++)
+            if (any[i])
+               kill |= 1 << i;
+         continue;
+      }
+      case TGSI_OPCODE_KILL:
+         kill = 0xf;
+         continue;
+      /* integers and bits */
+      case TGSI_OPCODE_AND:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) & BI(c));
+         break;
+      case TGSI_OPCODE_OR:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) | BI(c));
+         break;
+      case TGSI_OPCODE_XOR:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) ^ BI(c));
+         break;
+      case TGSI_OPCODE_NOT:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(~AI(c));
+         break;
+      case TGSI_OPCODE_INEG:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(-AI(c));
+         break;
+      case TGSI_OPCODE_UADD:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) + BI(c));
+         break;
+      case TGSI_OPCODE_UMUL:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)((uvec)AI(c) * (uvec)BI(c));
+         break;
+      case TGSI_OPCODE_ISLT:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) < BI(c));
+         break;
+      case TGSI_OPCODE_ISGE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) >= BI(c));
+         break;
+      case TGSI_OPCODE_USEQ:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) == BI(c));
+         break;
+      case TGSI_OPCODE_USNE:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = (vec)(AI(c) != BI(c));
+         break;
+      case TGSI_OPCODE_IMAX:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const ivec a = AI(c), b = BI(c); res[c] = (vec)isel(a > b, a, b); }
+         break;
+      case TGSI_OPCODE_IMIN:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) { const ivec a = AI(c), b = BI(c); res[c] = (vec)isel(a < b, a, b); }
+         break;
+      case TGSI_OPCODE_UCMP:
+         for (c = 0; c < 4; c++) if (m & (1 << c)) res[c] = vsel(AI(c) != 0, (vec)BI(c), (vec)CI(c));
+         break;
+      default:
+         continue;
+      replicate:
+         res[1] = res[2] = res[3] = res[0];
+         break;
+      }
+      for (c = 0; c < 4; c++) {
+         if (!(m & (1 << c)))
+            continue;
+         if (op->sat) {
+            const vec v = res[c];
+
+            res[c] = vsel(v > 1.0f, splat(1.0f), vsel(v > 0.0f, v, splat(0.0f)));
+         }
+         p->r[op->dst][c] = res[c];
+      }
+   }
+
+   quad->inout.mask &= ~kill;
+   if (!quad->inout.mask)
+      return FALSE;
+
+   /* the outputs, as sp_fs_exec.c's exec_run() */
+   for (i = 0; i < info->num_outputs; i++) {
+      const vec *o = p->r[p->out_base + i];
+      unsigned j;
+
+      switch (info->output_semantic_name[i]) {
+      case TGSI_SEMANTIC_COLOR: {
+         float (*col)[4] = quad->output.color[info->output_semantic_index[i]];
+
+         for (c = 0; c < 4; c++)
+            for (j = 0; j < 4; j++)
+               col[c][j] = o[c][j];
+         break;
+      }
+      case TGSI_SEMANTIC_POSITION:
+         if (!early_depth_test)
+            for (j = 0; j < 4; j++)
+               quad->output.depth[j] = o[2][j];
+         break;
+      case TGSI_SEMANTIC_STENCIL:
+         if (!early_depth_test)
+            for (j = 0; j < 4; j++)
+               quad->output.stencil[j] = ((const uvec *)o)[1][j];
+         break;
+      }
+   }
+   return TRUE;
+}
