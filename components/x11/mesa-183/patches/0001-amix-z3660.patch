diff --git a/src/gallium/drivers/zz3660/zz_board.c b/src/gallium/drivers/zz3660/zz_board.c
new file mode 100644
index 0000000..f581342
--- /dev/null
+++ b/src/gallium/drivers/zz3660/zz_board.c
@@ -0,0 +1,212 @@
+/*
+ * zz_board.c -- the zz3660 stream over the Z3660's ring: zzgl's transport, with
+ * core 1's server underneath.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <signal.h>
+#include <unistd.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <sys/time.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include "zz_proto.h"
+
+/* state_tracker/xlibsw_api.h's: the transport has none of Gallium's headers */
+struct xlib_drawable {
+   Visual *visual;
+   int depth;
+   Drawable drawable;
+};
+#include "zzgl_enc.h"
+#include "zzgl_platform.h"
+
+static int up;
+static pid_t watcher;
+static int unwatched;           /* no fork for the watcher: zzp_show places the overlay */
+
+static void
+leave(void)
+{
+   if (watcher > 0) {
+      kill(watcher, SIGTERM);
+      waitpid(watcher, NULL, 0);
+      watcher = 0;
+   }
+   zzgl_platform_close();
+}
+
+/* killed: the overlay and core 1's server must not stay behind */
+static void
+on_signal(int s)
+{
+   leave();
+   signal(s, SIG_DFL);
+   kill(getpid(), s);
+}
+
+int
+zzp_start(void)
+{
+   if (!up && zzgl_platform_server() == 0) {
+      atexit(leave);
+      if (signal(SIGTERM, on_signal) == SIG_IGN)
+         signal(SIGTERM, SIG_IGN);
+      if (signal(SIGINT, on_signal) == SIG_IGN)
+         signal(SIGINT, SIG_IGN);
+      if (signal(SIGHUP, on_signal) == SIG_IGN)
+         signal(SIGHUP, SIG_IGN);
+      if (signal(SIGPIPE, on_signal) == SIG_IGN)
+         signal(SIGPIPE, SIG_IGN);
+      up = 1;
+   }
+   return up;
+}
+
+static void
+start(void)
+{
+   if (!zzp_start()) {
+      fprintf(stderr, "zz3660: no GPU on core 1\n");
+      exit(1);
+   }
+}
+
+void
+zzp_send(uint32_t *w, unsigned n)
+{
+   start();
+   zzgl_pipe(w, n);
+   zzgl_flush();
+}
+
+void
+zzp_read(uint32_t *w, unsigned n, void *reply)
+{
+   start();
+   zzgl_pipe_read(w, n, reply, (size_t)w[9] * w[7]);
+}
+
+/* all sent so far is done */
+void
+zzp_sync(void)
+{
+   start();
+   zzgl_pipe_read(NULL, 0, NULL, 0);
+}
+
+void *zz3660_display;           /* xlib.c's */
+
+static int gone;
+
+static int
+window_gone(Display *dpy, XErrorEvent *e)
+{
+   gone = 1;
+   return 0;
+}
+
+static int
+server_gone(Display *dpy)
+{
+   zzgl_platform_hide();
+   _exit(0);
+   return 0;
+}
+
+/* A program waiting for events draws nothing and looks at nothing: a process of
+   its own keeps the overlay over the window, and ends it however the program ends */
+static void
+watch(Display *dpy, Window win, int x, int y)
+{
+   const pid_t parent = getpid();
+   Display *own;
+
+   if (unwatched)
+      return;
+   /* a big process may not fork (AMIX has no room for its copy): without the
+      watcher the program goes on, not as the child */
+   watcher = fork();
+   if (watcher < 0) {
+      watcher = 0;
+      unwatched = 1;
+      return;
+   }
+   if (watcher)
+      return;
+   signal(SIGTERM, SIG_DFL);
+   signal(SIGINT, SIG_IGN);
+   signal(SIGHUP, SIG_IGN);
+   signal(SIGPIPE, SIG_DFL);
+   own = XOpenDisplay(DisplayString(dpy));
+   close(ConnectionNumber(dpy));
+   if (!own)
+      _exit(0);
+   XSetErrorHandler(window_gone);
+   XSetIOErrorHandler(server_gone);
+   while (getppid() == parent) {
+      Window child;
+      int nx = x, ny = y;
+
+      usleep(100000);
+      XTranslateCoordinates(own, win, DefaultRootWindow(own), 0, 0, &nx, &ny, &child);
+      XSync(own, False);
+      if (gone)
+         _exit(0);
+      if (nx != x || ny != y)
+         zzgl_platform_place(nx, ny);
+      x = nx;
+      y = ny;
+   }
+   zzgl_platform_hide();
+   _exit(0);
+}
+
+/* the overlay over the window */
+int
+zzp_show(void *priv, uint32_t id, unsigned w, unsigned h)
+{
+   static unsigned cur_w, cur_h;
+   static Drawable cur;
+   static double next;
+   struct xlib_drawable *d = priv;
+   Display *dpy = zz3660_display;
+   struct timeval tv;
+   double t;
+   uint32_t c[2];
+
+   /* one overlay: a program's other windows go through X */
+   if (cur && d->drawable != cur)
+      return 0;
+   gettimeofday(&tv, NULL);
+   t = tv.tv_sec + tv.tv_usec * 1e-6;
+   if (w != cur_w || h != cur_h || d->drawable != cur || (!watcher && t >= next)) {
+      Window child;
+      int x = 0, y = 0;
+
+      XTranslateCoordinates(dpy, d->drawable, DefaultRootWindow(dpy), 0, 0, &x, &y, &child);
+      XSync(dpy, False);
+      next = t + 0.2;
+      if (watcher > 0) {
+         kill(watcher, SIGTERM);
+         waitpid(watcher, NULL, 0);
+         watcher = 0;
+      }
+      if (w != cur_w || h != cur_h) {
+         if (zzgl_platform_show(x, y, w, h) != 0)
+            return 0;
+         cur_w = w;
+         cur_h = h;
+      }
+      zzgl_platform_place(x, y);
+      cur = d->drawable;
+      watch(dpy, cur, x, y);
+   }
+   c[0] = ZP_PRESENT | 1 << 8;
+   c[1] = id;
+   zzgl_pipe(c, 2);
+   zzgl_flush();
+   zzgl_pipe_frame();
+   return 1;
+}
diff --git a/src/gallium/drivers/zz3660/zz_driver.c b/src/gallium/drivers/zz3660/zz_driver.c
new file mode 100644
index 0000000..0657963
--- /dev/null
+++ b/src/gallium/drivers/zz3660/zz_driver.c
@@ -0,0 +1,939 @@
+/*
+ * zz_driver.c -- zz3660, a Gallium driver that does no work: each pipe_context
+ * call goes to the GPU as a command (zz_proto.h, zz_exec.c).  Modelled on noop
+ * and virgl.  Today's GPU is core 1 of the Z3660 running softpipe; a real one
+ * needs another executor, and this driver and Mesa above stay.
+ *
+ * Each resource has a copy here that transfers use; a write goes out at unmap,
+ * and a read of something the GPU may have drawn comes back first.
+ */
+#include <stdio.h>
+#include <string.h>
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "state_tracker/sw_winsys.h"
+#include "tgsi/tgsi_dump.h"
+#include "util/u_box.h"
+#include "util/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/u_transfer.h"
+#include "util/u_upload_mgr.h"
+#include "util/u_math.h"
+#include "zz_proto.h"
+#include "zz_fields.h"
+#include "zz_public.h"
+
+struct zz_screen {
+   struct pipe_screen base;
+   struct pipe_screen *caps;
+   struct sw_winsys *ws;
+};
+
+struct zz_resource {
+   struct pipe_resource base;
+   uint32_t id;
+   uint8_t *data;
+   unsigned stride[PIPE_MAX_TEXTURE_LEVELS], offset[PIPE_MAX_TEXTURE_LEVELS], layer[PIPE_MAX_TEXTURE_LEVELS];
+   unsigned size;
+   boolean gpu_wrote;           /* the copy here may be old */
+   struct sw_displaytarget *dt;
+   unsigned dt_stride;
+};
+
+struct zz_view { struct pipe_sampler_view base; uint32_t id; };
+struct zz_surface { struct pipe_surface base; uint32_t id; };
+
+static inline struct zz_resource *zr(struct pipe_resource *r) { return (struct zz_resource *)r; }
+
+/* ids: 0 is none */
+static uint32_t free_ids[ZZP_MAX_OBJ];
+static unsigned nfree, next_id = 1;
+
+static uint32_t
+new_id(void)
+{
+   if (nfree)
+      return free_ids[--nfree];
+   if (next_id == ZZP_MAX_OBJ) {
+      fprintf(stderr, "zz3660: out of object ids\n");
+      abort();
+   }
+   return next_id++;
+}
+
+static void
+drop_id(uint32_t id)
+{
+   free_ids[nfree++] = id;
+}
+
+/* the stream, and a shader's text: from the heap, as core 1 links this file too
+   and its GL needs the room */
+#define ZZ_BUF (1 << 21)
+#define ZZ_TEXT (1 << 22)
+static uint32_t *buf;
+static unsigned used;
+
+static void
+flush_cmds(void)
+{
+   if (used)
+      zzp_send(buf, used);
+   used = 0;
+}
+
+static uint32_t *
+cmd(unsigned op, unsigned words)
+{
+   uint32_t *p;
+
+   if (!buf)
+      buf = MALLOC(ZZ_BUF * 4);
+   if (used + words + 1 > ZZ_BUF)
+      flush_cmds();
+   if (words + 1 > ZZ_BUF) {
+      fprintf(stderr, "zz3660: command of %u words\n", words);
+      abort();
+   }
+   p = &buf[used];
+   p[0] = op | words << 8;
+   used += words + 1;
+   return p + 1;
+}
+
+/* a program may have several contexts: the stream says whose state follows */
+struct zz_context {
+   struct pipe_context base;
+   unsigned id;
+};
+static unsigned contexts, cur_context;
+
+static uint32_t *
+ccmd(struct pipe_context *c, unsigned op, unsigned words)
+{
+   const unsigned id = ((struct zz_context *)c)->id;
+
+   if (id != cur_context) {
+      cmd(ZP_CONTEXT, 1)[0] = id;
+      cur_context = id;
+   }
+   return cmd(op, words);
+}
+
+static inline uint32_t fw(float f) { union { uint32_t u; float f; } c; c.f = f; return c.u; }
+
+/*
+ * Resources
+ */
+static struct pipe_resource *
+zz_resource_create(struct pipe_screen *screen, const struct pipe_resource *t)
+{
+   struct zz_screen *s = (struct zz_screen *)screen;
+   struct zz_resource *r = CALLOC_STRUCT(zz_resource);
+   unsigned l, w = t->width0, h = t->height0, d = t->depth0, off = 0;
+   uint32_t *p;
+
+   r->base = *t;
+   r->base.screen = screen;
+   pipe_reference_init(&r->base.reference, 1);
+   for (l = 0; l <= t->last_level; l++) {
+      r->stride[l] = util_format_get_stride(t->format, w);
+      r->layer[l] = r->stride[l] * util_format_get_nblocksy(t->format, h);
+      r->offset[l] = off;
+      off += r->layer[l] * (t->target == PIPE_TEXTURE_3D ? d : t->array_size);
+      w = u_minify(w, 1);
+      h = u_minify(h, 1);
+      d = u_minify(d, 1);
+   }
+   r->size = off;
+   if (t->bind & PIPE_BIND_DISPLAY_TARGET) {
+      r->dt = s->ws->displaytarget_create(s->ws, t->bind, t->format, t->width0, t->height0, 64, NULL,
+                                          &r->dt_stride);
+   }
+   r->id = new_id();
+   p = cmd(ZP_RES_CREATE, 12);
+   p[0] = r->id; p[1] = t->target; p[2] = t->format; p[3] = t->width0; p[4] = t->height0;
+   p[5] = t->depth0; p[6] = t->array_size; p[7] = t->last_level; p[8] = t->nr_samples;
+   p[9] = t->usage; p[10] = t->bind; p[11] = t->flags;
+   return &r->base;
+}
+
+static void
+zz_resource_destroy(struct pipe_screen *screen, struct pipe_resource *res)
+{
+   struct zz_screen *s = (struct zz_screen *)screen;
+   struct zz_resource *r = zr(res);
+
+   cmd(ZP_RES_DESTROY, 1)[0] = r->id;
+   drop_id(r->id);
+   if (r->dt)
+      s->ws->displaytarget_destroy(s->ws, r->dt);
+   align_free(r->data);
+   FREE(r);
+}
+
+/* The copy here, made the first time it is needed: a texture that is never
+   written or read costs this process nothing */
+static uint8_t *
+data(struct zz_resource *r)
+{
+   if (!r->data)
+      r->data = align_malloc(MAX2(r->size, 16), 16);
+   return r->data;
+}
+
+/* the box of a level from the GPU into the copy here */
+static void
+fetch(struct zz_resource *r, unsigned level, const struct pipe_box *b)
+{
+   const unsigned stride = util_format_get_stride(r->base.format, b->width);
+   const unsigned rows = util_format_get_nblocksy(r->base.format, b->height);
+   uint8_t *dst = r->data + r->offset[level] + b->z * r->layer[level] +
+                  util_format_get_nblocksy(r->base.format, b->y) * r->stride[level] +
+                  util_format_get_stride(r->base.format, b->x);
+   uint8_t *tmp = MALLOC(stride * rows);
+   uint32_t w[11];
+   unsigned y;
+
+   flush_cmds();
+   w[0] = ZP_RES_READ | 10 << 8;
+   w[1] = r->id; w[2] = level; w[3] = b->x; w[4] = b->y; w[5] = b->z;
+   w[6] = b->width; w[7] = b->height; w[8] = 1; w[9] = stride; w[10] = 0;
+   zzp_read(w, 11, tmp);
+   for (y = 0; y < rows; y++)
+      memcpy(dst + y * r->stride[level], tmp + y * stride, stride);
+   FREE(tmp);
+}
+
+static void *
+zz_transfer_map(struct pipe_context *pipe, struct pipe_resource *res, unsigned level, unsigned usage,
+                const struct pipe_box *box, struct pipe_transfer **out)
+{
+   struct zz_resource *r = zr(res);
+   struct pipe_transfer *t;
+   unsigned off = r->offset[level] + box->z * r->layer[level] +
+                  util_format_get_nblocksy(res->format, box->y) * r->stride[level] +
+                  util_format_get_stride(res->format, box->x);
+
+   if (!data(r))
+      return NULL;
+   t = CALLOC_STRUCT(pipe_transfer);
+   pipe_resource_reference(&t->resource, res);
+   t->level = level;
+   t->usage = usage;
+   t->box = *box;
+   t->stride = r->stride[level];
+   t->layer_stride = r->layer[level];
+   *out = t;
+   if ((usage & PIPE_TRANSFER_READ) && r->gpu_wrote && res->target != PIPE_BUFFER)
+      fetch(r, level, box);
+   return r->data + off;
+}
+
+static void
+send_box(struct zz_resource *r, unsigned level, const struct pipe_box *b)
+{
+   const unsigned stride = util_format_get_stride(r->base.format, b->width);
+   const unsigned rows = util_format_get_nblocksy(r->base.format, b->height);
+   const unsigned sent = stride * rows * b->depth;
+   const unsigned words = 10 + (sent + 3) / 4;
+   uint8_t *src = r->data + r->offset[level] + b->z * r->layer[level] +
+                  util_format_get_nblocksy(r->base.format, b->y) * r->stride[level] +
+                  util_format_get_stride(r->base.format, b->x);
+   uint32_t *p;
+   uint8_t *d;
+   unsigned y;
+
+   /* a big one in pieces of rows, or of bytes for a buffer */
+   if (words + 1 > ZZ_BUF) {
+      struct pipe_box part = *b;
+
+      if (r->base.target == PIPE_BUFFER) {
+         part.width = b->width / 2;
+         send_box(r, level, &part);
+         part.x += part.width;
+         part.width = b->width - part.width;
+      } else {
+         part.height = util_format_get_blockheight(r->base.format) * (rows / 2);
+         send_box(r, level, &part);
+         part.y += part.height;
+         part.height = b->height - part.height;
+      }
+      send_box(r, level, &part);
+      return;
+   }
+   p = cmd(ZP_RES_WRITE, words);
+   p[0] = r->id; p[1] = level; p[2] = b->x; p[3] = b->y; p[4] = b->z;
+   p[5] = b->width; p[6] = b->height; p[7] = b->depth; p[8] = stride; p[9] = stride * rows;
+   d = (uint8_t *)&p[10];
+   for (y = 0; y < rows * b->depth; y++)
+      memcpy(d + y * stride, src + y * r->stride[level], stride);
+}
+
+static void
+zz_transfer_unmap(struct pipe_context *pipe, struct pipe_transfer *t)
+{
+   if ((t->usage & PIPE_TRANSFER_WRITE) && !(t->usage & PIPE_TRANSFER_FLUSH_EXPLICIT))
+      send_box(zr(t->resource), t->level, &t->box);
+   pipe_resource_reference(&t->resource, NULL);
+   FREE(t);
+}
+
+static void
+zz_transfer_flush_region(struct pipe_context *pipe, struct pipe_transfer *t, const struct pipe_box *box)
+{
+   struct pipe_box b = *box;
+
+   b.x += t->box.x;
+   b.y += t->box.y;
+   b.z += t->box.z;
+   send_box(zr(t->resource), t->level, &b);
+}
+
+/*
+ * State objects
+ */
+#define PI(x) *p++ = s->x;
+#define PF(x) *p++ = fw(s->x);
+
+static void *
+zz_create_blend(struct pipe_context *pipe, const struct pipe_blend_state *b)
+{
+   uint32_t id = new_id(), *p = ccmd(pipe, ZP_BLEND, 7 + 8 * PIPE_MAX_COLOR_BUFS);
+   unsigned i;
+
+   *p++ = id;
+   *p++ = b->independent_blend_enable; *p++ = b->logicop_enable; *p++ = b->logicop_func;
+   *p++ = b->dither; *p++ = b->alpha_to_coverage; *p++ = b->alpha_to_one;
+   for (i = 0; i < PIPE_MAX_COLOR_BUFS; i++) {
+#define PR(x) *p++ = b->rt[i].x;
+      ZZP_RTBLEND(PR, PR)
+   }
+   return (void *)(uintptr_t)id;
+}
+
+static void *
+zz_create_dsa(struct pipe_context *pipe, const struct pipe_depth_stencil_alpha_state *d)
+{
+   uint32_t id = new_id(), *p = ccmd(pipe, ZP_DSA, 1 + 6 + 14 + 3);
+
+   *p++ = id;
+#define PD(x) *p++ = d->depth.x;
+#define PDF(x) *p++ = fw(d->depth.x);
+   ZZP_DEPTH(PD, PDF)
+#define PS0(x) *p++ = d->stencil[0].x;
+#define PS1(x) *p++ = d->stencil[1].x;
+   ZZP_STENCIL(PS0, PS0)
+   ZZP_STENCIL(PS1, PS1)
+#define PA(x) *p++ = d->alpha.x;
+#define PAF(x) *p++ = fw(d->alpha.x);
+   ZZP_ALPHA(PA, PAF)
+   return (void *)(uintptr_t)id;
+}
+
+static void *
+zz_create_rast(struct pipe_context *pipe, const struct pipe_rasterizer_state *s)
+{
+#define ONE(x) + 1
+   uint32_t id = new_id(), *p = ccmd(pipe, ZP_RAST, 1 ZZP_RAST(ONE, ONE));
+
+   *p++ = id;
+   ZZP_RAST(PI, PF)
+   return (void *)(uintptr_t)id;
+}
+
+static void *
+zz_create_sampler(struct pipe_context *pipe, const struct pipe_sampler_state *s)
+{
+   uint32_t id = new_id(), *p = ccmd(pipe, ZP_SAMPLER, 5 ZZP_SAMPLER(ONE, ONE));
+   unsigned i;
+
+   *p++ = id;
+   ZZP_SAMPLER(PI, PF)
+   for (i = 0; i < 4; i++)
+      *p++ = s->border_color.ui[i];
+   return (void *)(uintptr_t)id;
+}
+
+static void *
+zz_create_velems(struct pipe_context *pipe, unsigned n, const struct pipe_vertex_element *e)
+{
+   uint32_t id = new_id(), *p = ccmd(pipe, ZP_VELEMS, 2 + n * 4);
+   unsigned i;
+
+   *p++ = id;
+   *p++ = n;
+   for (i = 0; i < n; i++) {
+      *p++ = e[i].src_offset; *p++ = e[i].vertex_buffer_index;
+      *p++ = e[i].src_format; *p++ = e[i].instance_divisor;
+   }
+   return (void *)(uintptr_t)id;
+}
+
+/* as text, as virgl: TGSI tokens are bitfields and do not survive a change of
+   byte order */
+static void *
+create_shader(struct pipe_context *pipe, enum zzp_kind kind, const struct pipe_shader_state *s)
+{
+   static char *text;
+   unsigned bytes;
+   uint32_t id = new_id(), *p;
+
+   if (!text)
+      text = MALLOC(ZZ_TEXT);
+   if (!tgsi_dump_str(s->tokens, TGSI_DUMP_FLOAT_AS_HEX, text, ZZ_TEXT)) {
+      fprintf(stderr, "zz3660: shader too long\n");
+      abort();
+   }
+   bytes = strlen(text) + 1;
+   p = ccmd(pipe, ZP_SHADER, 3 + (bytes + 3) / 4);
+   p[0] = id;
+   p[1] = kind;
+   p[2] = bytes;
+   memcpy(&p[3], text, bytes);
+   return (void *)(uintptr_t)id;
+}
+
+static void *zz_create_vs(struct pipe_context *c, const struct pipe_shader_state *s) { return create_shader(c, ZK_VS, s); }
+static void *zz_create_fs(struct pipe_context *c, const struct pipe_shader_state *s) { return create_shader(c, ZK_FS, s); }
+static void *zz_create_gs(struct pipe_context *c, const struct pipe_shader_state *s) { return create_shader(c, ZK_GS, s); }
