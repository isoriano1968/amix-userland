+static void
+zz_view_destroy(struct pipe_context *c, struct pipe_sampler_view *v)
+{
+   del(ZK_VIEW, (void *)(uintptr_t)((struct zz_view *)v)->id);
+   pipe_resource_reference(&v->texture, NULL);
+   FREE(v);
