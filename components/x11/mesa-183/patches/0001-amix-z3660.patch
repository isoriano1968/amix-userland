+static struct pipe_surface *
+zz_create_surface(struct pipe_context *c, struct pipe_resource *r, const struct pipe_surface *t)
+{
+   struct zz_surface *s = CALLOC_STRUCT(zz_surface);
+   uint32_t *p;
+
+   s->base = *t;
+   pipe_reference_init(&s->base.reference, 1);
+   s->base.texture = NULL;
+   pipe_resource_reference(&s->base.texture, r);
+   s->base.context = c;
+   s->base.width = u_minify(r->width0, t->u.tex.level);
+   s->base.height = u_minify(r->height0, t->u.tex.level);
+   s->id = new_id();
+   p = ccmd(c, ZP_SURFACE, 6);
+   p[0] = s->id; p[1] = zr(r)->id; p[2] = t->format; p[3] = t->u.tex.level;
+   p[4] = t->u.tex.first_layer; p[5] = t->u.tex.last_layer;
+   return &s->base;
+}
