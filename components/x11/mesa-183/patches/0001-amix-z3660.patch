+
+/* round(a * b / 255) for a, b in 0..255 */
+static inline unsigned
+mul255(unsigned a, unsigned b)
+{
+   unsigned t = a * b + 128;
+
+   return (t + (t >> 8)) >> 8;
+}
+
+static inline unsigned
+to8(float v)
+{
+   if (!(v > 0.0f))
+      return 0;
+   if (v >= 1.0f)
+      return 255;
+   return (unsigned)(v * 255.0f + 0.5f);
+}
+
+static inline int
+wrap(int i, int size, int clamp)
+{
+   if (clamp)
+      return i < 0 ? 0 : i >= size ? size - 1 : i;
+   return i & (size - 1);
+}
+
+static inline boolean
+test(int func, unsigned a, unsigned b)
+{
+   switch (func) {
+   case PIPE_FUNC_NEVER: return FALSE;
+   case PIPE_FUNC_LESS: return a < b;
+   case PIPE_FUNC_EQUAL: return a == b;
+   case PIPE_FUNC_LEQUAL: return a <= b;
+   case PIPE_FUNC_GREATER: return a > b;
+   case PIPE_FUNC_NOTEQUAL: return a != b;
+   case PIPE_FUNC_GEQUAL: return a >= b;
+   default: return TRUE;
+   }
+}
+
+static inline boolean
+testf(int func, float a, float b)
+{
+   switch (func) {
+   case PIPE_FUNC_NEVER: return FALSE;
+   case PIPE_FUNC_LESS: return a < b;
+   case PIPE_FUNC_EQUAL: return a == b;
+   case PIPE_FUNC_LEQUAL: return a <= b;
+   case PIPE_FUNC_GREATER: return a > b;
+   case PIPE_FUNC_NOTEQUAL: return a != b;
+   case PIPE_FUNC_GEQUAL: return a >= b;
+   default: return TRUE;
+   }
+}
+
+static inline unsigned
+factor(int f, const unsigned src[4], const unsigned dst[4], int c)
+{
+   switch (f) {
+   case PIPE_BLENDFACTOR_ONE: return 255;
+   case PIPE_BLENDFACTOR_SRC_COLOR: return src[c];
+   case PIPE_BLENDFACTOR_INV_SRC_COLOR: return 255 - src[c];
+   case PIPE_BLENDFACTOR_SRC_ALPHA: return src[3];
+   case PIPE_BLENDFACTOR_INV_SRC_ALPHA: return 255 - src[3];
+   case PIPE_BLENDFACTOR_DST_COLOR: return dst[c];
+   case PIPE_BLENDFACTOR_INV_DST_COLOR: return 255 - dst[c];
+   case PIPE_BLENDFACTOR_DST_ALPHA: return dst[3];
+   case PIPE_BLENDFACTOR_INV_DST_ALPHA: return 255 - dst[3];
+   case PIPE_BLENDFACTOR_SRC_ALPHA_SATURATE: return c == 3 ? 255 : MIN2(src[3], 255 - dst[3]);
+   default: return 0;
+   }
+}
+
+static inline unsigned
+combine(int func, unsigned s, unsigned d)
+{
+   int v;
+
+   switch (func) {
+   case PIPE_BLEND_ADD: v = (int)(s + d); break;
+   case PIPE_BLEND_SUBTRACT: v = (int)s - (int)d; break;
+   case PIPE_BLEND_REVERSE_SUBTRACT: v = (int)d - (int)s; break;
+   case PIPE_BLEND_MIN: return MIN2(s, d);
+   default: return MAX2(s, d);
+   }
+   return v < 0 ? 0 : v > 255 ? 255 : (unsigned)v;
+}
+
+/* the integer Z softpipe stores for depth value z */
+static inline unsigned
+zvalue(int format, float z)
+{
+   switch (format) {
+   case PIPE_FORMAT_Z16_UNORM:
+      return (unsigned)(z * 65535.0f);
+   case PIPE_FORMAT_Z32_UNORM:
+      return (unsigned)(z * (double)0xffffffffu);
+   case PIPE_FORMAT_Z32_FLOAT: {
+      union fi fi;
+
+      fi.f = z;
+      return fi.ui;
+   }
+   default:
+      return (unsigned)(z * (float)((1 << 24) - 1));
+   }
+}
+
+static inline unsigned
+zread(int format, const ubyte *p)
+{
+   switch (format) {
+   case PIPE_FORMAT_Z16_UNORM: return *(const ushort *)p;
+   case PIPE_FORMAT_Z24X8_UNORM:
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT: return *(const uint *)p & 0xffffff;
+   case PIPE_FORMAT_X8Z24_UNORM:
+   case PIPE_FORMAT_S8_UINT_Z24_UNORM: return *(const uint *)p >> 8;
+   default: return *(const uint *)p;
+   }
+}
+
+static inline void
+zwrite(int format, ubyte *p, unsigned z)
+{
+   switch (format) {
+   case PIPE_FORMAT_Z16_UNORM: *(ushort *)p = (ushort)z; break;
+   case PIPE_FORMAT_Z24X8_UNORM:
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT: *(uint *)p = (*(uint *)p & 0xff000000u) | z; break;
+   case PIPE_FORMAT_X8Z24_UNORM:
+   case PIPE_FORMAT_S8_UINT_Z24_UNORM: *(uint *)p = (*(uint *)p & 0xffu) | (z << 8); break;
+   default: *(uint *)p = z;
+   }
+}
+
+static inline int
+zbytes(int format)
+{
+   return format == PIPE_FORMAT_Z16_UNORM ? 2 : 4;
+}
+
+/* canonical packed colour: r | g << 8 | b << 16 | a << 24 */
+#define R(v) ((v) & 0xff)
+#define G(v) (((v) >> 8) & 0xff)
+#define B(v) (((v) >> 16) & 0xff)
+#define A(v) ((v) >> 24)
+
+static inline uint32_t
+pack(unsigned r, unsigned g, unsigned b, unsigned a)
+{
+   return r | g << 8 | b << 16 | a << 24;
+}
+
+static inline uint32_t
+mod4(uint32_t a, uint32_t b)
+{
+   return pack(mul255(R(a), R(b)), mul255(G(a), G(b)), mul255(B(a), B(b)), mul255(A(a), A(b)));
+}
+
+/* (a * (256 - f) + b * f) / 256 per channel, f 0..256 */
+static inline uint32_t
+lerp4(uint32_t a, uint32_t b, unsigned f)
+{
+   const uint32_t rb = ((((a & 0xff00ffu) * (256 - f) + (b & 0xff00ffu) * f) + 0x800080u) >> 8) & 0xff00ffu;
+   const uint32_t ag = ((((a >> 8) & 0xff00ffu) * (256 - f) + ((b >> 8) & 0xff00ffu) * f) + 0x800080u) & 0xff00ff00u;
+
+   return rb | ag;
+}
+
+static inline uint32_t
+load_texel(const struct sp_fast_tex *t, int l, int x, int y)
+{
+   const ubyte *p = t->data[l] + (unsigned)y * t->stride[l] + (unsigned)x * t->bpp;
+   unsigned c[4];
+   int i;
+
+   if (t->ident)
+      return *(const uint32_t *)p;
+   for (i = 0; i < 4; i++)
+      c[i] = t->map[i] >= 0 ? p[t->map[i]] : t->map[i] == -1 ? 0 : 255;
+   return pack(c[0], c[1], c[2], c[3]);
+}
+
+/* u, v: texel coordinates, 16.16, the half-texel offset taken off for linear */
+static inline uint32_t
+fetch(const struct sp_fast_tex *t, int l, int linear, int u, int v)
+{
+   const int w = t->w[l], h = t->h[l];
+   int x0 = u >> 16, y0 = v >> 16;
+
+   if (!linear)
+      return load_texel(t, l, wrap(x0, w, t->clamp_s), wrap(y0, h, t->clamp_t));
+   {
+      const unsigned fx = (u >> 8) & 0xff, fy = (v >> 8) & 0xff;
+      const int x1 = wrap(x0 + 1, w, t->clamp_s), y1 = wrap(y0 + 1, h, t->clamp_t);
+
+      x0 = wrap(x0, w, t->clamp_s);
+      y0 = wrap(y0, h, t->clamp_t);
+      return lerp4(lerp4(load_texel(t, l, x0, y0), load_texel(t, l, x1, y0), fx),
+                   lerp4(load_texel(t, l, x0, y1), load_texel(t, l, x1, y1), fx), fy);
+   }
+}
+
+/* fetch() for one word per texel (fast4): masks (repeat, a power of two)
+   or min/max (clamp) and whole-word loads, inline in the spans */
+static inline __attribute__((always_inline)) int
+coord(int i, unsigned size, int clamp)
+{
+   if (clamp)
+      return i < 0 ? 0 : i >= (int)size ? (int)size - 1 : i;
+   return (int)((unsigned)i & (size - 1));
+}
+
+static inline __attribute__((always_inline)) uint32_t
+fetch_fast(const struct sp_fast_tex *t, int l, int linear, int u, int v)
+{
+   if (t->fast4) {
+      const unsigned w = (unsigned)t->w[l], h = (unsigned)t->h[l];
+      const ubyte *base = t->data[l];
+      const unsigned stride = t->stride[l];
+      const int xi = u >> 16, yi = v >> 16;
+      const unsigned x0 = coord(xi, w, t->clamp_s), y0 = coord(yi, h, t->clamp_t);
+      const uint32_t *r0 = (const uint32_t *)(base + y0 * stride), *r1;
+      unsigned x1;
+
+      if (!linear)
+         return r0[x0] | t->amask;
+      x1 = coord(xi + 1, w, t->clamp_s);
+      r1 = (const uint32_t *)(base + coord(yi + 1, h, t->clamp_t) * stride);
+      return lerp4(lerp4(r0[x0], r0[x1], (u >> 8) & 0xff), lerp4(r1[x0], r1[x1], (u >> 8) & 0xff),
+                   (v >> 8) & 0xff) | t->amask;
+   }
+   return fetch(t, l, linear, u, v) | t->amask;
+}
+
+static inline uint32_t
+load_pixel(const struct sp_fast *f, const ubyte *p)
+{
+   unsigned c[4];
+   int i;
+
+   switch (f->cpack) {
+   case CPACK_RGBA: return *(const uint32_t *)p;
+   case CPACK_BGRA: {
+      const uint32_t v = *(const uint32_t *)p;
+
+      return (v & 0xff00ff00u) | (v >> 16 & 0xff) | (v & 0xff) << 16;
+   }
+   default:
+      for (i = 0; i < 4; i++)
+         c[i] = f->cmap[i] >= 0 ? p[f->cmap[i]] : 255;
+      return pack(c[0], c[1], c[2], c[3]);
+   }
+}
+
+static inline void
+store_pixel(const struct sp_fast *f, ubyte *p, uint32_t v)
+{
+   int i;
+
+   switch (f->cpack) {
+   case CPACK_RGBA: *(uint32_t *)p = v; return;
+   case CPACK_BGRA: *(uint32_t *)p = (v & 0xff00ff00u) | (v >> 16 & 0xff) | (v & 0xff) << 16; return;
+   default:
+      for (i = 0; i < 4; i++)
+         if (f->cmap[i] >= 0 && (f->colormask & (1 << i)))
+            p[f->cmap[i]] = (ubyte)(v >> (8 * i));
+   }
+}
+
+static uint32_t
+blend_generic(const struct sp_fast *f, uint32_t s, uint32_t d)
+{
+   const unsigned src[4] = { R(s), G(s), B(s), A(s) }, dst[4] = { R(d), G(d), B(d), A(d) };
+   unsigned o[4];
+   int c;
+
+   for (c = 0; c < 3; c++)
+      o[c] = f->rgb_func >= PIPE_BLEND_MIN ? combine(f->rgb_func, src[c], dst[c]) :
+             combine(f->rgb_func, mul255(src[c], factor(f->rgb_src, src, dst, c)),
+                     mul255(dst[c], factor(f->rgb_dst, src, dst, c)));
+   o[3] = f->a_func >= PIPE_BLEND_MIN ? combine(f->a_func, src[3], dst[3]) :
+          combine(f->a_func, mul255(src[3], factor(f->a_src, src, dst, 3)),
+                  mul255(dst[3], factor(f->a_dst, src, dst, 3)));
+   return pack(o[0], o[1], o[2], o[3]);
+}
+
+/* the fog factor of a vertex, 0..1 */
+static inline float
+fog_factor(const struct sp_fast *f, const float (*v)[4])
+{
+   const float c = v[f->fog_slot][0] * f->fog_scale;
+   const float r = f->fog_kind == FOG_EXP ? util_fast_exp2(-c) : c + f->fog_off;
+
+   return CLAMP(r, 0.0f, 1.0f);
+}
+
+static inline int32_t
+fog_fix(float v)
+{
+   const float m = 65536.0f * 255.0f;
+   const float r = v * m;
+
+   return (int32_t)CLAMP(r, -m, m);
+}
+
+/* the factor is exact at the corners and linear between them, as fog per
+   vertex is: a shader's exponential per pixel costs a thousand cycles */
+static void
+fog_plane(struct sp_fast *f, const float (*v0)[4], const float (*v1)[4], const float (*v2)[4])
+{
+   const float f0 = fog_factor(f, v0), f1 = fog_factor(f, v1) - f0, f2 = fog_factor(f, v2) - f0;
+   const float ax = v1[0][0] - v0[0][0], ay = v1[0][1] - v0[0][1];
+   const float bx = v2[0][0] - v0[0][0], by = v2[0][1] - v0[0][1];
+   const float det = ax * by - bx * ay;
+   float dx = 0.0f, dy = 0.0f;
+
+   if (det != 0.0f) {
+      const float r = 1.0f / det;
+
+      dx = (f1 * by - f2 * ay) * r;
+      dy = (f2 * ax - f1 * bx) * r;
+   }
+   f->FDX = fog_fix(dx);
+   f->FDY = fog_fix(dy);
+   f->FO = fog_fix(f0 + dx * ((float)(int)v0[0][0] - v0[0][0]) + dy * ((float)(int)v0[0][1] - v0[0][1]));
+}
+
+void
+sp_fast_tri(struct sp_fast *f, const float (*provoke)[4],
+            const float (*v0)[4], const float (*v1)[4], const float (*v2)[4])
+{
+   unsigned c8[4] = { 255, 255, 255, 255 };
+   int c;
+
+   if (f->fog_kind)
+      fog_plane(f, v0, v1, v2);
+   f->tri_const = TRUE;
+   if (f->col_in < 0) {
+      f->tri_col = 0xffffffffu;
+      return;
+   }
+   if (f->col_const) {
+      f->tri_col = f->const_col;
+      return;
+   }
+   for (c = 0; c < 4; c++) {
+      const int ch = f->col_chan[c];
+
+      if (ch < 0)
+         continue;
+      if (f->col_interp == SP_INTERP_CONSTANT) {
+         c8[c] = to8(provoke[f->col_slot][ch]);
+      } else {
+         const float a = v0[f->col_slot][ch];
+
+         if (v1[f->col_slot][ch] != a || v2[f->col_slot][ch] != a) {
+            /* the spans interpolate it: no constant colour on top */
+            f->tri_const = FALSE;
+            f->tri_col = 0xffffffffu;
+            return;
+         }
+         c8[c] = to8(a);
+      }
+   }
+   f->tri_col = pack(c8[0], c8[1], c8[2], c8[3]);
+}
+
+/* texel of level l at normalized (s, t) */
+static inline uint32_t
+tex_at(const struct sp_fast_tex *t, int l, int linear, float s, float tt)
+{
+   const float off = linear ? 0.5f : 0.0f;
+
+   /* keep the 16.16 texel coordinates in range */
+   if (t->clamp_s)
+      s = CLAMP(s, -4.0f, 4.0f);
+   else
+      s -= (float)util_ifloor(s);
+   if (t->clamp_t)
+      tt = CLAMP(tt, -4.0f, 4.0f);
+   else
+      tt -= (float)util_ifloor(tt);
+   return fetch(t, l, linear, (int)((s * (float)t->w[l] - off) * 65536.0f),
+                (int)((tt * (float)t->h[l] - off) * 65536.0f));
+}
+
+static inline uint32_t
+tex_sample(const struct sp_fast_tex *t, float s, float tt, float lambda)
+{
+   int l;
+
+   if (!t->need_lambda || !(lambda > 0.0f))      /* (not a number too) */
+      return tex_at(t, t->first, t->mag_linear, s, tt);
+   lambda = MIN2(lambda, 15.0f);
+   switch (t->mip) {
+   case PIPE_TEX_MIPFILTER_NEAREST:
+      l = t->first + (int)(lambda + 0.5f);
+      return tex_at(t, MIN2(l, t->last), t->min_linear, s, tt);
+   case PIPE_TEX_MIPFILTER_LINEAR:
+      l = t->first + (int)lambda;
+      if (l >= t->last)
+         return tex_at(t, t->last, t->min_linear, s, tt);
+      return lerp4(tex_at(t, l, t->min_linear, s, tt), tex_at(t, l + 1, t->min_linear, s, tt),
+                   (unsigned)((lambda - (float)(int)lambda) * 256.0f));
+   default:
+      return tex_at(t, t->first, t->min_linear, s, tt);
+   }
+}
+
+/* output channel c: colour channel col_chan[c] times texel channel chan[c] of each unit */
+static uint32_t
+combine_mixed(const struct sp_fast *f, uint32_t cv, uint32_t tv0, uint32_t tv1)
+{
+   const uint32_t tv[SP_FAST_UNITS] = { tv0, tv1 };
+   unsigned o[4];
+   int c, k;
+
+   for (c = 0; c < 4; c++) {
+      unsigned v = f->col_in >= 0 && f->col_chan[c] >= 0 ? (cv >> (8 * c)) & 0xff : 255;
+
+      for (k = 0; k < SP_FAST_UNITS; k++)
+         if (f->u[k].in >= 0 && f->u[k].chan[c] >= 0)
+            v = mul255(v, (tv[k] >> (8 * f->u[k].chan[c])) & 0xff);
+      o[c] = v;
+   }
+   return pack(o[0], o[1], o[2], o[3]);
+}
+
+static void fast_span(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+                      const struct tgsi_interp_coef *pos, int y, int x0, int x1);
+
+/*
+ * The span in integers: Z, texel coordinates and colours are evaluated
+ * exactly (in float) at the start of the span and every SEG pixels, and
+ * stepped in fixed point in between.  The Cortex-A9's VFP has long
+ * latencies (16 cycles a divide, 11 a dependent multiply-add), so the
+ * float work is per span, not per pixel.  Z: Z16 as 16.16, Z24 as 24.8.
+ */
+#define SEG 16
+
+/* level, filter and 16.16 texel coordinates (u, v, du, dv) at pixel x */
+static inline void
+tex_setup(const struct sp_fast_unit *un, const struct tgsi_interp_coef *tc,
+          const struct tgsi_interp_coef *pos, float fx, float fy, int *level, int *linear,
+          int32_t *u, int32_t *v, int32_t *du, int32_t *dv, boolean pick, float *rq_share, float n)
+{
+   const struct sp_fast_tex *t = &un->tex;
+   const int cs = un->coord_chan[0], ct = un->coord_chan[1];
+   float S = tc->a0[cs] + tc->dadx[cs] * fx + tc->dady[cs] * fy;
+   float T = tc->a0[ct] + tc->dadx[ct] * fx + tc->dady[ct] * fy;
+   float Q = 1.0f, dQdx = 0.0f, dQdy = 0.0f, rq, rqe, s, tt, dsdx, dtdx, w, h, off;
+
+   if (un->txp) {
+      const int cq = un->coord_chan[2];
+
+      Q = tc->a0[cq] + tc->dadx[cq] * fx + tc->dady[cq] * fy;
+      dQdx = tc->dadx[cq];
+      dQdy = tc->dady[cq];
+   } else if (un->interp == SP_INTERP_PERSPECTIVE) {
+      Q = pos->a0[3] + pos->dadx[3] * fx + pos->dady[3] * fy;
+      dQdx = pos->dadx[3];
+      dQdy = pos->dady[3];
+   }
+   /* 1/Q: the other unit's when their Q planes are the same (rq_share) */
+   if (rq_share && *rq_share != 0.0f)
+      rq = *rq_share;
+   else {
+      rq = 1.0f / Q;
+      if (rq_share)
+         *rq_share = rq;
+   }
+   s = S * rq;
+   tt = T * rq;
+   /* the step that lands on the next segment's start, n pixels on: the
+      slope here would leave a jump there on a steep surface */
+   rqe = n != 0.0f && dQdx != 0.0f ? 1.0f / (Q + dQdx * n) : rq;
+   dsdx = (tc->dadx[cs] - s * dQdx) * rqe;
+   dtdx = (tc->dadx[ct] - tt * dQdx) * rqe;
+   if (pick) {
+      float lambda = 0.0f;
+
+      if (t->need_lambda) {
+         const float dsdy = (tc->dady[cs] - s * dQdy) * rq;
+         const float dtdy = (tc->dady[ct] - tt * dQdy) * rq;
+         const float rs = MAX2(fabsf(dsdx), fabsf(dsdy)) * (float)t->w[t->first];
+         const float rt = MAX2(fabsf(dtdx), fabsf(dtdy)) * (float)t->h[t->first];
+
+         lambda = util_fast_log2(MAX2(rs, rt)) + t->lod_bias;
+         lambda = CLAMP(lambda, t->min_lod, t->max_lod);
+      }
+      pick_level(t, lambda, level, linear);
+   }
+   w = (float)t->w[*level];
+   h = (float)t->h[*level];
+   off = *linear ? 0.5f : 0.0f;
+   if (t->clamp_s)
+      s = CLAMP(s, -4.0f, 4.0f);
+   else
+      s -= (float)util_ifloor(s);
+   if (t->clamp_t)
+      tt = CLAMP(tt, -4.0f, 4.0f);
+   else
+      tt -= (float)util_ifloor(tt);
+   dsdx = CLAMP(dsdx, -1.0f, 1.0f);
+   dtdx = CLAMP(dtdx, -1.0f, 1.0f);
+   *u = (int32_t)((s * w - off) * 65536.0f);
+   *v = (int32_t)((tt * h - off) * 65536.0f);
+   *du = (int32_t)(dsdx * w * 65536.0f);
+   *dv = (int32_t)(dtdx * h * 65536.0f);
+}
+
+/* colour channels as 8.16 (0..255) and their steps at pixel x */
+static inline void
+col_setup(const struct sp_fast *f, const struct tgsi_interp_coef *cc,
+          const struct tgsi_interp_coef *pos, float fx, float fy, int32_t c[4], int32_t dc[4])
+{
+   const boolean persp = f->col_interp == SP_INTERP_PERSPECTIVE;
+   const float oow = persp ? pos->a0[3] + pos->dadx[3] * fx + pos->dady[3] * fy : 1.0f;
+   const float w = persp ? 1.0f / oow : 1.0f;
+   const float doow = persp ? pos->dadx[3] : 0.0f;
+   int i;
+
+   for (i = 0; i < 4; i++) {
+      const int ch = f->col_chan[i];
+      float v, dv;
+
+      if (ch < 0) {
+         c[i] = 255 << 16;
+         dc[i] = 0;
+         continue;
+      }
+      v = (cc->a0[ch] + cc->dadx[ch] * fx + cc->dady[ch] * fy) * w;
+      dv = (cc->dadx[ch] - v * doow) * w;
+      v = CLAMP(v, 0.0f, 1.0f);
+      dv = CLAMP(dv, -1.0f, 1.0f);
+      c[i] = (int32_t)(v * (255.0f * 65536.0f)) + 32768;
+      dc[i] = (int32_t)(dv * (255.0f * 65536.0f));
+   }
+}
+
+static inline unsigned
+col8(int32_t v)
+{
+   return v <= 0 ? 0 : v >= (255 << 16) ? 255 : (unsigned)v >> 16;
+}
+
+#ifdef __ARM_NEON
+/*
+ * The pixel arithmetic in NEON: a pixel is the low half of a uint8x8_t
+ * (r, g, b, a bytes).  Values stay in NEON from the texel loads to the
+ * store: moving them to ARM registers costs ~20 cycles on the Cortex-A9.
+ */
+#include <arm_neon.h>
+
+/* round(a * b / 255) per byte */
+static inline uint8x8_t
+n_mod(uint8x8_t a, uint8x8_t b)
+{
+   uint16x8_t t = vmull_u8(a, b);
+
+   return vrshrn_n_u16(vaddq_u16(t, vrshrq_n_u16(t, 8)), 8);
+}
+
+/* round(t / 255) of products */
+static inline uint8x8_t
+n_div255(uint16x8_t t)
+{
+   return vrshrn_n_u16(vaddq_u16(t, vrshrq_n_u16(t, 8)), 8);
+}
+
+static inline uint8x8_t
+n_word(uint32_t v)
+{
+   return vreinterpret_u8_u32(vdup_n_u32(v));
+}
+
+/* fetch_fast() in NEON; bilinear weights of 7 bits */
+static inline __attribute__((always_inline)) uint8x8_t
+fetch_neon(const struct sp_fast_tex *t, int l, int linear, int u, int v)
+{
+   if (t->fast4) {
+      const unsigned w = (unsigned)t->w[l], h = (unsigned)t->h[l];
+      const ubyte *base = t->data[l];
+      const unsigned stride = t->stride[l];
+      const int xi = u >> 16, yi = v >> 16;
+      const unsigned x0 = coord(xi, w, t->clamp_s), y0 = coord(yi, h, t->clamp_t);
+      const uint32_t *r0 = (const uint32_t *)(base + y0 * stride), *r1;
+      const uint8x8_t am = vreinterpret_u8_u32(vdup_n_u32(t->amask));
+      unsigned x1, fx, fy;
+      uint32x2_t top, bot;
+      uint16x8_t m;
+      uint32x4_t wv;
+
+      if (!linear)
+         return vorr_u8(vreinterpret_u8_u32(vld1_dup_u32(r0 + x0)), am);
+      x1 = coord(xi + 1, w, t->clamp_s);
+      r1 = (const uint32_t *)(base + coord(yi + 1, h, t->clamp_t) * stride);
+      fx = (u >> 9) & 0x7f;
+      fy = (v >> 9) & 0x7f;
+      top = vld1_lane_u32(r0 + x1, vld1_dup_u32(r0 + x0), 1);
+      bot = vld1_lane_u32(r1 + x1, vld1_dup_u32(r1 + x0), 1);
+      m = vmull_u8(vreinterpret_u8_u32(top), vdup_n_u8((uint8_t)(128 - fy)));
+      m = vmlal_u8(m, vreinterpret_u8_u32(bot), vdup_n_u8((uint8_t)fy));
+      wv = vmull_n_u16(vget_low_u16(m), (uint16_t)(128 - fx));
+      wv = vmlal_n_u16(wv, vget_high_u16(m), (uint16_t)fx);
+      {
+         const uint16x4_t r = vrshrn_n_u32(wv, 14);
+
+         return vorr_u8(vmovn_u16(vcombine_u16(r, r)), am);
+      }
+   }
+   return n_word(fetch(t, l, linear, u, v) | t->amask);
+}
+
+/* a level of a texture as the pixel loop needs it: copied into locals per
+   segment, so the stores to the colour and Z buffers (which may alias
+   anything) do not make the compiler reload it for every pixel */
+struct texl {
+   const struct sp_fast_tex *t;
+   const ubyte *base;
+   unsigned stride, w, h;
+   uint32_t amask;
+   int l, linear, clamp_s, clamp_t, fast4;
+   int wm, hm;                  /* w - 1, h - 1 */
+   uint8x8_t am;
+};
+
+static inline __attribute__((always_inline)) void
+texl_set(struct texl *L, const struct sp_fast_tex *t, int l, int linear)
+{
+   L->t = t;
+   L->base = t->data[l];
+   L->stride = t->stride[l];
+   L->w = (unsigned)t->w[l];
+   L->h = (unsigned)t->h[l];
+   L->amask = t->amask;
+   L->l = l;
+   L->linear = linear;
+   L->clamp_s = t->clamp_s;
+   L->clamp_t = t->clamp_t;
+   L->fast4 = t->fast4;
+   L->wm = (int)L->w - 1;
+   L->hm = (int)L->h - 1;
+   L->am = vreinterpret_u8_u32(vdup_n_u32(t->amask));
+}
+
+/* what fetch_k() can be compiled for: TK_DIRECT, bilinear fast4 whose
+   texel pairs of a segment all lie inside the level (no wrap, no clamp:
+   each row's two texels one load), else fetch_l() */
+enum { TK_ANY, TK_DIRECT };
+
+static inline int
+tex_kind(const struct texl *L, int32_t u, int32_t v, int32_t du, int32_t dv, int n)
+{
+   const int64_t ue = (int64_t)u + (int64_t)du * (n - 1), ve = (int64_t)v + (int64_t)dv * (n - 1);
+   const int64_t um = (int64_t)L->wm << 16, vm = (int64_t)L->hm << 16;
+
+   if (!L->fast4 || !L->linear)
+      return TK_ANY;
+   return u >= 0 && u < um && ue >= 0 && ue < um && v >= 0 && v < vm && ve >= 0 && ve < vm ?
+          TK_DIRECT : TK_ANY;
+}
+
+static inline __attribute__((always_inline)) uint8x8_t
+fetch_l(const struct texl *L, int u, int v)
+{
+   if (L->fast4) {
+      const int xi = u >> 16, yi = v >> 16;
+      const unsigned x0 = coord(xi, L->w, L->clamp_s), y0 = coord(yi, L->h, L->clamp_t);
+      const uint32_t *r0 = (const uint32_t *)(L->base + y0 * L->stride), *r1;
+      const uint8x8_t am = L->am;
+      unsigned x1, fx, fy;
+      uint32x2_t top, bot;
+      uint16x8_t m;
+      uint32x4_t wv;
+
+      if (!L->linear)
+         return vorr_u8(vreinterpret_u8_u32(vld1_dup_u32(r0 + x0)), am);
+      x1 = coord(xi + 1, L->w, L->clamp_s);
+      r1 = (const uint32_t *)(L->base + coord(yi + 1, L->h, L->clamp_t) * L->stride);
+      fx = (u >> 9) & 0x7f;
+      fy = (v >> 9) & 0x7f;
+      top = vld1_lane_u32(r0 + x1, vld1_dup_u32(r0 + x0), 1);
+      bot = vld1_lane_u32(r1 + x1, vld1_dup_u32(r1 + x0), 1);
+      m = vmull_u8(vreinterpret_u8_u32(top), vdup_n_u8((uint8_t)(128 - fy)));
+      m = vmlal_u8(m, vreinterpret_u8_u32(bot), vdup_n_u8((uint8_t)fy));
+      wv = vmull_n_u16(vget_low_u16(m), (uint16_t)(128 - fx));
+      wv = vmlal_n_u16(wv, vget_high_u16(m), (uint16_t)fx);
+      {
+         const uint16x4_t r = vrshrn_n_u32(wv, 14);
+
+         return vorr_u8(vmovn_u16(vcombine_u16(r, r)), am);
+      }
+   }
+   return n_word(fetch(L->t, L->l, L->linear, u, v) | L->amask);
+}
+
+static inline __attribute__((always_inline)) int
+clampi(int i, int m)
+{
+   return i < 0 ? 0 : i > m ? m : i;
+}
+
+/* fetch_l() for a kind known when compiling: no tests per pixel */
+static inline __attribute__((always_inline)) uint8x8_t
+fetch_k(const struct texl *L, const int K, int u, int v)
+{
+   const ubyte *p;
+   unsigned fx, fy;
+   uint32x2_t top, bot;
+   uint16x8_t m;
+   uint32x4_t wv;
+
+   if (K == TK_ANY)
+      return fetch_l(L, u, v);
+   p = L->base + (unsigned)(v >> 16) * L->stride + (unsigned)(u >> 16) * 4;
+   fx = (u >> 9) & 0x7f;
+   fy = (v >> 9) & 0x7f;
+   top = vld1_u32((const uint32_t *)p);
+   bot = vld1_u32((const uint32_t *)(p + L->stride));
+   m = vmull_u8(vreinterpret_u8_u32(top), vdup_n_u8((uint8_t)(128 - fy)));
+   m = vmlal_u8(m, vreinterpret_u8_u32(bot), vdup_n_u8((uint8_t)fy));
+   wv = vmull_n_u16(vget_low_u16(m), (uint16_t)(128 - fx));
+   wv = vmlal_n_u16(wv, vget_high_u16(m), (uint16_t)fx);
+   {
+      const uint16x4_t r = vrshrn_n_u32(wv, 14);
+
+      return vorr_u8(vmovn_u16(vcombine_u16(r, r)), L->am);
+   }
+}
+
+/* the colour the texels are multiplied by: none, the triangle's constant
+   one (tri_col) or the interpolated one */
+enum { CM_WHITE, CM_CONST, CM_INTERP };
+
+/* a pixel's colour before blending: texels times the colour (NEON) */
+static inline __attribute__((always_inline)) uint8x8_t
+px_color(const struct texl *L0, const struct texl *L1, const int NT, const int K0, const int K1,
+         int u0, int v0, int u1, int v1, const int CM, int32x4_t cvec, uint8x8_t tcol)
+{
+   uint8x8_t s8 = tcol;
+
+   if (NT >= 1) {
+      const uint8x8_t t8 = fetch_k(L0, K0, u0, v0);
+
+      s8 = CM != CM_CONST ? t8 : n_mod(t8, s8);
+   }
+   if (NT >= 2)
+      s8 = n_mod(s8, fetch_k(L1, K1, u1, v1));
+   if (CM == CM_INTERP) {
+      const uint8x8_t c8 = vqmovn_u16(vcombine_u16(vqshrun_n_s32(cvec, 16), vdup_n_u16(0)));
+
+      s8 = NT ? n_mod(s8, c8) : c8;
+   }
+   return s8;
+}
+#endif
+
+#ifdef __ARM_NEON
+/*
+ * tex_setup() for both units at once, in NEON lanes s0 t0 s1 t1: one
+ * dependent chain instead of two, one division (f->share_q).  The levels
+ * are chosen already (l, lin); out: u0 v0 u1 v1, du0 dv0 du1 dv1.
+ */
+static inline __attribute__((always_inline)) void
+tex_setup2(const struct sp_fast *f, float fx, float fy, float n, int l0, int lin0, int l1, int lin1,
+           int32x4_t *uv, int32x4_t *duv)
+{
+   const struct sp_fast_tex *t0 = &f->u[0].tex, *t1 = &f->u[1].tex;
+   const float32x4_t dx = vld1q_f32(f->vq_dx);
+   const float32x4_t st = vmlaq_n_f32(vmlaq_n_f32(vld1q_f32(f->vq_a0), dx, fx), vld1q_f32(f->vq_dy), fy);
+   const float q = f->vq_q[0] + f->vq_q[1] * fx + f->vq_q[2] * fy;
+   const float rq = 1.0f / q, rqe = 1.0f / (q + f->vq_q[1] * n);     /* tex_setup() has why */
+   const float32x4_t one = vdupq_n_f32(1.0f);
+   float32x4_t s = vmulq_n_f32(st, rq), d, fl, size, off;
+   const float32x2_t of0 = vdup_n_f32(lin0 ? 0.5f : 0.0f), of1 = vdup_n_f32(lin1 ? 0.5f : 0.0f);
+
+   d = vmulq_n_f32(vmlsq_n_f32(dx, s, f->vq_q[1]), rqe);
+   /* repeat: s - floor(s); clamp: kept in -4..4 */
+   fl = vcvtq_f32_s32(vcvtq_s32_f32(s));
+   fl = vsubq_f32(fl, vreinterpretq_f32_u32(vandq_u32(vcgtq_f32(fl, s), vreinterpretq_u32_f32(one))));
+   s = vbslq_f32(vld1q_u32(f->vq_clamp), vminq_f32(vmaxq_f32(s, vdupq_n_f32(-4.0f)), vdupq_n_f32(4.0f)),
+                 vsubq_f32(s, fl));
+   d = vminq_f32(vmaxq_f32(d, vnegq_f32(one)), one);
+   size = vcombine_f32(vld1_f32(t0->fsize[l0]), vld1_f32(t1->fsize[l1]));
+   off = vcombine_f32(of0, of1);
+   *uv = vcvtq_n_s32_f32(vmlsq_f32(vmulq_f32(s, size), one, off), 16);
+   *duv = vcvtq_n_s32_f32(vmulq_f32(d, size), 16);
+}
+#endif
+
+/* the fog factor of an 8.16 plane value */
+static inline unsigned
+fog8(int32_t v)
+{
+   const int i = v >> 16;
+
+   return i < 0 ? 0 : i > 255 ? 255 : (unsigned)i;
+}
+
+#ifdef __ARM_NEON
+/* two pixels to the fog colour by factors a and b; alpha stays (fogc has
+   alpha 0, the weight is 255) */
+static inline __attribute__((always_inline)) uint8x8_t
+n_fog(uint8x8_t s, int32_t a, int32_t b, uint8x8_t fogc)
+{
+   const uint32_t wa = fog8(a) * 0x010101u | 0xff000000u, wb = fog8(b) * 0x010101u | 0xff000000u;
+   const uint8x8_t w = vreinterpret_u8_u32(vset_lane_u32(wb, vdup_n_u32(wa), 1));
+
+   return n_div255(vmlal_u8(vmull_u8(s, w), fogc, vmvn_u8(w)));
+}
+
+/* the state pair_run() carries along a span segment */
+struct pstate {
+   ubyte *cp, *zp;
+   uint32_t zacc;
+   int32_t u0, v0, u1, v1;
+   int x;
+   int32_t fogv;
+};
+
+/*
+ * span_tmpl()'s pixels two a turn: both Z tests, then both pixels'
+ * arithmetic without branches between (the A9 runs NEON in order: two
+ * independent chains hide each other's latencies), then the stores.  Also
+ * compiled per texture kind (K0, K1) and colour (CM).
+ */
+static inline __attribute__((always_inline)) void
+pair_run(const struct sp_fast *f, struct pstate *ps, int end, int32_t dz, int zsh,
+         int32_t du0, int32_t dv0, int32_t du1, int32_t dv1, int32_t *c, const int32_t *dc,
+         const struct texl *L0, const struct texl *L1, int z16, int zlow, int zb,
+         const int ZK, const int NT, const int BK, const int K0, const int K1, const int CM)
+{
+   static const uint8_t bgra2[8] = { 2, 1, 0, 3, 6, 5, 4, 7 };
+   const uint32_t tri_col = f->tri_col;
+   const int zwrite = f->zwrite, afunc = f->afunc, cpack = f->cpack, cbpp = f->cbpp;
+   const float areff = f->areff;
+   const uint8x8_t tcol = n_word(tri_col), fogc = n_word(f->fog_rgba);
+   const int fog = f->fog_kind;
+   const int32_t fogd = f->FDX;
+   int32_t fogv = ps->fogv;
+   int32x4_t cva = vld1q_s32(c);
+   const int32x4_t dcv = vld1q_s32(dc), dcv2 = vshlq_n_s32(dcv, 1);
+   ubyte *cp = ps->cp, *zp = ps->zp;
+   uint32_t zacc = ps->zacc;
+   int32_t u0 = ps->u0, v0 = ps->v0, u1 = ps->u1, v1 = ps->v1;
+   int x = ps->x;
+
+      for (; x + 1 < end; x += 2, cp += 2 * cbpp, zp += 2 * zb, zacc += 2 * (uint32_t)dz,
+           u0 += 2 * du0, v0 += 2 * dv0, u1 += 2 * du1, v1 += 2 * dv1, cva = vaddq_s32(cva, dcv2),
+           fogv += 2 * fogd) {
+         unsigned za = 0, zbv = 0;
+         int la = 1, lb = 1;
+         uint8x8_t sa, sb;
+
+         if (ZK) {
+            const unsigned oa = z16 ? ((const ushort *)zp)[0] :
+                                zlow ? ((const uint *)zp)[0] & 0xffffff : ((const uint *)zp)[0] >> 8;
+            const unsigned ob = z16 ? ((const ushort *)zp)[1] :
+                                zlow ? ((const uint *)zp)[1] & 0xffffff : ((const uint *)zp)[1] >> 8;
+
+            za = zacc >> zsh;
+            zbv = (zacc + (uint32_t)dz) >> zsh;
+            if (ZK == 1) {
+               la = za <= oa;
+               lb = zbv <= ob;
+            } else if (ZK == 2) {
+               la = za == oa;
+               lb = zbv == ob;
+            } else if (ZK == 3) {
+               la = za < oa;
+               lb = zbv < ob;
+            } else {
+               la = test(f->zfunc, za, oa);
+               lb = test(f->zfunc, zbv, ob);
+            }
+            if (!(la | lb))
+               continue;
+         }
+         sa = px_color(L0, L1, NT, K0, K1, u0, v0, u1, v1, CM, cva, tcol);
+         sb = px_color(L0, L1, NT, K0, K1, u0 + du0, v0 + dv0, u1 + du1, v1 + dv1, CM,
+                       vaddq_s32(cva, dcv), tcol);
+         if (afunc != PIPE_FUNC_ALWAYS) {
+            la = la && testf(afunc, (float)vget_lane_u8(sa, 3) * (1.0f / 255.0f), areff);
+            lb = lb && testf(afunc, (float)vget_lane_u8(sb, 3) * (1.0f / 255.0f), areff);
+         }
+         if (ZK && zwrite) {
+            if (z16) {
+               if (la)
+                  ((ushort *)zp)[0] = (ushort)za;
+               if (lb)
+                  ((ushort *)zp)[1] = (ushort)zbv;
+            } else if (zlow) {
+               if (la)
+                  ((uint *)zp)[0] = (((uint *)zp)[0] & 0xff000000u) | za;
+               if (lb)
+                  ((uint *)zp)[1] = (((uint *)zp)[1] & 0xff000000u) | zbv;
+            } else {
+               if (la)
+                  ((uint *)zp)[0] = (((uint *)zp)[0] & 0xffu) | (za << 8);
+               if (lb)
+                  ((uint *)zp)[1] = (((uint *)zp)[1] & 0xffu) | (zbv << 8);
+            }
+         }
+         {
+            /* both pixels in one register: a in the low half, b in the high */
+            uint8x8_t s2 = vreinterpret_u8_u32(vzip_u32(vreinterpret_u32_u8(sa),
+                                                        vreinterpret_u32_u8(sb)).val[0]);
+            if (fog)
+               s2 = n_fog(s2, fogv, fogv + fogd, fogc);
+            if (BK != BLEND_NONE) {
+               uint8x8_t d2 = vreinterpret_u8_u32(vld1_u32((const uint32_t *)cp));
+
+               if (cpack == CPACK_BGRA)
+                  d2 = vtbl1_u8(d2, vld1_u8(bgra2));
+               if (BK == BLEND_MODULATE) {
+                  s2 = n_mod(s2, d2);
+               } else if (BK == BLEND_ALPHA) {
+                  static const uint8_t alpha_idx[8] = { 3, 3, 3, 3, 7, 7, 7, 7 };
+                  const uint8x8_t a = vtbl1_u8(s2, vld1_u8(alpha_idx));
+
+                  s2 = n_div255(vmlal_u8(vmull_u8(s2, a), d2, vmvn_u8(a)));
+               } else if (BK == BLEND_MODADD) {
+                  s2 = vqadd_u8(n_mod(s2, d2), d2);
+               } else if (BK == BLEND_ALPHAADD) {
+                  static const uint8_t alpha_idx[8] = { 3, 3, 3, 3, 7, 7, 7, 7 };
+
+                  s2 = vqadd_u8(n_mod(s2, vtbl1_u8(s2, vld1_u8(alpha_idx))), d2);
+               } else {
+                  s2 = vqadd_u8(s2, d2);
+               }
+            }
+            if (cpack == CPACK_BGRA)
+               s2 = vtbl1_u8(s2, vld1_u8(bgra2));
+            if (la && lb) {
+               vst1_u32((uint32_t *)cp, vreinterpret_u32_u8(s2));
+            } else if (la) {
+               vst1_lane_u32((uint32_t *)cp, vreinterpret_u32_u8(s2), 0);
+            } else if (lb) {
+               vst1_lane_u32((uint32_t *)cp + 1, vreinterpret_u32_u8(s2), 1);
+            }
+         }
+      }
+   vst1q_s32(c, cva);
+   ps->cp = cp;
+   ps->zp = zp;
+   ps->zacc = zacc;
+   ps->u0 = u0;
+   ps->v0 = v0;
+   ps->u1 = u1;
+   ps->v1 = v1;
+   ps->x = x;
+   ps->fogv = fogv;
+}
+#endif
+
+/* the Q planes of units 0 and 1 are the same */
+static inline boolean
+same_q(const struct sp_fast *f, const struct tgsi_interp_coef *coef, const struct tgsi_interp_coef *pos)
+{
+   const struct sp_fast_unit *a = &f->u[0], *b = &f->u[1];
+   const float *qa0, *qa1, *qa2, *qb0, *qb1, *qb2;
+
+   if (a->txp != b->txp || a->interp != b->interp)
+      return FALSE;
+   if (!a->txp)
+      return a->interp == SP_INTERP_PERSPECTIVE;    /* both 1/w */
+   qa0 = &coef[a->in].a0[a->coord_chan[2]]; qa1 = &coef[a->in].dadx[a->coord_chan[2]];
+   qa2 = &coef[a->in].dady[a->coord_chan[2]];
+   qb0 = &coef[b->in].a0[b->coord_chan[2]]; qb1 = &coef[b->in].dadx[b->coord_chan[2]];
+   qb2 = &coef[b->in].dady[b->coord_chan[2]];
+   (void)pos;
+   return *qa0 == *qb0 && *qa1 == *qb1 && *qa2 == *qb2;
+}
+
+/* the start of a span from the affine planes: wrapped (repeat) or kept in
+   range (clamp) */
+static inline __attribute__((always_inline)) void
+aff_setup(const struct sp_fast_unit *un, int dx, int dy, int *level, int *linear,
+          int32_t *u, int32_t *v, int32_t *du, int32_t *dv)
+{
+   const struct sp_fast_tex *t = &un->tex;
+   const int32_t wl = t->w[un->aff_level] << 16, hl = t->h[un->aff_level] << 16;
+
+   *level = un->aff_level;
+   *linear = un->aff_linear;
+   if (t->clamp_s) {
+      const int64_t U = (int64_t)un->UO + (int64_t)un->UDX * dx + (int64_t)un->UDY * dy;
+
+      *u = (int32_t)(U < -4 * (int64_t)wl ? -4 * (int64_t)wl : U > 4 * (int64_t)wl ? 4 * (int64_t)wl : U);
+   } else {
+      *u = (int32_t)(((uint32_t)un->UO + (uint32_t)un->UDX * (uint32_t)dx +
+                      (uint32_t)un->UDY * (uint32_t)dy) & (uint32_t)(wl - 1));
+   }
+   if (t->clamp_t) {
+      const int64_t V = (int64_t)un->VO + (int64_t)un->VDX * dx + (int64_t)un->VDY * dy;
+
+      *v = (int32_t)(V < -4 * (int64_t)hl ? -4 * (int64_t)hl : V > 4 * (int64_t)hl ? 4 * (int64_t)hl : V);
+   } else {
+      *v = (int32_t)(((uint32_t)un->VO + (uint32_t)un->VDX * (uint32_t)dx +
+                      (uint32_t)un->VDY * (uint32_t)dy) & (uint32_t)(hl - 1));
+   }
+   *du = un->UDX;
+   *dv = un->VDX;
+}
+
+/*
+ * The span, compiled per depth test (ZK: 0 none, 1-3 Z16 with LEQUAL,
+ * EQUAL, LESS, 4 any), texture units (NT) and blend (BK, BLEND_x): the
+ * per-pixel choices become constants.
+ */
+static inline __attribute__((always_inline)) void
+span_tmpl(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+          const struct tgsi_interp_coef *pos, int y, int x0, int x1,
+          const int ZK, const int NT, const int BK, const int NEON)
+{
+   const struct sp_fast_tex *t0 = &f->u[0].tex, *t1 = &f->u[1].tex;
+   const float fy = (float)y;
+   const struct tgsi_interp_coef *cc = f->col_in >= 0 && !f->tri_const ? &coef[f->col_in] : NULL;
+   const struct tgsi_interp_coef *tc0 = NT >= 1 ? &coef[f->u[0].in] : NULL;
+   const struct tgsi_interp_coef *tc1 = NT >= 2 ? &coef[f->u[1].in] : NULL;
+   const int zb = f->zformat ? zbytes(f->zformat) : 0;
+   const int cbpp = f->cbpp;
+   const int z16 = (ZK >= 1 && ZK <= 3) || f->zformat == PIPE_FORMAT_Z16_UNORM;
+   const int zlow = f->zformat == PIPE_FORMAT_Z24X8_UNORM || f->zformat == PIPE_FORMAT_Z24_UNORM_S8_UINT;
+   ubyte *cp = f->cbuf + (unsigned)y * f->cstride + (unsigned)x0 * cbpp;
+   ubyte *zp = ZK ? f->zbuf + (unsigned)y * f->zstride + (unsigned)x0 * zb : NULL;
+   uint32_t zacc = 0;
+   int32_t dz = 0;
+   int zsh = 0, zfloat = 0, x;
+   int level0 = 0, linear0 = 0, level1 = 0, linear1 = 0;
+   int32_t u0 = 0, v0 = 0, du0 = 0, dv0 = 0, u1 = 0, v1 = 0, du1 = 0, dv1 = 0;
+   int32_t c[4] = { 0, 0, 0, 0 }, dc[4] = { 0, 0, 0, 0 };
+   /* what the pixels read, in locals (see struct texl) */
+   const int zwrite = f->zwrite, afunc = f->afunc, cpack = f->cpack;
+   const float areff = f->areff;
+   const uint32_t tri_col = f->tri_col;
+#ifdef __ARM_NEON
+   struct texl L0, L1;
+#endif
+   /* both units divide by the same Q (texture q 1.0 on both, as GL1 games
+      send them): one division for the two */
+   const boolean share = NT >= 2 && f->share_q;
+   const int32_t fogd = f->fog_kind ? f->FDX : 0;
+   int32_t fogv = f->fog_kind ? f->FO + f->FDX * (x0 - f->ox) + f->FDY * (y - f->oy) : 0;
+
+   if (zp) {
+      const int fb = zfrac_bits(f->zformat);
+      const int64_t z0 = (int64_t)f->ZO + (int64_t)f->ZDX * (x0 - f->ox) + (int64_t)f->ZDY * (y - f->oy);
+      const int64_t zl = z0 + (int64_t)f->ZDX * (x1 - x0 - 1), top = (int64_t)(z16 ? 65535 : 16777215) << fb;
+
+      /* stepping off the ends of the range: Z per pixel in float, clamped */
+      zfloat = !f->zplane || z0 < 0 || z0 > top || zl < 0 || zl > top;
+      zacc = (uint32_t)z0;
+      dz = f->ZDX;
+      zsh = fb;
+   }
+
+   if (NT == 0 && BK == BLEND_NONE && zp && z16 && !zfloat && f->zonly) {
+      /* a depth pass: nothing but the test and the Z store */
+      const boolean zw = f->zwrite;
+
+      for (x = x0; x < x1; x++, zacc += (uint32_t)dz, zp += 2) {
+         const unsigned z = zacc >> zsh, old = *(const ushort *)zp;
+
+         if ((ZK == 1 ? z <= old : ZK == 2 ? z == old : ZK == 3 ? z < old : test(f->zfunc, z, old)) && zw)
+            *(ushort *)zp = (ushort)z;
+      }
+      return;
+   }
+
+   for (x = x0; x < x1; ) {
+      int end;
+
+      if (f->tri_affine) {
+         /* small and nearly flat: the planes, in integers */
+         end = x1;
+         const int ax = x0 - f->ox, ay = y - f->oy;
+
+         if (NT >= 1)
+            aff_setup(&f->u[0], ax, ay, &level0, &linear0, &u0, &v0, &du0, &dv0);
+         if (NT >= 2)
+            aff_setup(&f->u[1], ax, ay, &level1, &linear1, &u1, &v1, &du1, &dv1);
+         if (cc) {
+            int i;
+
+            for (i = 0; i < 4; i++) {
+               c[i] = f->CO[i] + f->CDX[i] * ax + f->CDY[i] * ay;
+               dc[i] = f->CDX[i];
+            }
+         }
+      } else {
+         const boolean pick = x == x0 && !f->tri_level;
+
+         SPF_PROF_BEGIN(ts);
+         end = MIN2(x1, x + f->seg);
+         if (x == x0 && f->tri_level) {
+            level0 = f->u[0].aff_level;
+            linear0 = f->u[0].aff_linear;
+            level1 = f->u[1].aff_level;
+            linear1 = f->u[1].aff_linear;
+         }
+         float rq = 0.0f;
+
+#ifdef __ARM_NEON
+         if (NEON && share && !pick) {
+            int32x4_t uv, duv;
+
+            tex_setup2(f, (float)x, fy, (float)(end - x), level0, linear0, level1, linear1, &uv, &duv);
+            u0 = vgetq_lane_s32(uv, 0);
+            v0 = vgetq_lane_s32(uv, 1);
+            u1 = vgetq_lane_s32(uv, 2);
+            v1 = vgetq_lane_s32(uv, 3);
+            du0 = vgetq_lane_s32(duv, 0);
+            dv0 = vgetq_lane_s32(duv, 1);
+            du1 = vgetq_lane_s32(duv, 2);
+            dv1 = vgetq_lane_s32(duv, 3);
+         } else
+#endif
+         {
+            if (tc0)
+               tex_setup(&f->u[0], tc0, pos, (float)x, fy, &level0, &linear0, &u0, &v0, &du0, &dv0, pick,
+                         share ? &rq : NULL, (float)(end - x));
+            if (tc1)
+               tex_setup(&f->u[1], tc1, pos, (float)x, fy, &level1, &linear1, &u1, &v1, &du1, &dv1, pick,
+                         share ? &rq : NULL, (float)(end - x));
+         }
+         if (cc)
+            col_setup(f, cc, pos, (float)x, fy, c, dc);
+         SPF_PROF_END(12, ts);
+         SPF_PROF_ADD(13, 1);
+      }
+
+#ifdef __ARM_NEON
+      if (NEON) {
+         if (NT >= 1)
+            texl_set(&L0, t0, level0, linear0);
+         if (NT >= 2)
+            texl_set(&L1, t1, level1, linear1);
+      }
+#endif
+#ifdef __ARM_NEON
+      /* two pixels a turn (pair_run()) */
+      if (NEON && !zfloat && x + 1 < end && f->pairs) {
+         struct pstate ps = { cp, zp, zacc, u0, v0, u1, v1, x, fogv };
+
+         SPF_PROF_ADD(8, (end - x) & ~1);       /* pixels two a turn */
+         const int cm = cc ? CM_INTERP : tri_col == 0xffffffffu ? CM_WHITE : CM_CONST;
+#define PAIRS(K0, K1, CM) pair_run(f, &ps, end, dz, zsh, du0, dv0, du1, dv1, c, dc, &L0, &L1, \
+                                   z16, zlow, zb, ZK, NT, BK, K0, K1, CM)
+#define PAIRS_CM(K0, K1) do { \
+            if (cm == CM_WHITE) PAIRS(K0, K1, CM_WHITE); \
+            else if (cm == CM_CONST) PAIRS(K0, K1, CM_CONST); \
+            else PAIRS(K0, K1, CM_INTERP); \
+         } while (0)
+
+         /* the common cases compiled each: Z16 with a fixed test, no
+            generic blend */
+         if (ZK >= 1 && ZK <= 3 && NT >= 1) {
+            const int n = end - x;
+            const int k0 = tex_kind(&L0, u0, v0, du0, dv0, n);
+            const int k1 = NT >= 2 ? tex_kind(&L1, u1, v1, du1, dv1, n) : TK_DIRECT;
+
+            if (k0 == TK_DIRECT && k1 == TK_DIRECT) {
+               SPF_PROF_ADD(15, n & ~1);
+               PAIRS_CM(TK_DIRECT, TK_DIRECT);
+            }
+            else if (NT >= 2 && k0 == TK_DIRECT)
+               PAIRS_CM(TK_DIRECT, TK_ANY);
+            else if (NT >= 2 && k1 == TK_DIRECT)
+               PAIRS_CM(TK_ANY, TK_DIRECT);
+            else
+               PAIRS_CM(TK_ANY, TK_ANY);
+         } else {
+            PAIRS(TK_ANY, TK_ANY, cc ? CM_INTERP : CM_CONST);
+         }
+#undef PAIRS_CM
+#undef PAIRS
+         cp = ps.cp;
+         zp = ps.zp;
+         zacc = ps.zacc;
+         u0 = ps.u0;
+         v0 = ps.v0;
+         u1 = ps.u1;
+         v1 = ps.v1;
+         x = ps.x;
+         fogv = ps.fogv;
+      }
+#endif
+      for (; x < end; x++, cp += cbpp, zp += zb, zacc += (uint32_t)dz, u0 += du0, v0 += dv0,
+           u1 += du1, v1 += dv1, c[0] += dc[0], c[1] += dc[1], c[2] += dc[2], c[3] += dc[3],
+           fogv += fogd) {
+         unsigned z = 0;
+         uint32_t src, tv0 = 0xffffffffu, tv1 = 0xffffffffu, cv = f->tri_col;
+
+         if (zp) {
+            unsigned old;
+
+            if (zfloat) {
+               float zf = pos->a0[2] + pos->dadx[2] * (float)x + pos->dady[2] * fy;
+
+               zf = CLAMP(zf, 0.0f, 1.0f);
+               z = (unsigned)(zf * (z16 ? 65535.0f : 16777215.0f));
+            } else {
+               z = zacc >> zsh;
+            }
+            old = z16 ? *(const ushort *)zp :
+                  zlow ? *(const uint *)zp & 0xffffff : *(const uint *)zp >> 8;
+            if (ZK == 1 ? !(z <= old) : ZK == 2 ? z != old : ZK == 3 ? !(z < old) :
+                !test(f->zfunc, z, old))
+               continue;
+         }
+#ifdef __ARM_NEON
+         if (NEON) {
+            /* f->mixed is off, the pixels are RGBA or BGRA, BK is not BLEND_GENERIC */
+            static const uint8_t bgra[8] = { 2, 1, 0, 3, 6, 5, 4, 7 };
+            uint8x8_t s8 = n_word(tri_col), d8;
+            boolean white = !cc && tri_col == 0xffffffffu;
+
+            if (NT >= 1) {
+               const uint8x8_t t8 = fetch_l(&L0, u0, v0);
+
+               s8 = white ? t8 : n_mod(t8, s8);
+               white = FALSE;
+            }
+            if (NT >= 2)
+               s8 = n_mod(s8, fetch_l(&L1, u1, v1));
+            if (cc) {
+               const uint8x8_t c8 = vqmovn_u16(vcombine_u16(vqshrun_n_s32(vld1q_s32(c), 16),
+                                                            vdup_n_u16(0)));
+
+               s8 = NT ? n_mod(s8, c8) : c8;
+            }
+            if (afunc != PIPE_FUNC_ALWAYS &&
+                !testf(afunc, (float)vget_lane_u8(s8, 3) * (1.0f / 255.0f), areff))
+               continue;
+            if (zp && zwrite) {
+               if (z16)
+                  *(ushort *)zp = (ushort)z;
+               else if (zlow)
+                  *(uint *)zp = (*(uint *)zp & 0xff000000u) | z;
+               else
+                  *(uint *)zp = (*(uint *)zp & 0xffu) | (z << 8);
+            }
+            if (f->fog_kind)
+               s8 = n_fog(s8, fogv, fogv, n_word(f->fog_rgba));
+            if (BK != BLEND_NONE) {
+               d8 = vreinterpret_u8_u32(vld1_dup_u32((const uint32_t *)cp));
+               if (cpack == CPACK_BGRA)
+                  d8 = vtbl1_u8(d8, vld1_u8(bgra));
+               if (BK == BLEND_MODULATE) {
+                  s8 = n_mod(s8, d8);
+               } else if (BK == BLEND_ALPHA) {
+                  const uint8x8_t a = vdup_lane_u8(s8, 3);
+
+                  s8 = n_div255(vmlal_u8(vmull_u8(s8, a), d8, vmvn_u8(a)));
+               } else if (BK == BLEND_MODADD) {
+                  s8 = vqadd_u8(n_mod(s8, d8), d8);
+               } else if (BK == BLEND_ALPHAADD) {
+                  s8 = vqadd_u8(n_mod(s8, vdup_lane_u8(s8, 3)), d8);
+               } else {
+                  s8 = vqadd_u8(s8, d8);
+               }
+            }
+            if (cpack == CPACK_BGRA)
+               s8 = vtbl1_u8(s8, vld1_u8(bgra));
+            vst1_lane_u32((uint32_t *)cp, vreinterpret_u32_u8(s8), 0);
+            continue;
+         }
+#endif
+         if (tc0)
+            tv0 = fetch_fast(t0, level0, linear0, u0, v0);
+         if (tc1)
+            tv1 = fetch_fast(t1, level1, linear1, u1, v1);
+         if (cc)
+            cv = pack(col8(c[0]), col8(c[1]), col8(c[2]), col8(c[3]));
+
+         if (f->mixed) {
+            src = combine_mixed(f, cv, tv0, tv1);
+         } else {
+            src = tv1 == 0xffffffffu ? tv0 : tv0 == 0xffffffffu ? tv1 : mod4(tv0, tv1);
+            if (cv != 0xffffffffu)
+               src = src == 0xffffffffu ? cv : mod4(src, cv);
+         }
+
+         if (f->afunc != PIPE_FUNC_ALWAYS &&
+             !testf(f->afunc, (float)A(src) * (1.0f / 255.0f), f->areff))
+            continue;
+
+         if (zp && f->zwrite) {
+            if (z16)
+               *(ushort *)zp = (ushort)z;
+            else if (zlow)
+               *(uint *)zp = (*(uint *)zp & 0xff000000u) | z;
+            else
+               *(uint *)zp = (*(uint *)zp & 0xffu) | (z << 8);
+         }
+
+         if (f->fog_kind) {
+            const unsigned w = fog8(fogv), iw = 255 - w;
+
+            src = pack(mul255(R(src), w) + mul255(R(f->fog_rgba), iw),
+                       mul255(G(src), w) + mul255(G(f->fog_rgba), iw),
+                       mul255(B(src), w) + mul255(B(f->fog_rgba), iw), A(src));
+         }
+
+         switch (BK) {
+         case BLEND_NONE:
+            break;
+         case BLEND_MODULATE:
+            src = mod4(src, load_pixel(f, cp));
+            break;
+         case BLEND_ALPHA: {
+            const unsigned a = A(src);
+
+            src = lerp4(load_pixel(f, cp), src, a + (a >> 7));
+            break;
+         }
+         case BLEND_ADD: {
+            const uint32_t d = load_pixel(f, cp);
+
+            src = pack(MIN2(R(src) + R(d), 255), MIN2(G(src) + G(d), 255),
+                       MIN2(B(src) + B(d), 255), MIN2(A(src) + A(d), 255));
+            break;
+         }
+         case BLEND_MODADD: {
+            const uint32_t d = load_pixel(f, cp);
+
+            src = pack(MIN2(mul255(R(src), R(d)) + R(d), 255), MIN2(mul255(G(src), G(d)) + G(d), 255),
+                       MIN2(mul255(B(src), B(d)) + B(d), 255), MIN2(mul255(A(src), A(d)) + A(d), 255));
+            break;
+         }
+         case BLEND_ALPHAADD: {
+            const uint32_t d = load_pixel(f, cp);
+            const unsigned a = A(src);
+
+            src = pack(MIN2(mul255(R(src), a) + R(d), 255), MIN2(mul255(G(src), a) + G(d), 255),
+                       MIN2(mul255(B(src), a) + B(d), 255), MIN2(mul255(a, a) + A(d), 255));
+            break;
+         }
+         default:
+            src = blend_generic(f, src, load_pixel(f, cp));
+         }
+         store_pixel(f, cp, src);
+      }
+   }
+}
+
+#define SPAN_ARGS const struct sp_fast *f, const struct tgsi_interp_coef *coef, \
+                  const struct tgsi_interp_coef *pos, int y, int x0, int x1
+#define SPAN_FN(Z, N, B) \
+   static void span_##Z##_##N##_##B(SPAN_ARGS) { span_tmpl(f, coef, pos, y, x0, x1, Z, N, B, 0); } \
+   static void nspan_##Z##_##N##_##B(SPAN_ARGS) { span_tmpl(f, coef, pos, y, x0, x1, Z, N, B, B != BLEND_GENERIC); }
+#define SPAN_B(Z, N) SPAN_FN(Z, N, 0) SPAN_FN(Z, N, 1) SPAN_FN(Z, N, 2) SPAN_FN(Z, N, 3) SPAN_FN(Z, N, 4) \
+                     SPAN_FN(Z, N, 5) SPAN_FN(Z, N, 6)
+#define SPAN_N(Z) SPAN_B(Z, 0) SPAN_B(Z, 1) SPAN_B(Z, 2)
+SPAN_N(0) SPAN_N(1) SPAN_N(2) SPAN_N(3) SPAN_N(4)
+
+#define TAB_B(Z, N) { span_##Z##_##N##_0, span_##Z##_##N##_1, span_##Z##_##N##_2, \
+                      span_##Z##_##N##_3, span_##Z##_##N##_4, span_##Z##_##N##_5, span_##Z##_##N##_6 }
+#define TAB_N(Z) { TAB_B(Z, 0), TAB_B(Z, 1), TAB_B(Z, 2) }
+static void (*const span_tab[5][3][7])(SPAN_ARGS) = {
+   TAB_N(0), TAB_N(1), TAB_N(2), TAB_N(3), TAB_N(4)
+};
+#define NTAB_B(Z, N) { nspan_##Z##_##N##_0, nspan_##Z##_##N##_1, nspan_##Z##_##N##_2, \
+                       nspan_##Z##_##N##_3, nspan_##Z##_##N##_4, nspan_##Z##_##N##_5, nspan_##Z##_##N##_6 }
+#define NTAB_N(Z) { NTAB_B(Z, 0), NTAB_B(Z, 1), NTAB_B(Z, 2) }
+static void (*const nspan_tab[5][3][7])(SPAN_ARGS) = {
+   NTAB_N(0), NTAB_N(1), NTAB_N(2), NTAB_N(3), NTAB_N(4)
+};
+
+void
+sp_fast_span(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+             const struct tgsi_interp_coef *pos, int y, int x0, int x1)
+{
+   SPF_PROF_BEGIN(t0);
+#ifdef __z3660core__
+   /* event counter reads cost ~19 cycles each: only when asked */
+   const uint32_t e0 = sp_fast_evt_on ? sp_fast_evt(0) : 0, e1 = sp_fast_evt_on ? sp_fast_evt(1) : 0;
+#endif
+   if (f->fixed)
+      f->span(f, coef, pos, y, x0, x1);
+   else
+      fast_span(f, coef, pos, y, x0, x1);
+   SPF_PROF_END(1, t0);
+#ifdef __z3660core__
+   if (sp_fast_evt_on) {
+      sp_fast_prof[8] += sp_fast_evt(0) - e0;
+      sp_fast_prof[14] += sp_fast_evt(1) - e1;
+   }
+   /* pixels by path: 9 affine NEON, 10 perspective NEON, 11 the rest */
+   sp_fast_prof[!f->fixed || !f->neon_span ? 11 : f->tri_affine ? 9 : 10] += x1 - x0;
+#endif
+   SPF_PROF_ADD(4, 1);
+   SPF_PROF_ADD(5, x1 - x0);
+}
+
+static void
+fast_span(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+          const struct tgsi_interp_coef *pos, int y, int x0, int x1)
+{
+   const struct sp_fast_tex *t = &f->u[0].tex;
+   const float fy = (float)y, fyq = (float)(y & ~1);
+   const float dzdx = pos->dadx[2], dzrow = (y & 1) ? pos->dady[2] : 0.0f;
+   const struct tgsi_interp_coef *cc = f->col_in >= 0 && !f->tri_const ? &coef[f->col_in] : NULL;
+   const struct tgsi_interp_coef *tc = f->u[0].in >= 0 ? &coef[f->u[0].in] : NULL;
+   const boolean col_persp = cc && f->col_interp == SP_INTERP_PERSPECTIVE;
+   const boolean tex_oow = tc && !f->u[0].txp && f->u[0].interp == SP_INTERP_PERSPECTIVE;
+   const int cs = f->u[0].coord_chan[0], ct = f->u[0].coord_chan[1], cq = f->u[0].coord_chan[2];
+   const int zb = f->zformat ? zbytes(f->zformat) : 0;
+   const int cbpp = f->cbpp;
+   ubyte *cp = f->cbuf + (unsigned)y * f->cstride + (unsigned)x0 * cbpp;
+   ubyte *zp = f->zformat ? f->zbuf + (unsigned)y * f->zstride + (unsigned)x0 * zb : NULL;
+   /* the planes at the start of the span, stepped per pixel */
+   const float fx0 = (float)x0;
+   float S = 0.0f, T = 0.0f, Q = 1.0f, oow = 1.0f;
+   float dSdx = 0.0f, dTdx = 0.0f, dQdx = 0.0f, dQdy = 0.0f;
+   int x;
+
+   if (tc) {
+      S = tc->a0[cs] + tc->dadx[cs] * fx0 + tc->dady[cs] * fy;
+      T = tc->a0[ct] + tc->dadx[ct] * fx0 + tc->dady[ct] * fy;
+      dSdx = tc->dadx[cs];
+      dTdx = tc->dadx[ct];
+      if (f->u[0].txp) {
+         Q = tc->a0[cq] + tc->dadx[cq] * fx0 + tc->dady[cq] * fy;
+         dQdx = tc->dadx[cq];
+         dQdy = tc->dady[cq];
+      } else if (tex_oow) {
+         dQdx = pos->dadx[3];
+         dQdy = pos->dady[3];
+      }
+   }
+   if (tex_oow || col_persp)
+      oow = pos->a0[3] + pos->dadx[3] * fx0 + pos->dady[3] * fy;
+
+   for (x = x0; x < x1; x++, cp += cbpp, zp += zb,
+        S += dSdx, T += dTdx, Q += f->u[0].txp ? dQdx : 0.0f, oow += pos->dadx[3]) {
+      unsigned z = 0;
+      uint32_t src, tv = 0xffffffffu, cv = f->tri_col;
+
+      /* depth test: softpipe's per-quad Z (see interpolate_quad_depth) */
+      if (zp) {
+         float zf = pos->a0[2] + dzdx * (float)(x & ~1) + pos->dady[2] * fyq;
+
+         if (x & 1)
+            zf += dzdx;
+         zf += dzrow;
+         if (f->zclamp)
+            zf = CLAMP(zf, f->zmin, f->zmax);
+         z = zvalue(f->zformat, zf);
+         if (f->zformat == PIPE_FORMAT_Z16_UNORM) {
+            const unsigned old = *(const ushort *)zp;
+
+            switch (f->zfunc) {
+            case PIPE_FUNC_LESS: if (!(z < old)) continue; break;
+            case PIPE_FUNC_LEQUAL: if (!(z <= old)) continue; break;
+            case PIPE_FUNC_EQUAL: if (z != old) continue; break;
+            default: if (!test(f->zfunc, z, old)) continue;
+            }
+         } else if (!test(f->zfunc, z, zread(f->zformat, zp))) {
+            continue;
+         }
+      }
+
+      if (tc) {
+         const float q = tex_oow ? oow : Q;
+         const float rq = 1.0f / q;
+         const float s = S * rq, tt = T * rq;
+         float lambda = 0.0f;
+
+         if (t->need_lambda) {
+            const float fx = (float)x;
+            const float dsdx = fabsf((dSdx - s * dQdx) * rq);
+            const float dsdy = fabsf((tc->dady[cs] - s * dQdy) * rq);
+            const float dtdx = fabsf((dTdx - tt * dQdx) * rq);
+            const float dtdy = fabsf((tc->dady[ct] - tt * dQdy) * rq);
+            const float rs = MAX2(dsdx, dsdy) * (float)t->w[t->first];
+            const float rt = MAX2(dtdx, dtdy) * (float)t->h[t->first];
+
+            (void)fx;
+            lambda = util_fast_log2(MAX2(rs, rt)) + t->lod_bias;
+            lambda = CLAMP(lambda, t->min_lod, t->max_lod);
+         }
+         tv = tex_sample(t, s, tt, lambda) | t->amask;
+      }
+
+      if (cc) {
+         const float fx = (float)x;
+         const float w = col_persp ? 1.0f / oow : 1.0f;
+         unsigned c8[4] = { 255, 255, 255, 255 };
+         int c;
+
+         for (c = 0; c < 4; c++) {
+            const int ch = f->col_chan[c];
+
+            if (ch >= 0)
+               c8[c] = to8((cc->a0[ch] + cc->dadx[ch] * fx + cc->dady[ch] * fy) * w);
+         }
+         cv = pack(c8[0], c8[1], c8[2], c8[3]);
+      }
+
+      if (f->mixed)
+         src = combine_mixed(f, cv, tv, 0xffffffffu);
+      else if (!tc)
+         src = cv;
+      else
+         src = cv == 0xffffffffu ? tv : mod4(tv, cv);
+
+      if (f->afunc != PIPE_FUNC_ALWAYS &&
+          !testf(f->afunc, (float)A(src) * (1.0f / 255.0f), f->areff))
+         continue;
+
+      if (zp && f->zwrite) {
+         if (f->zformat == PIPE_FORMAT_Z16_UNORM)
+            *(ushort *)zp = (ushort)z;
+         else
+            zwrite(f->zformat, zp, z);
+      }
+
+      switch (f->blend_kind) {
+      case BLEND_NONE:
+         break;
+      case BLEND_MODULATE:
+         src = mod4(src, load_pixel(f, cp));
+         break;
+      case BLEND_ALPHA: {
+         const unsigned a = A(src);
+
+         src = lerp4(load_pixel(f, cp), src, a + (a >> 7));
+         break;
+      }
+      case BLEND_ADD: {
+         const uint32_t d = load_pixel(f, cp);
+
+         src = pack(MIN2(R(src) + R(d), 255), MIN2(G(src) + G(d), 255),
+                    MIN2(B(src) + B(d), 255), MIN2(A(src) + A(d), 255));
+         break;
+      }
+      default:
+         src = blend_generic(f, src, load_pixel(f, cp));
+      }
+      store_pixel(f, cp, src);
+   }
+}
+
+
+static void
+choose_span(struct sp_fast *f)
+{
+   const int z16 = f->zformat == PIPE_FORMAT_Z16_UNORM;
+   const int zk = !f->zformat ? 0 : z16 && f->zfunc == PIPE_FUNC_LEQUAL ? 1 :
+                  z16 && f->zfunc == PIPE_FUNC_EQUAL ? 2 : z16 && f->zfunc == PIPE_FUNC_LESS ? 3 : 4;
+   const int nt = (f->u[0].in >= 0) + (f->u[1].in >= 0);
+
+   /* NEON for RGBA/BGRA pixels without channel mixing (and SOFTPIPE_FAST_NONEON
+      not set); on the PC the two tables are the same code */
+   const boolean neon = !f->mixed && (f->cpack == CPACK_RGBA || f->cpack == CPACK_BGRA) &&
+                        f->neon_ok;
+
+   f->span = (neon ? nspan_tab : span_tab)[zk][nt][f->blend_kind];
+   f->neon_span = (neon && f->blend_kind != BLEND_GENERIC) || f->zonly;
+   if (debug_get_bool_option("SOFTPIPE_FAST_WHY", FALSE) && !f->neon_span) {
+      /* why not NEON: one line per kind */
+      static unsigned seen[64];
+      const unsigned k = (f->mixed ? 1 : 0) | (f->cpack == CPACK_OTHER ? 2 : 0) |
+                         (!f->neon_ok ? 4 : 0) | (f->blend_kind == BLEND_GENERIC ? 8 : 0) |
+                         (f->blend_kind << 4 & 0x30);
+
+      if (!seen[k]++)
+         fprintf(stderr, "sp_fast: not NEON: mixed %d cpack %d neon_ok %d blend %d (%d %d %d %d) "
+                 "col_chan %d %d %d %d u0 %d %d %d %d u1 %d %d %d %d\n", f->mixed, f->cpack, f->neon_ok,
+                 f->blend_kind, f->rgb_src, f->rgb_dst, f->a_src, f->a_dst,
+                 f->col_chan[0], f->col_chan[1], f->col_chan[2], f->col_chan[3],
+                 f->u[0].chan[0], f->u[0].chan[1], f->u[0].chan[2], f->u[0].chan[3],
+                 f->u[1].chan[0], f->u[1].chan[1], f->u[1].chan[2], f->u[1].chan[3]);
+   }
+}
+
+
+/* level and filter for a lambda (tex_setup()'s choice) */
+static void
+pick_level(const struct sp_fast_tex *t, float lambda, int *level, int *linear)
+{
+   /* not a number (a degenerate triangle: Q = 0): as no minification */
+   if (!t->need_lambda || !(lambda > 0.0f)) {
+      *level = t->first;
+      *linear = t->mag_linear;
+   } else {
+      *level = t->mip == PIPE_TEX_MIPFILTER_NEAREST ?
+               t->first + (int)(MIN2(lambda, 15.0f) + 0.5f) : t->first;
+      if (*level > t->last)
+         *level = t->last;
+      *linear = t->min_linear;
+   }
+}
+
+/* float to int32, saturating (a native conversion on the A9, unlike to int64) */
+static inline int32_t
+fix32(float v)
+{
+   return v >= 2147483520.0f ? INT32_MAX : v <= -2147483520.0f ? INT32_MIN : (int32_t)v;
+}
+
+void
+sp_fast_tri_planes(struct sp_fast *f, const struct tgsi_interp_coef *coef,
+                   const struct tgsi_interp_coef *pos, int ox, int oy,
+                   const struct tgsi_interp_coef *aff, const struct tgsi_interp_coef *col)
+{
+   const float fx = (float)ox, fy = (float)oy;
+   int k, c;
+
+   /* perspective, but 1/w varies by half at most: the mip level per
+      triangle (at its first corner) and longer segments */
+   f->tri_level = FALSE;
+   f->seg = f->tri_ratio <= 1.15f ? 32 : 16;
+   if (!aff && f->tri_ratio <= 1.5f) {
+      for (k = 0; k < SP_FAST_UNITS; k++) {
+         struct sp_fast_unit *un = &f->u[k];
+         int32_t a, b, d, e;
+
+         if (un->in >= 0)
+            tex_setup(un, &coef[un->in], pos, fx, fy, &un->aff_level, &un->aff_linear,
+                      &a, &b, &d, &e, TRUE, NULL, 0.0f);
+      }
+      f->tri_level = TRUE;
+   }
+
+   f->share_q = FALSE;
+   if (!aff && f->u[0].in >= 0 && f->u[1].in >= 0) {
+      f->share_q = same_q(f, coef, pos);
+      if (f->share_q) {
+         const struct sp_fast_unit *un = &f->u[0];
+         const struct tgsi_interp_coef *qc = un->txp ? &coef[un->in] : pos;
+         const int qch = un->txp ? un->coord_chan[2] : 3;
+
+         for (k = 0; k < 4; k++) {
+            const struct sp_fast_unit *uk = &f->u[k >> 1];
+            const int ch = uk->coord_chan[k & 1];
+
+            f->vq_a0[k] = coef[uk->in].a0[ch];
+            f->vq_dx[k] = coef[uk->in].dadx[ch];
+            f->vq_dy[k] = coef[uk->in].dady[ch];
+            f->vq_clamp[k] = (k & 1 ? uk->tex.clamp_t : uk->tex.clamp_s) ? 0xffffffffu : 0;
+         }
+         if (un->txp || un->interp == SP_INTERP_PERSPECTIVE) {
+            f->vq_q[0] = qc->a0[qch];
+            f->vq_q[1] = qc->dadx[qch];
+            f->vq_q[2] = qc->dady[qch];
+         } else {
+            f->vq_q[0] = 1.0f;
+            f->vq_q[1] = f->vq_q[2] = 0.0f;
+         }
+      }
+   }
+
+   f->ox = ox;
+   f->oy = oy;
+   f->zplane = FALSE;
+   if (f->zformat && zfrac_bits(f->zformat) >= 0) {
+      const float scale = (f->zformat == PIPE_FORMAT_Z16_UNORM ? 65535.0f : 16777215.0f) *
+                          (float)(1 << zfrac_bits(f->zformat));
+      const float z = pos->a0[2] + pos->dadx[2] * fx + pos->dady[2] * fy;
+      const float dx = pos->dadx[2] * scale, dy = pos->dady[2] * scale;
+
+      if (z >= 0.0f && z <= 1.0f && fabsf(dx) < 2.0e9f && fabsf(dy) < 2.0e9f) {
+         f->ZO = (uint32_t)(z * scale);
+         f->ZDX = (int32_t)dx;
+         f->ZDY = (int32_t)dy;
+         f->zplane = TRUE;
+      }
+   }
+   f->tri_affine = aff != NULL;
+   if (!aff)
+      return;
+   for (k = 0; k < SP_FAST_UNITS; k++) {
+      struct sp_fast_unit *un = &f->u[k];
+      const struct sp_fast_tex *t = &un->tex;
+      float w, h, off, so, to;
+
+      if (un->in < 0)
+         continue;
+      if (t->need_lambda) {
+         const float rs = MAX2(fabsf(aff[k].dadx[0]), fabsf(aff[k].dady[0])) * (float)t->w[t->first];
+         const float rt = MAX2(fabsf(aff[k].dadx[1]), fabsf(aff[k].dady[1])) * (float)t->h[t->first];
+         float lambda = util_fast_log2(MAX2(rs, rt)) + t->lod_bias;
+
+         pick_level(t, CLAMP(lambda, t->min_lod, t->max_lod), &un->aff_level, &un->aff_linear);
+      } else {
+         pick_level(t, 0.0f, &un->aff_level, &un->aff_linear);
+      }
+      w = (float)t->w[un->aff_level] * 65536.0f;
+      h = (float)t->h[un->aff_level] * 65536.0f;
+      off = un->aff_linear ? 32768.0f : 0.0f;
+      /* at the origin; repeat: reduced to [0, 1) (the stepping wraps modulo
+         2^32, which the power-of-two mask does not mind); clamp: kept near */
+      so = aff[k].a0[0] + aff[k].dadx[0] * fx + aff[k].dady[0] * fy;
+      to = aff[k].a0[1] + aff[k].dadx[1] * fx + aff[k].dady[1] * fy;
+      so = t->clamp_s ? CLAMP(so, -4.0f, 4.0f) : so - (float)util_ifloor(so);
+      to = t->clamp_t ? CLAMP(to, -4.0f, 4.0f) : to - (float)util_ifloor(to);
+      un->UO = fix32(so * w - off);
+      un->VO = fix32(to * h - off);
+      un->UDX = fix32(CLAMP(aff[k].dadx[0], -1.0f, 1.0f) * w);
+      un->UDY = fix32(CLAMP(aff[k].dady[0], -1.0f, 1.0f) * w);
+      un->VDX = fix32(CLAMP(aff[k].dadx[1], -1.0f, 1.0f) * h);
+      un->VDY = fix32(CLAMP(aff[k].dady[1], -1.0f, 1.0f) * h);
+   }
+   if (col)
+      for (c = 0; c < 4; c++) {
+         const float v = col->a0[c] + col->dadx[c] * fx + col->dady[c] * fy;
+
+         f->CO[c] = fix32(v * (255.0f * 65536.0f)) + 32768;
+         f->CDX[c] = fix32(col->dadx[c] * (255.0f * 65536.0f));
+         f->CDY[c] = fix32(col->dady[c] * (255.0f * 65536.0f));
+      }
+}
diff --git a/src/gallium/drivers/softpipe/sp_fast.h b/src/gallium/drivers/softpipe/sp_fast.h
new file mode 100644
index 0000000..c057774
--- /dev/null
+++ b/src/gallium/drivers/softpipe/sp_fast.h
@@ -0,0 +1,193 @@
+/*
+ * sp_fast.h -- a fixed-function fast path for softpipe's triangles.
+ *
+ * The fragment shaders the GL fixed-function pipeline produces for
+ * colour, texture and texture * colour, with depth test, alpha test and
+ * blending, are drawn span by span straight into the colour and depth
+ * buffers (8-bit channels), without the TGSI interpreter and the quad
+ * pipeline.  Everything else falls back to softpipe.
+ *
+ * SOFTPIPE_NO_FAST=1 turns it off (for comparisons).
+ */
+#ifndef SP_FAST_H
+#define SP_FAST_H
+
+#include "pipe/p_compiler.h"
+#include "tgsi/tgsi_exec.h"
+
+struct softpipe_context;
+struct sp_fragment_shader_variant;
+
+#define SP_FAST_LEVELS 16
+
+/* cycle counts on Z3660 core 1 (glbench and the GPU program read them):
+   0 fast triangles (setup and spans), 1 spans, 2 prepare, 3 draw_vbo,
+   4 spans, 5 pixels, 6 softpipe's own triangles, 7 their cycles */
+#ifdef __z3660core__
+#include <stdint.h>
+extern uint64_t sp_fast_prof[16];
+extern int sp_fast_evt_on;       /* event counters 0 and 1 into sp_fast_prof[8], [14] */
+static inline uint32_t
+sp_fast_ccnt(void)
+{
+   uint32_t v;
+
+   __asm__ volatile("mrc p15, 0, %0, c9, c13, 0" : "=r"(v));
+   return v;
+}
+/* PMU event counters 0 and 1 (set by the core program; the GPU program:
+   0 = L1 data refills): profile 8 and 14 */
+static inline uint32_t
+sp_fast_evt(uint32_t n)
+{
+   uint32_t v;
+
+   __asm__ volatile("mcr p15, 0, %1, c9, c12, 5\n"
+                    "mrc p15, 0, %0, c9, c13, 2" : "=r"(v) : "r"(n));
+   return v;
+}
+#define sp_fast_evt0() sp_fast_evt(0)
+#define SPF_PROF_BEGIN(v) uint32_t v = sp_fast_ccnt()
+#define SPF_PROF_END(i, v) (sp_fast_prof[i] += sp_fast_ccnt() - (v))
+#define SPF_PROF_ADD(i, n) (sp_fast_prof[i] += (n))
+#else
+#define SPF_PROF_BEGIN(v) (void)0
+#define SPF_PROF_END(i, v) (void)0
+#define SPF_PROF_ADD(i, n) (void)0
+#endif
+
+struct sp_fast_tex {
+   const ubyte *data[SP_FAST_LEVELS];
+   unsigned stride[SP_FAST_LEVELS];
+   int w[SP_FAST_LEVELS], h[SP_FAST_LEVELS];
+   float fsize[SP_FAST_LEVELS][2];   /* w, h as floats (tex_setup2()) */
+   int first, last;              /* levels in use */
+   int bpp;                      /* bytes per texel */
+   signed char map[4];           /* r, g, b, a: byte in the texel, -1 = 0, -2 = 255 */
+   int clamp_s, clamp_t;         /* clamp to edge, else repeat */
+   int min_linear, mag_linear;
+   int mip;                      /* PIPE_TEX_MIPFILTER_x */
+   int need_lambda;
+   float lod_bias, min_lod, max_lod;
+   boolean ident;                /* texels are r, g, b, a bytes: load as one word */
+   boolean fast4;                /* r, g, b, a/x bytes: fetch_fast() and fetch_neon() */
+   uint32_t amask;               /* ORed in: 0xff000000 for x (alpha 1.0) */
+};
+
+#define SP_FAST_UNITS 2
+
+/* a texture unit the shader reads */
+struct sp_fast_unit {
+   int in;                       /* coordinate input, -1 = unit not used */
+   int coord_chan[3];            /* s, t, q (TXP) channels of the input */
+   boolean txp;
+   int interp;                   /* SP_INTERP_x of the input */
+   int chan[4];                  /* output channel <- texel channel, -1 = 1.0 */
+   uint32_t ormask;              /* the bytes of channels taken as 1.0 */
+   struct sp_fast_tex tex;
+   /* per triangle, when it is drawn affine (tri_affine): the level, the
+      filter and the 16.16 texel coordinate planes, relative to the
+      triangle's origin (ox, oy): u = UO + UDX (x - ox) + UDY (y - oy) */
+   int aff_level, aff_linear;
+   int32_t UO, VO, UDX, UDY, VDX, VDY;
+};
+
+struct sp_fast {
+   boolean enabled;              /* SOFTPIPE_NO_FAST not set */
+   boolean neon_ok;              /* SOFTPIPE_FAST_NONEON not set */
+   boolean pairs;                /* two pixels a turn (SOFTPIPE_FAST_NOPAIR not set) */
+   boolean on;                   /* this draw goes the fast way */
+   boolean fixed;                /* fixed-point spans (span_tmpl()) */
+   /* the span_tmpl() instance for this draw's depth test, units and blend */
+   void (*span)(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+                const struct tgsi_interp_coef *pos, int y, int x0, int x1);
+   boolean neon_span;            /* f->span is a NEON one (profile) */
+   boolean zonly;                /* no colour written and no texture: depth only */
+
+   /* the fragment shader, analysed once per variant */
+   const struct sp_fragment_shader_variant *fs;
+   boolean fs_ok;
+   int col_in;                   /* colour input, -1 = unused */
+   int col_chan[4];              /* output channel <- input channel, -1 = 1.0 */
+   struct sp_fast_unit u[SP_FAST_UNITS];   /* texture units 0 and 1 */
+   boolean mixed;                /* not plain texel (* colour) per channel */
+   int fog_kind;                 /* FOG_x: the shader ends in fixed-function fog */
+   int fog_in;                   /* the fog coordinate's input */
+   int fog_ka, fog_kb;           /* constants: scale, offset (word in the buffer) */
+   int fog_kc;                   /* constant with the fog colour */
+
+   /* per draw */
+   int col_interp;               /* SP_INTERP_x */
+   boolean col_const;            /* the colour is a constant of the shader (glColor) */
+   uint32_t const_col;           /* then this, for the draw */
+   int fog_slot;                 /* vertex slot of fog_in */
+   float fog_scale, fog_off;
+   uint32_t fog_rgba;            /* the fog colour, alpha 0 */
+
+   ubyte *cbuf;
+   unsigned cstride;
+   int cbpp;
+   signed char cmap[4];          /* byte of r, g, b, a in the pixel, -1 = none */
+   unsigned colormask;
+   int cpack;                    /* CPACK_x: how a pixel is loaded and stored */
+
+   ubyte *zbuf;
+   unsigned zstride;
+   int zformat;                  /* PIPE_FORMAT_x, 0 = no depth test */
+   int zfunc;
+   boolean zwrite;
+   boolean zclamp;
+   float zmin, zmax;
+
+   int afunc;                    /* PIPE_FUNC_ALWAYS = no alpha test */
+   int aref;                     /* 0..255 */
+   float areff;
+
+   boolean blend;
+   int rgb_func, rgb_src, rgb_dst, a_func, a_src, a_dst;
+   int blend_kind;               /* BLEND_x: the common cases */
+
+   /* per triangle */
+   int col_slot;                 /* vertex slot of col_in */
+   boolean tri_const;            /* the colour is the same over the triangle */
+   uint32_t tri_col;             /* then this: r | g << 8 | b << 16 | a << 24 */
+   boolean tri_affine;           /* texture and colour planes, no perspective */
+   float tri_ratio;              /* the largest 1/w over the smallest at the corners */
+   boolean tri_level;            /* perspective with the level chosen per triangle
+                                    (u[].aff_level, aff_linear) */
+   int seg;                      /* perspective: re-anchored every seg pixels */
+   boolean share_q;              /* both units divide by the same Q (same_q()) */
+   /* perspective with share_q, for tex_setup2(): the S, T planes of both
+      units in lanes s0 t0 s1 t1, Q's plane,
+      the lanes that clamp (else repeat) */
+   float vq_a0[4], vq_dx[4], vq_dy[4], vq_q[3];
+   uint32_t vq_clamp[4];
+   int ox, oy;                   /* the planes' origin: a pixel of the triangle */
+   int32_t CO[4], CDX[4], CDY[4];   /* colour planes, 8.16 (0..255) */
+   uint32_t ZO;                  /* Z plane in span_tmpl()'s fixed point */
+   int32_t ZDX, ZDY;
+   int32_t FO, FDX, FDY;         /* fog factor plane, 8.16 (0..255), from (ox, oy) */
+   boolean zplane;               /* the Z plane fits (else Z per pixel in float) */
+};
+
+void sp_fast_init(struct sp_fast *f);
+
+/* validate the state for the next draw: sets and returns f->on */
+boolean sp_fast_prepare(struct sp_fast *f, struct softpipe_context *sp);
+
+/* per triangle, before the planes: is the colour constant (tri_const)? */
+void sp_fast_tri(struct sp_fast *f, const float (*provoke)[4],
+                 const float (*v0)[4], const float (*v1)[4], const float (*v2)[4]);
+
+/* per triangle, after the planes: Z in fixed point; aff (the s, t planes of
+   each unit in channels 0 and 1) and col (the colour's planes) when the
+   triangle is drawn affine, else NULL */
+void sp_fast_tri_planes(struct sp_fast *f, const struct tgsi_interp_coef *coef,
+                        const struct tgsi_interp_coef *pos, int ox, int oy,
+                        const struct tgsi_interp_coef *aff, const struct tgsi_interp_coef *col);
+
+/* draw pixels [x0, x1) of row y */
+void sp_fast_span(const struct sp_fast *f, const struct tgsi_interp_coef *coef,
+                  const struct tgsi_interp_coef *pos, int y, int x0, int x1);
+
+#endif
