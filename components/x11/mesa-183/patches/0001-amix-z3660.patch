+/**
+ * setup_tri_coefficients() for the fast path: only Z, W and the channels
+ * it reads (no colour planes when the colour is constant).
+ */
+static void
+fast_coeff(struct setup_context *setup, int fragSlot, uint chan)
+{
+   const struct sp_setup_info *sinfo = &setup->softpipe->setup_info;
+   const uint vertSlot = sinfo->attrib[fragSlot].src_index;
+   float v[3];
+
+   switch (sinfo->attrib[fragSlot].interp) {
+   case SP_INTERP_CONSTANT:
+      const_coeff(setup, &setup->coef[fragSlot], vertSlot, chan);
+      break;
+   case SP_INTERP_LINEAR:
+      v[0] = setup->vmin[vertSlot][chan];
+      v[1] = setup->vmid[vertSlot][chan];
+      v[2] = setup->vmax[vertSlot][chan];
+      tri_linear_coeff(setup, &setup->coef[fragSlot], chan, v);
+      break;
+   default:
+      v[0] = setup->vmin[vertSlot][chan];
+      v[1] = setup->vmid[vertSlot][chan];
+      v[2] = setup->vmax[vertSlot][chan];
+      tri_persp_coeff(setup, &setup->coef[fragSlot], chan, v);
+   }
+}
+
+static void
+fast_tri_coefficients(struct setup_context *setup, boolean persp)
+{
+   const struct sp_fast *f = &setup->fast;
+   float v[3];
+   int c, u;
+
+   v[0] = setup->vmin[0][2];
+   v[1] = setup->vmid[0][2];
+   v[2] = setup->vmax[0][2];
+   tri_linear_coeff(setup, &setup->posCoef, 2, v);
+   v[0] = setup->vmin[0][3];
+   v[1] = setup->vmid[0][3];
+   v[2] = setup->vmax[0][3];
+   tri_linear_coeff(setup, &setup->posCoef, 3, v);
+
+   /* the texture planes: not when the triangle is drawn affine */
+   for (u = 0; u < SP_FAST_UNITS && persp; u++)
+      if (f->u[u].in >= 0)
+         for (c = 0; c < (f->u[u].txp ? 3 : 2); c++)
+            fast_coeff(setup, f->u[u].in, f->u[u].coord_chan[c]);
+   if (f->col_in >= 0 && !f->tri_const && persp)
+      for (c = 0; c < 4; c++)
+         if (f->col_chan[c] >= 0)
+            fast_coeff(setup, f->col_in, f->col_chan[c]);
+}
+
+
+/**
+ * Affine planes for a small, nearly flat triangle (1/w within 3 % over its
+ * corners, or the attributes not perspective): s and t of each texture unit
+ * (s/q, t/q for TXP) and the colour, linear in x and y from the corners.
+ * The fast path then needs no division per span.
+ */
+static boolean
+fast_affine_planes(struct setup_context *setup, struct tgsi_interp_coef aff[SP_FAST_UNITS],
+                   struct tgsi_interp_coef *col, float *ratio)
+{
+   const struct sp_fast *f = &setup->fast;
+   const struct sp_setup_info *sinfo = &setup->softpipe->setup_info;
+   const float (*vx[3])[4] = { setup->vmin, setup->vmid, setup->vmax };
+   const float o0 = setup->vmin[0][3], o1 = setup->vmid[0][3], o2 = setup->vmax[0][3];
+   const float lo = MIN2(o0, MIN2(o1, o2)), hi = MAX2(o0, MAX2(o1, o2));
+   int u, c, i;
+
+   *ratio = lo > 0.0f ? hi / lo : 1e9f;
+   if (!f->fixed || !(lo > 0.0f) || hi > lo * 1.03f)
+      return FALSE;
+   for (u = 0; u < SP_FAST_UNITS; u++) {
+      const struct sp_fast_unit *un = &f->u[u];
+      int slot;
+      float sv[3], tv[3];
+
+      if (un->in < 0)
+         continue;
+      slot = sinfo->attrib[un->in].src_index;
+      for (i = 0; i < 3; i++) {
+         float s = vx[i][slot][un->coord_chan[0]], t = vx[i][slot][un->coord_chan[1]];
+
+         if (un->txp) {
+            const float q = vx[i][slot][un->coord_chan[2]];
+
+            if (q == 0.0f)
+               return FALSE;
+            s /= q;
+            t /= q;
+         }
+         sv[i] = s;
+         tv[i] = t;
+      }
+      tri_linear_coeff(setup, &aff[u], 0, sv);
+      tri_linear_coeff(setup, &aff[u], 1, tv);
+   }
+   if (f->col_in >= 0 && !f->tri_const) {
+      const int slot = sinfo->attrib[f->col_in].src_index;
+
+      for (c = 0; c < 4; c++) {
+         const int ch = f->col_chan[c];
+         float v[3];
+
+         if (ch < 0) {
+            col->a0[c] = 1.0f;
+            col->dadx[c] = col->dady[c] = 0.0f;
+            continue;
+         }
+         for (i = 0; i < 3; i++)
+            v[i] = CLAMP(vx[i][slot][ch], 0.0f, 1.0f);
+         tri_linear_coeff(setup, col, c, v);
+      }
+   }
+   return TRUE;
+}
