+static void
+zz_copy_region(struct pipe_context *c, struct pipe_resource *dst, unsigned dl, unsigned x, unsigned y,
+               unsigned z, struct pipe_resource *src, unsigned sl, const struct pipe_box *b)
+{
+   uint32_t *p = ccmd(c, ZP_COPY, 13);
+
+   p[0] = zr(dst)->id; p[1] = dl; p[2] = x; p[3] = y; p[4] = z; p[5] = sl;
+   p[6] = b->x; p[7] = b->y; p[8] = b->z; p[9] = b->width; p[10] = b->height; p[11] = b->depth;
+   p[12] = zr(src)->id;
+   zr(dst)->gpu_wrote = TRUE;
+}
