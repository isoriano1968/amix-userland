+static struct pipe_framebuffer_state fb;
+
+static void
+zz_set_framebuffer(struct pipe_context *c, const struct pipe_framebuffer_state *f)
+{
+   uint32_t *p = ccmd(c, ZP_FRAMEBUFFER, 6 + f->nr_cbufs);
+   unsigned i;
+
+   p[0] = f->width; p[1] = f->height; p[2] = f->nr_cbufs; p[3] = f->layers; p[4] = f->samples;
+   p[5] = f->zsbuf ? ((struct zz_surface *)f->zsbuf)->id : 0;
+   for (i = 0; i < f->nr_cbufs; i++)
+      p[6 + i] = f->cbufs[i] ? ((struct zz_surface *)f->cbufs[i])->id : 0;
+   for (i = 0; i < PIPE_MAX_COLOR_BUFS; i++)
+      fb.cbufs[i] = i < f->nr_cbufs ? f->cbufs[i] : NULL;
+   fb.nr_cbufs = f->nr_cbufs;
+}
+
+/* what is bound to draw on: its copy here is old after a draw */
+static void
+drew(void)
+{
+   unsigned i;
+
+   for (i = 0; i < fb.nr_cbufs; i++)
+      if (fb.cbufs[i] && fb.cbufs[i]->texture)
+         zr(fb.cbufs[i]->texture)->gpu_wrote = TRUE;
+}
+
+static void
+zz_set_viewports(struct pipe_context *c, unsigned start, unsigned n, const struct pipe_viewport_state *v)
+{
+   uint32_t *p = ccmd(c, ZP_VIEWPORT, 6);
+   unsigned i;
+
+   for (i = 0; i < 3; i++) {
+      p[i] = fw(v->scale[i]);
+      p[3 + i] = fw(v->translate[i]);
+   }
+}
