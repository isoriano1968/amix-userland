+static void
+bind(struct pipe_context *c, enum zzp_kind kind, void *o)
+{
+   uint32_t *p = ccmd(c, ZP_BIND, 2);
+
+   p[0] = kind;
+   p[1] = (uint32_t)(uintptr_t)o;
+}
+
+static void
+del(enum zzp_kind kind, void *o)
+{
+   uint32_t *p = cmd(ZP_FREE, 2);
+
+   p[0] = (uint32_t)(uintptr_t)o;
+   p[1] = kind;
+   drop_id((uint32_t)(uintptr_t)o);
+}
+
+#define BD(name, kind) \
+   static void zz_bind_##name(struct pipe_context *c, void *o) { bind(c, kind, o); } \
+   static void zz_del_##name(struct pipe_context *c, void *o) { del(kind, o); }
+BD(blend, ZK_BLEND) BD(dsa, ZK_DSA) BD(rast, ZK_RAST) BD(velems, ZK_VELEMS)
+BD(vs, ZK_VS) BD(fs, ZK_FS) BD(gs, ZK_GS)
