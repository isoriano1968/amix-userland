--- /dev/null
+++ b/src/gallium/drivers/softpipe/sp_fast.c
@@ -0,0 +1,2494 @@
+/*
+ * sp_fast.c -- see sp_fast.h.
+ *
+ * Coverage, attribute planes and the Z values are softpipe's own (the
+ * triangle setup is shared, Z is evaluated per 2x2 quad as in
+ * sp_quad_depth_test.c), so fast and slow passes over the same geometry
+ * meet with GL_EQUAL.  Colour maths is 8-bit integer: results can differ
+ * from softpipe's float pipeline by one step per channel.
+ */
+#include "sp_context.h"
+#include "sp_state.h"
+#include "sp_texture.h"
+#include "sp_tile_cache.h"
+#include "sp_fast.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_shader_tokens.h"
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_util.h"
+#include "tgsi/tgsi_dump.h"
+#include "util/u_debug.h"
+#include "util/u_format.h"
+#include "util/u_math.h"
+#include "util/u_inlines.h"
+
+#ifdef __z3660core__
+int sp_fast_evt_on;
+uint64_t sp_fast_prof[16];
+#endif
+
+extern unsigned sp_fast_why[16];
+
+enum { CPACK_RGBA = 1, CPACK_BGRA, CPACK_OTHER };
+
+static void choose_span(struct sp_fast *f);
+static void pick_level(const struct sp_fast_tex *t, float lambda, int *level, int *linear);
+static inline unsigned to8(float v);
+static inline uint32_t pack(unsigned r, unsigned g, unsigned b, unsigned a);
+enum { BLEND_NONE, BLEND_MODULATE, BLEND_ALPHA, BLEND_ADD, BLEND_MODADD, BLEND_ALPHAADD, BLEND_GENERIC };
+enum { FOG_NONE, FOG_EXP, FOG_LINEAR };
+
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static void
+print_why(void)
+{
+   int k;
+
+   fprintf(stderr, "sp_fast: draws refused by reason:");
+   for (k = 1; k < 16; k++)
+      if (sp_fast_why[k])
+         fprintf(stderr, " %d:%u", k, sp_fast_why[k]);
+   fprintf(stderr, "\n");
+}
+
+void
+sp_fast_init(struct sp_fast *f)
+{
+   static int registered;
+
+   if (!registered && debug_get_bool_option("SOFTPIPE_FAST_WHY", FALSE)) {
+      registered = 1;
+      atexit(print_why);
+   }
+   memset(f, 0, sizeof(*f));
+   f->enabled = !debug_get_bool_option("SOFTPIPE_NO_FAST", FALSE);
+   f->neon_ok = !debug_get_bool_option("SOFTPIPE_FAST_NONEON", FALSE);
+   f->pairs = !debug_get_bool_option("SOFTPIPE_FAST_NOPAIR", FALSE);
+}
+
+
+/*
+ * The fragment shader: a straight run of MOV, MUL, TEX and TXP whose
+ * output channels are each a product of at most one colour input channel
+ * and one texel channel of each texture unit (2D, units 0 and 1: the
+ * fixed-function texture * colour and multitexture with GL_MODULATE).
+ * Every value is tracked per channel as such a product.
+ */
+struct sym {
+   signed char in, in_chan;      /* in = -1: factor 1 */
+   signed char tex[SP_FAST_UNITS];   /* texel channel of unit u, -1: factor 1 */
+   boolean def;
+};
+
+#define FAST_TEMPS 16
+#define FAST_CONST 64           /* sym.in >= this: constant FAST_CONST + n of buffer 0 */
+
+static boolean
+src_value(const struct tgsi_full_src_register *src, const struct sym (*temp)[4],
+          unsigned chan, struct sym *out)
+{
+   const unsigned swz = tgsi_util_get_full_src_register_swizzle(src, chan);
+   int u;
+
+   if (src->Register.Indirect || src->Register.Negate || src->Register.Absolute ||
+       (src->Register.Dimension && (src->Register.File != TGSI_FILE_CONSTANT ||
+                                    src->Dimension.Indirect || src->Dimension.Index != 0)))
+      return FALSE;
+   switch (src->Register.File) {
+   case TGSI_FILE_INPUT:
+      out->in = (signed char)src->Register.Index;
+      out->in_chan = (signed char)swz;
+      for (u = 0; u < SP_FAST_UNITS; u++)
+         out->tex[u] = -1;
+      out->def = TRUE;
+      return TRUE;
+   case TGSI_FILE_TEMPORARY:
+      if (src->Register.Index >= FAST_TEMPS || !temp[src->Register.Index][swz].def)
+         return FALSE;
+      *out = temp[src->Register.Index][swz];
+      return TRUE;
+   case TGSI_FILE_CONSTANT:
+      /* glColor without a colour array: Mesa's constant; a colour per draw */
+      if (src->Register.Index >= 32)
+         return FALSE;
+      out->in = (signed char)(FAST_CONST + src->Register.Index);
+      out->in_chan = (signed char)swz;
+      for (u = 0; u < SP_FAST_UNITS; u++)
+         out->tex[u] = -1;
+      out->def = TRUE;
+      return TRUE;
+   default:
+      return FALSE;
+   }
+}
+
+static boolean
+plain_input(const struct sym *s)
+{
+   int u;
+
+   for (u = 0; u < SP_FAST_UNITS; u++)
+      if (s->tex[u] >= 0)
+         return FALSE;
+   return s->in >= 0 && s->in < FAST_CONST;
+}
+
+/* word of a constant the instruction reads, or -1 */
+static int
+const_word(const struct tgsi_full_src_register *src)
+{
+   if (src->Register.File != TGSI_FILE_CONSTANT || src->Register.Indirect || src->Register.Index >= 32 ||
+       (src->Register.Dimension && (src->Dimension.Indirect || src->Dimension.Index != 0)))
+      return -1;
+   return src->Register.Index * 4 + tgsi_util_get_full_src_register_swizzle(src, 0);
+}
+
+/*
+ * The end of a fixed-function shader with fog, as Mesa writes it:
+ *    MOV  out.w, alpha
+ *    MUL  t.x, fogcoord, scale; EX2 t.x, -t.x         (GL_EXP)
+ *    or MAD t.x, fogcoord, scale, offset              (GL_LINEAR)
+ *    MOV_SAT t.x, t.x; ADD u.x, 1, -t.x; MUL u.xyz, fogcolor, u.x
+ *    MAD  out.xyz, colour, t.x, u.xyz; MOV OUT[0], out; END
+ * Sets fog_kind and the rest; returns the index of the first MOV (the
+ * program before it is the colour), and the final MAD in *mad.
+ */
+static int
+find_fog(struct sp_fast *f, const struct sp_fragment_shader_variant *v,
+         const struct tgsi_full_instruction *in, int n, int *mad)
+{
+   static const unsigned exp_ops[] = { TGSI_OPCODE_MUL, TGSI_OPCODE_EX2, TGSI_OPCODE_MOV, TGSI_OPCODE_ADD,
+                                       TGSI_OPCODE_MUL, TGSI_OPCODE_MAD, TGSI_OPCODE_MOV, TGSI_OPCODE_END };
+   static const unsigned lin_ops[] = { TGSI_OPCODE_MAD, TGSI_OPCODE_MOV, TGSI_OPCODE_ADD,
+                                       TGSI_OPCODE_MUL, TGSI_OPCODE_MAD, TGSI_OPCODE_MOV, TGSI_OPCODE_END };
+   int i, k;
+
+   for (i = 1; i < n; i++) {
+      const struct tgsi_full_src_register *s = &in[i].Src[0];
+      const boolean lin = in[i].Instruction.Opcode == TGSI_OPCODE_MAD;
+      const unsigned *ops = lin ? lin_ops : exp_ops;
+      const int nops = lin ? 7 : 8;
+
+      if ((!lin && in[i].Instruction.Opcode != TGSI_OPCODE_MUL) || s->Register.File != TGSI_FILE_INPUT ||
+          s->Register.Index >= (int)v->info.num_inputs ||
+          v->info.input_semantic_name[s->Register.Index] != TGSI_SEMANTIC_FOG)
+         continue;
+      if (i + nops != n || in[i - 1].Instruction.Opcode != TGSI_OPCODE_MOV ||
+          in[i - 1].Dst[0].Register.WriteMask != TGSI_WRITEMASK_W)
+         return -1;
+      for (k = 0; k < nops; k++)
+         if (in[i + k].Instruction.Opcode != ops[k])
+            return -1;
+      f->fog_in = s->Register.Index;
+      f->fog_ka = const_word(&in[i].Src[1]);
+      f->fog_kb = lin ? const_word(&in[i].Src[2]) : 0;
+      f->fog_kc = const_word(&in[i + nops - 4].Src[0]);
+      if (f->fog_ka < 0 || f->fog_kb < 0 || f->fog_kc < 0 || (f->fog_kc & 3) ||
+          in[i + nops - 3].Src[0].Register.File != TGSI_FILE_TEMPORARY)
+         return -1;
+      f->fog_kind = lin ? FOG_LINEAR : FOG_EXP;
+      *mad = i + nops - 3;
+      return i - 1;
+   }
+   return -1;
+}
+
+#define FAST_INSNS 32
+
+static boolean
+analyse_fs(struct sp_fast *f, const struct sp_fragment_shader_variant *v)
+{
+   struct sym temp[FAST_TEMPS][4], outv[4];
+   struct tgsi_parse_context parse;
+   struct tgsi_full_instruction insns[FAST_INSNS];
+   boolean ok = TRUE;
+   unsigned c;
+   int u, n = 0, k, fog_at = -1, fog_mad = 0;
+
+   if (v->info.num_outputs != 1 ||
+       v->info.output_semantic_name[0] != TGSI_SEMANTIC_COLOR ||
+       v->info.output_semantic_index[0] != 0 ||
+       v->info.uses_kill || v->info.writes_z || v->info.writes_stencil)
+      return FALSE;
+
+   memset(temp, 0, sizeof(temp));
+   memset(outv, 0, sizeof(outv));
+   f->col_in = -1;
+   f->fog_kind = FOG_NONE;
+   for (u = 0; u < SP_FAST_UNITS; u++) {
+      f->u[u].in = -1;
+      f->u[u].txp = FALSE;
+   }
+
+   tgsi_parse_init(&parse, v->tokens);
+   while (!tgsi_parse_end_of_tokens(&parse)) {
+      tgsi_parse_token(&parse);
+      if (parse.FullToken.Token.Type != TGSI_TOKEN_TYPE_INSTRUCTION)
+         continue;
+      if (n == FAST_INSNS) {
+         tgsi_parse_free(&parse);
+         return FALSE;
+      }
+      insns[n++] = parse.FullToken.FullInstruction;
+   }
+   tgsi_parse_free(&parse);
+   fog_at = find_fog(f, v, insns, n, &fog_mad);
+
+   for (k = 0; ok && k < n; k++) {
+      const struct tgsi_full_instruction *inst = &insns[k];
+      struct sym res[4];
+
+      if (inst->Instruction.Opcode == TGSI_OPCODE_END)
+         break;
+      if (k == fog_at) {
+         /* the colour before the fog */
+         const int t = insns[fog_mad].Src[0].Register.Index;
+
+         if (t >= FAST_TEMPS || !src_value(&inst->Src[0], temp, 3, &outv[3])) {
+            ok = FALSE;
+            break;
+         }
+         for (c = 0; c < 3; c++) {
+            if (!temp[t][c].def) {
+               ok = FALSE;
+               break;
+            }
+            outv[c] = temp[t][c];
+         }
+         break;
+      }
+      if (inst->Instruction.NumDstRegs != 1 || inst->Dst[0].Register.Indirect ||
+          inst->Dst[0].Register.Dimension) {
+         ok = FALSE;
+         break;
+      }
+
+      switch (inst->Instruction.Opcode) {
+      case TGSI_OPCODE_MOV:
+         for (c = 0; ok && c < 4; c++)
+            if (inst->Dst[0].Register.WriteMask & (1 << c))
+               ok = src_value(&inst->Src[0], temp, c, &res[c]);
+         break;
+      case TGSI_OPCODE_MUL:
+         for (c = 0; ok && c < 4; c++) {
+            struct sym a, b;
+
+            if (!(inst->Dst[0].Register.WriteMask & (1 << c)))
+               continue;
+            ok = src_value(&inst->Src[0], temp, c, &a) && src_value(&inst->Src[1], temp, c, &b);
+            if (!ok)
+               break;
+            /* one input factor and one texel factor per unit at most */
+            if (a.in >= 0 && b.in >= 0) {
+               ok = FALSE;
+               break;
+            }
+            res[c].def = TRUE;
+            res[c].in = a.in >= 0 ? a.in : b.in;
+            res[c].in_chan = a.in >= 0 ? a.in_chan : b.in_chan;
+            for (u = 0; u < SP_FAST_UNITS; u++) {
+               if (a.tex[u] >= 0 && b.tex[u] >= 0)
+                  ok = FALSE;
+               res[c].tex[u] = a.tex[u] >= 0 ? a.tex[u] : b.tex[u];
+            }
+         }
+         break;
+      case TGSI_OPCODE_TEX:
+      case TGSI_OPCODE_TXP: {
+         const boolean txp = inst->Instruction.Opcode == TGSI_OPCODE_TXP;
+         struct sym s, t, q;
+         struct sp_fast_unit *un;
+
+         u = inst->Src[1].Register.Index;
+         if (inst->Texture.Texture != TGSI_TEXTURE_2D ||
+             inst->Src[1].Register.File != TGSI_FILE_SAMPLER || u < 0 || u >= SP_FAST_UNITS ||
+             f->u[u].in >= 0 ||
+             !src_value(&inst->Src[0], temp, 0, &s) || !src_value(&inst->Src[0], temp, 1, &t) ||
+             (txp && !src_value(&inst->Src[0], temp, 3, &q)) ||
+             !plain_input(&s) || !plain_input(&t) || t.in != s.in ||
+             (txp && (!plain_input(&q) || q.in != s.in))) {
+            ok = FALSE;
+            break;
+         }
+         un = &f->u[u];
+         un->in = s.in;
+         un->coord_chan[0] = s.in_chan;
+         un->coord_chan[1] = t.in_chan;
+         un->coord_chan[2] = txp ? q.in_chan : -1;
+         un->txp = txp;
+         for (c = 0; c < 4; c++) {
+            int k;
+
+            res[c].def = TRUE;
+            res[c].in = -1;
+            res[c].in_chan = 0;
+            for (k = 0; k < SP_FAST_UNITS; k++)
+               res[c].tex[k] = -1;
+            res[c].tex[u] = (signed char)c;
+         }
+         break;
+      }
+      default:
+         ok = FALSE;
+      }
+      if (!ok)
+         break;
+
+      for (c = 0; c < 4; c++) {
+         if (!(inst->Dst[0].Register.WriteMask & (1 << c)))
+            continue;
+         if (inst->Dst[0].Register.File == TGSI_FILE_TEMPORARY &&
+             inst->Dst[0].Register.Index < FAST_TEMPS)
+            temp[inst->Dst[0].Register.Index][c] = res[c];
+         else if (inst->Dst[0].Register.File == TGSI_FILE_OUTPUT && inst->Dst[0].Register.Index == 0)
+            outv[c] = res[c];
+         else
+            ok = FALSE;
+      }
+   }
+   if (!ok)
+      return FALSE;
+
+   /* unit 1 alone: not here (the spans' single texture is unit 0) */
+   if (f->u[1].in >= 0 && f->u[0].in < 0)
+      return FALSE;
+
+   f->mixed = FALSE;
+   for (c = 0; c < 4; c++) {
+      if (!outv[c].def)
+         return FALSE;
+      if (outv[c].in >= 0) {
+         if (f->col_in >= 0 && f->col_in != outv[c].in)
+            return FALSE;
+         f->col_in = outv[c].in;
+      }
+      f->col_chan[c] = outv[c].in >= 0 ? outv[c].in_chan : -1;
+      for (u = 0; u < SP_FAST_UNITS; u++)
+         f->u[u].chan[c] = outv[c].tex[u];
+   }
+   /* channel c from a channel other than c (a swizzle): the general way.
+      A factor that is not there (-1) is 1.0: for a unit, its texel byte is
+      ORed to 255 (ormask, e.g. alpha of an RGB texture under GL_MODULATE);
+      for the colour the setups make it 255 already. */
+   for (u = 0; u < SP_FAST_UNITS; u++)
+      f->u[u].ormask = 0;
+   for (c = 0; c < 4; c++) {
+      for (u = 0; u < SP_FAST_UNITS; u++)
+         if (f->u[u].in >= 0) {
+            if (f->u[u].chan[c] < 0)
+               f->u[u].ormask |= 0xffu << (8 * c);
+            else if (f->u[u].chan[c] != (int)c)
+               f->mixed = TRUE;
+         }
+      if (f->col_in >= 0 && f->col_chan[c] >= 0 && f->col_chan[c] != (int)c)
+         f->mixed = TRUE;
+   }
+   return TRUE;
+}
+
+
+/* bytes of r, g, b, a in a pixel of an 8-bit unorm array format, or FALSE */
+static boolean
+byte_map(enum pipe_format format, int *bpp, signed char map[4])
+{
+   const struct util_format_description *d = util_format_description(format);
+   unsigned c;
+
+   if (!d || d->layout != UTIL_FORMAT_LAYOUT_PLAIN || !d->is_array ||
+       d->colorspace != UTIL_FORMAT_COLORSPACE_RGB || d->block.width != 1 ||
+       d->block.height != 1 || (d->block.bits & 7) || d->block.bits > 32)
+      return FALSE;
+   for (c = 0; c < d->nr_channels; c++)
+      if (d->channel[c].type != UTIL_FORMAT_TYPE_VOID &&
+          (d->channel[c].type != UTIL_FORMAT_TYPE_UNSIGNED || !d->channel[c].normalized ||
+           d->channel[c].size != 8))
+         return FALSE;
+   *bpp = d->block.bits / 8;
+   for (c = 0; c < 4; c++) {
+      const unsigned s = d->swizzle[c];
+
+      if (s <= PIPE_SWIZZLE_W && d->channel[s].type != UTIL_FORMAT_TYPE_VOID)
+         map[c] = (signed char)(d->channel[s].shift / 8);
+      else
+         map[c] = s == PIPE_SWIZZLE_0 ? -1 : -2;
+   }
+   return TRUE;
+}
+
+static boolean
+blend_factor_ok(unsigned f)
+{
+   switch (f) {
+   case PIPE_BLENDFACTOR_ONE:
+   case PIPE_BLENDFACTOR_ZERO:
+   case PIPE_BLENDFACTOR_SRC_COLOR:
+   case PIPE_BLENDFACTOR_INV_SRC_COLOR:
+   case PIPE_BLENDFACTOR_SRC_ALPHA:
+   case PIPE_BLENDFACTOR_INV_SRC_ALPHA:
+   case PIPE_BLENDFACTOR_DST_COLOR:
+   case PIPE_BLENDFACTOR_INV_DST_COLOR:
+   case PIPE_BLENDFACTOR_DST_ALPHA:
+   case PIPE_BLENDFACTOR_INV_DST_ALPHA:
+   case PIPE_BLENDFACTOR_SRC_ALPHA_SATURATE:
+      return TRUE;
+   default:
+      return FALSE;
+   }
+}
+
+static boolean
+blend_func_ok(unsigned f)
+{
+   return f == PIPE_BLEND_ADD || f == PIPE_BLEND_SUBTRACT || f == PIPE_BLEND_REVERSE_SUBTRACT ||
+          f == PIPE_BLEND_MIN || f == PIPE_BLEND_MAX;
+}
+
+static boolean
+prepare_texture(struct sp_fast *f, struct softpipe_context *sp, int unit)
+{
+   struct sp_fast_tex *t = &f->u[unit].tex;
+   const struct pipe_sampler_view *view = sp->sampler_views[PIPE_SHADER_FRAGMENT][unit];
+   const struct pipe_sampler_state *samp = sp->samplers[PIPE_SHADER_FRAGMENT][unit];
+   const struct softpipe_resource *res;
+   const unsigned vswz[4] = { view ? view->swizzle_r : 0, view ? view->swizzle_g : 0,
+                              view ? view->swizzle_b : 0, view ? view->swizzle_a : 0 };
+   signed char fmap[4];
+   int l, c;
+
+   if (!view || !samp || !view->texture || view->target != PIPE_TEXTURE_2D ||
+       view->texture->target != PIPE_TEXTURE_2D || !samp->normalized_coords ||
+       samp->compare_mode != PIPE_TEX_COMPARE_NONE || samp->max_anisotropy > 1)
+      return FALSE;
+   res = softpipe_resource(view->texture);
+   if (!res->data || !byte_map(view->format, &t->bpp, fmap))
+      return FALSE;
+   for (c = 0; c < 4; c++)
+      t->map[c] = vswz[c] <= PIPE_SWIZZLE_W ? fmap[vswz[c]] : vswz[c] == PIPE_SWIZZLE_0 ? -1 : -2;
+#ifdef PIPE_ARCH_LITTLE_ENDIAN
+   t->ident = t->bpp == 4 && t->map[0] == 0 && t->map[1] == 1 && t->map[2] == 2 && t->map[3] == 3;
+#else
+   t->ident = FALSE;
+#endif
+
+   /* GL_CLAMP is taken as GL_CLAMP_TO_EDGE (the border colour is not blended in) */
+   if (samp->wrap_s == PIPE_TEX_WRAP_REPEAT)
+      t->clamp_s = 0;
+   else if (samp->wrap_s == PIPE_TEX_WRAP_CLAMP_TO_EDGE || samp->wrap_s == PIPE_TEX_WRAP_CLAMP)
+      t->clamp_s = 1;
+   else
+      return FALSE;
+   if (samp->wrap_t == PIPE_TEX_WRAP_REPEAT)
+      t->clamp_t = 0;
+   else if (samp->wrap_t == PIPE_TEX_WRAP_CLAMP_TO_EDGE || samp->wrap_t == PIPE_TEX_WRAP_CLAMP)
+      t->clamp_t = 1;
+   else
+      return FALSE;
+
+   /* one word per texel: r, g, b in bytes 0-2, alpha in 3 or none (x) */
+#ifdef PIPE_ARCH_LITTLE_ENDIAN
+   t->fast4 = t->bpp == 4 && t->map[0] == 0 && t->map[1] == 1 && t->map[2] == 2 &&
+              (t->map[3] == 3 || t->map[3] == -2);
+#else
+   t->fast4 = FALSE;
+#endif
+   t->amask = t->map[3] == -2 ? 0xff000000u : 0;
+   if (debug_get_bool_option("SOFTPIPE_FAST_WHY", FALSE)) {
+      static unsigned seen[PIPE_FORMAT_COUNT][2][2];
+
+      if (!seen[view->format][t->fast4][t->clamp_s]++)
+         fprintf(stderr, "sp_fast: texture %s fast4 %d clamp %d/%d mip %d\n",
+                 util_format_name(view->format), t->fast4, t->clamp_s, t->clamp_t, t->mip);
+   }
+   t->first = view->u.tex.first_level;
+   t->last = MIN2(view->u.tex.last_level, view->texture->last_level);
+   if (t->last < t->first || t->last >= SP_FAST_LEVELS)
+      return FALSE;
+   for (l = t->first; l <= t->last; l++) {
+      t->data[l] = (const ubyte *)res->data + res->level_offset[l];
+      t->stride[l] = res->stride[l];
+      t->w[l] = u_minify(view->texture->width0, l);
+      t->h[l] = u_minify(view->texture->height0, l);
+      t->fsize[l][0] = (float)t->w[l];
+      t->fsize[l][1] = (float)t->h[l];
+      if ((!t->clamp_s && !util_is_power_of_two_or_zero(t->w[l])) ||
+          (!t->clamp_t && !util_is_power_of_two_or_zero(t->h[l])))
+         return FALSE;
+   }
+   t->min_linear = samp->min_img_filter == PIPE_TEX_FILTER_LINEAR;
+   t->mag_linear = samp->mag_img_filter == PIPE_TEX_FILTER_LINEAR;
+   t->mip = t->last > t->first ? samp->min_mip_filter : PIPE_TEX_MIPFILTER_NONE;
+   t->need_lambda = t->mip != PIPE_TEX_MIPFILTER_NONE || t->min_linear != t->mag_linear;
+   t->lod_bias = samp->lod_bias;
+   t->min_lod = MAX2(samp->min_lod, 0.0f);
+   t->max_lod = MIN2(samp->max_lod, (float)(t->last - t->first));
+   return TRUE;
+}
+
+/* fixed-point fraction bits of Z in fixed_span(), -1: not there */
+static inline int
+zfrac_bits(int format)
+{
+   switch (format) {
+   case PIPE_FORMAT_Z16_UNORM: return 16;
+   case PIPE_FORMAT_Z24X8_UNORM:
+   case PIPE_FORMAT_Z24_UNORM_S8_UINT:
+   case PIPE_FORMAT_X8Z24_UNORM:
+   case PIPE_FORMAT_S8_UINT_Z24_UNORM: return 8;
+   default: return -1;
+   }
+}
+
+/* write back and drop the cached tiles: the fast path works on the buffers */
+static void
+tile_cache_release(struct softpipe_tile_cache *tc)
+{
+   int pos;
+
+
+   /* sp_flush_tile_cache() fills a scratch tile with the clear value each
+      time: only when a clear or softpipe's own drawing left something */
+   if (!tc || !tc->num_maps || tc->fast_clean)
+      return;
+   sp_flush_tile_cache(tc);
+   for (pos = 0; pos < NUM_ENTRIES; pos++)
+      tc->tile_addrs[pos].bits.invalid = 1;
+   tc->last_tile_addr.bits.invalid = 1;
+   tc->fast_clean = TRUE;
+}
+
+/* why draws miss the fast path: counts per fast_prepare() check (the GPU
+   program publishes them; SOFTPIPE_FAST_WHY=1 prints them on the PC) */
+unsigned sp_fast_why[16];
+
+static boolean
+why(int k)
+{
+   sp_fast_why[k & 15]++;
+   return FALSE;
+}
+
+static boolean
+fast_prepare(struct sp_fast *f, struct softpipe_context *sp)
+{
+   const struct sp_setup_info *sinfo = &sp->setup_info;
+   const struct pipe_framebuffer_state *fb = &sp->framebuffer;
+   const struct pipe_depth_stencil_alpha_state *dsa = sp->depth_stencil;
+   const struct pipe_rasterizer_state *rast = sp->rasterizer;
+   const struct pipe_rt_blend_state *rt;
+   struct softpipe_tile_cache *ctc, *ztc;
+   int unit;
+
+   f->on = FALSE;
+   if (!f->enabled || !sp->fs_variant || !dsa || !rast || !sp->blend)
+      return why(1);
+   if (f->fs != sp->fs_variant) {
+      f->fs = sp->fs_variant;
+      f->fs_ok = analyse_fs(f, sp->fs_variant);
+      if (!f->fs_ok && debug_get_bool_option("SOFTPIPE_FAST_WHY", FALSE))
+         tgsi_dump(sp->fs_variant->tokens, 0);
+   }
+   if (!f->fs_ok)
+      return why(2);
+
+   if (sp->reduced_api_prim != PIPE_PRIM_TRIANGLES || rast->poly_stipple_enable ||
+       rast->multisample || sp->active_query_count || sp->active_statistics_queries ||
+       sp->layer_slot > 0 || sp->viewport_index_slot > 0 || sp->fs_variant->key.polygon_stipple)
+      return why(3);
+
+   /* interpolation of the inputs used */
+   f->col_const = f->col_in >= FAST_CONST;
+   if (f->col_const) {
+      /* the colour from the constant buffer: the same for the whole draw */
+      const float *cb = (const float *)sp->mapped_constants[PIPE_SHADER_FRAGMENT][0];
+      const unsigned k = f->col_in - FAST_CONST;
+      unsigned c8[4] = { 255, 255, 255, 255 }, c;
+
+      if (!cb || (k + 1) * 16 > sp->const_buffer_size[PIPE_SHADER_FRAGMENT][0])
+         return why(14);
+      for (c = 0; c < 4; c++)
+         if (f->col_chan[c] >= 0)
+            c8[c] = to8(cb[k * 4 + f->col_chan[c]]);
+      f->const_col = pack(c8[0], c8[1], c8[2], c8[3]);
+      f->col_interp = SP_INTERP_CONSTANT;
+      f->col_slot = 0;
+   } else {
+      f->col_interp = f->col_in >= 0 ? sinfo->attrib[f->col_in].interp : SP_INTERP_CONSTANT;
+      f->col_slot = f->col_in >= 0 ? sinfo->attrib[f->col_in].src_index : 0;
+   }
+   if (f->col_interp == SP_INTERP_POS)
+      return why(4);
+   if (f->fog_kind) {
+      const float *cb = (const float *)sp->mapped_constants[PIPE_SHADER_FRAGMENT][0];
+      const int top = MAX3(f->fog_ka, f->fog_kb, f->fog_kc + 2);
+
+      if (!cb || (top + 1) * 4 > (int)sp->const_buffer_size[PIPE_SHADER_FRAGMENT][0])
+         return why(14);
+      f->fog_slot = sinfo->attrib[f->fog_in].src_index;
+      f->fog_scale = cb[f->fog_ka];
+      f->fog_off = f->fog_kind == FOG_LINEAR ? cb[f->fog_kb] : 0.0f;
+      f->fog_rgba = pack(to8(cb[f->fog_kc]), to8(cb[f->fog_kc + 1]), to8(cb[f->fog_kc + 2]), 0);
+   }
+   for (unit = 0; unit < SP_FAST_UNITS; unit++) {
+      struct sp_fast_unit *u = &f->u[unit];
+
+      if (u->in < 0)
+         continue;
+      u->interp = sinfo->attrib[u->in].interp;
+      if (u->interp == SP_INTERP_POS || sp->fs_variant->info.input_cylindrical_wrap[u->in] ||
+          !prepare_texture(f, sp, unit))
+         return why(5);
+      u->tex.amask |= u->ormask;     /* channels the shader takes as 1.0 */
+   }
+   if (f->col_in >= 0 && !f->col_const && sp->fs_variant->info.input_cylindrical_wrap[f->col_in])
+      return why(6);
+
+   /* colour buffer */
+   if (fb->nr_cbufs != 1 || !fb->cbufs[0] || !(ctc = sp->cbuf_cache[0]) || ctc->num_maps != 1 ||
+       !byte_map(fb->cbufs[0]->format, &f->cbpp, f->cmap))
+      return why(7);
+   rt = &sp->blend->rt[0];
+   if (sp->blend->logicop_enable || sp->blend->alpha_to_coverage || sp->blend->alpha_to_one)
+      return why(8);
+   f->colormask = rt->colormask;
+   f->cpack = CPACK_OTHER;
+#ifdef PIPE_ARCH_LITTLE_ENDIAN
+   if (f->cbpp == 4 && f->colormask == 0xf && f->cmap[1] == 1 && f->cmap[3] == 3) {
+      if (f->cmap[0] == 0 && f->cmap[2] == 2)
+         f->cpack = CPACK_RGBA;
+      else if (f->cmap[0] == 2 && f->cmap[2] == 0)
+         f->cpack = CPACK_BGRA;
+   }
+#endif
+   f->blend = rt->blend_enable;
+   f->blend_kind = BLEND_NONE;
+   if (f->blend) {
+      if (!blend_func_ok(rt->rgb_func) || !blend_func_ok(rt->alpha_func) ||
+          !blend_factor_ok(rt->rgb_src_factor) || !blend_factor_ok(rt->rgb_dst_factor) ||
+          !blend_factor_ok(rt->alpha_src_factor) || !blend_factor_ok(rt->alpha_dst_factor))
+         return why(9);
+      f->rgb_func = rt->rgb_func;
+      f->rgb_src = rt->rgb_src_factor;
+      f->rgb_dst = rt->rgb_dst_factor;
+      f->a_func = rt->alpha_func;
+      f->a_src = rt->alpha_src_factor;
+      f->a_dst = rt->alpha_dst_factor;
+      f->blend_kind = BLEND_GENERIC;
+      if (f->rgb_func == PIPE_BLEND_ADD && f->a_func == PIPE_BLEND_ADD) {
+         const unsigned rs = f->rgb_src, rd = f->rgb_dst, as = f->a_src, ad = f->a_dst;
+
+         if (((rs == PIPE_BLENDFACTOR_DST_COLOR && rd == PIPE_BLENDFACTOR_ZERO) ||
+              (rs == PIPE_BLENDFACTOR_ZERO && rd == PIPE_BLENDFACTOR_SRC_COLOR)) &&
+             (((as == PIPE_BLENDFACTOR_DST_COLOR || as == PIPE_BLENDFACTOR_DST_ALPHA) &&
+               ad == PIPE_BLENDFACTOR_ZERO) ||
+              (as == PIPE_BLENDFACTOR_ZERO &&
+               (ad == PIPE_BLENDFACTOR_SRC_COLOR || ad == PIPE_BLENDFACTOR_SRC_ALPHA))))
+            f->blend_kind = BLEND_MODULATE;
+         else if (rs == PIPE_BLENDFACTOR_SRC_ALPHA && rd == PIPE_BLENDFACTOR_INV_SRC_ALPHA &&
+                  as == PIPE_BLENDFACTOR_SRC_ALPHA && ad == PIPE_BLENDFACTOR_INV_SRC_ALPHA)
+            f->blend_kind = BLEND_ALPHA;
+         else if (rs == PIPE_BLENDFACTOR_ONE && rd == PIPE_BLENDFACTOR_ONE &&
+                  as == PIPE_BLENDFACTOR_ONE && ad == PIPE_BLENDFACTOR_ONE)
+            f->blend_kind = BLEND_ADD;
+         else if (rs == PIPE_BLENDFACTOR_DST_COLOR && rd == PIPE_BLENDFACTOR_ONE &&
+                  as == PIPE_BLENDFACTOR_DST_COLOR && ad == PIPE_BLENDFACTOR_ONE)
+            f->blend_kind = BLEND_MODADD;
+         else if (rs == PIPE_BLENDFACTOR_SRC_ALPHA && rd == PIPE_BLENDFACTOR_ONE &&
+                  as == PIPE_BLENDFACTOR_SRC_ALPHA && ad == PIPE_BLENDFACTOR_ONE)
+            f->blend_kind = BLEND_ALPHAADD;
+      }
+   }
+
+   /* depth, stencil, alpha */
+   if (dsa->stencil[0].enabled || dsa->depth.bounds_test)
+      return why(10);
+   f->zformat = 0;
+   ztc = NULL;
+   if (dsa->depth.enabled && fb->zsbuf) {
+      switch (fb->zsbuf->format) {
+      case PIPE_FORMAT_Z16_UNORM:
+      case PIPE_FORMAT_Z32_UNORM:
+      case PIPE_FORMAT_Z24X8_UNORM:
+      case PIPE_FORMAT_Z24_UNORM_S8_UINT:
+      case PIPE_FORMAT_X8Z24_UNORM:
+      case PIPE_FORMAT_S8_UINT_Z24_UNORM:
+      case PIPE_FORMAT_Z32_FLOAT:
+         break;
+      default:
+         return why(11);
+      }
+      ztc = sp->zsbuf_cache;
+      if (!ztc || ztc->num_maps != 1)
+         return why(12);
+      f->zformat = fb->zsbuf->format;
+      f->zfunc = dsa->depth.func;
+      f->zwrite = dsa->depth.writemask;
+      f->zbuf = (ubyte *)ztc->transfer_map[0];
+      f->zstride = ztc->transfer[0]->stride;
+      f->zclamp = !rast->depth_clip_near;
+      {
+         const float n = sp->viewports[0].translate[2] - sp->viewports[0].scale[2];
+         const float fa = n + sp->viewports[0].scale[2] * 2.0f;
+
+         f->zmin = MIN2(n, fa);
+         f->zmax = MAX2(n, fa);
+      }
+   }
+   f->afunc = dsa->alpha.enabled ? dsa->alpha.func : PIPE_FUNC_ALWAYS;
+   f->areff = dsa->alpha.ref_value;
+
+   f->cbuf = (ubyte *)ctc->transfer_map[0];
+   f->cstride = ctc->transfer[0]->stride;
+
+   /* fixed_span() unless trilinear, 32-bit Z or depth clamping */
+   f->fixed = !(f->u[0].in >= 0 && f->u[0].tex.mip == PIPE_TEX_MIPFILTER_LINEAR) &&
+              !(f->u[1].in >= 0 && f->u[1].tex.mip == PIPE_TEX_MIPFILTER_LINEAR) &&
+              (!f->zformat || (zfrac_bits(f->zformat) >= 0 && !f->zclamp)) &&
+              !debug_get_bool_option("SOFTPIPE_FAST_FLOAT", FALSE);
+
+   if ((f->u[1].in >= 0 || f->fog_kind) && !f->fixed)
+      return why(13);             /* fast_span() has one unit and no fog */
+   f->zonly = f->fixed && f->colormask == 0 && f->u[0].in < 0 && f->u[1].in < 0 &&
+              f->afunc == PIPE_FUNC_ALWAYS && f->zformat && !f->fog_kind;
+   if (f->fixed)
+      choose_span(f);
+
+   tile_cache_release(ctc);
+   if (ztc)
+      tile_cache_release(ztc);
+   f->on = TRUE;
+   return TRUE;
+}
+
+
+boolean
+sp_fast_prepare(struct sp_fast *f, struct softpipe_context *sp)
+{
+   SPF_PROF_BEGIN(t0);
+   const boolean on = fast_prepare(f, sp);
+
+   SPF_PROF_END(2, t0);
+   return on;
+}
