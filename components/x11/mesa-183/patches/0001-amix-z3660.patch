+   c->draw_vbo = zz_draw_vbo;
+   c->clear = zz_clear;
+   c->clear_render_target = zz_clear_rt;
+   c->clear_depth_stencil = zz_clear_ds;
+   c->resource_copy_region = zz_copy_region;
+   c->blit = zz_blit;
+   c->create_query = zz_create_query;
+   c->destroy_query = zz_destroy_query;
+   c->begin_query = zz_begin_query;
+   c->end_query = zz_end_query;
+   c->get_query_result = zz_query_result;
+   c->set_active_query_state = zz_query_state;
+   return c;
+}
+
+/*
+ * Screen: the caps are the GPU's, so its driver answers them
+ */
+static const char *zz_vendor(struct pipe_screen *s) { return "AMIX"; }
+static const char *zz_name(struct pipe_screen *s) { return "zz3660 (Z3660 core 1)"; }
+#define CAPS(s) (((struct zz_screen *)(s))->caps)
+/* softpipe's, less what the stream does not carry */
+static int
+zz_param(struct pipe_screen *s, enum pipe_cap p)
+{
+   if (p == PIPE_CAP_USER_VERTEX_BUFFERS)
+      return 0;         /* a pointer into this process means nothing on core 1 */
+   return CAPS(s)->get_param(CAPS(s), p);
+}
+static float zz_paramf(struct pipe_screen *s, enum pipe_capf p) { return CAPS(s)->get_paramf(CAPS(s), p); }
+static int zz_shader_param(struct pipe_screen *s, enum pipe_shader_type t, enum pipe_shader_cap p)
+{
+   /* softpipe's, less what the stream does not carry */
+   if (t == PIPE_SHADER_COMPUTE || p == PIPE_SHADER_CAP_MAX_SHADER_IMAGES ||
+       p == PIPE_SHADER_CAP_MAX_SHADER_BUFFERS || p == PIPE_SHADER_CAP_MAX_HW_ATOMIC_COUNTERS ||
+       p == PIPE_SHADER_CAP_MAX_HW_ATOMIC_COUNTER_BUFFERS)
+      return 0;
+   return CAPS(s)->get_shader_param(CAPS(s), t, p);
+}
+static boolean zz_format(struct pipe_screen *s, enum pipe_format f, enum pipe_texture_target t, unsigned sc,
+                         unsigned ssc, unsigned b)
+{
+   return CAPS(s)->is_format_supported(CAPS(s), f, t, sc, ssc, b);
+}
+static int zz_compute_param(struct pipe_screen *s, enum pipe_shader_ir ir, enum pipe_compute_cap p, void *r)
+{
+   return CAPS(s)->get_compute_param(CAPS(s), ir, p, r);
+}
+static void zz_fence_ref(struct pipe_screen *s, struct pipe_fence_handle **a, struct pipe_fence_handle *b) { *a = b; }
+static boolean
+zz_fence_finish(struct pipe_screen *s, struct pipe_context *c, struct pipe_fence_handle *f, uint64_t t)
+{
+   flush_cmds();
+   zzp_sync();
+   return TRUE;
+}
+static uint64_t zz_timestamp(struct pipe_screen *s) { return 0; }
+
+static void
+zz_flush_frontbuffer(struct pipe_screen *screen, struct pipe_resource *res, unsigned level, unsigned layer,
+                     void *priv, struct pipe_box *box)
+{
+   struct zz_screen *s = (struct zz_screen *)screen;
+   struct zz_resource *r = zr(res);
+   struct pipe_box all;
+   uint8_t *map;
+   unsigned y;
+
+   flush_cmds();
+   if (zzp_show(priv, r->id, res->width0, res->height0) || !data(r))
+      return;
+   u_box_2d(0, 0, res->width0, res->height0, &all);
+   fetch(r, level, &all);
+   map = s->ws->displaytarget_map(s->ws, r->dt, PIPE_TRANSFER_WRITE);
+   for (y = 0; y < res->height0; y++)
+      memcpy(map + y * r->dt_stride, r->data + r->offset[level] + y * r->stride[level], r->stride[level]);
+   s->ws->displaytarget_unmap(s->ws, r->dt);
+   s->ws->displaytarget_display(s->ws, r->dt, priv, box);
+}
+
+static void zz_screen_destroy(struct pipe_screen *s) { FREE(s); }
+
+struct pipe_screen *
+zz3660_create_screen(struct pipe_screen *caps, struct sw_winsys *ws)
+{
+   struct zz_screen *s = CALLOC_STRUCT(zz_screen);
+   struct pipe_screen *b = &s->base;
+
+   s->caps = caps;
+   s->ws = ws;
+   b->destroy = zz_screen_destroy;
+   b->get_name = zz_name;
+   b->get_vendor = zz_vendor;
+   b->get_device_vendor = zz_vendor;
+   b->get_param = zz_param;
+   b->get_paramf = zz_paramf;
+   b->get_shader_param = zz_shader_param;
+   b->is_format_supported = zz_format;
+   b->get_compute_param = zz_compute_param;
+   b->context_create = zz_context_create;
+   b->resource_create = zz_resource_create;
+   b->resource_destroy = zz_resource_destroy;
+   b->flush_frontbuffer = zz_flush_frontbuffer;
+   b->fence_reference = zz_fence_ref;
+   b->fence_finish = zz_fence_finish;
+   b->get_timestamp = zz_timestamp;
+   return b;
+}
diff --git a/src/gallium/drivers/zz3660/zz_exec.c b/src/gallium/drivers/zz3660/zz_exec.c
new file mode 100644
index 0000000..01201f9
--- /dev/null
+++ b/src/gallium/drivers/zz3660/zz_exec.c
@@ -0,0 +1,812 @@
+/*
+ * zz_exec.c -- the zz3660 executor: the command stream into a pipe_context.
+ * Nothing here knows which driver is underneath.
+ */
+#include <string.h>
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/u_memory.h"
+#include "util/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_box.h"
+#include "tgsi/tgsi_text.h"
+#include "zz_proto.h"
+#include "zz_fields.h"
+
+static struct pipe_screen *screen;
+static struct pipe_context *gp;
+static struct pipe_context *gps[ZZP_MAX_CONTEXTS];
+static void *obj[ZZP_MAX_OBJ];                  /* state objects, views, surfaces */
+static uint8_t kinds[ZZP_MAX_OBJ];              /* of obj: ZK_ */
+static struct pipe_resource *res[ZZP_MAX_OBJ];
+static void *cur_vs, *cur_fs;   /* the shaders bound */
+static int vbs_lost;            /* a vertex buffer bound that was refused */
+#define ZZ_TOKENS (1 << 18)
+static struct tgsi_token *tokens;     /* from the heap: the GL needs the room */
+static void *cbuf[PIPE_SHADER_TYPES][PIPE_MAX_CONSTANT_BUFFERS];
+static unsigned cbuf_size[PIPE_SHADER_TYPES][PIPE_MAX_CONSTANT_BUFFERS];
+static int swapped;                             /* the sender is big-endian */
+static const struct pipe_vertex_element *cur_ve;
+static struct { unsigned n; struct pipe_vertex_element e[PIPE_MAX_ATTRIBS]; } *ves[ZZP_MAX_OBJ];
+static struct pipe_vertex_buffer vbs[PIPE_MAX_ATTRIBS];
+static unsigned nvbs, cur_nve;
+static void *scratch[PIPE_MAX_ATTRIBS];
+static unsigned scratch_size[PIPE_MAX_ATTRIBS];
+/* what the draw needs of the other contexts */
+static struct {
+   const struct pipe_vertex_element *ve;
+   struct pipe_vertex_buffer vb[PIPE_MAX_ATTRIBS];
+   unsigned nvb, nve;
+} kept[ZZP_MAX_CONTEXTS];
+static unsigned cur_context;
+
+static inline uint32_t sw32(uint32_t v) { return __builtin_bswap32(v); }
+static inline float wf(uint32_t w) { union { uint32_t u; float f; } c; c.u = w; return c.f; }
+
+void
+zzp_exec_init(struct pipe_screen *s, int sw)
+{
+   screen = s;
+   swapped = sw;
+}
+
+#ifdef __z3660core__
+/* on the board: the stream is the 060's, big-endian */
+struct sw_winsys *null_sw_create(void);
+struct pipe_screen *softpipe_create_screen(struct sw_winsys *winsys);
+
+void
+zz3660_exec_start(void)
+{
+   if (!screen)
+      zzp_exec_init(softpipe_create_screen(null_sw_create()), 1);
+}
+
+/* Room left on the heap: the part never taken from it and the free blocks inside.
+   softpipe and Mesa do not look at every allocation, so resources may not take
+   the last of it: shaders and state still need some. */
+#include <malloc.h>
+#define ZZ_RESERVE (16u << 20)
+#define ZZ_SMALL (256u << 10)     /* a texture this size may still use it */
+extern char _heap_end[];
+void *_sbrk(int incr);          /* malloc's break; the BSP's sbrk keeps another */
+
+static size_t
+heap_left(void)
+{
+   return (size_t)(_heap_end - (char *)_sbrk(0)) + mallinfo().fordblks;
+}
+#endif
+
+/* whole elements of the format in place: bytes stay, 16 and 32 bits turn */
+static void
+swap_element(uint8_t *p, enum pipe_format format)
+{
+   const struct util_format_description *d = util_format_description(format);
+   const unsigned bytes = d->block.bits / 8, size = d->channel[0].size;
+   /* by channel; a packed format (10-10-10-2) as a whole */
+   const unsigned step = size == 8 || size == 16 || size == 32 ? size / 8 : bytes;
+   unsigned i;
+
+   if (step == 2)
+      for (i = 0; i + 2 <= bytes; i += 2) {
+         uint8_t t = p[i]; p[i] = p[i + 1]; p[i + 1] = t;
+      }
+   else if (step == 4)
+      for (i = 0; i + 4 <= bytes; i += 4) {
+         uint32_t v;
+         memcpy(&v, p + i, 4);
+         v = sw32(v);
+         memcpy(p + i, &v, 4);
+      }
+}
+
+/* pixels of the format differ between the byte orders: over a byte each and not
+   an array of bytes */
+static boolean
+pixels_turn(enum pipe_format format)
+{
+   const struct util_format_description *d = util_format_description(format);
+
+   return swapped && d->block.bits > 8 && d->channel[0].size != 8;
+}
+
+/* the vertex buffers of a draw, in this CPU's order, for vertices first..last */
+static void
+vertices(unsigned first, unsigned last)
+{
+   struct pipe_vertex_buffer vb[PIPE_MAX_ATTRIBS];
+   unsigned b, e, v;
+
+   for (b = 0; b < nvbs; b++) {
+      const unsigned stride = vbs[b].stride;
+      const unsigned off = vbs[b].buffer_offset + first * stride;
+      const uint64_t want = ((uint64_t)(last - first) + 1) * MAX2(stride, 64);
+      struct pipe_transfer *t;
+      struct pipe_box box;
+      const uint8_t *src;
+      unsigned have, size;
+
+      vb[b] = vbs[b];
+      if (!vbs[b].buffer.resource)
+         continue;
+      have = vbs[b].buffer.resource->width0 - MIN2(off, vbs[b].buffer.resource->width0);
+      size = MAX2(MIN2(want, have), 64);
+      if (size > scratch_size[b]) {
+         FREE(scratch[b]);
+         scratch[b] = MALLOC(size);
+         scratch_size[b] = size;
+      }
+      u_box_1d(off, MIN2(size, have), &box);
+      src = gp->transfer_map(gp, vbs[b].buffer.resource, 0, PIPE_TRANSFER_READ, &box, &t);
+      memcpy(scratch[b], src, box.width);
+      gp->transfer_unmap(gp, t);
+      for (e = 0; e < cur_nve; e++)
+         if (cur_ve[e].vertex_buffer_index == b) {
+            const unsigned bytes = util_format_get_blocksize(cur_ve[e].src_format);
+
+            /* stride 0: one value for all, to turn once; never past what came */
+            for (v = 0; v <= (stride ? last - first : 0); v++) {
+               const uint64_t at = (uint64_t)v * stride + cur_ve[e].src_offset;
+
+               if (at + bytes > box.width)
+                  break;
+               swap_element((uint8_t *)scratch[b] + at, cur_ve[e].src_format);
+            }
+         }
+      vb[b].is_user_buffer = true;
+      vb[b].buffer.user = (const uint8_t *)scratch[b] - (ptrdiff_t)first * stride;
+      vb[b].buffer_offset = 0;
+   }
+   gp->set_vertex_buffers(gp, 0, nvbs, vb);
+}
+
+/* glDrawElements with all arrays in buffers: the state tracker has no need of
+   the bounds and sends ~0; vertices() does */
+static void
+index_bounds(struct pipe_draw_info *d, const void *indices)
+{
+   unsigned lo = ~0u, hi = 0, i, k;
+
+   for (i = 0; i < d->count; i++) {
+      k = d->index_size == 1 ? ((const uint8_t *)indices)[i] :
+          d->index_size == 2 ? ((const uint16_t *)indices)[i] : ((const uint32_t *)indices)[i];
+      if (d->primitive_restart && k == d->restart_index)
+         continue;
+      lo = MIN2(lo, k);
+      hi = MAX2(hi, k);
+   }
+   d->min_index = lo > hi ? 0 : lo;
+   d->max_index = hi;
+}
+
+static void
+draw(const uint32_t *w, unsigned n)
+{
+   struct pipe_draw_info d;
+   void *indices = NULL;
+
+   memset(&d, 0, sizeof(d));
+   d.mode = w[0];
+   d.index_size = w[1];
+   d.start = w[2];
+   d.count = w[3];
+   d.start_instance = w[4];
+   d.instance_count = w[5];
+   d.index_bias = (int)w[6];
+   d.min_index = w[7];
+   d.max_index = w[8];
+   d.primitive_restart = w[9];
+   d.restart_index = w[10];
+   if (d.index_size) {
+      const unsigned bytes = d.count * d.index_size;
+      unsigned i;
+
+      /* the indices came with the command, words of the sender */
+      indices = MALLOC(bytes + 4);
+      memcpy(indices, &w[11], bytes);
+      if (swapped) {
+         if (d.index_size == 2)
+            for (i = 0; i < d.count; i++)
+               ((uint16_t *)indices)[i] = __builtin_bswap16(((uint16_t *)indices)[i]);
+         else if (d.index_size == 4)
+            for (i = 0; i < d.count; i++)
+               ((uint32_t *)indices)[i] = sw32(((uint32_t *)indices)[i]);
+      }
+      d.has_user_indices = true;
+      d.index.user = indices;
+      if (d.max_index == ~0u)
+         index_bounds(&d, indices);
+   }
+   if (swapped) {
+      if (d.index_size)
+         vertices(d.min_index + d.index_bias, d.max_index + d.index_bias);
+      else
+         vertices(d.start, d.start + d.count - 1);
+   }
+   gp->draw_vbo(gp, &d);
+   FREE(indices);
+}
+
+static void
+res_write(const uint32_t *w)
+{
+   struct pipe_box box;
+
+   if (!res[w[0]])                 /* refused: the data goes nowhere */
+      return;
+   u_box_3d(w[2], w[3], w[4], w[5], w[6], w[7], &box);
+   if (res[w[0]]->target == PIPE_BUFFER)
+      gp->buffer_subdata(gp, res[w[0]], PIPE_TRANSFER_WRITE, box.x, box.width, &w[10]);
+   else {
+      if (pixels_turn(res[w[0]]->format)) {
+         const unsigned bytes = util_format_get_blocksize(res[w[0]]->format);
+         unsigned i;
+
+         for (i = 0; i + bytes <= w[8] * box.height * box.depth; i += bytes)
+            swap_element((uint8_t *)&w[10] + i, res[w[0]]->format);
+      }
+      gp->texture_subdata(gp, res[w[0]], w[1], PIPE_TRANSFER_WRITE, &box, &w[10], w[8], w[9]);
+   }
+}
+
+static void
+res_read(const uint32_t *w, void *reply)
+{
+   struct pipe_transfer *t;
+   struct pipe_box box;
+   const uint8_t *src;
+   unsigned y;
+
+   u_box_3d(w[2], w[3], w[4], w[5], w[6], w[7], &box);
+   if (!res[w[0]]) {               /* refused: zeros, but the 060 has its answer */
+      memset(reply, 0, (size_t)w[8] * box.height);
+      return;
+   }
+   gp->flush(gp, NULL, 0);
+   src = gp->transfer_map(gp, res[w[0]], w[1], PIPE_TRANSFER_READ, &box, &t);
+   for (y = 0; y < box.height; y++) {
+      uint8_t *row = (uint8_t *)reply + y * w[8];
+
+      memcpy(row, src + y * t->stride, w[8]);
+      if (pixels_turn(res[w[0]]->format)) {
+         const unsigned bytes = util_format_get_blocksize(res[w[0]]->format);
+         unsigned i;
+
+         for (i = 0; i + bytes <= w[8]; i += bytes)
+            swap_element(row + i, res[w[0]]->format);
+      }
+   }
+   gp->transfer_unmap(gp, t);
+}
+
+#ifdef __z3660core__
+/* the frame to the board's output, in the order it wants: bottom row first.
+   again: the same frame, no new one to count */
+static uint32_t shown;
+
+static void
+present(uint32_t id, int again)
+{
+   static uint8_t *rgba;
+   static unsigned size;
+   struct pipe_resource *r = res[id];
+   unsigned w, h;
+   struct pipe_transfer *t;
+   struct pipe_box box;
+   const uint8_t *src;
+   unsigned y;
+
+   if (!r) {
+      zzp_refused(0x7ffe0000u, id);
+      return;
+   }
+   w = r->width0;
+   h = r->height0;
+   gp->flush(gp, NULL, 0);
+   if (w * h * 4 > size) {
+      FREE(rgba);
+      size = w * h * 4;
+      rgba = MALLOC(size);
+      if (!rgba) {
+         zzp_refused(0x7fff0000u, w << 16 | h);
+         size = 0;
+         return;
+      }
+   }
+   u_box_2d(0, 0, w, h, &box);
+   src = gp->transfer_map(gp, r, 0, PIPE_TRANSFER_READ, &box, &t);
+   for (y = 0; y < h; y++)
+      util_format_read_4ub(r->format, rgba + (h - 1 - y) * w * 4, w * 4, src + y * t->stride, t->stride,
+                           0, 0, w, 1);
+   gp->transfer_unmap(gp, t);
+   shown = id;
+   zzp_present(rgba, w, h, again);
+}
+
+/* the ring is empty: the display keeps being fed, as a real one scans out.  One
+   frame alone does not reach the screen; a program that draws once has no more */
+void
+zz3660_idle(void)
+{
+   extern unsigned long long armgl_now_us(void);
+   static unsigned long long next;
+   const unsigned long long t = armgl_now_us();
+
+   if (t < next || !gp || !shown || !res[shown])
+      return;
+   next = t + 200000;
+   present(shown, 1);
+}
+#endif
+
+#define GI(x) s.x = *w++;
+#define GF(x) s.x = wf(*w++);
+
+static void
+drop(unsigned i)
+{
+   void *o = obj[i];
+
+   if (!o)
+      return;
+   switch (kinds[i]) {
+   case ZK_BLEND: gp->delete_blend_state(gp, o); break;
+   case ZK_DSA: gp->delete_depth_stencil_alpha_state(gp, o); break;
+   case ZK_RAST: gp->delete_rasterizer_state(gp, o); break;
+   case ZK_SAMPLER: gp->delete_sampler_state(gp, o); break;
+   case ZK_VELEMS: gp->delete_vertex_elements_state(gp, o); break;
+   case ZK_VS: gp->delete_vs_state(gp, o); break;
+   case ZK_FS: gp->delete_fs_state(gp, o); break;
+   case ZK_GS: gp->delete_gs_state(gp, o); break;
+   case ZK_VIEW: {
+      struct pipe_sampler_view *v = o;
+      pipe_sampler_view_reference(&v, NULL);
+      break;
+   }
+   case ZK_SURFACE: {
+      struct pipe_surface *v = o;
+      pipe_surface_reference(&v, NULL);
+      break;
+   }
+   }
+   obj[i] = NULL;
+}
+
+/* a new client: nothing of the last one stays behind.  Views and surfaces hold
+   their resources: all objects go first, or the textures stay for good */
+static void
+release(void)
+{
+   unsigned i;
+
+#ifdef __z3660core__
+   shown = 0;
+#endif
+   cur_vs = cur_fs = NULL;
+   vbs_lost = 0;
+   if (!gp)
+      return;
+   for (i = 0; i < ZZP_MAX_OBJ; i++)
+      drop(i);
+   for (i = 0; i < ZZP_MAX_OBJ; i++) {
+      pipe_resource_reference(&res[i], NULL);
+      FREE(ves[i]);
+      ves[i] = NULL;
+   }
+   for (i = 0; i < ZZP_MAX_CONTEXTS; i++) {
+      if (gps[i])
+         gps[i]->destroy(gps[i]);
+      gps[i] = NULL;
+   }
+   memset(kept, 0, sizeof(kept));
+   cur_context = 0;
+   gp = NULL;
+   cur_ve = NULL;
+   cur_nve = 0;
+   nvbs = 0;
+}
+
+static void
+context(unsigned id)
+{
+   kept[cur_context].ve = cur_ve;
+   kept[cur_context].nve = cur_nve;
+   kept[cur_context].nvb = nvbs;
+   memcpy(kept[cur_context].vb, vbs, sizeof(vbs));
+   if (!gps[id])
+      gps[id] = screen->context_create(screen, NULL, 0);
+   gp = gps[id];
+   cur_context = id;
+   cur_ve = kept[id].ve;
+   cur_nve = kept[id].nve;
+   nvbs = kept[id].nvb;
+   memcpy(vbs, kept[id].vb, sizeof(vbs));
+}
+
+static void
+command(unsigned op, const uint32_t *w, unsigned n, void *reply)
+{
+   unsigned i;
+
+   switch (op) {
+   case ZP_OPEN:
+      /* a new client: nothing of the last one stays behind */
+      release();
+      gps[0] = gp = screen->context_create(screen, NULL, 0);
+      break;
+   case ZP_CONTEXT:
+      context(w[0] % ZZP_MAX_CONTEXTS);
+      break;
+   case ZP_RES_CREATE: {
+      struct pipe_resource t;
+
+      memset(&t, 0, sizeof(t));
+      t.target = w[1]; t.format = w[2]; t.width0 = w[3]; t.height0 = w[4]; t.depth0 = w[5];
+      t.array_size = w[6]; t.last_level = w[7]; t.nr_samples = w[8]; t.usage = w[9];
+      t.bind = w[10] & ~(PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_SCANOUT | PIPE_BIND_SHARED);
+      t.flags = w[11];
+      res[w[0]] = screen->resource_create(screen, &t);
+#ifdef __z3660core__
+      /* the reserve is not for textures: those a program can pile up (Mesa
+         marks most of them RENDER_TARGET too); buffers, depth buffers and the
+         window's colour buffer (DISPLAY_TARGET, as the 060 sent it) may use it,
+         and so may small textures: glyphs and the like still draw */
+      if (res[w[0]] && t.target != PIPE_BUFFER &&
+          !(w[10] & (PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_DEPTH_STENCIL)) &&
+          (uint64_t)util_format_get_stride(t.format, t.width0) *
+          util_format_get_nblocksy(t.format, t.height0) * t.depth0 * t.array_size > ZZ_SMALL &&
+          heap_left() < ZZ_RESERVE)
+         pipe_resource_reference(&res[w[0]], NULL);
+      if (!res[w[0]])
+         zzp_refused(t.format << 16 | (t.bind & 0xfff) << 4 | t.target, w[3] << 16 | w[4]);
+#endif
+      break;
+   }
+   case ZP_RES_DESTROY:
+      pipe_resource_reference(&res[w[0]], NULL);
+      break;
+   case ZP_RES_WRITE:
+      res_write(w);
+      break;
+   case ZP_RES_READ:
+      res_read(w, reply);
+      break;
+   case ZP_BLEND: {
+      struct pipe_blend_state b;
+      const uint32_t id = *w++;
+
+      memset(&b, 0, sizeof(b));
+      b.independent_blend_enable = *w++; b.logicop_enable = *w++; b.logicop_func = *w++;
+      b.dither = *w++; b.alpha_to_coverage = *w++; b.alpha_to_one = *w++;
+      for (i = 0; i < PIPE_MAX_COLOR_BUFS; i++) {
+#define GR(x) b.rt[i].x = *w++;
+         ZZP_RTBLEND(GR, GR)
+      }
+      kinds[id] = ZK_BLEND;
+      obj[id] = gp->create_blend_state(gp, &b);
+      break;
+   }
+   case ZP_DSA: {
+      struct pipe_depth_stencil_alpha_state d;
+      const uint32_t id = *w++;
+
+      memset(&d, 0, sizeof(d));
+#define GD(x) d.depth.x = *w++;
+#define GDF(x) d.depth.x = wf(*w++);
+      ZZP_DEPTH(GD, GDF)
+#define GS0(x) d.stencil[0].x = *w++;
+#define GS1(x) d.stencil[1].x = *w++;
+      ZZP_STENCIL(GS0, GS0)
+      ZZP_STENCIL(GS1, GS1)
+#define GA(x) d.alpha.x = *w++;
+#define GAF(x) d.alpha.x = wf(*w++);
+      ZZP_ALPHA(GA, GAF)
+      kinds[id] = ZK_DSA;
+      obj[id] = gp->create_depth_stencil_alpha_state(gp, &d);
+      break;
+   }
+   case ZP_RAST: {
+      struct pipe_rasterizer_state s;
+      const uint32_t id = *w++;
+
+      memset(&s, 0, sizeof(s));
+      ZZP_RAST(GI, GF)
+      kinds[id] = ZK_RAST;
+      obj[id] = gp->create_rasterizer_state(gp, &s);
+      break;
+   }
+   case ZP_SAMPLER: {
+      struct pipe_sampler_state s;
+      const uint32_t id = *w++;
+
+      memset(&s, 0, sizeof(s));
+      ZZP_SAMPLER(GI, GF)
+      for (i = 0; i < 4; i++)
+         s.border_color.ui[i] = *w++;
+      kinds[id] = ZK_SAMPLER;
+      obj[id] = gp->create_sampler_state(gp, &s);
+      break;
+   }
+   case ZP_VELEMS: {
+      const uint32_t id = *w++, c = *w++;
+
+      if (!ves[id])
+         ves[id] = MALLOC(sizeof(*ves[id]));
+      ves[id]->n = c;
+      for (i = 0; i < c; i++) {
+         struct pipe_vertex_element *e = &ves[id]->e[i];
+
+         memset(e, 0, sizeof(*e));
+         e->src_offset = *w++; e->vertex_buffer_index = *w++;
+         e->src_format = *w++; e->instance_divisor = *w++;
+      }
+      kinds[id] = ZK_VELEMS;
+      obj[id] = gp->create_vertex_elements_state(gp, c, ves[id]->e);
+      break;
+   }
+   case ZP_SHADER: {
+      struct pipe_shader_state s;
+      const uint32_t id = w[0], kind = w[1];
+
+      memset(&s, 0, sizeof(s));
+      s.type = PIPE_SHADER_IR_TGSI;
+      if (!tokens)
+         tokens = MALLOC(ZZ_TOKENS * sizeof(*tokens));
+      if (!tgsi_text_translate((const char *)&w[3], tokens, ZZ_TOKENS))
+         break;
+      s.tokens = tokens;
+      kinds[id] = kind;
+      obj[id] = kind == ZK_VS ? gp->create_vs_state(gp, &s) :
+                kind == ZK_FS ? gp->create_fs_state(gp, &s) : gp->create_gs_state(gp, &s);
+      break;
+   }
+   case ZP_VIEW: {
+      struct pipe_sampler_view t;
+
+      memset(&t, 0, sizeof(t));
+      t.format = w[2]; t.u.tex.first_layer = w[3]; t.u.tex.last_layer = w[4];
+      t.u.tex.first_level = w[5]; t.u.tex.last_level = w[6];
+      t.swizzle_r = w[7]; t.swizzle_g = w[8]; t.swizzle_b = w[9]; t.swizzle_a = w[10];
+      t.target = w[11];
+      if (!res[w[1]])
+         break;
+      kinds[w[0]] = ZK_VIEW;
+      obj[w[0]] = gp->create_sampler_view(gp, res[w[1]], &t);
+      break;
+   }
+   case ZP_SURFACE: {
+      struct pipe_surface t;
+
+      memset(&t, 0, sizeof(t));
+      t.format = w[2]; t.u.tex.level = w[3]; t.u.tex.first_layer = w[4]; t.u.tex.last_layer = w[5];
+      if (!res[w[1]])
+         break;
+      kinds[w[0]] = ZK_SURFACE;
+      obj[w[0]] = gp->create_surface(gp, res[w[1]], &t);
+      break;
+   }
+   case ZP_FREE:
+      kinds[w[0]] = w[1];
+      drop(w[0]);
+      break;
+   case ZP_BIND: {
+      void *o = w[1] ? obj[w[1]] : NULL;
+
+      switch (w[0]) {
+      case ZK_BLEND: gp->bind_blend_state(gp, o); break;
+      case ZK_DSA: gp->bind_depth_stencil_alpha_state(gp, o); break;
+      case ZK_RAST: gp->bind_rasterizer_state(gp, o); break;
+      case ZK_VELEMS:
+         gp->bind_vertex_elements_state(gp, o);
+         cur_ve = w[1] ? ves[w[1]]->e : NULL;
+         cur_nve = w[1] ? ves[w[1]]->n : 0;
+         break;
+      case ZK_VS: gp->bind_vs_state(gp, o); cur_vs = o; break;
+      case ZK_FS: gp->bind_fs_state(gp, o); cur_fs = o; break;
+      case ZK_GS: gp->bind_gs_state(gp, o); break;
+      }
+      break;
+   }
+   case ZP_BIND_SAMPLERS: {
+      void *s[PIPE_MAX_SAMPLERS];
+
+      for (i = 0; i < w[2]; i++)
+         s[i] = w[3 + i] ? obj[w[3 + i]] : NULL;
+      gp->bind_sampler_states(gp, w[0], w[1], w[2], s);
+      break;
+   }
+   case ZP_SET_VIEWS: {
+      struct pipe_sampler_view *v[PIPE_MAX_SHADER_SAMPLER_VIEWS];
+
+      for (i = 0; i < w[2]; i++)
+         v[i] = w[3 + i] ? obj[w[3 + i]] : NULL;
+      gp->set_sampler_views(gp, w[0], w[1], w[2], v);
+      break;
+   }
+   case ZP_FRAMEBUFFER: {
+      struct pipe_framebuffer_state f;
+
+      memset(&f, 0, sizeof(f));
+      f.width = w[0]; f.height = w[1]; f.nr_cbufs = w[2];
+      f.layers = w[3]; f.samples = w[4];
+      f.zsbuf = w[5] ? obj[w[5]] : NULL;
+      for (i = 0; i < f.nr_cbufs; i++)
+         f.cbufs[i] = w[6 + i] ? obj[w[6 + i]] : NULL;
+      gp->set_framebuffer_state(gp, &f);
+      break;
+   }
+   case ZP_VIEWPORT: {
+      struct pipe_viewport_state v;
+
+      for (i = 0; i < 3; i++) {
+         v.scale[i] = wf(w[i]);
+         v.translate[i] = wf(w[3 + i]);
+      }
+      gp->set_viewport_states(gp, 0, 1, &v);
+      break;
+   }
+   case ZP_SCISSOR: {
+      struct pipe_scissor_state s;
+
+      s.minx = w[0]; s.miny = w[1]; s.maxx = w[2]; s.maxy = w[3];
+      gp->set_scissor_states(gp, 0, 1, &s);
+      break;
+   }
+   case ZP_BLEND_COLOR: {
+      struct pipe_blend_color c;
+
+      for (i = 0; i < 4; i++)
+         c.color[i] = wf(w[i]);
+      gp->set_blend_color(gp, &c);
+      break;
+   }
+   case ZP_STENCIL_REF: {
+      struct pipe_stencil_ref r;
+
+      r.ref_value[0] = w[0]; r.ref_value[1] = w[1];
+      gp->set_stencil_ref(gp, &r);
+      break;
+   }
+   case ZP_SAMPLE_MASK:
+      gp->set_sample_mask(gp, w[0]);
+      break;
+   case ZP_CLIP: {
+      struct pipe_clip_state c;
+
+      memcpy(c.ucp, w, sizeof(c.ucp));
+      gp->set_clip_state(gp, &c);
+      break;
+   }
+   case ZP_STIPPLE: {
+      struct pipe_poly_stipple p;
+
+      memcpy(p.stipple, w, sizeof(p.stipple));
+      gp->set_polygon_stipple(gp, &p);
+      break;
+   }
+   case ZP_CONSTBUF: {
+      /* shader, index, bytes, words: always inline, whole words */
+      struct pipe_constant_buffer c;
+
+      memset(&c, 0, sizeof(c));
+      /* softpipe keeps the pointer, past this batch of commands */
+      if (w[2] > cbuf_size[w[0]][w[1]]) {
+         FREE(cbuf[w[0]][w[1]]);
+         cbuf[w[0]][w[1]] = MALLOC(w[2]);
+         cbuf_size[w[0]][w[1]] = w[2];
+      }
+      if (w[2])
+         memcpy(cbuf[w[0]][w[1]], &w[3], w[2]);
+      c.buffer_size = w[2];
+      c.user_buffer = c.buffer_size ? cbuf[w[0]][w[1]] : NULL;
+      gp->set_constant_buffer(gp, w[0], w[1], c.buffer_size ? &c : NULL);
+      break;
+   }
+   case ZP_VBUFS:
+      vbs_lost = 0;
+      nvbs = w[0];
+      for (i = 0; i < nvbs; i++) {
+         memset(&vbs[i], 0, sizeof(vbs[i]));
+         vbs[i].stride = w[1 + i * 3];
+         vbs[i].buffer_offset = w[2 + i * 3];
+         vbs[i].buffer.resource = w[3 + i * 3] ? res[w[3 + i * 3]] : NULL;
+         if (w[3 + i * 3] && !vbs[i].buffer.resource)
+            vbs_lost = 1;
+      }
+      if (!swapped)
+         gp->set_vertex_buffers(gp, 0, nvbs, vbs);
+      break;
+   case ZP_DRAW:
+      /* a shader the sender could not make (out of memory there): no draw,
+         softpipe would take the missing one for granted */
+      if (cur_vs && cur_fs && !vbs_lost)
+         draw(w, n);
+      break;
+   case ZP_CLEAR: {
+      union pipe_color_union c;
+      double d;
+
+      memcpy(&c, &w[1], sizeof(c));
+      d = wf(w[5]);
+      gp->clear(gp, w[0], &c, d, w[6]);
+      break;
+   }
+   case ZP_CLEAR_RT: {
+      union pipe_color_union c;
+
+      memcpy(&c, &w[1], sizeof(c));
+      if (!obj[w[0]])
+         break;
+      gp->clear_render_target(gp, obj[w[0]], &c, w[5], w[6], w[7], w[8], false);
+      break;
+   }
+   case ZP_CLEAR_DS:
+      if (!obj[w[0]])
+         break;
+      gp->clear_depth_stencil(gp, obj[w[0]], w[1], wf(w[2]), w[3], w[4], w[5], w[6], w[7], false);
+      break;
+   case ZP_COPY: {
+      struct pipe_box b;
+
+      u_box_3d(w[6], w[7], w[8], w[9], w[10], w[11], &b);
+      if (!res[w[0]] || !res[w[12]])
+         break;
+      gp->resource_copy_region(gp, res[w[0]], w[1], w[2], w[3], w[4], res[w[12]], w[5], &b);
+      break;
+   }
+   case ZP_BLIT: {
+      struct pipe_blit_info b;
+
+      memset(&b, 0, sizeof(b));
+      b.dst.resource = res[w[0]]; b.dst.level = w[1]; b.dst.format = w[2];
+      u_box_3d(w[3], w[4], w[5], w[6], w[7], w[8], &b.dst.box);
+      b.src.resource = res[w[9]]; b.src.level = w[10]; b.src.format = w[11];
+      u_box_3d(w[12], w[13], w[14], w[15], w[16], w[17], &b.src.box);
+      b.mask = w[18]; b.filter = w[19]; b.scissor_enable = 0;
+      if (b.dst.resource && b.src.resource)
+         gp->blit(gp, &b);
+      break;
+   }
+   case ZP_FLUSH:
+      gp->flush(gp, NULL, 0);
+      break;
+#ifdef __z3660core__
+   case ZP_PRESENT:
+      present(w[0], 0);
+      break;
+#endif
+   }
+}
+
+/* a new client, of either kind */
+void
+zz3660_forget(void)
+{
+   release();
+}
+
+/* whole commands; payloads (ZP_RES_WRITE, ZP_DRAW, ZP_SHADER) keep their byte order */
+void
+zzp_exec(uint32_t *words, unsigned n, void *reply)
+{
+   unsigned i = 0, k;
+
+   while (i < n) {
+      unsigned head = words[i], len, op, turn;
+
+      if (swapped)
+         head = sw32(head);
+      op = head & 255;
+      len = head >> 8;
+      if (swapped) {
+         turn = op == ZP_RES_WRITE ? MIN2(len, 10) : op == ZP_DRAW ? MIN2(len, 11) :
+                op == ZP_SHADER ? MIN2(len, 3) : len;
+         for (k = 0; k < turn; k++)
+            words[i + 1 + k] = sw32(words[i + 1 + k]);
+      }
+      command(op, &words[i + 1], len, reply);
+      i += 1 + len;
+   }
+}
