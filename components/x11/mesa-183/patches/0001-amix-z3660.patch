+/**
+ * subtriangle() for the fast path: the same spans, drawn at once.
+ */
+static void
+fast_subtriangle(struct setup_context *setup,
+                 struct edge *eleft,
+                 struct edge *eright,
+                 int lines)
+{
+   const struct pipe_scissor_state *cliprect = &setup->softpipe->cliprect[0];
+   const int minx = (int) cliprect->minx;
+   const int maxx = (int) cliprect->maxx;
+   const int miny = (int) cliprect->miny;
+   const int maxy = (int) cliprect->maxy;
+   int y, start_y, finish_y;
+   int sy = (int)eleft->sy;
+
+   start_y = sy < miny ? miny : sy;
+   finish_y = sy + lines > maxy ? maxy : sy + lines;
+
+   for (y = start_y - sy; y < finish_y - sy; y++) {
+      int left = (int)(eleft->sx + y * eleft->dxdy);
+      int right = (int)(eright->sx + y * eright->dxdy);
+
+      if (left < minx)
+         left = minx;
+      if (right > maxx)
+         right = maxx;
+      if (left < right)
+         sp_fast_span(&setup->fast, setup->coef, &setup->posCoef, sy + y, left, right);
+   }
+
+   eleft->sx += lines * eleft->dxdy;
+   eright->sx += lines * eright->dxdy;
+   eleft->sy += lines;
+   eright->sy += lines;
+}
