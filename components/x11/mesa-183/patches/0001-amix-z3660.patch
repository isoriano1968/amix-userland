+static void
+zz_set_constant_buffer(struct pipe_context *c, enum pipe_shader_type sh, unsigned index,
+                       const struct pipe_constant_buffer *cb)
+{
+   const unsigned size = cb ? cb->buffer_size : 0;
+   const void *data = NULL;
+   uint32_t *p;
+
+   if (cb)
+      data = cb->user_buffer ? cb->user_buffer :
+             cb->buffer ? zr(cb->buffer)->data + cb->buffer_offset : NULL;
+   p = ccmd(c, ZP_CONSTBUF, 3 + (size + 3) / 4);
+   p[0] = sh; p[1] = index; p[2] = data ? size : 0;
+   if (data)
+      memcpy(&p[3], data, size);
+}
+
+static void
+zz_set_vertex_buffers(struct pipe_context *c, unsigned start, unsigned n, const struct pipe_vertex_buffer *b)
+{
+   uint32_t *p = ccmd(c, ZP_VBUFS, 1 + n * 3);
+   unsigned i;
+
+   p[0] = n;
+   for (i = 0; i < n; i++) {
+      p[1 + i * 3] = b ? b[i].stride : 0;
+      p[2 + i * 3] = b ? b[i].buffer_offset : 0;
+      p[3 + i * 3] = b && b[i].buffer.resource ? zr(b[i].buffer.resource)->id : 0;
+   }
+}
+
+static void
+zz_draw_vbo(struct pipe_context *c, const struct pipe_draw_info *d)
+{
+   const unsigned bytes = d->index_size * d->count;
+   const uint8_t *idx = NULL;
+   uint32_t *p;
+
+   if (d->index_size)
+      idx = (d->has_user_indices ? (const uint8_t *)d->index.user : zr(d->index.resource)->data) +
+            (d->has_user_indices ? 0 : d->start * d->index_size);
+   p = ccmd(c, ZP_DRAW, 11 + (bytes + 3) / 4);
+   p[0] = d->mode; p[1] = d->index_size;
+   p[2] = d->index_size ? 0 : d->start;
+   p[3] = d->count; p[4] = d->start_instance; p[5] = d->instance_count;
+   p[6] = d->index_bias; p[7] = d->min_index; p[8] = d->max_index;
+   p[9] = d->primitive_restart; p[10] = d->restart_index;
+   if (bytes)
+      memcpy(&p[11], idx, bytes);
+   drew();
+}
