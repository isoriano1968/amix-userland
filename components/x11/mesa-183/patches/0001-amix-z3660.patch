+static void
+zz_clear(struct pipe_context *c, unsigned buffers, const union pipe_color_union *col, double depth,
+         unsigned stencil)
+{
+   uint32_t *p = ccmd(c, ZP_CLEAR, 7);
+
+   p[0] = buffers;
+   memcpy(&p[1], col, 16);
+   p[5] = fw(depth);
+   p[6] = stencil;
+   drew();
+}
