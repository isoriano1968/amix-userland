+static void
+zz_bind_samplers(struct pipe_context *c, enum pipe_shader_type sh, unsigned start, unsigned n, void **s)
+{
+   uint32_t *p = ccmd(c, ZP_BIND_SAMPLERS, 3 + n);
+   unsigned i;
+
+   p[0] = sh; p[1] = start; p[2] = n;
+   for (i = 0; i < n; i++)
+      p[3 + i] = s ? (uint32_t)(uintptr_t)s[i] : 0;
+}
