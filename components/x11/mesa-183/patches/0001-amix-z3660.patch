diff --git a/src/gallium/auxiliary/draw/draw_vs_fast.c b/src/gallium/auxiliary/draw/draw_vs_fast.c
new file mode 100644
index 0000000..a437cfb
--- /dev/null
+++ b/src/gallium/auxiliary/draw/draw_vs_fast.c
@@ -0,0 +1,361 @@
+/*
+ * draw_vs_fast.c -- see draw_vs_fast.h.
+ *
+ * Registers live in one array of float[4]: inputs, temporaries, outputs,
+ * immediates, then the constants of buffer 0 (copied in per run).  The
+ * maths is tgsi_exec's (powf, logf), so the results are the same.
+ */
+#include "draw_vs_fast.h"
+#include "pipe/p_shader_tokens.h"
+#include "tgsi/tgsi_parse.h"
+#include "tgsi/tgsi_scan.h"
+#include "tgsi/tgsi_util.h"
+#include "util/u_debug.h"
+#include "util/u_math.h"
+#include "util/u_memory.h"
+
+#define VSF_MAX_REGS 1024
+
+struct vsf_src {
+   unsigned short reg;
+   unsigned char swz[4];
+   unsigned char neg, abs;
+   unsigned char plain;          /* no swizzle, no modifiers */
+};
+
+struct vsf_op {
+   unsigned short opcode;
+   unsigned char wmask, sat;
+   unsigned short dst;
+   unsigned char nsrc;
+   struct vsf_src src[3];
+};
+
+struct draw_vs_fast {
+   struct vsf_op *ops;
+   unsigned nops;
+   unsigned nregs;
+   unsigned in_base, ninputs;
+   unsigned temp_base;
+   unsigned out_base, noutputs;
+   unsigned imm_base;
+   unsigned const_base, nconsts;
+   boolean out_color[PIPE_MAX_SHADER_OUTPUTS];
+   float (*init)[4];             /* immediates, set once */
+};
+
+static boolean
+op_supported(unsigned opcode, unsigned *nsrc)
+{
+   switch (opcode) {
+   case TGSI_OPCODE_MOV: case TGSI_OPCODE_RSQ: case TGSI_OPCODE_RCP: case TGSI_OPCODE_SQRT:
+   case TGSI_OPCODE_FLR: case TGSI_OPCODE_FRC: case TGSI_OPCODE_EX2: case TGSI_OPCODE_LG2:
+   case TGSI_OPCODE_LIT:
+      *nsrc = 1;
+      return TRUE;
+   case TGSI_OPCODE_ADD: case TGSI_OPCODE_MUL: case TGSI_OPCODE_DP2: case TGSI_OPCODE_DP3:
+   case TGSI_OPCODE_DP4: case TGSI_OPCODE_MAX: case TGSI_OPCODE_MIN: case TGSI_OPCODE_SLT:
+   case TGSI_OPCODE_SGE: case TGSI_OPCODE_SEQ: case TGSI_OPCODE_SNE: case TGSI_OPCODE_POW:
+      *nsrc = 2;
+      return TRUE;
+   case TGSI_OPCODE_MAD: case TGSI_OPCODE_LRP: case TGSI_OPCODE_CMP:
+      *nsrc = 3;
+      return TRUE;
+   default:
+      return FALSE;
+   }
+}
+
+struct draw_vs_fast *
+draw_vs_fast_compile(const struct tgsi_token *tokens, const struct tgsi_shader_info *info)
+{
+   struct draw_vs_fast *p;
+   struct tgsi_parse_context parse;
+   unsigned i, nimm = 0, max_ops, ntemps, nconsts;
+   boolean ok = TRUE;
+
+   if (debug_get_bool_option("DRAW_NO_FAST_VS", FALSE))
+      return NULL;
+   if (info->num_system_values || info->indirect_files || info->uses_kill ||
+       info->file_max[TGSI_FILE_SAMPLER] >= 0 || info->file_max[TGSI_FILE_SAMPLER_VIEW] >= 0 ||
+       info->file_max[TGSI_FILE_ADDRESS] >= 0 || info->num_outputs > PIPE_MAX_SHADER_OUTPUTS ||
+       info->const_buffers_declared > 1)
+      return NULL;
+
+   ntemps = info->file_max[TGSI_FILE_TEMPORARY] + 1;
+   nconsts = info->file_max[TGSI_FILE_CONSTANT] + 1;
+   max_ops = info->num_instructions;
+
+   p = CALLOC_STRUCT(draw_vs_fast);
+   if (!p)
+      return NULL;
+   p->ninputs = info->num_inputs;
+   p->noutputs = info->num_outputs;
+   p->in_base = 0;
+   p->temp_base = p->in_base + MAX2(p->ninputs, info->file_max[TGSI_FILE_INPUT] + 1);
+   p->out_base = p->temp_base + ntemps;
+   p->imm_base = p->out_base + MAX2(p->noutputs, info->file_max[TGSI_FILE_OUTPUT] + 1);
+   p->const_base = p->imm_base + info->immediate_count;
+   p->nconsts = nconsts;
+   p->nregs = p->const_base + nconsts;
+   p->ops = CALLOC(max_ops ? max_ops : 1, sizeof(*p->ops));
+   p->init = CALLOC(p->nregs, sizeof(*p->init));
+   if (!p->ops || !p->init || p->nregs > VSF_MAX_REGS) {
+      draw_vs_fast_destroy(p);
+      return NULL;
+   }
+   for (i = 0; i < p->noutputs; i++)
+      p->out_color[i] = info->output_semantic_name[i] == TGSI_SEMANTIC_COLOR ||
+                        info->output_semantic_name[i] == TGSI_SEMANTIC_BCOLOR;
+
+   tgsi_parse_init(&parse, tokens);
+   while (ok && !tgsi_parse_end_of_tokens(&parse)) {
+      tgsi_parse_token(&parse);
+      switch (parse.FullToken.Token.Type) {
+      case TGSI_TOKEN_TYPE_IMMEDIATE: {
+         const struct tgsi_full_immediate *imm = &parse.FullToken.FullImmediate;
+         unsigned c;
+
+         if (imm->Immediate.DataType != TGSI_IMM_FLOAT32 || nimm >= info->immediate_count) {
+            ok = FALSE;
+            break;
+         }
+         for (c = 0; c < imm->Immediate.NrTokens - 1 && c < 4; c++)
+            p->init[p->imm_base + nimm][c] = imm->u[c].Float;
+         nimm++;
+         break;
+      }
+      case TGSI_TOKEN_TYPE_INSTRUCTION: {
+         const struct tgsi_full_instruction *inst = &parse.FullToken.FullInstruction;
+         struct vsf_op *op;
+         unsigned nsrc, s, c;
+
+         if (inst->Instruction.Opcode == TGSI_OPCODE_END)
+            break;
+         if (!op_supported(inst->Instruction.Opcode, &nsrc) || inst->Instruction.NumDstRegs != 1 ||
+             inst->Instruction.NumSrcRegs != nsrc || inst->Instruction.Saturate > 1 ||
+             inst->Dst[0].Register.Indirect || inst->Dst[0].Register.Dimension ||
+             p->nops >= max_ops) {
+            ok = FALSE;
+            break;
+         }
+         op = &p->ops[p->nops++];
+         op->opcode = inst->Instruction.Opcode;
+         op->sat = inst->Instruction.Saturate;
+         op->wmask = inst->Dst[0].Register.WriteMask;
+         op->nsrc = nsrc;
+         switch (inst->Dst[0].Register.File) {
+         case TGSI_FILE_TEMPORARY: op->dst = p->temp_base + inst->Dst[0].Register.Index; break;
+         case TGSI_FILE_OUTPUT: op->dst = p->out_base + inst->Dst[0].Register.Index; break;
+         default: ok = FALSE;
+         }
+         for (s = 0; ok && s < nsrc; s++) {
+            const struct tgsi_full_src_register *src = &inst->Src[s];
+            struct vsf_src *d = &op->src[s];
+            const int idx = src->Register.Index;
+
+            if (src->Register.Indirect ||
+                (src->Register.Dimension && (src->Dimension.Indirect || src->Dimension.Index != 0))) {
+               ok = FALSE;
+               break;
+            }
+            switch (src->Register.File) {
+            case TGSI_FILE_INPUT: d->reg = p->in_base + idx; break;
+            case TGSI_FILE_TEMPORARY: d->reg = p->temp_base + idx; break;
+            case TGSI_FILE_OUTPUT: d->reg = p->out_base + idx; break;
+            case TGSI_FILE_IMMEDIATE: d->reg = p->imm_base + idx; break;
+            case TGSI_FILE_CONSTANT: d->reg = p->const_base + idx; break;
+            default: ok = FALSE;
+            }
+            for (c = 0; c < 4; c++)
+               d->swz[c] = (unsigned char)tgsi_util_get_full_src_register_swizzle(src, c);
+            d->neg = src->Register.Negate;
+            d->abs = src->Register.Absolute;
+            d->plain = !d->neg && !d->abs && d->swz[0] == 0 && d->swz[1] == 1 && d->swz[2] == 2 &&
+                       d->swz[3] == 3;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+   tgsi_parse_free(&parse);
+   if (!ok) {
+      draw_vs_fast_destroy(p);
+      return NULL;
+   }
+   return p;
+}
+
+void
+draw_vs_fast_destroy(struct draw_vs_fast *p)
+{
+   if (!p)
+      return;
+   FREE(p->ops);
+   FREE(p->init);
+   FREE(p);
+}
+
+static inline void
+fetch(float (*r)[4], const struct vsf_src *s, float v[4])
+{
+   const float *x = r[s->reg];
+   int c;
+
+   if (s->plain) {
+      v[0] = x[0]; v[1] = x[1]; v[2] = x[2]; v[3] = x[3];
+      return;
+   }
+   for (c = 0; c < 4; c++) {
+      float a = x[s->swz[c]];
+
+      if (s->abs)
+         a = fabsf(a);
+      if (s->neg)
+         a = -a;
+      v[c] = a;
+   }
+}
+
+static void
+run_vertex(const struct draw_vs_fast *p, float (*r)[4])
+{
+   const struct vsf_op *op = p->ops, *end = p->ops + p->nops;
+
+   for (; op < end; op++) {
+      float a[4], b[4], c[4], d[4];
+      float *dst = r[op->dst];
+      int i;
+
+      fetch(r, &op->src[0], a);
+      if (op->nsrc > 1)
+         fetch(r, &op->src[1], b);
+      if (op->nsrc > 2)
+         fetch(r, &op->src[2], c);
+
+      switch (op->opcode) {
+      case TGSI_OPCODE_MOV:
+         d[0] = a[0]; d[1] = a[1]; d[2] = a[2]; d[3] = a[3];
+         break;
+      case TGSI_OPCODE_ADD:
+         for (i = 0; i < 4; i++) d[i] = a[i] + b[i];
+         break;
+      case TGSI_OPCODE_MUL:
+         for (i = 0; i < 4; i++) d[i] = a[i] * b[i];
+         break;
+      case TGSI_OPCODE_MAD:
+         for (i = 0; i < 4; i++) d[i] = a[i] * b[i] + c[i];
+         break;
+      case TGSI_OPCODE_DP2:
+         d[0] = d[1] = d[2] = d[3] = a[0] * b[0] + a[1] * b[1];
+         break;
+      case TGSI_OPCODE_DP3:
+         d[0] = d[1] = d[2] = d[3] = a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+         break;
+      case TGSI_OPCODE_DP4:
+         d[0] = d[1] = d[2] = d[3] = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
+         break;
+      case TGSI_OPCODE_RSQ:
+         d[0] = d[1] = d[2] = d[3] = 1.0f / sqrtf(a[0]);
+         break;
+      case TGSI_OPCODE_RCP:
+         d[0] = d[1] = d[2] = d[3] = 1.0f / a[0];
+         break;
+      case TGSI_OPCODE_SQRT:
+         d[0] = d[1] = d[2] = d[3] = sqrtf(a[0]);
+         break;
+      case TGSI_OPCODE_EX2:
+         d[0] = d[1] = d[2] = d[3] = powf(2.0f, a[0]);
+         break;
+      case TGSI_OPCODE_LG2:
+         d[0] = d[1] = d[2] = d[3] = logf(a[0]) * 1.442695f;
+         break;
+      case TGSI_OPCODE_POW:
+         d[0] = d[1] = d[2] = d[3] = powf(a[0], b[0]);
+         break;
+      case TGSI_OPCODE_FLR:
+         for (i = 0; i < 4; i++) d[i] = floorf(a[i]);
+         break;
+      case TGSI_OPCODE_FRC:
+         for (i = 0; i < 4; i++) d[i] = a[i] - floorf(a[i]);
+         break;
+      case TGSI_OPCODE_MAX:
+         for (i = 0; i < 4; i++) d[i] = a[i] > b[i] ? a[i] : b[i];
+         break;
+      case TGSI_OPCODE_MIN:
+         for (i = 0; i < 4; i++) d[i] = a[i] < b[i] ? a[i] : b[i];
+         break;
+      case TGSI_OPCODE_SLT:
+         for (i = 0; i < 4; i++) d[i] = a[i] < b[i] ? 1.0f : 0.0f;
+         break;
+      case TGSI_OPCODE_SGE:
+         for (i = 0; i < 4; i++) d[i] = a[i] >= b[i] ? 1.0f : 0.0f;
+         break;
+      case TGSI_OPCODE_SEQ:
+         for (i = 0; i < 4; i++) d[i] = a[i] == b[i] ? 1.0f : 0.0f;
+         break;
+      case TGSI_OPCODE_SNE:
+         for (i = 0; i < 4; i++) d[i] = a[i] != b[i] ? 1.0f : 0.0f;
+         break;
+      case TGSI_OPCODE_LRP:
+         for (i = 0; i < 4; i++) d[i] = a[i] * (b[i] - c[i]) + c[i];
+         break;
+      case TGSI_OPCODE_CMP:
+         for (i = 0; i < 4; i++) d[i] = a[i] < 0.0f ? b[i] : c[i];
+         break;
+      case TGSI_OPCODE_LIT:
+         d[0] = 1.0f;
+         d[1] = MAX2(a[0], 0.0f);
+         d[2] = a[0] > 0.0f ? powf(MAX2(a[1], 0.0f), CLAMP(a[3], -128.0f, 128.0f)) : 0.0f;
+         d[3] = 1.0f;
+         break;
+      }
+      if (op->sat)
+         for (i = 0; i < 4; i++)
+            d[i] = CLAMP(d[i], 0.0f, 1.0f);
+      for (i = 0; i < 4; i++)
+         if (op->wmask & (1 << i))
+            dst[i] = d[i];
+   }
+}
+
+void
+draw_vs_fast_run(const struct draw_vs_fast *p, const float (*input)[4], float (*output)[4],
+                 const void *constants[PIPE_MAX_CONSTANT_BUFFERS],
+                 const unsigned const_size[PIPE_MAX_CONSTANT_BUFFERS],
+                 unsigned count, unsigned input_stride, unsigned output_stride,
+                 boolean clamp_color)
+{
+   float r[VSF_MAX_REGS][4];
+   const unsigned have = constants[0] ? const_size[0] / (4 * sizeof(float)) : 0;
+   unsigned i, slot;
+
+   /* immediates; constants beyond the buffer read as 0, as in tgsi_exec */
+   memcpy(r, p->init, p->nregs * sizeof(r[0]));
+   if (p->nconsts)
+      memcpy(r[p->const_base], constants[0], MIN2(have, p->nconsts) * sizeof(r[0]));
+
+   for (i = 0; i < count; i++) {
+      memcpy(r[p->in_base], input, p->ninputs * sizeof(r[0]));
+      run_vertex(p, r);
+      for (slot = 0; slot < p->noutputs; slot++) {
+         const float *o = r[p->out_base + slot];
+
+         if (clamp_color && p->out_color[slot]) {
+            output[slot][0] = CLAMP(o[0], 0.0f, 1.0f);
+            output[slot][1] = CLAMP(o[1], 0.0f, 1.0f);
+            output[slot][2] = CLAMP(o[2], 0.0f, 1.0f);
+            output[slot][3] = CLAMP(o[3], 0.0f, 1.0f);
+         } else {
+            output[slot][0] = o[0];
+            output[slot][1] = o[1];
+            output[slot][2] = o[2];
+            output[slot][3] = o[3];
+         }
+      }
+      input = (const float (*)[4])((const char *)input + input_stride);
+      output = (float (*)[4])((char *)output + output_stride);
+   }
+}
diff --git a/src/gallium/auxiliary/draw/draw_vs_fast.h b/src/gallium/auxiliary/draw/draw_vs_fast.h
new file mode 100644
index 0000000..91826b6
--- /dev/null
+++ b/src/gallium/auxiliary/draw/draw_vs_fast.h
@@ -0,0 +1,36 @@
+/*
+ * draw_vs_fast.h -- vertex shaders run one vertex at a time.
+ *
+ * The TGSI of a vertex shader made of plain float arithmetic (what the GL
+ * fixed-function pipeline produces: transforms, lighting) is decoded once
+ * into a short list of operations on float[4] registers and run per vertex,
+ * instead of through the tgsi_exec machine.  Anything else (flow control,
+ * integers, textures, system values, indirect addressing) is refused and
+ * stays with tgsi_exec.
+ *
+ * DRAW_NO_FAST_VS=1 turns it off.
+ */
+#ifndef DRAW_VS_FAST_H
+#define DRAW_VS_FAST_H
+
+#include "pipe/p_compiler.h"
+#include "pipe/p_state.h"
+
+struct tgsi_token;
+struct tgsi_shader_info;
+struct draw_vs_fast;
+
+struct draw_vs_fast *
+draw_vs_fast_compile(const struct tgsi_token *tokens, const struct tgsi_shader_info *info);
+
+void
+draw_vs_fast_run(const struct draw_vs_fast *p, const float (*input)[4], float (*output)[4],
+                 const void *constants[PIPE_MAX_CONSTANT_BUFFERS],
+                 const unsigned const_size[PIPE_MAX_CONSTANT_BUFFERS],
+                 unsigned count, unsigned input_stride, unsigned output_stride,
+                 boolean clamp_color);
+
+void
+draw_vs_fast_destroy(struct draw_vs_fast *p);
+
+#endif
