+static void
+zz_set_scissors(struct pipe_context *c, unsigned start, unsigned n, const struct pipe_scissor_state *s)
+{
+   uint32_t *p = ccmd(c, ZP_SCISSOR, 4);
+
+   p[0] = s->minx; p[1] = s->miny; p[2] = s->maxx; p[3] = s->maxy;
