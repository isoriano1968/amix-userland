@@ -0,0 +1,36 @@
+/*
+ * sp_fs_fast.h -- fragment shaders run as vector code, a quad at a time.
+ *
+ * A fragment shader without flow control is decoded once into a list of
+ * operations on registers held as one 4-wide vector per channel (the four
+ * pixels of a quad: NEON on the Z3660's core 1, SSE on a PC), instead of
+ * going through the tgsi_exec machine for every quad.  The inputs, the
+ * texture sampling (softpipe's sampler) and the outputs are tgsi_exec's,
+ * so the results are the same.  Anything it does not know stays with
+ * tgsi_exec.
+ *
+ * SOFTPIPE_NO_FAST_FS=1 turns it off.
+ */
+#ifndef SP_FS_FAST_H
+#define SP_FS_FAST_H
+
+#include "pipe/p_compiler.h"
+
+struct tgsi_token;
+struct tgsi_shader_info;
+struct tgsi_exec_machine;
+struct quad_header;
+struct sp_fs_fast;
+
+struct sp_fs_fast *
+sp_fs_fast_compile(const struct tgsi_token *tokens, const struct tgsi_shader_info *info);
+
+/* run the shader for one quad: the mask of the pixels still alive */
+unsigned
+sp_fs_fast_run(struct sp_fs_fast *p, struct tgsi_exec_machine *mach, struct quad_header *quad,
+               boolean early_depth_test, const struct tgsi_shader_info *info);
+
+void
+sp_fs_fast_destroy(struct sp_fs_fast *p);
+
+#endif
