diff --git a/src/gallium/drivers/zz3660/zz_loop.c b/src/gallium/drivers/zz3660/zz_loop.c
new file mode 100644
index 0000000..6fd76ba
--- /dev/null
+++ b/src/gallium/drivers/zz3660/zz_loop.c
@@ -0,0 +1,45 @@
+/*
+ * zz_loop.c -- the stream straight into the executor in this process, on softpipe
+ * (GALLIUM_DRIVER=zz3660): the driver tested with no board.  ZZ_BE=1 turns the
+ * stream into what a big-endian sender writes, for the executor's other path;
+ * buffers are taken for 32-bit data, as the test's are.
+ */
+#include <stdlib.h>
+#include "zz_proto.h"
+
+static void
+be(uint32_t *w, unsigned n)
+{
+   unsigned i = 0, k;
+
+   while (i < n) {
+      const unsigned head = w[i], op = head & 255, len = head >> 8;
+      /* a buffer's payload turns too: the executor turns it back */
+      const unsigned keep = op == ZP_SHADER ? 3 : len;
+
+      for (k = 0; k < len && k < keep; k++)
+         w[i + 1 + k] = __builtin_bswap32(w[i + 1 + k]);
+      w[i] = __builtin_bswap32(head);
+      i += 1 + len;
+   }
+}
+
+void
+zzp_send(uint32_t *w, unsigned n)
+{
+   if (getenv("ZZ_BE"))
+      be(w, n);
+   zzp_exec(w, n, 0);
+}
+
+void
+zzp_read(uint32_t *w, unsigned n, void *reply)
+{
+   if (getenv("ZZ_BE"))
+      be(w, n);
+   zzp_exec(w, n, reply);
+}
+
+int zzp_show(void *priv, uint32_t id, unsigned w, unsigned h) { return 0; }
+void zzp_sync(void) { }
+int zzp_start(void) { return 1; }
diff --git a/src/gallium/drivers/zz3660/zz_proto.h b/src/gallium/drivers/zz3660/zz_proto.h
new file mode 100644
index 0000000..cfd393f
--- /dev/null
+++ b/src/gallium/drivers/zz3660/zz_proto.h
@@ -0,0 +1,50 @@
+/*
+ * zz_proto.h -- the zz3660 command stream: pipe_context calls in 32-bit words,
+ * from the driver on the 060 to the executor on the GPU (for now core 1 of the
+ * Z3660, softpipe).  A command: op | words << 8, then its words, all in the
+ * sender's byte order.  Payload bytes (buffers, textures, indices) stay in that
+ * order; the executor turns them where it knows their format: vertex data at
+ * the draw.  Constants always come as words in the command.
+ */
+#ifndef ZZ_PROTO_H
+#define ZZ_PROTO_H
+#include <stdint.h>
+
+enum zzp_op {
+   ZP_NONE, ZP_OPEN, ZP_RES_CREATE, ZP_RES_DESTROY, ZP_RES_WRITE, ZP_RES_READ,
+   ZP_BLEND, ZP_DSA, ZP_RAST, ZP_SAMPLER, ZP_VELEMS, ZP_SHADER, ZP_VIEW, ZP_SURFACE,
+   ZP_FREE, ZP_BIND, ZP_BIND_SAMPLERS, ZP_SET_VIEWS, ZP_FRAMEBUFFER, ZP_VIEWPORT,
+   ZP_SCISSOR, ZP_BLEND_COLOR, ZP_STENCIL_REF, ZP_SAMPLE_MASK, ZP_CLIP, ZP_STIPPLE,
+   ZP_CONSTBUF, ZP_VBUFS, ZP_DRAW, ZP_CLEAR, ZP_CLEAR_RT, ZP_CLEAR_DS, ZP_COPY, ZP_BLIT,
+   ZP_FLUSH, ZP_PRESENT, ZP_CONTEXT, ZP_COUNT
+};
+
+/* what ZP_BIND and ZP_FREE name */
+enum zzp_kind {
+   ZK_BLEND, ZK_DSA, ZK_RAST, ZK_SAMPLER, ZK_VELEMS, ZK_VS, ZK_FS, ZK_GS, ZK_VIEW, ZK_SURFACE
+};
+
+#define ZZP_MAX_OBJ 8192
+#define ZZP_MAX_CONTEXTS 8
+
+/* the executor, fed whole commands; reply: where ZP_RES_READ puts its bytes.
+   swapped: the sender has the other byte order: the words are turned here
+   in place, payloads not */
+struct pipe_screen;
+void zzp_exec_init(struct pipe_screen *screen, int swapped);
+void zzp_exec(uint32_t *words, unsigned n, void *reply);
+
+/* the driver's way to the executor: on the 060 the ring, in a test a call */
+void zzp_send(uint32_t *words, unsigned n);
+void zzp_read(uint32_t *words, unsigned n, void *reply);
+/* the resource in the window on the GPU's own output; 0: the transport has
+   none, the driver goes through the winsys.  priv: flush_frontbuffer's */
+void zzp_sync(void);
+/* the GPU is there: 1, it may serve from now on */
+int zzp_start(void);
+int zzp_show(void *priv, uint32_t id, unsigned w, unsigned h);
+/* the board's: a frame ready, top row first, for its output */
+void zzp_refused(uint32_t what, uint32_t size);
+void zzp_present(const void *rgba, int w, int h, int again);
+
+#endif
