+static struct pipe_sampler_view *
+zz_create_view(struct pipe_context *c, struct pipe_resource *r, const struct pipe_sampler_view *t)
+{
+   struct zz_view *v = CALLOC_STRUCT(zz_view);
+   uint32_t *p;
+
+   v->base = *t;
+   pipe_reference_init(&v->base.reference, 1);
+   v->base.texture = NULL;
+   pipe_resource_reference(&v->base.texture, r);
+   v->base.context = c;
+   v->id = new_id();
+   p = ccmd(c, ZP_VIEW, 12);
+   p[0] = v->id; p[1] = zr(r)->id; p[2] = t->format; p[3] = t->u.tex.first_layer;
+   p[4] = t->u.tex.last_layer; p[5] = t->u.tex.first_level; p[6] = t->u.tex.last_level;
+   p[7] = t->swizzle_r; p[8] = t->swizzle_g; p[9] = t->swizzle_b; p[10] = t->swizzle_a; p[11] = t->target;
+   return &v->base;
+}
