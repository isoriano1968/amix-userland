@@ -366,6 +367,16 @@
   glutSpecialFunc(special);
   glutVisibilityFunc(visible);
 
+#ifdef AMIX
+  /*
+   * Creating the display lists is slow enough on AMIX that the initial
+   * VisibilityNotify can arrive before glutVisibilityFunc is registered.
+   * Seed the idle callback so the first Expose does not become the only
+   * rendered frame.  Later visibility events still suspend and resume it.
