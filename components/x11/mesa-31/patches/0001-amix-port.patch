+      use_move16 = getenv("MESA_NOMOVE16") == NULL;
+   if (((unsigned long) p & 2) && n >= 2) {     /* to a long boundary */
+      *p++ = pixel;
+      n -= 2;
+   }
+   l = (GLuint *) p;
+   if (use_move16 && n >= 128) {
+      while (((unsigned long) l & 15) && n >= 4) {
+         *l++ = two;
+         n -= 4;
+      }
+      src = (GLuint *) (((unsigned long) line + 15) & ~15UL);
+      for (i = 0; i < 16; i++)
+         src[i] = two;
+      for (; n >= 64; n -= 64) {                /* 64 bytes per step */
