+
+  qobj = gluNewQuadric();
+#ifdef LIGHT
+  SetMaterial(mat_specular2, mat_ambient2, mat_diffuse2, mat_shininess2);
+#endif
+  glEnable(GL_DEPTH_TEST);
+  MechTorso(i);
+  MechHip(i);
+  Shoulder(i);
+  RocketPod(i);
+  UpperArm(i);
+  ForeArm(i);
+  UpperLeg(i);
