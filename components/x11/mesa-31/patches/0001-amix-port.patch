+  glPushMatrix();
+  glTranslatef(0.5, 0.5, 0.0);
+#ifdef ROCKET_POD
+  glCallList(SOLID_MECH_ROCKET);
+#endif
+  glPopMatrix();
+  for (i = 0; i < 2; i++) {
+    glPushMatrix();
+    if (i)
+      glScalef(-1.0, 1.0, 1.0);
