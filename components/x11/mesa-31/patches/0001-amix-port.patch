+         __asm__ volatile( "move16 (%0)+,(%1)+\n\t"
+                           "move16 (%0)+,(%1)+\n\t"
+                           "move16 (%0)+,(%1)+\n\t"
+                           "move16 (%0)+,(%1)+"
+                           : "+a" (s), "+a" (l) : : "memory" );
+      }
+   }
+   for (; n >= 4; n -= 4)
+      *l++ = two;
+   if (n >= 2)
+      *(GLushort *) l = pixel;
+}
