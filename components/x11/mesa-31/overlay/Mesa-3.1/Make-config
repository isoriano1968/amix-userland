MESA_MAJOR=3
MESA_MINOR=1
MESA_TINY=0

AMIX_TARGETS=targets

amix060:
	$(MAKE) $(MFLAGS) -f Makefile.X11 $(AMIX_TARGETS) \
	"GL_LIB = libGL.a" \
	"GLU_LIB = libGLU.a" \
	"GLUT_LIB = libglut.a" \
	"GLW_LIB = libGLw.a" \
	"CC = m68k-elf-gcc" \
	"CFLAGS = -O2 -m68060 -ffast-math -DSHM -fno-strict-aliasing -fcommon \
		-U__linux__ -Ulinux -DAMIX -Dm68k -DSVR4 -D__amix__ \
		-Wno-error=implicit-function-declaration -Wno-error=int-conversion \
		-Wno-error=incompatible-pointer-types -Wno-error=return-mismatch \
		-Wno-error=implicit-int -I$(HOME)/opt/m68k-amix-sysroot/usr/x11r6/xc/exports/include" \
	"MAKELIB = ../bin/mklib.ar-ruv" \
	"AR = m68k-elf-ar" "RANLIB = m68k-elf-ranlib" \
	"XLIBS = -lXmu -lXext -lX11 -lsocket -lnsl -lm"

amix:
	$(MAKE) $(MFLAGS) -f Makefile.X11 $(AMIX_TARGETS) \
	"GL_LIB = libGL.a" \
	"GLU_LIB = libGLU.a" \
	"GLUT_LIB = libglut.a" \
	"GLW_LIB = libGLw.a" \
	"CC = gcc" \
	"CFLAGS = -O -ansi -finline-functions -DAMIX -Dm68k -DSVR4 \
		-I/usr/x11r6/xc/exports/include -I/usr/x11r6/include" \
	"MAKELIB = ../bin/mklib.ar-ruv" \
	"XLIBS = -L/usr/x11r6/xc/exports/lib -L/usr/x11r6/lib \
		-lXmu -z nodefs -lXext -lX11 -lsocket -lnsl -lm"
