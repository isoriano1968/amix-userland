# name, version and what building and running it needs
name     x11/mesa-demos
version  60ad664
# 68060 only: demo programs tuned for the 68060 (Z3660)
cpu      68060
summary  Mesa demos on Mesa 18.3
require  x11/x11r6.3
require  x11/mesa-183
require  library/glu
require  library/freeglut
require  library/libpng
require  library/zlib
