# name, version and what building and running it needs
name     developer/vscode-agent
version  0.1.2
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
summary  vscode-agent: runs programs from VS Code on AMIX (dials out, shared-key sign-in)
# libamixc99 (snprintf, vsnprintf) is linked in: nothing beyond a stock AMIX
# but the description of VS Code's terminal (TERM=xterm-256color; the agent
# falls back to stock AMIX's xterm without it)
require  sysutils/terminfo
file     /usr/local/bin/vscode-agent
file     /etc/init.d/vscode-agent
file     /etc/rc2.d/S87vscode-agent
file     /etc/rc0.d/K13vscode-agent
file     /etc/vscode-agent.conf.example
