      "\treturn 0;",
      "}",
      "",
      "int",
      "${1:name}close(dev, flag, otyp, credp)",
      "\tdev_t dev;",
      "\tint flag;",
      "\tint otyp;",
      "\tstruct cred *credp;",
      "{",
      "\treturn 0;",
      "}",
      "",
      "int",
      "${1:name}read(dev, uiop, credp)",
      "\tdev_t dev;",
      "\tstruct uio *uiop;",
      "\tstruct cred *credp;",
      "{",
      "\treturn 0;",
      "}"
