  "AMIX CDE hello": {
    "prefix": "amix-cde-hello",
    "body": [
      "#include <stdlib.h>",
      "#include <Xm/Xm.h>",
      "#include <Xm/Form.h>",
      "#include <Xm/Label.h>",
      "#include <Xm/PushB.h>",
      "",
      "static void quit(Widget w, XtPointer client, XtPointer call)",
      "{",
      "\texit(0);",
      "}",
      "",
      "int main(int argc, char **argv)",
      "{",
      "\tXtAppContext app;",
      "\tWidget top, form, label, button;",
      "\tXmString s;",
      "",
      "\ttop = XtVaAppInitialize(&app, \"Hello\", NULL, 0, &argc, argv, NULL,",
      "\t                        XmNtitle, \"${2:Hello AMIX}\", NULL);",
      "",
      "\tform = XtVaCreateManagedWidget(\"form\", xmFormWidgetClass, top,",
      "\t                               XmNmarginWidth, 12, XmNmarginHeight, 12,",
      "\t                               NULL);",
      "",
      "\ts = XmStringCreateLocalized(\"${1:Hello, world}\");",
      "\tlabel = XtVaCreateManagedWidget(\"label\", xmLabelWidgetClass, form,",
      "\t                                XmNlabelString, s,",
      "\t                                XmNtopAttachment, XmATTACH_FORM,",
      "\t                                XmNleftAttachment, XmATTACH_FORM,",
      "\t                                XmNrightAttachment, XmATTACH_FORM,",
      "\t                                NULL);",
      "\tXmStringFree(s);",
      "",
      "\ts = XmStringCreateLocalized(\"Quit\");",
      "\tbutton = XtVaCreateManagedWidget(\"quit\", xmPushButtonWidgetClass, form,",
      "\t                                 XmNlabelString, s,",
      "\t                                 XmNtopAttachment, XmATTACH_WIDGET,",
      "\t                                 XmNtopWidget, label,",
      "\t                                 XmNtopOffset, 12,",
      "\t                                 XmNbottomAttachment, XmATTACH_FORM,",
      "\t                                 XmNleftAttachment, XmATTACH_POSITION,",
      "\t                                 XmNleftPosition, 30,",
      "\t                                 XmNrightAttachment, XmATTACH_POSITION,",
      "\t                                 XmNrightPosition, 70,",
      "\t                                 NULL);",
      "\tXmStringFree(s);",
      "\tXtAddCallback(button, XmNactivateCallback, quit, NULL);",
      "",
      "\tXtRealizeWidget(top);",
      "\tXtAppMainLoop(app);",
      "\treturn 0;",
      "}"
    ],
    "description": "Motif/CDE \"Hello, world\" window with a Quit button (link: -lXm -lXmu -lXtInherit -lXt -lSM -lICE -lXext -lX11 -lsocket -lnsl -lamixc99 -lgen -lm)"
  },
  "AMIX curses hello": {
    "prefix": "amix-curses-hello",
    "body": [
      "#include <curses.h>",
      "#include <string.h>",
      "#include <time.h>",
      "#include <sys/utsname.h>",
      "",
      "static const char *items[] = { \"Say hello\", \"Show the time\", \"Quit\" };",
      "#define NITEMS (sizeof items / sizeof items[0])",
      "",
      "static void draw(WINDOW *w, struct utsname *u, int sel, const char *msg)",
      "{",
      "    char now[64];",
      "    time_t t = time(NULL);",
      "    int i;",
      "",
      "    strftime(now, sizeof now, \"%Y-%m-%d %H:%M:%S\", localtime(&t));",
      "    werase(w);",
      "    box(w, 0, 0);",
      "    mvwprintw(w, 0, 2, \" Hello AMIX \");",
      "    mvwprintw(w, 2, 3, \"%s %s on %s (%s)\", u->sysname, u->release,",
      "              u->nodename, u->machine);",
      "    mvwprintw(w, 3, 3, \"%s\", now);",
      "    for (i = 0; i < (int)NITEMS; i++) {",
      "        if (i == sel)",
      "            wattron(w, A_REVERSE);",
      "        mvwprintw(w, 5 + i, 5, \" %-16s \", items[i]);",
      "        if (i == sel)",
      "            wattroff(w, A_REVERSE);",
      "    }",
      "    mvwprintw(w, 9, 3, \"%-40.40s\", msg);",
      "    mvwprintw(w, 10, 3, \"arrows: move  Enter: choose  q: quit\");",
      "    wrefresh(w);",
      "}",
      "",
      "int main(void)",
      "{",
      "    struct utsname u;",
      "    WINDOW *w;",
      "    int sel = 0, ch, rows, cols;",
      "    char msg[64] = \"\";",
      "",
      "    uname(&u);",
      "    initscr();",
      "    cbreak();",
      "    noecho();",
      "    curs_set(0);",
      "    getmaxyx(stdscr, rows, cols);",
      "    refresh();",
      "",
      "    w = newwin(12, 50, (rows - 12) / 2, (cols - 50) / 2);",
      "    keypad(w, TRUE);",
      "    halfdelay(10);              /* wake up every second for the clock */",
      "",
      "    for (;;) {",
      "        draw(w, &u, sel, msg);",
      "        ch = wgetch(w);",
      "        if (ch == 'q' || ch == 'Q')",
      "            break;",
      "        if (ch == KEY_UP || ch == 'k')",
      "            sel = (sel + NITEMS - 1) % NITEMS;",
      "        else if (ch == KEY_DOWN || ch == 'j')",
      "            sel = (sel + 1) % NITEMS;",
      "        else if (ch == '\\n' || ch == '\\r' || ch == KEY_ENTER) {",
      "            if (sel == 0)",
      "                strcpy(msg, \"Hello, world!\");",
      "            else if (sel == 1) {",
      "                time_t t = time(NULL);",
      "                strftime(msg, sizeof msg, \"It is %H:%M.\", localtime(&t));",
      "            } else",
      "                break;",
      "        }",
      "    }",
      "",
      "    delwin(w);",
      "    endwin();",
      "    return 0;",
      "}"
    ],
    "description": "Console (curses) program: framed window, clock, menu with arrow keys (link: -lncurses -lamixc99, runpath /usr/local/lib)"
  }
}
