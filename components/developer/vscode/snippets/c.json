{
  "AMIX hello": {
    "prefix": "amix-hello",
    "body": [
      "#include <stdio.h>",
      "",
      "int",
      "main(void)",
      "{",
      "\tputs(\"hello from AMIX\");",
      "\treturn 0;",
      "}"
    ],
    "description": "Small AMIX userland C program"
  },
  "AMIX driver entry points": {
    "prefix": "amix-driver",
    "body": [
      "#include <sys/types.h>",
      "#include <sys/errno.h>",
      "#include <sys/uio.h>",
      "",
      "int",
      "${1:name}open(dev, flag, otyp, credp)",
      "\tdev_t dev;",
      "\tint flag;",
      "\tint otyp;",
      "\tstruct cred *credp;",
      "{",
      "\treturn 0;",
      "}",
      "",
      "int",
      "${1:name}close(dev, flag, otyp, credp)",
      "\tdev_t dev;",
      "\tint flag;",
      "\tint otyp;",
      "\tstruct cred *credp;",
      "{",
      "\treturn 0;",
      "}",
      "",
      "int",
      "${1:name}read(dev, uiop, credp)",
      "\tdev_t dev;",
      "\tstruct uio *uiop;",
      "\tstruct cred *credp;",
      "{",
      "\treturn 0;",
      "}"
    ],
    "description": "Skeleton AMIX character driver entry points"
  },
  "AMIX CDE hello": {
    "prefix": "amix-cde-hello",
    "body": [
      "#include <stdlib.h>",
      "#include <Xm/Xm.h>",
      "#include <Xm/Form.h>",
      "#include <Xm/Label.h>",
      "#include <Xm/PushB.h>",
      "",
      "static void quit(Widget w, XtPointer client, XtPointer call)",
      "{",
      "\texit(0);",
      "}",
      "",
      "int main(int argc, char **argv)",
      "{",
      "\tXtAppContext app;",
      "\tWidget top, form, label, button;",
      "\tXmString s;",
      "",
      "\ttop = XtVaAppInitialize(&app, \"Hello\", NULL, 0, &argc, argv, NULL,",
      "\t                        XmNtitle, \"${2:Hello AMIX}\", NULL);",
      "",
      "\tform = XtVaCreateManagedWidget(\"form\", xmFormWidgetClass, top,",
      "\t                               XmNmarginWidth, 12, XmNmarginHeight, 12,",
      "\t                               NULL);",
      "",
      "\ts = XmStringCreateLocalized(\"${1:Hello, world}\");",
      "\tlabel = XtVaCreateManagedWidget(\"label\", xmLabelWidgetClass, form,",
      "\t                                XmNlabelString, s,",
      "\t                                XmNtopAttachment, XmATTACH_FORM,",
      "\t                                XmNleftAttachment, XmATTACH_FORM,",
      "\t                                XmNrightAttachment, XmATTACH_FORM,",
      "\t                                NULL);",
      "\tXmStringFree(s);",
      "",
      "\ts = XmStringCreateLocalized(\"Quit\");",
      "\tbutton = XtVaCreateManagedWidget(\"quit\", xmPushButtonWidgetClass, form,",
      "\t                                 XmNlabelString, s,",
      "\t                                 XmNtopAttachment, XmATTACH_WIDGET,",
      "\t                                 XmNtopWidget, label,",
      "\t                                 XmNtopOffset, 12,",
      "\t                                 XmNbottomAttachment, XmATTACH_FORM,",
      "\t                                 XmNleftAttachment, XmATTACH_POSITION,",
      "\t                                 XmNleftPosition, 30,",
      "\t                                 XmNrightAttachment, XmATTACH_POSITION,",
      "\t                                 XmNrightPosition, 70,",
      "\t                                 NULL);",
      "\tXmStringFree(s);",
      "\tXtAddCallback(button, XmNactivateCallback, quit, NULL);",
      "",
      "\tXtRealizeWidget(top);",
      "\tXtAppMainLoop(app);",
      "\treturn 0;",
      "}"
    ],
    "description": "Motif/CDE \"Hello, world\" window with a Quit button (link: -lXm -lXmu -lXtInherit -lXt -lSM -lICE -lXext -lX11 -lsocket -lnsl -lamixc99 -lgen -lm)"
  }
}
