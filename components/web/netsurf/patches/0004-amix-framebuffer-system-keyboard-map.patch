framebuffer: keys from the system's keyboard map.  A keycode with
NSFB_KEY_UCS4 (library/libnsfb's Xlib surface) is a character as the X
server's keymap makes it, German or any other, and is taken as it is, not
through fbtk's own US map.  The text widget (the URL bar) keeps its text in
UTF-8: a character goes in as UTF-8, and Backspace, Left and Right go by
characters; a key that is no character inserts nothing (it inserted 0xff).

--- a/frontends/framebuffer/fbtk/event.c	2023-12-28 01:26:04.000000000 +0100
+++ b/frontends/framebuffer/fbtk/event.c	2026-11-03 18:20:14.860574660 +0100
@@ -302,6 +302,15 @@
 {
 	int ucs4 = -1;
 
+#ifdef NSFB_KEY_UCS4
+	/* a character the surface made with the system's keyboard map */
+	if (code & NSFB_KEY_UCS4) {
+		if (mods & FBTK_MOD_LCTRL || mods & FBTK_MOD_RCTRL)
+			return -1;
+		return code & ~NSFB_KEY_UCS4;
+	}
+#endif
+
 	if (mods & FBTK_MOD_LSHIFT || mods & FBTK_MOD_RSHIFT) {
 		if ((code >= 0) && (code < (int) NOF_ELEMENTS(sh_keymap)))
 			ucs4 = sh_keymap[code];
