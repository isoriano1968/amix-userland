 /**
+ * AMIX: one gap (row-gap or column-gap) of a flex container in pixels.
+ * normal is 0 for flex containers; thin, medium and thick are taken as the
+ * border widths 1, 3 and 5; a percentage is of the size in that direction, 0
+ * while that size is not known.
+ *
+ * \param[in] ctx     Flex layout context
+ * \param[in] type    Value of css_computed_row_gap / css_computed_column_gap
+ * \param[in] length  Its length
+ * \param[in] unit    Its unit
+ * \param[in] size    Size the percentage is of, or AUTO / UNKNOWN_WIDTH
+ * \return the gap in pixels, never negative
+ */
+static int layout_flex__gap(const struct flex_ctx *ctx, uint8_t type,
+		css_fixed length, css_unit unit, int size)
+{
+	int gap = 0;
+
+	switch (type) {
+	case CSS_COLUMN_GAP_SET:
+		if (unit == CSS_UNIT_PCT) {
+			if (size != AUTO && size != UNKNOWN_WIDTH && size > 0)
+				gap = FPCT_OF_INT_TOINT(length, size);
+		} else {
+			gap = FIXTOINT(css_unit_len2device_px(ctx->flex->style,
+					ctx->unit_len_ctx, length, unit));
+		}
+		break;
+	case CSS_COLUMN_GAP_THIN:
+		gap = 1;
+		break;
+	case CSS_COLUMN_GAP_MEDIUM:
+		gap = 3;
+		break;
+	case CSS_COLUMN_GAP_THICK:
+		gap = 5;
+		break;
+	default:
+		break;
+	}
+	return gap > 0 ? gap : 0;
+}
+
+/**
+ * AMIX: the main and cross gaps of a flex container: column-gap separates
+ * items of a row container, row-gap its lines, and the other way round for a
+ * column container.
+ *
+ * \param[in] ctx  Flex layout context, available_main/_cross set
+ */
+static void layout_flex__gaps(struct flex_ctx *ctx)
+{
+	css_fixed rlen = 0, clen = 0;
+	css_unit runit = CSS_UNIT_PX, cunit = CSS_UNIT_PX;
+	uint8_t rtype, ctype;
+	int row, col;
+
+	rtype = css_computed_row_gap(ctx->flex->style, &rlen, &runit);
+	ctype = css_computed_column_gap(ctx->flex->style, &clen, &cunit);
+	if (ctx->horizontal) {
+		col = layout_flex__gap(ctx, ctype, clen, cunit,
+				ctx->available_main);
+		row = layout_flex__gap(ctx, rtype, rlen, runit,
+				ctx->available_cross);
+		ctx->main_gap = col;
+		ctx->cross_gap = row;
+	} else {
+		row = layout_flex__gap(ctx, rtype, rlen, runit,
+				ctx->available_main);
+		col = layout_flex__gap(ctx, ctype, clen, cunit,
+				ctx->available_cross);
+		ctx->main_gap = row;
+		ctx->cross_gap = col;
+	}
+}
