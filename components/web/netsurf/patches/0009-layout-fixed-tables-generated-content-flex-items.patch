+/**
+ * Whether a pseudo element's content makes any box: an image, or text
+ * once the icon font characters are left out.
+ */
+static bool box_generated_has_content(dom_node *n,
+		const css_computed_style *style)
+{
+	const css_computed_content_item *item = NULL;
+	char *text = NULL;
+	size_t len = 0, cap = 0;
+	bool any = false;
+
+	if (css_computed_content(style, &item) != CSS_CONTENT_SET ||
+			item == NULL)
+		return false;
+	for (; !any && item->type != CSS_COMPUTED_CONTENT_NONE; item++) {
+		switch (item->type) {
+		case CSS_COMPUTED_CONTENT_URI:
+		case CSS_COMPUTED_CONTENT_ATTR:
+		case CSS_COMPUTED_CONTENT_OPEN_QUOTE:
+		case CSS_COMPUTED_CONTENT_CLOSE_QUOTE:
+			any = true;
+			break;
+		case CSS_COMPUTED_CONTENT_STRING:
+			box_generated_text_add(&text, &len, &cap,
+					lwc_string_data(item->data.string),
+					lwc_string_length(item->data.string));
+			any = len > 0;
+			break;
+		default:
+			break;
+		}
+	}
+	free(text);
+	return any;
+}
