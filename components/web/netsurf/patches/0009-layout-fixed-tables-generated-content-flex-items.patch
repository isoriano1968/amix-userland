+static void box_text_transform(char *s, unsigned int len,
+		enum css_text_transform_e tt);
+
+/**
+ * Append UTF-8 text to a growing buffer, leaving out characters of the
+ * Unicode private use areas: those are icon font glyphs (Font Awesome and
+ * the like), which need the web font the page loads; without it they would
+ * show as empty glyph boxes.
+ */
+static bool box_generated_text_add(char **buf, size_t *len, size_t *cap,
+		const char *s, size_t n)
+{
+	size_t i = 0;
+
+	while (i < n) {
+		unsigned char c = (unsigned char) s[i];
+		size_t l = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 :
+				(c >> 3) == 30 ? 4 : 1;
+		uint32_t cp = c;
+
+		if (i + l > n)
+			l = n - i;
+		if (l == 2)
+			cp = ((c & 0x1f) << 6) | (s[i + 1] & 0x3f);
+		else if (l == 3)
+			cp = ((c & 0x0f) << 12) | ((s[i + 1] & 0x3f) << 6) |
+					(s[i + 2] & 0x3f);
+		else if (l == 4)
+			cp = ((c & 0x07) << 18) | ((s[i + 1] & 0x3f) << 12) |
+					((s[i + 2] & 0x3f) << 6) |
+					(s[i + 3] & 0x3f);
+		if ((cp >= 0xE000 && cp <= 0xF8FF) || cp >= 0xF0000) {
+			i += l;
+			continue;
+		}
+		if (*len + l + 1 > *cap) {
+			size_t ncap = (*cap ? *cap * 2 : 64) + l;
+			char *nb = realloc(*buf, ncap);
+			if (nb == NULL)
+				return false;
+			*buf = nb;
+			*cap = ncap;
+		}
+		memcpy(*buf + *len, s + i, l);
+		*len += l;
+		(*buf)[*len] = '\0';
+		i += l;
+	}
+	return true;
+}
