+/**
+ * The outer (border box) width a cell of a table-layout: fixed table's
+ * first row asks for.
+ *
+ * \param content      the HTML content being laid out
+ * \param cell         a cell of the first row
+ * \param table_width  the table's width, for percentages (or AUTO)
+ * \return  the width, or -1 when the cell gives none (auto)
+ */
+static int layout_table_fixed_cell_width(const html_content *content,
+		struct box *cell, int table_width)
+{
+	css_fixed value = 0;
+	css_unit unit = CSS_UNIT_PX;
+	int width, extra = 0;
+	float frac = 0;
+
+	if (css_computed_width(cell->style, &value, &unit) != CSS_WIDTH_SET)
+		return -1;
+	if (unit == CSS_UNIT_PCT) {
+		if (table_width == AUTO)
+			return -1;
+		width = FPCT_OF_INT_TOINT(value, table_width);
+	} else {
+		width = FIXTOINT(css_unit_len2device_px(cell->style,
+				&content->unit_len_ctx, value, unit));
+	}
+	if (css_computed_box_sizing(cell->style) != CSS_BOX_SIZING_BORDER_BOX) {
+		/* the column holds the cell's padding and borders too */
+		calculate_mbp_width(&content->unit_len_ctx, cell->style, LEFT,
+				false, true, true, &extra, &frac);
+		calculate_mbp_width(&content->unit_len_ctx, cell->style, RIGHT,
+				false, true, true, &extra, &frac);
+		width += extra;
+	}
+	return width < 0 ? 0 : width;
+}
