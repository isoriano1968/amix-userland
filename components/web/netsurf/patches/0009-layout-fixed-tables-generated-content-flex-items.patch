+/**
+ * Column widths of a table with table-layout: fixed (CSS 2.1 17.5.2.1).
+ *
+ * The cells of the first row give the widths of their columns; the
+ * columns they leave open share what remains of the table's width
+ * equally.  The cells' content plays no part: what does not fit is
+ * clipped or overflows, as in other browsers.  A table narrower than its
+ * columns grows to hold them.
+ *
+ * \param content           the HTML content being laid out
+ * \param table             the table box
+ * \param col               the columns, their width set here
+ * \param columns           how many
+ * \param table_width       the table's width, updated
+ * \param border_spacing_h  horizontal border spacing
+ * \return  true when the widths are set, false to use the auto layout
+ */
+static bool layout_table_fixed_columns(const html_content *content,
+		struct box *table, struct column *col, unsigned int columns,
+		int *table_width, int border_spacing_h)
+{
+	struct box *row = layout_table_first_row(table);
+	struct box *c;
+	unsigned int i, j, open = 0, placed = 0;
+	int used = 0, share, rest;
+
+	if (row == NULL)
+		return false;
+	for (i = 0; i != columns; i++)
+		col[i].width = -1;
+	for (c = row->children; c; c = c->next) {
+		int w;
+
+		if (c->type != BOX_TABLE_CELL || c->style == NULL)
+			continue;
+		w = layout_table_fixed_cell_width(content, c, *table_width);
+		if (w < 0)
+			continue;
+		/* a cell over several columns shares its width out */
+		if (c->columns > 1)
+			w = (w - (int) (c->columns - 1) * border_spacing_h) /
+					(int) c->columns;
+		for (j = 0; j != c->columns; j++) {
+			i = c->start_column + j;
+			if (i < columns && col[i].width < 0)
+				col[i].width = w < 0 ? 0 : w;
+		}
+	}
+	for (i = 0; i != columns; i++) {
+		if (col[i].positioned)
+			continue;
+		placed++;
+		if (col[i].width < 0)
+			open++;
+		else
+			used += col[i].width;
+	}
+	used += (placed + 1) * border_spacing_h;
+	rest = *table_width - used;
+	if (rest < 0)
+		rest = 0;
+	if (open > 0) {
+		share = rest / open;
+		for (i = 0; i != columns; i++) {
+			if (!col[i].positioned && col[i].width < 0) {
+				col[i].width = share;
+				used += share;
+			}
+		}
+	} else if (rest > 0 && placed > 0) {
+		/* wider than its columns: the extra goes to all of them */
+		share = rest / placed;
+		for (i = 0; i != columns; i++) {
+			if (!col[i].positioned) {
+				col[i].width += share;
+				used += share;
+			}
