+/**
+ * Add a text box of generated content to an inline container.
+ */
+static bool box_generated_text_box(html_content *content, struct box *ic,
+		struct box *parent, const css_computed_style *style,
+		const char *text, size_t len)
+{
+	struct box *box;
+
+	if (len == 0)
+		return true;
+	/** \todo Not wise to drop const from the computed style */
+	box = box_create(NULL, (css_computed_style *) style, false,
+			parent->href, parent->target, parent->title, NULL,
+			content->bctx);
+	if (box == NULL)
+		return false;
+	box->type = BOX_TEXT;
+	box->text = talloc_strndup(content->bctx, text, len);
+	if (box->text == NULL)
+		return false;
+	box->length = len;
+	/* a trailing space separates it from what follows */
+	if (box->length > 1 && box->text[box->length - 1] == ' ') {
+		box->space = UNKNOWN_WIDTH;
+		box->length--;
+	}
+	if (css_computed_text_transform(style) != CSS_TEXT_TRANSFORM_NONE)
+		box_text_transform(box->text, box->length,
+				css_computed_text_transform(style));
+	box_add_child(ic, box);
+	return true;
+}
