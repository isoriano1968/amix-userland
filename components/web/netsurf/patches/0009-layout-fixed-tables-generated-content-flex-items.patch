+/**
+ * Add the boxes of a pseudo element's content to an inline container:
+ * text for strings, attr() and quotes, an image for url().
+ *
+ * \param n        the element the pseudo element belongs to
+ * \param content  the HTML content being built
+ * \param ic       inline container to add to
+ * \param parent   the element's box (for its link)
+ * \param style    the pseudo element's computed style
+ * \return false on memory exhaustion
+ */
+static bool box_generated_content(dom_node *n, html_content *content,
+		struct box *ic, struct box *parent,
+		const css_computed_style *style)
+{
+	const css_computed_content_item *item = NULL;
+	char *text = NULL;
+	size_t len = 0, cap = 0;
+	bool ok = true;
+
+	if (css_computed_content(style, &item) != CSS_CONTENT_SET ||
+			item == NULL)
+		return true;
+	for (; ok && item->type != CSS_COMPUTED_CONTENT_NONE; item++) {
+		switch (item->type) {
+		case CSS_COMPUTED_CONTENT_STRING:
+			ok = box_generated_text_add(&text, &len, &cap,
+					lwc_string_data(item->data.string),
+					lwc_string_length(item->data.string));
+			break;
+		case CSS_COMPUTED_CONTENT_ATTR: {
+			dom_string *name = NULL, *value = NULL;
+
+			if (dom_string_create((const uint8_t *)
+					lwc_string_data(item->data.attr),
+					lwc_string_length(item->data.attr),
+					&name) != DOM_NO_ERR)
+				break;
+			if (dom_element_get_attribute(n, name, &value) ==
+					DOM_NO_ERR && value != NULL) {
+				ok = box_generated_text_add(&text, &len, &cap,
+						dom_string_data(value),
+						dom_string_byte_length(value));
+				dom_string_unref(value);
+			}
+			dom_string_unref(name);
+			break;
+		}
+		case CSS_COMPUTED_CONTENT_OPEN_QUOTE:
+		case CSS_COMPUTED_CONTENT_CLOSE_QUOTE:
+			ok = box_generated_text_add(&text, &len, &cap, "\"", 1);
+			break;
+		case CSS_COMPUTED_CONTENT_URI: {
+			struct box *img;
+			nsurl *url;
+
+			/* the text so far comes first */
+			ok = box_generated_text_box(content, ic, parent, style,
+					text, len);
+			len = 0;
+			if (!ok || nsoption_bool(foreground_images) == false)
+				break;
+			if (nsurl_create(lwc_string_data(item->data.uri),
+					&url) != NSERROR_OK)
+				break;
+			img = box_create(NULL, (css_computed_style *) style,
+					false, parent->href, parent->target,
+					parent->title, NULL, content->bctx);
+			if (img == NULL) {
+				nsurl_unref(url);
+				ok = false;
+				break;
+			}
+			img->type = BOX_INLINE;
+			img->flags |= IS_REPLACED;
+			if (html_fetch_object(content, url, img, image_types,
+					false) == false)
+				ok = false;
+			nsurl_unref(url);
+			if (ok)
+				box_add_child(ic, img);
+			break;
+		}
+		default:
+			/* counters: not supported */
+			break;
+		}
+	}
+	if (ok)
+		ok = box_generated_text_box(content, ic, parent, style, text,
+				len);
+	free(text);
+	return ok;
+}
