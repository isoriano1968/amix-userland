+		if (p[i] == PLOTTER_PATH_MOVE && i + 2 < n) {
+			sx = TX(p[i + 1], p[i + 2]);
+			sy = TY(p[i + 1], p[i + 2]);
+			ok = fb_path_move(&fp, sx, sy);
+			i += 3;
+		} else if (p[i] == PLOTTER_PATH_CLOSE) {
+			ok = fb_path_point(&fp, sx, sy);
+			i++;
+		} else if (p[i] == PLOTTER_PATH_LINE && i + 2 < n) {
+			ok = fb_path_point(&fp, TX(p[i + 1], p[i + 2]),
+					   TY(p[i + 1], p[i + 2]));
+			i += 3;
+		} else if (p[i] == PLOTTER_PATH_BEZIER && i + 6 < n) {
+			ok = fb_path_bezier(&fp,
+					    TX(p[i + 1], p[i + 2]), TY(p[i + 1], p[i + 2]),
+					    TX(p[i + 3], p[i + 4]), TY(p[i + 3], p[i + 4]),
+					    TX(p[i + 5], p[i + 6]), TY(p[i + 5], p[i + 6]));
+			i += 7;
+		} else {
+			NSLOG(netsurf, INFO, "bad path command %f", p[i]);
+			break;
+		}
+	}
+#undef TX
+#undef TY
+
+	if (ok && pstyle->fill_colour != NS_TRANSPARENT)
+		ok = fb_path_fill(&fp, pstyle->fill_colour);
+	if (ok && pstyle->stroke_colour != NS_TRANSPARENT)
+		ok = fb_path_stroke(&fp, pstyle->stroke_colour,
+				    plot_style_fixed_to_int(pstyle->stroke_width));
+
+	free(fp.pt);
+	free(fp.start);
+	return ok ? NSERROR_OK : NSERROR_NOMEM;
