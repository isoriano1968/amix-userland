+/*
+ * A path, flattened to straight edges in window coordinates: the points of
+ * all its subpaths and where each one starts.
+ */
+struct fb_path {
+	float *pt;		/**< x, y of each point */
+	int n, alloc;		/**< points used, allocated */
+	int *start;		/**< first point of each subpath */
+	int nsub, suballoc;	/**< subpaths used, allocated */
+};
+
+/** An edge for the fill, its top end first; dir is +1 downwards, -1 up */
+struct fb_edge {
+	float x0, y0, y1, dxdy;
+	int dir;
+};
+
+/** Where an edge crosses a scanline */
+struct fb_cross {
+	float x;
+	int dir;
+};
+
+static bool fb_path_point(struct fb_path *fp, float x, float y)
+{
+	if (fp->n == fp->alloc) {
+		int alloc = fp->alloc ? fp->alloc * 2 : 64;
+		float *pt = realloc(fp->pt, alloc * 2 * sizeof(float));
+		if (pt == NULL)
+			return false;
+		fp->pt = pt;
+		fp->alloc = alloc;
+	}
+	fp->pt[fp->n * 2] = x;
+	fp->pt[fp->n * 2 + 1] = y;
+	fp->n++;
+	return true;
+}
+
+static bool fb_path_move(struct fb_path *fp, float x, float y)
+{
+	if (fp->nsub > 0 && fp->start[fp->nsub - 1] == fp->n - 1) {
+		/* a move after a move: the earlier subpath has no edges */
+		fp->n--;
+	} else {
+		if (fp->nsub == fp->suballoc) {
+			int alloc = fp->suballoc ? fp->suballoc * 2 : 8;
+			int *start = realloc(fp->start, alloc * sizeof(int));
+			if (start == NULL)
+				return false;
+			fp->start = start;
+			fp->suballoc = alloc;
+		}
+		fp->nsub++;
+	}
+	fp->start[fp->nsub - 1] = fp->n;
+	return fb_path_point(fp, x, y);
+}
+
+/** One past the last point of subpath k */
+static int fb_path_end(const struct fb_path *fp, int k)
+{
+	return k + 1 < fp->nsub ? fp->start[k + 1] : fp->n;
+}
+
+static int fb_edge_cmp(const void *a, const void *b)
+{
+	const struct fb_edge *ea = a, *eb = b;
+	return ea->y0 < eb->y0 ? -1 : ea->y0 > eb->y0;
+}
+
+static int fb_cross_cmp(const void *a, const void *b)
+{
+	const struct fb_cross *ca = a, *cb = b;
+	return ca->x < cb->x ? -1 : ca->x > cb->x;
+}
+
+/**
+ * Fill the subpaths of a path, each one closed, by the nonzero winding
+ * rule (SVG's default); a pixel is inside when its centre is.
+ */
+static bool fb_path_fill(const struct fb_path *fp, colour c)
+{
+	struct fb_edge *edge, **active;
+	struct fb_cross *cross;
+	nsfb_bbox_t clip, span;
+	int nedge = 0, nactive = 0, next = 0;
+	int k, i, j, y, ybot;
+
+	if (fp->n < 3)
+		return true;
+	edge = malloc(fp->n * sizeof(struct fb_edge));
+	active = malloc(fp->n * sizeof(struct fb_edge *));
+	cross = malloc(fp->n * sizeof(struct fb_cross));
+	if (edge == NULL || active == NULL || cross == NULL) {
+		free(edge);
+		free(active);
+		free(cross);
+		return false;
+	}
+
+	/* the edges, the closing one of each subpath too; none horizontal */
+	for (k = 0; k < fp->nsub; k++) {
+		int s = fp->start[k], end = fb_path_end(fp, k);
+		for (i = s; i < end; i++) {
+			const float *a = fp->pt + i * 2;
+			const float *b = fp->pt + (i + 1 < end ? i + 1 : s) * 2;
+			struct fb_edge *e = edge + nedge;
+			if (a[1] == b[1])
+				continue;
+			if (a[1] < b[1]) {
+				e->x0 = a[0]; e->y0 = a[1]; e->y1 = b[1];
+				e->dir = 1;
+			} else {
+				e->x0 = b[0]; e->y0 = b[1]; e->y1 = a[1];
+				e->dir = -1;
+			}
+			e->dxdy = (b[0] - a[0]) / (b[1] - a[1]);
+			nedge++;
+		}
+	}
+	qsort(edge, nedge, sizeof(struct fb_edge), fb_edge_cmp);
+
+	nsfb_plot_get_clip(nsfb, &clip);
+	y = nedge > 0 ? (int)ceil(edge[0].y0 - 0.5f) : clip.y1;
+	if (y < clip.y0)
+		y = clip.y0;
+	ybot = clip.y1;
+
+	for (; y < ybot && (next < nedge || nactive > 0); y++) {
+		float sy = y + 0.5f;
+		int ncross = 0, wind = 0;
+		float xs = 0;
+
+		/* edges that start above this line come in, ended ones go */
+		while (next < nedge && edge[next].y0 <= sy)
+			active[nactive++] = edge + next++;
+		for (i = j = 0; i < nactive; i++) {
+			struct fb_edge *e = active[i];
+			if (e->y1 <= sy)
+				continue;
+			active[j++] = e;
+			cross[ncross].x = e->x0 + (sy - e->y0) * e->dxdy;
+			cross[ncross].dir = e->dir;
+			ncross++;
+		}
+		nactive = j;
+		if (ncross < 2)
+			continue;
+		qsort(cross, ncross, sizeof(struct fb_cross), fb_cross_cmp);
+
+		span.y0 = y;
+		span.y1 = y + 1;
+		for (i = 0; i < ncross; i++) {
+			int was = wind;
+			wind += cross[i].dir;
+			if (was == 0 && wind != 0) {
+				xs = cross[i].x;
+			} else if (was != 0 && wind == 0) {
+				span.x0 = (int)ceil(xs - 0.5f);
+				span.x1 = (int)ceil(cross[i].x - 0.5f);
+				if (span.x1 > span.x0)
+					nsfb_plot_rectangle_fill(nsfb, &span, c);
+			}
+		}
+	}
+
+	free(edge);
+	free(active);
+	free(cross);
+	return true;
+}
+
+static int fb_round(float v)
+{
+	return (int)floor(v + 0.5f);
+}
+
+/**
+ * Stroke the subpaths of a path: one pixel wide with libnsfb's lines,
+ * wider as a quadrilateral for each segment, filled.
+ */
+static bool fb_path_stroke(const struct fb_path *fp, colour c, int width)
+{
+	int k, i;
+
+	if (width <= 1) {
+		nsfb_plot_pen_t pen;
+		nsfb_bbox_t line;
+
+		pen.stroke_type = NFSB_PLOT_OPTYPE_SOLID;
+		pen.stroke_width = 1;
+		pen.stroke_colour = c;
+		for (k = 0; k < fp->nsub; k++) {
+			int end = fb_path_end(fp, k);
+			for (i = fp->start[k]; i + 1 < end; i++) {
+				const float *a = fp->pt + i * 2;
+				line.x0 = fb_round(a[0]);
+				line.y0 = fb_round(a[1]);
+				line.x1 = fb_round(a[2]);
+				line.y1 = fb_round(a[3]);
+				nsfb_plot_line(nsfb, &line, &pen);
+			}
+		}
+		return true;
+	}
+
+	/* all quadrilaterals turn the same way: their union by nonzero */
+	struct fb_path quads = { NULL, 0, 0, NULL, 0, 0 };
+	bool ok = true;
+	float h = width / 2.0f;
+
+	for (k = 0; k < fp->nsub && ok; k++) {
+		int end = fb_path_end(fp, k);
+		for (i = fp->start[k]; i + 1 < end && ok; i++) {
+			const float *a = fp->pt + i * 2;
+			float dx = a[2] - a[0], dy = a[3] - a[1];
+			float len = sqrt(dx * dx + dy * dy);
+			float nx, ny;
+			if (len == 0)
+				continue;
+			nx = -dy / len * h;
+			ny = dx / len * h;
+			/* square ends cover the joins */
+			dx = dx / len * h;
+			dy = dy / len * h;
+			ok = fb_path_move(&quads, a[0] - dx + nx, a[1] - dy + ny) &&
+				fb_path_point(&quads, a[2] + dx + nx, a[3] + dy + ny) &&
+				fb_path_point(&quads, a[2] + dx - nx, a[3] + dy - ny) &&
+				fb_path_point(&quads, a[0] - dx - nx, a[1] - dy - ny);
+		}
+	}
+	if (ok)
+		ok = fb_path_fill(&quads, c);
+	free(quads.pt);
+	free(quads.start);
+	return ok;
+}
+
+/** Add a cubic Bezier curve from the last point, in enough lines */
+static bool
+fb_path_bezier(struct fb_path *fp, float x1, float y1, float x2, float y2,
+	       float x3, float y3)
+{
+	float x0 = fp->pt[fp->n * 2 - 2], y0 = fp->pt[fp->n * 2 - 1];
+	/* the control polygon's length bounds the curve's: lines of 3 px */
+	float len = fabs(x1 - x0) + fabs(y1 - y0) + fabs(x2 - x1) +
+		fabs(y2 - y1) + fabs(x3 - x2) + fabs(y3 - y2);
+	int segs = (int)(len / 3), i;
+
+	if (segs < 1)
+		segs = 1;
+	else if (segs > 64)
+		segs = 64;
+	for (i = 1; i <= segs; i++) {
+		float t = (float)i / segs, u = 1 - t;
+		float a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t;
+		float d = t * t * t;
+		if (!fb_path_point(fp, a * x0 + b * x1 + c * x2 + d * x3,
+				   a * y0 + b * y1 + c * y2 + d * y3))
+			return false;
+	}
+	return true;
+}
+
 /**
  * Plots a path.
  *
@@ -271,8 +537,57 @@
