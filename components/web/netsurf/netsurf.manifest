# name, version and what building and running it needs
name     web/netsurf
version  3.11
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
summary  NetSurf web browser (framebuffer frontend on libnsfb's Xlib surface)
build    developer/netsurf-buildsystem
build    developer/nsgenbind
require  library/libwapcaplet
require  library/libparserutils
require  library/libhubbub
require  library/libdom
require  library/libcss
require  library/libnsbmp
require  library/libnsgif
require  library/libnsutils
require  library/libnslog
require  library/libnspsl
require  library/libutf8proc
require  library/libnsfb
require  library/libsvgtiny
require  library/expat
require  library/freetype
require  fonts/dejavu
require  fonts/comic-neue
require  fonts/anton
require  library/libiconv
require  library/libm99
require  library/quickjs-ng
require  library/libjpeg
require  library/libpng
require  library/zlib
require  library/openssl
require  network/curl
# the X surface links libX11.so.7 and libXext.so.7
require  x11/x11r6.3 >= 6.3
