# name, version and what building and running it needs
name     desktop/motif
version  2.3.8
# the 68020..68060 baseline (-mcpu=68020 -mtune=68060), tools/amix-cpu-scan clean
cpu      68020
summary  Motif toolkit: libXm, libMrm (shared), their headers, .pc files and mwm in /usr/motif
require  x11/x11r6.3 >= 6.3
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
provide  xm
provide  mrm
# every file the stage installs; "devel": headers, .so links, .pc, link stubs
file     /usr/local/share/amix-stubs/motif/LIST devel
file     /usr/local/share/amix-stubs/motif/libMrm.so.4.s devel
file     /usr/local/share/amix-stubs/motif/libXm.so.4.s devel
file     /usr/motif/bin/mwm
