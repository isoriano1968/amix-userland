#
# amixsoftware.dt -- the AMIX Software Center: find, install, upgrade and
# remove AMIX software through IPS pkg and apkg.  Installed in /etc/dt/appconfig/types/C.
#
ACTION AmixSoftware
{
	LABEL		Software Center
	TYPE		COMMAND
	WINDOW_TYPE	NO_STDIO
	EXEC_STRING	/opt/amix/bin/amixsoftware
	ICON		AmixSoftware
	DESCRIPTION	Find, install, update and remove AMIX software from both \
			package systems: IPS pkg (our packages) and apkg \
			(amigaux); Try shows what a change would do without \
			making it.
}
