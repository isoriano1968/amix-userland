# name, version and what building and running it needs
name     desktop/cde-apps
summary  AMIX applications for CDE: the AMIX panel control, System Monitor, Display, Printers, Software Center
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
require  x11/x11r6.3
require  desktop/cde
require  desktop/motif
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
require  library/amixstat >= 1.3
require  x11/libxrandr
# amixcast: the DLNA control point (libupnp) on Pth threads
require  library/libupnp
require  library/pth
# the apps of the Z3660's core 1 are packages of their own (desktop/cde-z3660,
# cde-amixuae, cde-amixq3), with org.amix.hw: each app's panel control comes
# with the package that delivers the app (<app>.fp into AmixPanel)
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/AmixDisplay
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/AmixPrinters
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/AmixSoftware
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/AmixSysMon
file     /etc/dt/appconfig/icons/C/AmixPanel.l.pm
file     /etc/dt/appconfig/icons/C/AmixPanel.m.pm
file     /etc/dt/appconfig/icons/C/AmixPanel.t.pm
file     /etc/dt/appconfig/icons/C/AmixPrinters.l.pm
file     /etc/dt/appconfig/icons/C/AmixPrinters.m.pm
file     /etc/dt/appconfig/icons/C/AmixPrinters.t.pm
file     /etc/dt/appconfig/icons/C/AmixSoftware.l.pm
file     /etc/dt/appconfig/icons/C/AmixSoftware.m.pm
file     /etc/dt/appconfig/icons/C/AmixSoftware.t.pm
file     /etc/dt/appconfig/icons/C/Display.l.pm
file     /etc/dt/appconfig/icons/C/Display.m.pm
file     /etc/dt/appconfig/icons/C/Display.t.pm
file     /etc/dt/appconfig/icons/C/SysMon.l.pm
file     /etc/dt/appconfig/icons/C/SysMon.m.pm
file     /etc/dt/appconfig/icons/C/SysMon.t.pm
file     /etc/dt/appconfig/types/C/amix.fp
file     /etc/dt/appconfig/types/C/amixdisplay.dt
file     /etc/dt/appconfig/types/C/amixdisplay.fp
file     /etc/dt/appconfig/types/C/amixprinters.dt
file     /etc/dt/appconfig/types/C/amixprinters.fp
file     /etc/dt/appconfig/types/C/amixsoftware.dt
file     /etc/dt/appconfig/types/C/amixsoftware.fp
file     /etc/dt/appconfig/types/C/amixsysmon.dt
file     /etc/dt/appconfig/types/C/amixsysmon.fp
file     /etc/dt/config/Xsession.d/0012.amixdisplay
file     /etc/dt/config/Xsetup.d/0012.amixdisplay
file     /opt/amix/bin/amixdisplay
file     /opt/amix/bin/amixprinters
file     /opt/amix/bin/amixsoftware
file     /opt/amix/bin/amixsysmon mode=2755 owner=root group=sys
file     /opt/amix/lib/amixdisplay/setlogin mode=4755 owner=root group=sys
file     /opt/amix/lib/amixprinters/amixprfind
file     /opt/amix/lib/amixprinters/prsend
file     /opt/amix/lib/amixprinters/prset mode=4755 owner=root group=sys
file     /opt/amix/lib/amixprinters/testpage.ps
file     /opt/amix/lib/amixsoftware/swrun mode=4755 owner=root group=sys
