#
# amixq3.dt -- Quake III: Quake III Arena (ioquake3) on the Z3660's ARM core
# 1 (games/ioquake3), its front end.  Installed in /etc/dt/appconfig/types/C.
#
ACTION AmixQ3
{
	LABEL		Quake III
	TYPE		COMMAND
	WINDOW_TYPE	NO_STDIO
	EXEC_STRING	/opt/amix/bin/amixq3
	ICON		AmixQ3
	DESCRIPTION	Quake III Arena (the demo) or Return to Castle \
			Wolfenstein with the whole engine and \
			its GL on the Z3660's second ARM core: picture in the \
			RTG overlay, sound on HDMI.  F10 quits the game.
}
