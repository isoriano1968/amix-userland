%!PS-Adobe-3.0
%%Pages: 1
%%DocumentMedia: A4 595 842 0 () ()
%%EndComments
%%Page: 1 1
<< /PageSize [595 842] >> setpagedevice
/Helvetica-Bold findfont 28 scalefont setfont
72 760 moveto (AMIX test page) show
/Helvetica findfont 14 scalefont setfont
72 720 moveto (Amiga 3000 + Z3660, AT&T SVR4 2.1c, lp spooler) show
72 700 moveto (printed by amixprinters through lp, raw TCP port) show
0 0 1 setrgbcolor 72 600 100 60 rectfill
1 0 0 setrgbcolor 192 600 100 60 rectfill
0 0.6 0 setrgbcolor 312 600 100 60 rectfill
showpage
%%EOF
