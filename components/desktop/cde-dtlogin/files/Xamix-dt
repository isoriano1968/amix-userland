#!/bin/sh
# Xamix-dt -- the AMIX X server (Xamix) as dtlogin (/etc/dt/config/Xservers)
# and startcde start it.  The limits and library path are startx-rtg's: the
# server maps the whole framebuffer and its heap is brk, so the 16 MB
# defaults make it fail with "Not enough space" or "Out of memory".  exec, so
# that dtlogin's signals (reset, terminate) reach the server itself.
# The card is the server's choice: /etc/X11/amix-card (the AMIX Installer
# writes it: cirrus for the Picasso II, zz9000, z3660).  Mode: $RTG_MODE, else
# the first word of /etc/dt/config/rtg-mode, else 1920x1080 on the Z3660 RTG
# and the card's own default on the others.
ulimit -v 131072 2> /dev/null || ulimit -m 131072 2> /dev/null
ulimit -d 65536 2> /dev/null
MODE=${RTG_MODE-}
# the first word of line 1 only: the line may carry a comment after the mode
[ -z "$MODE" ] && [ -r /etc/dt/config/rtg-mode ] && MODE=`awk 'NR == 1 { print $1; exit }' /etc/dt/config/rtg-mode`
CARD=`cat /etc/X11/amix-card 2> /dev/null`
[ -z "$MODE" ] && [ "$CARD" = z3660 ] && MODE=1920x1080
LD_LIBRARY_PATH=/usr/lib:/usr/amiga/lib
export LD_LIBRARY_PATH
[ -d /var/dt ] || mkdir -p /var/dt
# not ${MODE:+-mode $MODE}: AMIX's sh calls a $ inside ${...+word} a "bad
# substitution"
[ -z "$MODE" ] || set -- "$@" -mode "$MODE"
# the fonts of x11/x11r6.3-fonts (the server's own default path) and CDE's,
# the colour names from the server's rgb.txt: nothing of stock AMIX's X11R5
# (/usr/X/lib, Commodore's Xcore, which an AMIX may not have)
F=/usr/x11r6/lib/X11/fonts
exec /usr/x11r6/bin/Xamix "$@" \
	-fp $F/misc/,$F/75dpi/,$F/100dpi/,$F/Speedo/,$F/Type1/,/usr/dt/config/xfonts/C/ \
	-kb >> /var/dt/Xamix.log 2>&1
