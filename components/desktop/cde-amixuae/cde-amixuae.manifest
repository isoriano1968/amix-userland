# name, version and what building and running it needs
name     desktop/cde-amixuae
version  1.0
summary  Amiga: the window of the Amiga emulator on the Z3660's core 1 (amixuae), with the ADF/HDF/ROM data types
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
# the Z3660's ARM core 1: pkg and the installer leave it off a machine
# without the board; its CDE files are in /etc/dt/appconfig-hw/z3660-core1,
# which the session searches only when amix-hw finds the board
hw       z3660-core1
require  x11/x11r6.3
require  desktop/cde
require  desktop/motif
require  library/amixc99 >= 2
# the AMIX control and its subpanel AmixPanel, which the control goes into
require  desktop/cde-apps
# amixuae runs emulators/uae4arm's c1uae
require  emulators/uae4arm
file     /etc/dt/appconfig-hw/z3660-core1/appmanager/C/Desktop_Apps/AmixUAE
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaADF.l.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaADF.m.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaADF.t.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaHDF.l.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaHDF.m.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaHDF.t.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaROM.l.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaROM.m.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmigaROM.t.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixUAE.l.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixUAE.m.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixUAE.t.pm
file     /etc/dt/appconfig-hw/z3660-core1/types/C/amixuae.dt
file     /etc/dt/appconfig-hw/z3660-core1/types/C/amixuae.fp
file     /opt/amix/bin/amixuae
