! xmodmap.amiga-usa2 -- the AMIX console keymap "usa2" for the Xzz9000 server
! generated by kmap2xmodmap.py from /usr/amiga/lib/kmap/usa2; keycode = Amiga raw + 1
! right Alt = Mode_switch (the keymap's Alt column), left Alt stays Alt
clear mod1
clear mod3
keycode 0x66 = Mode_switch
add mod1 = Alt_L
add mod3 = Mode_switch
keycode 0x01 = grave asciitilde grave asciitilde
keycode 0x02 = 1 exclam 0x00b9 exclam
keycode 0x03 = 2 at 0x00b2 at
keycode 0x04 = 3 numbersign 0x00b3 numbersign
keycode 0x05 = 4 dollar 0x00a2 dollar
keycode 0x06 = 5 percent 0x00bc percent
keycode 0x07 = 6 asciicircum 0x00bd asciicircum
keycode 0x08 = 7 ampersand 0x00be ampersand
keycode 0x09 = 8 asterisk 0x00b7 asterisk
keycode 0x0a = 9 parenleft 0x00ab parenleft
keycode 0x0b = 0 parenright 0x00bb parenright
keycode 0x0c = backslash bar minus underscore
keycode 0x0d = equal plus
keycode 0x0e = braceright braceleft backslash bar
keycode 0x11 = apostrophe quotedbl 0x00e5 0x00c5
keycode 0x12 = comma less 0x00b0 0x00b0
keycode 0x13 = period greater 0x00a9 0x00a9
keycode 0x14 = p P 0x00ae 0x00ae
keycode 0x15 = y Y 0x00fe 0x00de
keycode 0x16 = f F 0x00a4 0x00a5
keycode 0x17 = g G 0x00b5 0x00b5
keycode 0x18 = c C 0x00a1 0x00a6
keycode 0x19 = r R 0x00f8 0x00d8
keycode 0x1a = l L 0x00b6 0x00b6
keycode 0x1b = slash question bracketleft braceleft
keycode 0x1c = bracketright bracketleft bracketright braceright
keycode 0x21 = a A 0x00e6 0x00c6
keycode 0x22 = o O 0x00df 0x00a7
keycode 0x23 = e E 0x00f0 0x00d0
keycode 0x24 = u U acute acute
keycode 0x25 = i I grave grave
keycode 0x26 = d D asciicircum asciicircum
keycode 0x27 = h H asciitilde asciitilde
keycode 0x28 = t T diaeresis diaeresis
keycode 0x29 = n N 0x00a3 0x00a3
keycode 0x2a = s S semicolon colon
keycode 0x2b = minus underscore apostrophe quotedbl
keycode 0x31 = less greater 0x00ab 0x00bb
keycode 0x32 = semicolon colon 0x00b1 0x00ac
keycode 0x33 = q Q 0x00d7 0x00f7
keycode 0x34 = j J 0x00e7 0x00c7
keycode 0x35 = k K 0x00aa 0x00aa
keycode 0x36 = x X 0x00ba 0x00ba
keycode 0x37 = b B 0x00ad 0x00af
keycode 0x38 = m M 0x00b8 0x00bf
keycode 0x39 = w W comma less
keycode 0x3a = v V period greater
keycode 0x3b = z Z slash question
keycode 0x41 = space NoSymbol nobreakspace
