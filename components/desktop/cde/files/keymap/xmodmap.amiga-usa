! xmodmap.amiga-usa -- the AMIX console keymap "usa" for the Xzz9000 server
! generated by kmap2xmodmap.py from /usr/amiga/lib/kmap/usa; keycode = Amiga raw + 1
! right Alt = Mode_switch (the keymap's Alt column), left Alt stays Alt
clear mod1
clear mod3
keycode 0x66 = Mode_switch
add mod1 = Alt_L
add mod3 = Mode_switch
keycode 0x01 = 0x00e0 0x00fe
keycode 0x02 = 0x00b1 0x00a1
keycode 0x03 = 0x00b2 0x00c0
keycode 0x04 = 0x00b3 0x00a3
keycode 0x05 = acute 0x00a4
keycode 0x06 = 0x00b5 0x00a5
keycode 0x07 = 0x00b6 0x00de
keycode 0x08 = 0x00b7 0x00a6
keycode 0x09 = 0x00b8 0x00aa
keycode 0x0a = 0x00b9 diaeresis
keycode 0x0b = 0x00b0 0x00a9
keycode 0x0c = 0x00ad 0x00df
keycode 0x0d = 0x00bd 0x00ab
keycode 0x0e = 0x00dc 0x00fc
keycode 0x11 = 0x00f1 0x00d1
keycode 0x12 = 0x00f7 0x00d7
keycode 0x13 = 0x00e5 0x00c5
keycode 0x14 = 0x00f2 0x00d2
