! xmodmap.amiga-f -- the AMIX console keymap "f" for the Xzz9000 server
! generated by kmap2xmodmap.py from /usr/amiga/lib/kmap/f; keycode = Amiga raw + 1
! right Alt = Mode_switch (the keymap's Alt column), left Alt stays Alt
clear mod1
clear mod3
keycode 0x66 = Mode_switch
add mod1 = Alt_L
add mod3 = Mode_switch
keycode 0x01 = grave asciitilde grave asciitilde
keycode 0x02 = ampersand 1 0x00b9 exclam
keycode 0x03 = 0x00e9 2 0x00b2 at
keycode 0x04 = quotedbl 3 0x00b3 numbersign
keycode 0x05 = apostrophe 4 0x00a2 dollar
keycode 0x06 = parenleft 5 0x00bc percent
keycode 0x07 = 0x00a7 6 0x00bd asciicircum
keycode 0x08 = 0x00e8 7 0x00be ampersand
keycode 0x09 = exclam 8 0x00b7 asterisk
keycode 0x0a = 0x00e7 9 0x00ab parenleft
keycode 0x0b = 0x00e0 0 0x00bb parenright
keycode 0x0c = parenright 0x00b0 minus underscore
keycode 0x0d = minus underscore equal plus
keycode 0x0e = backslash bar backslash bar
keycode 0x11 = a A 0x00e5 0x00c5
keycode 0x12 = z Z 0x00b0 0x00b0
keycode 0x13 = e E 0x00a9 0x00a9
keycode 0x14 = r R 0x00ae 0x00ae
keycode 0x15 = t T 0x00fe 0x00de
keycode 0x16 = y Y 0x00a4 0x00a5
keycode 0x17 = u U 0x00b5 0x00b5
keycode 0x18 = i I 0x00a1 0x00a6
keycode 0x19 = o O 0x00f8 0x00d8
keycode 0x1a = p P 0x00b6 0x00b6
keycode 0x1b = asciicircum diaeresis bracketleft braceleft
keycode 0x1c = dollar asterisk bracketright braceright
keycode 0x21 = q Q 0x00e6 0x00c6
keycode 0x22 = s S 0x00df 0x00a7
keycode 0x23 = d D 0x00f0 0x00d0
keycode 0x24 = f F acute acute
keycode 0x25 = g G grave grave
keycode 0x26 = h H asciicircum asciicircum
keycode 0x27 = j J asciitilde asciitilde
keycode 0x28 = k K diaeresis diaeresis
keycode 0x29 = l L 0x00a3 0x00a3
keycode 0x2a = m M semicolon colon
keycode 0x2b = 0x00f9 percent apostrophe quotedbl
keycode 0x2c = 0x00b5 0x00a3
keycode 0x31 = less greater
keycode 0x32 = w W 0x00b1 0x00ac
keycode 0x33 = x X 0x00d7 0x00f7
keycode 0x34 = c C 0x00e7 0x00c7
keycode 0x35 = v V 0x00aa 0x00aa
keycode 0x36 = b B 0x00ba 0x00ba
keycode 0x37 = n N 0x00ad 0x00af
keycode 0x38 = comma question 0x00b8 0x00bf
keycode 0x39 = semicolon period comma less
keycode 0x3a = colon slash period greater
keycode 0x3b = equal plus slash question
keycode 0x41 = space NoSymbol nobreakspace
