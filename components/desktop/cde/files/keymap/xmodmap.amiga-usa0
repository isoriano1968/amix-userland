! xmodmap.amiga-usa0 -- the AMIX console keymap "usa0" for the Xzz9000 server
! generated by kmap2xmodmap.py from /usr/amiga/lib/kmap/usa0; keycode = Amiga raw + 1
! right Alt = Mode_switch (the keymap's Alt column), left Alt stays Alt
clear mod1
clear mod3
keycode 0x66 = Mode_switch
add mod1 = Alt_L
add mod3 = Mode_switch
keycode 0x01 = grave asciitilde 0x00e0 0x00fe
keycode 0x02 = 1 exclam 0x00b1 0x00a1
keycode 0x03 = 2 at 0x00b2 0x00c0
keycode 0x04 = 3 numbersign 0x00b3 0x00a3
keycode 0x05 = 4 dollar acute 0x00a4
keycode 0x06 = 5 percent 0x00b5 0x00a5
keycode 0x07 = 6 asciicircum 0x00b6 0x00de
keycode 0x08 = 7 ampersand 0x00b7 0x00a6
keycode 0x09 = 8 asterisk 0x00b8 0x00aa
keycode 0x0a = 9 parenleft 0x00b9 diaeresis
keycode 0x0b = 0 parenright 0x00b0 0x00a9
keycode 0x0c = minus underscore 0x00ad 0x00df
keycode 0x0d = equal plus 0x00bd 0x00ab
keycode 0x0e = backslash bar 0x00dc 0x00fc
keycode 0x11 = q Q 0x00f1 0x00d1
keycode 0x12 = w W 0x00f7 0x00d7
keycode 0x13 = e E 0x00e5 0x00c5
keycode 0x14 = r R 0x00f2 0x00d2
keycode 0x15 = t T 0x00f4 0x00d4
keycode 0x16 = y Y 0x00f9 0x00d9
keycode 0x17 = u U 0x00f5 0x00d5
keycode 0x18 = i I 0x00e9 0x00c9
keycode 0x19 = o O 0x00ef 0x00cf
keycode 0x1a = p P 0x00f0 0x00d0
keycode 0x1b = bracketleft braceleft 0x00db 0x00fb
keycode 0x1c = bracketright braceright 0x00dd 0x00fd
keycode 0x21 = a A 0x00e1 0x00c1
keycode 0x22 = s S 0x00f3 0x00d3
keycode 0x23 = d D 0x00e4 0x00c4
keycode 0x24 = f F 0x00e6 0x00c6
keycode 0x25 = g G 0x00e7 0x00c7
keycode 0x26 = h H 0x00e8 0x00c8
keycode 0x27 = j J 0x00ea 0x00ca
keycode 0x28 = k K 0x00eb 0x00cb
keycode 0x29 = l L 0x00ec 0x00cc
keycode 0x2a = semicolon colon 0x00bb 0x00ba
keycode 0x2b = apostrophe quotedbl 0x00a7 0x00a2
keycode 0x32 = z Z 0x00fa 0x00da
keycode 0x33 = x X 0x00f8 0x00d8
keycode 0x34 = c C 0x00e3 0x00c3
keycode 0x35 = v V 0x00f6 0x00d6
keycode 0x36 = b B 0x00e2 0x00c2
keycode 0x37 = n N 0x00ee 0x00ce
keycode 0x38 = m M 0x00ed 0x00cd
keycode 0x39 = comma less 0x00ac 0x00bc
keycode 0x3a = period greater 0x00ae 0x00be
keycode 0x3b = slash question 0x00af 0x00bf
keycode 0x41 = space NoSymbol nobreakspace
