From 2c42f35a56aec1c47336515c8f052f82c0da0656 Mon Sep 17 00:00:00 2001
From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:57:36 +0100
Subject: [PATCH 40/42] dtlogin: read the password from /etc/shadow on AMIX

AMIX uses the generic Authenticate(), which compares against getpwnam()'s
pw_passwd -- "x" on a system with a shadow file -- so every login was
"Login incorrect".  Use the getspnam() path the Linux build already has;
AMIX's libc.a provides getspnam and crypt.
---
 programs/dtlogin/sysauth.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/programs/dtlogin/sysauth.c b/programs/dtlogin/sysauth.c
index 449dcd9a..5db4df0a 100644
--- a/programs/dtlogin/sysauth.c
+++ b/programs/dtlogin/sysauth.c
@@ -119,7 +119,7 @@
 #define generic
 #endif
 
-#if defined(__linux__)
+#if defined(__linux__) || defined(__amix__)
 #    include <shadow.h>
 #endif
 
@@ -1944,9 +1944,10 @@ Authenticate( struct display *d, char *name, char *passwd, char **msg )
 
     p = getpwnam(name);
     
-#if defined(__linux__)
+#if defined(__linux__) || defined(__amix__)
     /*
-     * Use the Linux Shadow Password system to get the crypt()ed password
+     * Use the Linux Shadow Password system to get the crypt()ed password.
+     * AMIX (SVR4) keeps it in /etc/shadow too; pw_passwd is just "x".
      */
     if(p) {
         struct spwd *s = getspnam(name);
-- 
