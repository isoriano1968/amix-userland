From: isoriano1968 <81116077+isoriano1968@users.noreply.github.com>
Subject: [PATCH] AMIX rpc/types.h: rpc_inline_t and __unused for illumos rpcgen output

OpenIndiana's rpcgen declares the XDR routines' inline buffer as
"rpc_inline_t *buf __unused;" (TI-RPC names AMIX's SVR4.0 RPC predates);
libcsa did not compile when CDE was built on OpenIndiana.
---
--- a/config/amix/include/rpc/types.h	2026-11-15 14:49:15.435065219 +0100
+++ b/config/amix/include/rpc/types.h	2026-11-15 14:49:15.435065219 +0100
@@ -5,4 +5,14 @@
 #define _AMIX_CDE_RPC_TYPES_H
 #include_next <rpc/types.h>
 #include <stdint.h>
+/* The build host's rpcgen writes the XDR routines.  illumos' (OpenIndiana)
+ * declares their inline buffer as "rpc_inline_t *buf __unused;", TI-RPC's
+ * names, which AMIX's SVR4.0 RPC predates; Linux's says int32_t. */
+#ifndef _AMIX_HAVE_RPC_INLINE_T
+#define _AMIX_HAVE_RPC_INLINE_T
+typedef int32_t rpc_inline_t;
+#endif
+#ifndef __unused
+#define __unused __attribute__((__unused__))
+#endif
 #endif
