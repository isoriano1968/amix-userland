From 649b8b3bacf357ac481a97f902af065e2a0ae8fb Mon Sep 17 00:00:00 2001
From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:44:35 +0200
Subject: [PATCH 09/42] host.def: C++ compiles search amix-cxxfix/ (AMIX
 headers with K&R "()" as "(...)")

---
 config/cf/host.def | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/config/cf/host.def b/config/cf/host.def
index 170cf570..7133cea7 100644
--- a/config/cf/host.def
+++ b/config/cf/host.def
@@ -33,7 +33,13 @@ XCOMM host.def -- cross-building CDE for AMIX on a Linux host (read before amix.
 #define RanlibCmd		AmixCrossPrefix/bin/m68k-elf-ranlib
 #define DoRanlibCmd		YES
 #define DefaultCCOptions	-fno-strict-aliasing -fcommon AmixOldCWarnings
-#define DefaultCplusplusOptions	-fno-strict-aliasing AmixOldCWarnings
+/*
+ * C++ sees AMIX's K&R declarations through amix-cxxfix/: copies of the
+ * affected headers with "()" turned into "(...)" (ABI-neutral on m68k),
+ * generated by ../amix-cxxfix.py from the sysroot -- AMIX text, not kept in
+ * this tree.
+ */
+#define DefaultCplusplusOptions	-fno-strict-aliasing AmixOldCWarnings -isystem $(TOP)/amix-cxxfix
 #define DefaultCDebugFlags	-O2
 #define DefaultCplusplusDebugFlags -O2
 
-- 
2.47.3

