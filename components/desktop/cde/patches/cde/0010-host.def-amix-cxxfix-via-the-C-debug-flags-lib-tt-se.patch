From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:46:05 +0200
Subject: [PATCH 10/42] host.def: amix-cxxfix via the C++ debug flags (lib/tt
 sets CXXOPTIONS itself)

---
 config/cf/host.def | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/config/cf/host.def b/config/cf/host.def
index 7133cea7..58458a3e 100644
--- a/config/cf/host.def
+++ b/config/cf/host.def
@@ -39,9 +39,10 @@ XCOMM host.def -- cross-building CDE for AMIX on a Linux host (read before amix.
  * generated by ../amix-cxxfix.py from the sysroot -- AMIX text, not kept in
  * this tree.
  */
-#define DefaultCplusplusOptions	-fno-strict-aliasing AmixOldCWarnings -isystem $(TOP)/amix-cxxfix
+#define DefaultCplusplusOptions	-fno-strict-aliasing AmixOldCWarnings
 #define DefaultCDebugFlags	-O2
-#define DefaultCplusplusDebugFlags -O2
+/* in the debug flags because some trees (lib/tt) set CXXOPTIONS themselves */
+#define DefaultCplusplusDebugFlags -O2 -isystem $(TOP)/amix-cxxfix
 
 /*
  * Host tools: imake's cpp (and CppCmd for data files) is the host cpp,
-- 
2.47.3

