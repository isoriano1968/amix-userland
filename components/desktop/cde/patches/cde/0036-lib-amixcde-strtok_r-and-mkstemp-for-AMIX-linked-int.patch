diff --git a/lib/Imakefile b/lib/Imakefile
index df37a00c..c3f07bf6 100644
--- a/lib/Imakefile
+++ b/lib/Imakefile
@@ -12,7 +12,11 @@ PAMDIR = pam
 PAMDIR =
 #endif
 
-SUBDIRS = $(XINDIR) $(PAMDIR) tt DtSvc DtSearch DtWidget DtHelp DtPrint \
+#if defined(AMIXArchitecture)
+AMIXDIR = amixcde
+#endif
+
+SUBDIRS = $(AMIXDIR) $(XINDIR) $(PAMDIR) tt DtSvc DtSearch DtWidget DtHelp DtPrint \
 	DtTerm DtMrm csa
 
 MakeSubdirs($(SUBDIRS))
