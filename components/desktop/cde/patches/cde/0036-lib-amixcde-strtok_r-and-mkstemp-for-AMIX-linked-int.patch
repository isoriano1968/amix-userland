+XCOMM lib/amixcde -- functions CDE uses that AMIX (SVR4.0) lacks; built on AMIX
+XCOMM only (lib/Imakefile), linked into every program via ExtraLibraries.
+#define DoNormalLib   YES
+#define DoSharedLib   NO
+#define DoDebugLib    NO
+#define DoProfileLib  NO
+#define HasSharedData NO
+#define LibName       amixcde
+#define LibHeaders    NO
