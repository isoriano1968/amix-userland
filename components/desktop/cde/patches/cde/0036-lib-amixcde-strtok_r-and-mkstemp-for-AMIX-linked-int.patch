 lib/Imakefile         |  6 +++-
 lib/amixcde/Imakefile | 19 ++++++++++++
 lib/amixcde/amixcde.c | 70 +++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 96 insertions(+), 2 deletions(-)
 create mode 100644 lib/amixcde/Imakefile
