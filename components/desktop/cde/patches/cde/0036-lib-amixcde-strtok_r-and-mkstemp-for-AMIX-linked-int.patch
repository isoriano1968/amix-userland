+DependTarget()
diff --git a/lib/amixcde/amixcde.c b/lib/amixcde/amixcde.c
new file mode 100644
index 00000000..3b5b27c9
--- /dev/null
+++ b/lib/amixcde/amixcde.c
@@ -0,0 +1,70 @@
+/*
+ * amixcde.c -- C library functions CDE uses that Amiga UNIX (AMIX, SVR4.0)
+ * does not have.  Part of the AMIX port of CDE.
+ */
+#include <sys/types.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <time.h>
+
+/* POSIX.1c strtok_r */
+char *
+strtok_r(char *s, const char *delim, char **last)
+{
+	char *tok;
+
+	if (s == NULL && (s = *last) == NULL)
+		return NULL;
+	s += strspn(s, delim);
+	if (*s == '\0') {
+		*last = NULL;
+		return NULL;
+	}
+	tok = s;
+	s += strcspn(s, delim);
+	if (*s != '\0')
+		*s++ = '\0';
+	else
+		s = NULL;
+	*last = s;
+	return tok;
+}
+
+/*
+ * mkstemp: replace the trailing XXXXXX of template and create the file
+ * exclusively (O_EXCL), retrying with other names on a clash.
+ */
+int
+mkstemp(char *template)
+{
+	static const char chars[] =
+	    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+	static unsigned long seed;
+	size_t len = strlen(template);
+	char *x;
+	int tries, fd, i;
+
+	if (len < 6 || strcmp(template + len - 6, "XXXXXX") != 0) {
+		errno = EINVAL;
+		return -1;
+	}
+	x = template + len - 6;
+	if (seed == 0)
+		seed = (unsigned long)getpid() * 2654435761UL + (unsigned long)time(0);
+	for (tries = 0; tries < 1000; tries++) {
+		unsigned long v;
+
+		seed = seed * 1103515245UL + 12345UL;
+		v = seed;
+		for (i = 0; i < 6; i++, v /= 62)
+			x[i] = chars[v % 62];
+		fd = open(template, O_RDWR | O_CREAT | O_EXCL, 0600);
+		if (fd >= 0 || errno != EEXIST)
+			return fd;
+	}
+	errno = EEXIST;
+	return -1;
+}
