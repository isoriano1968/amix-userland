From 5225d8a824720f897eea86f3e8836bcfe58612ac Mon Sep 17 00:00:00 2001
From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:27:50 +0200
Subject: [PATCH 35/42] host.def: Xmu/Xp and their dependencies at the end of
 every link (static libXm)

---
 config/cf/host.def | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/config/cf/host.def b/config/cf/host.def
index d40a3158..ad9276d6 100644
--- a/config/cf/host.def
+++ b/config/cf/host.def
@@ -94,4 +94,7 @@ XCOMM host.def -- cross-building CDE for AMIX on a Linux host (read before amix.
 
 /* the C++ runtime for C programs that link ToolTalk (libtt is C++);
  * archives, so programs that do not need it get nothing from it */
-#define ExtraLibraries		-lstdc++ -lsupc++ -lsocket -lnsl -lgen
+/* ... and, last, what static libXm needs from X (Editres in Xmu, Xp printing)
+ * with their own dependencies after them: a static link resolves left to right */
+#define ExtraLibraries		-lXmu -lXt -lXp -lXext -lSM -lICE -lX11 \
+				-lstdc++ -lsupc++ -lsocket -lnsl -lgen
-- 
2.47.3

