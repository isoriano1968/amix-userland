# name, version and what building and running it needs
name     desktop/cde
version  2.2.4a
# the 68020..68060 baseline (-mcpu=68020 -mtune=68060), tools/amix-cpu-scan clean
cpu      68020
summary  Common Desktop Environment 2.2.4a on shared libraries, in /usr/dt
require  x11/x11r6.3 >= 6.3
require  desktop/motif >= 2.3.8
require  x11/libxp >= 6.3
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
# Xsession runs these (XDIR=/usr/x11r6/bin): the gate checks they are delivered
uses     /usr/x11r6/bin/xset
uses     /usr/x11r6/bin/xsetroot
uses     /usr/x11r6/bin/xrdb
uses     /usr/x11r6/bin/xterm
# Xlib's locale database (CDE's font sets need XSupportsLocale) and Motif's osf keysyms
uses     /usr/x11r6/lib/X11/locale/locale.dir
uses     /usr/x11r6/lib/X11/locale/C/XLC_LOCALE
uses     /usr/x11r6/lib/X11/XKeysymDB
provide  tt
provide  dtsvc
provide  dthelp
provide  dtwidget
provide  dtterm
provide  dtprint
provide  dtsearch
provide  dtmrm
provide  csa
# every file the stage installs; "devel": headers, .so links, .pc, link stubs
file     /usr/dt/AMIX-INSTALL.sh
file     /usr/dt/CONTRIBUTORS
file     /usr/dt/COPYING
