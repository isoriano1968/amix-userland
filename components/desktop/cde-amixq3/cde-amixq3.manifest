# name, version and what building and running it needs
name     desktop/cde-amixq3
version  1.0
summary  Quake III / RtCW launcher for the Z3660's core 1 (amixq3)
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
# the Z3660's ARM core 1: pkg and the installer leave it off a machine
# without the board; its CDE files are in /etc/dt/appconfig-hw/z3660-core1,
# which the session searches only when amix-hw finds the board
hw       z3660-core1
require  x11/x11r6.3
require  desktop/cde
require  desktop/motif
require  library/amixc99 >= 2
# the AMIX control and its subpanel AmixPanel, which the control goes into
require  desktop/cde-apps
# amixq3 runs games/ioquake3's c1q3 (and games/iortcw's, when installed)
require  games/ioquake3
file     /etc/dt/appconfig-hw/z3660-core1/appmanager/C/Desktop_Apps/AmixQ3
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixQ3.l.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixQ3.m.pm
file     /etc/dt/appconfig-hw/z3660-core1/icons/C/AmixQ3.t.pm
file     /etc/dt/appconfig-hw/z3660-core1/types/C/amixq3.dt
file     /etc/dt/appconfig-hw/z3660-core1/types/C/amixq3.fp
file     /opt/amix/bin/amixq3
