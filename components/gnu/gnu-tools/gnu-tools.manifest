# name, version and what building and running it needs
name     gnu/gnu-tools
version  1
summary  The GNU tools: a metapackage, with no files of its own
require  shell/bash
require  gnu/bison
require  gnu/diffutils
require  gnu/findutils
require  gnu/gawk
require  gnu/grep
require  gnu/m4
require  gnu/make
require  gnu/sed
require  gnu/tar
