diff -ruN a/openssh-10.2p1/smult_curve25519_ref.c openssh-10.2p1/smult_curve25519_ref.c
--- a/openssh-10.2p1/smult_curve25519_ref.c	2025-10-10 04:38:31.000000000 +0200
+++ b/openssh-10.2p1/smult_curve25519_ref.c	2026-11-03 08:00:26.104778829 +0100
@@ -8,6 +8,47 @@
 
 int crypto_scalarmult_curve25519(unsigned char *, const unsigned char *, const unsigned char *);
 
+#ifdef __amix__
+/*
+ * AMIX: through libcrypto's X25519, which the Z3660's ARM core 1 computes
+ * (0.01 s against 0.5 s here on the 060); this code if libcrypto fails.
+ * The result is the same: both clamp the scalar.
+ */
+#include "includes.h"
+#include <string.h>
+#ifdef WITH_OPENSSL
+#include <openssl/evp.h>
+
+static int amix_x25519(unsigned char *q, const unsigned char *n, const unsigned char *p)
+{
+  static const unsigned char base[32] = {9};
+  EVP_PKEY *k, *peer = NULL;
+  EVP_PKEY_CTX *c = NULL;
+  size_t len = 32;
+  int ok = 0;
+
+  if ((k = EVP_PKEY_new_raw_private_key(EVP_PKEY_X25519, NULL, n, 32)) == NULL)
+    return 0;
+  if (memcmp(p, base, 32) == 0)
+    ok = EVP_PKEY_get_raw_public_key(k, q, &len) == 1 && len == 32;
+  else if ((peer = EVP_PKEY_new_raw_public_key(EVP_PKEY_X25519, NULL, p, 32)) != NULL &&
+           (c = EVP_PKEY_CTX_new(k, NULL)) != NULL && EVP_PKEY_derive_init(c) == 1 &&
+           EVP_PKEY_derive_set_peer(c, peer) == 1) {
+    if (EVP_PKEY_derive(c, q, &len) == 1 && len == 32)
+      ok = 1;
+    else {
+      memset(q, 0, 32);   /* a low-order point: libcrypto refuses, this code gives 0 */
+      ok = 1;
+    }
+  }
+  EVP_PKEY_CTX_free(c);
+  EVP_PKEY_free(peer);
+  EVP_PKEY_free(k);
+  return ok;
+}
+#endif
+#endif
+
 static void add(unsigned int out[32],const unsigned int a[32],const unsigned int b[32])
 {
   unsigned int j;
