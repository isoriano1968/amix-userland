AMIX: X25519 and Ed25519 through libcrypto, for the Z3660's ARM core 1

OpenSSH's own curve25519 (also the X25519 half of mlkem768x25519) and Ed25519
take 0.2 to 0.6 s each on the 060.  AMIX's libcrypto hands X25519 and Ed25519
to core 1 (library/openssl patches/0001-amix-zz3660-offload.patch), so these
call libcrypto's EVP X25519 and Ed25519 first and keep the reference code
for when libcrypto fails.  Results are identical (RFC 7748 / RFC 8032).

diff -ruN a/openssh-10.2p1/ed25519.c openssh-10.2p1/ed25519.c
--- a/openssh-10.2p1/ed25519.c	2025-10-10 04:38:31.000000000 +0200
+++ b/openssh-10.2p1/ed25519.c	2026-11-03 08:00:26.104778829 +0100
@@ -15,6 +15,54 @@
 
 #include "crypto_api.h"
 
+#if defined(__amix__) && defined(WITH_OPENSSL)
+/*
+ * AMIX: signing and verifying through libcrypto's Ed25519, which the
+ * Z3660's ARM core 1 computes (milliseconds against 0.2 and 0.6 s here on
+ * the 060); the code below if libcrypto fails.  sk is seed || public key.
+ */
+#include <openssl/evp.h>
+
+static int amix_ed25519_sign(unsigned char *sig, const unsigned char *m, size_t mlen,
+                             const unsigned char *sk)
+{
+  EVP_PKEY *k = EVP_PKEY_new_raw_private_key(EVP_PKEY_ED25519, NULL, sk, 32);
+  EVP_MD_CTX *c = EVP_MD_CTX_new();
+  size_t len = 64;
+  int ok = k != NULL && c != NULL && EVP_DigestSignInit(c, NULL, NULL, NULL, k) == 1 &&
+           EVP_DigestSign(c, sig, &len, m, mlen) == 1 && len == 64;
+
+  EVP_MD_CTX_free(c);
+  EVP_PKEY_free(k);
+  return ok;
+}
+
+/* 1 valid, 0 not, -1 libcrypto could not tell */
+static int amix_ed25519_verify(const unsigned char *sig, const unsigned char *m, size_t mlen,
+                               const unsigned char *pk)
+{
+  EVP_PKEY *k = EVP_PKEY_new_raw_public_key(EVP_PKEY_ED25519, NULL, pk, 32);
+  EVP_MD_CTX *c = EVP_MD_CTX_new();
+  int r = -1;
+
+  if (k != NULL && c != NULL && EVP_DigestVerifyInit(c, NULL, NULL, NULL, k) == 1)
+    r = EVP_DigestVerify(c, sig, 64, m, mlen) == 1;
+  EVP_MD_CTX_free(c);
+  EVP_PKEY_free(k);
+  return r;
+}
+
+static int amix_ed25519_pk(unsigned char *pk, const unsigned char *sk)
+{
+  EVP_PKEY *k = EVP_PKEY_new_raw_private_key(EVP_PKEY_ED25519, NULL, sk, 32);
+  size_t len = 32;
+  int ok = k != NULL && EVP_PKEY_get_raw_public_key(k, pk, &len) == 1 && len == 32;
+
+  EVP_PKEY_free(k);
+  return ok;
+}
+#endif
+
 #define int8 crypto_int8
 #define uint8 crypto_uint8
 #define int16 crypto_int16
@@ -1917,6 +1965,12 @@
   ge25519 gepk;
 
   randombytes(sk,32);
+#if defined(__amix__) && defined(WITH_OPENSSL)
+  if (amix_ed25519_pk(pk, sk)) {
+    memmove(sk + 32,pk,32);
+    return 0;
+  }
+#endif
   crypto_hash_sha512(az,sk,32);
   az[0] &= 248;
   az[31] &= 127;
@@ -1944,6 +1998,13 @@
