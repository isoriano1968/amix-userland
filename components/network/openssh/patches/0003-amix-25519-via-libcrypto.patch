   ge25519 ger;
 
+#if defined(__amix__) && defined(WITH_OPENSSL)
+  memmove(sm + 64,m,mlen);
+  if (amix_ed25519_sign(sm, sm + 64, mlen, sk)) {
+    *smlen = mlen + 64;
+    return 0;
+  }
+#endif
   memmove(pk,sk + 32,32);
   /* pk: 32-byte public key A */
 
@@ -2000,6 +2061,17 @@
 
