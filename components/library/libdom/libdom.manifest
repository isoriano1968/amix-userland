# name, version and what building and running it needs
name     library/libdom
version  0.4.2
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
summary  W3C DOM
provide  libdom
require  developer/netsurf-buildsystem
require  library/libhubbub
require  library/libwapcaplet
require  library/libparserutils
require  library/expat
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
