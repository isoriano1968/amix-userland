@@ -0,0 +1,22 @@
+/*
+ * This file is part of LibCSS (AMIX patch).
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ */
+
+#ifndef css_cssvars_h_
+#define css_cssvars_h_
+
+#include <stddef.h>
+#include <stdint.h>
+
+/*
+ * Replace var() (from the sheet's top-level :root / html custom properties)
+ * and clamp() in a whole stylesheet's text.  1 = *out (malloc'd, *out_len
+ * bytes) holds the new text; 0 = nothing to replace, use the original; -1 =
+ * out of memory.
+ */
+int css__vars_expand(const uint8_t *s, size_t n, uint8_t **out,
+		size_t *out_len);
+
+#endif
