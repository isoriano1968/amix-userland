@@ -285,6 +287,8 @@
 	if (sheet->cached_style != NULL)
 		css__stylesheet_style_destroy(sheet->cached_style);
 
+	free(sheet->src);			/* AMIX: unparsed text, if any */
+
 	/* destroy string vector */
 	for (index = 0; index < sheet->string_vector_c; index++) {
 		lwc_string_unref(sheet->string_vector[index]);
@@ -317,7 +321,51 @@
 	if (sheet->parser == NULL)
 		return CSS_INVALID;
 
-	return css__parser_parse_chunk(sheet->parser, data, len);
+	/* AMIX: keep the text; it is parsed in data_done, after var() */
+	if (sheet->src_len + len > sheet->src_cap) {
+		size_t cap = sheet->src_cap ? sheet->src_cap : 4096;
+		uint8_t *p;
+
+		while (sheet->src_len + len > cap)
+			cap *= 2;
+		p = realloc(sheet->src, cap);
+		if (p == NULL)
+			return CSS_NOMEM;
+		sheet->src = p;
+		sheet->src_cap = cap;
+	}
+	memcpy(sheet->src + sheet->src_len, data, len);
+	sheet->src_len += len;
+
+	return CSS_OK;
+}
+
+/* AMIX: parse the kept text, var() and clamp() replaced (cssvars.c) */
+static css_error css__stylesheet_parse_src(css_stylesheet *sheet)
+{
+	uint8_t *out;
+	size_t out_len;
+	css_error error = CSS_OK;
+	int r;
+
+	if (sheet->src == NULL)
+		return CSS_OK;
+	r = css__vars_expand(sheet->src, sheet->src_len, &out, &out_len);
+	if (r < 0)
+		return CSS_NOMEM;
+	if (r > 0) {
+		error = css__parser_parse_chunk(sheet->parser, out, out_len);
+		free(out);
+	} else {
+		error = css__parser_parse_chunk(sheet->parser, sheet->src,
+				sheet->src_len);
+	}
+	free(sheet->src);
+	sheet->src = NULL;
+	sheet->src_len = sheet->src_cap = 0;
+	if (error == CSS_NEEDDATA)
+		error = CSS_OK;
+	return error;
 }
 
 /**
@@ -339,6 +387,10 @@
