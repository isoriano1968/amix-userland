diff -ruN a/src/cssvars.c b/libcss-0.9.2/src/cssvars.c
--- a/src/cssvars.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/cssvars.c	2026-11-04 08:00:06.977386895 +0100
@@ -0,0 +1,378 @@
+/*
+ * This file is part of LibCSS (AMIX patch).
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ *
+ * Stage-1 CSS custom properties: a pass over a whole stylesheet's text before
+ * it is parsed.  The custom properties ("--name: value") of the top-level
+ * rules whose selector list holds :root or html are collected (the last one
+ * wins), and var(--name) / var(--name, fallback) are replaced by their value
+ * everywhere else, nested references included.  A var() with neither value
+ * nor fallback is left as it is, so its declaration stays invalid.
+ *
+ * Not covered: custom properties set on other elements or inside @media, and
+ * anything that needs the cascade.  clamp(min, preferred, max) is replaced by
+ * its max, which libcss (no calc) can parse: right for desktop-wide windows.
+ */
+
+#include <ctype.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cssvars.h"
+
+#define CSSVARS_MAX	256		/* custom properties kept per sheet */
+#define CSSVARS_DEPTH	16		/* nested var() levels (cycles stop) */
+
+typedef struct {
+	const uint8_t *name;		/* "--name", in the sheet's text */
+	size_t name_len;
+	const uint8_t *value;		/* trimmed, unexpanded */
+	size_t value_len;
+} cssvar;
+
+typedef struct {
+	uint8_t *p;
+	size_t len, cap;
+	int failed;
+} obuf;
+
+static void put(obuf *o, const uint8_t *s, size_t n)
+{
+	if (o->failed)
+		return;
+	if (o->len + n > o->cap) {
+		size_t cap = o->cap ? o->cap : 4096;
+		uint8_t *np;
+
+		while (o->len + n > cap)
+			cap *= 2;
+		np = realloc(o->p, cap);
+		if (np == NULL) {
+			o->failed = 1;
+			return;
+		}
+		o->p = np;
+		o->cap = cap;
+	}
+	memcpy(o->p + o->len, s, n);
+	o->len += n;
+}
+
+/* the end of a comment or string starting at s[i], or i when there is none */
+static size_t skip_lit(const uint8_t *s, size_t n, size_t i)
+{
+	if (i + 1 < n && s[i] == '/' && s[i + 1] == '*') {
+		for (i += 2; i + 1 < n; i++)
+			if (s[i] == '*' && s[i + 1] == '/')
+				return i + 2;
+		return n;
+	}
+	if (s[i] == '"' || s[i] == '\'') {
+		uint8_t q = s[i];
+
+		for (i++; i < n && s[i] != q; i++)
+			if (s[i] == '\\' && i + 1 < n)
+				i++;
+		return i < n ? i + 1 : n;
+	}
+	return i;
+}
+
+static int is_ident(uint8_t c)
+{
+	return isalnum(c) || c == '-' || c == '_' || c >= 0x80;
+}
+
+static void trim(const uint8_t **s, size_t *n)
+{
+	while (*n > 0 && isspace((*s)[0]))
+		(*s)++, (*n)--;
+	while (*n > 0 && isspace((*s)[*n - 1]))
+		(*n)--;
+}
+
+/* trim, and drop the comments in front: "/" "* x *" "/ --a: b" -> "--a: b" */
+static void trim_decl(const uint8_t **s, size_t *n)
+{
+	trim(s, n);
+	while (*n >= 2 && (*s)[0] == '/' && (*s)[1] == '*') {
+		size_t e = skip_lit(*s, *n, 0);
+
+		*s += e;
+		*n -= e;
+		trim(s, n);
+	}
+}
+
+/* does the selector list s[0..n) hold :root or html as one of its items */
+static int is_root_prelude(const uint8_t *s, size_t n)
+{
+	size_t a = 0, b;
+
+	while (a <= n) {
+		const uint8_t *it;
+		size_t len;
+
+		for (b = a; b < n && s[b] != ','; b++)
+			;
+		it = s + a;
+		len = b - a;
+		trim(&it, &len);
+		if ((len == 5 && strncasecmp((const char *) it, ":root", 5) == 0) ||
+		    (len == 4 && strncasecmp((const char *) it, "html", 4) == 0))
+			return 1;
+		a = b + 1;
+	}
+	return 0;
+}
+
+/* collect the --name: value declarations of a { } block at s[i] (after '{') */
+static size_t collect_block(const uint8_t *s, size_t n, size_t i,
+		cssvar *vars, int *nvars)
+{
+	size_t d0 = i;			/* declaration start */
+	int paren = 0;
+
+	for (; i < n; i++) {
+		size_t j = skip_lit(s, n, i);
+
+		if (j != i) {
+			i = j - 1;
+			continue;
+		}
+		if (s[i] == '(')
+			paren++;
+		else if (s[i] == ')' && paren > 0)
+			paren--;
+		else if (paren == 0 && (s[i] == ';' || s[i] == '}')) {
+			const uint8_t *d = s + d0, *colon;
+			size_t dn = i - d0;
+
+			trim_decl(&d, &dn);
+			colon = memchr(d, ':', dn);
+			if (dn > 2 && d[0] == '-' && d[1] == '-' && colon != NULL) {
+				const uint8_t *nm = d, *v = colon + 1;
+				size_t nl = (size_t)(colon - d), vl = dn - nl - 1;
+				int k;
+
+				trim(&nm, &nl);
+				trim(&v, &vl);
+				for (k = 0; k < *nvars; k++)
+					if (vars[k].name_len == nl &&
+					    memcmp(vars[k].name, nm, nl) == 0)
+						break;
+				if (k < CSSVARS_MAX) {
+					vars[k].name = nm;
+					vars[k].name_len = nl;
+					vars[k].value = v;
+					vars[k].value_len = vl;
+					if (k == *nvars)
+						(*nvars)++;
+				}
+			}
+			d0 = i + 1;
+			if (s[i] == '}')
+				return i + 1;
+		}
+	}
+	return n;
+}
+
+/* pass 1: the custom properties of top-level :root / html rules */
+static int collect(const uint8_t *s, size_t n, cssvar *vars)
+{
+	int nvars = 0, depth = 0;
+	size_t i, p0 = 0;		/* prelude start at depth 0 */
+
+	for (i = 0; i < n; i++) {
+		size_t j = skip_lit(s, n, i);
+
+		if (j != i) {
+			i = j - 1;
+			continue;
+		}
+		if (s[i] == '{') {
+			if (depth == 0 && is_root_prelude(s + p0, i - p0)) {
+				i = collect_block(s, n, i + 1, vars, &nvars) - 1;
+				p0 = i + 1;
+				continue;
+			}
+			depth++;
+		} else if (s[i] == '}') {
+			if (depth > 0)
+				depth--;
+			if (depth == 0)
+				p0 = i + 1;
+		} else if (s[i] == ';' && depth == 0) {
+			p0 = i + 1;		/* @import, @charset */
+		}
+	}
+	return nvars;
+}
+
+static void expand(obuf *o, const uint8_t *s, size_t n,
+		const cssvar *vars, int nvars, int level);
+
+/* the ')' that closes the '(' before s[i], or n */
+static size_t close_paren(const uint8_t *s, size_t n, size_t i)
+{
+	int paren = 1;
+
+	for (; i < n; i++) {
+		size_t j = skip_lit(s, n, i);
+
+		if (j != i) {
+			i = j - 1;
+			continue;
+		}
+		if (s[i] == '(')
+			paren++;
+		else if (s[i] == ')' && --paren == 0)
+			return i;
+	}
+	return n;
+}
+
+/* var( at s[i] (i at the 'v'); returns the index after its ')' */
+static size_t do_var(obuf *o, const uint8_t *s, size_t n, size_t i,
+		const cssvar *vars, int nvars, int level)
+{
+	size_t a = i + 4, e = close_paren(s, n, a), comma;
+	const uint8_t *nm;
+	size_t nl;
+	int k;
+
+	if (e == n || level >= CSSVARS_DEPTH) {
+		put(o, s + i, (e == n ? n : e + 1) - i);
+		return e == n ? n : e + 1;
+	}
+	for (comma = a; comma < e && s[comma] != ','; comma++)
+		;
+	nm = s + a;
+	nl = comma - a;
+	trim(&nm, &nl);
+	for (k = 0; k < nvars; k++)
+		if (vars[k].name_len == nl && memcmp(vars[k].name, nm, nl) == 0)
+			break;
+	if (k < nvars) {
+		expand(o, vars[k].value, vars[k].value_len, vars, nvars, level + 1);
+	} else if (comma < e) {
+		const uint8_t *f = s + comma + 1;
+		size_t fl = e - comma - 1;
+
+		trim(&f, &fl);
+		expand(o, f, fl, vars, nvars, level + 1);
+	} else {
+		put(o, s + i, e + 1 - i);	/* unknown: stays invalid */
+	}
+	return e + 1;
+}
+
+/* clamp( at s[i]: its third argument */
+static size_t do_clamp(obuf *o, const uint8_t *s, size_t n, size_t i,
+		const cssvar *vars, int nvars, int level)
+{
+	size_t a = i + 6, e = close_paren(s, n, a), c, commas = 0, last = a;
+	int paren = 0;
+
+	if (e == n) {
+		put(o, s + i, n - i);
+		return n;
+	}
+	for (c = a; c < e; c++) {
+		size_t j = skip_lit(s, e, c);
+
+		if (j != c) {
+			c = j - 1;
+			continue;
+		}
+		if (s[c] == '(')
+			paren++;
+		else if (s[c] == ')')
+			paren--;
+		else if (s[c] == ',' && paren == 0) {
+			commas++;
+			last = c + 1;
+		}
+	}
+	if (commas != 2) {
+		put(o, s + i, e + 1 - i);
+		return e + 1;
+	}
+	{
+		const uint8_t *m = s + last;
+		size_t ml = e - last;
+
+		trim(&m, &ml);
+		expand(o, m, ml, vars, nvars, level + 1);
+	}
+	return e + 1;
+}
+
+/* pass 2: copy s, replacing var() and clamp() */
+static void expand(obuf *o, const uint8_t *s, size_t n,
+		const cssvar *vars, int nvars, int level)
+{
+	size_t i = 0, run = 0;
+
+	while (i < n) {
+		size_t j = skip_lit(s, n, i);
+
+		if (j != i) {
+			i = j;
+			continue;
+		}
+		if ((i == 0 || !is_ident(s[i - 1])) && i + 4 <= n &&
+		    strncasecmp((const char *) s + i, "var(", 4) == 0) {
+			put(o, s + run, i - run);
+			i = run = do_var(o, s, n, i, vars, nvars, level);
+			continue;
+		}
+		if ((i == 0 || !is_ident(s[i - 1])) && i + 6 <= n &&
+		    strncasecmp((const char *) s + i, "clamp(", 6) == 0) {
+			put(o, s + run, i - run);
+			i = run = do_clamp(o, s, n, i, vars, nvars, level);
+			continue;
+		}
+		i++;
+	}
+	put(o, s + run, n - run);
+}
+
+static int has(const uint8_t *s, size_t n, const char *w)
+{
+	size_t l = strlen(w), i;
+
+	for (i = 0; i + l <= n; i++)
+		if (strncasecmp((const char *) s + i, w, l) == 0)
+			return 1;
+	return 0;
+}
+
+int css__vars_expand(const uint8_t *s, size_t n, uint8_t **out, size_t *out_len)
+{
+	cssvar *vars;
+	int nvars;
+	obuf o = { NULL, 0, 0, 0 };
+
+	*out = NULL;
+	*out_len = 0;
+	/* nothing to do, or not an ASCII-compatible encoding */
+	if (n == 0 || memchr(s, 0, n < 4096 ? n : 4096) != NULL ||
+	    (!has(s, n, "var(") && !has(s, n, "clamp(")))
+		return 0;
+	vars = malloc(CSSVARS_MAX * sizeof(cssvar));
+	if (vars == NULL)
+		return -1;
+	nvars = collect(s, n, vars);
+	expand(&o, s, n, vars, nvars, 0);
+	free(vars);
+	if (o.failed) {
+		free(o.p);
+		return -1;
+	}
+	*out = o.p;
+	*out_len = o.len;
+	return 1;
+}
