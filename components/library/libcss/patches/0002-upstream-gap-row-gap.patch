+		unit = CSS_UNIT_PX;
+		break;
+	case CSS_COLUMN_GAP_MEDIUM:
+		length = INTTOFIX(2);
+		unit = CSS_UNIT_PX;
+		break;
+	case CSS_COLUMN_GAP_THICK:
+		length = INTTOFIX(4);
+		unit = CSS_UNIT_PX;
+		break;
+	case CSS_COLUMN_GAP_SET:
+		if (unit != CSS_UNIT_EX)
