+/*
+ * zzc.h -- AMIX: public-key arithmetic on the Z3660's core 1 (crypto/zzc.c).
+ * Each returns -1 when it did nothing, else what the function it stands in
+ * for returns.  Built with OPENSSL_ZZ3660 only.
+ */
+#ifndef OSSL_CRYPTO_ZZC_H
+# define OSSL_CRYPTO_ZZC_H
+
+# include <stddef.h>
+# include <stdint.h>
+# include <openssl/bn.h>
+# include <openssl/ec.h>
+
+int ossl_zzc_x25519(uint8_t out[32], const uint8_t priv[32], const uint8_t peer[32]);
+int ossl_zzc_x25519_pub(uint8_t out[32], const uint8_t priv[32]);
+int ossl_zzc_ed25519_pub(uint8_t out[32], const uint8_t priv[32]);
+int ossl_zzc_ed25519_sign(uint8_t *sig, const uint8_t *tbs, size_t tbslen, const uint8_t pub[32],
+                          const uint8_t priv[32], int flags, const uint8_t *ctx, size_t ctxlen);
+int ossl_zzc_ed25519_verify(const uint8_t *tbs, size_t tbslen, const uint8_t sig[64],
+                            const uint8_t pub[32], int flags, const uint8_t *ctx, size_t ctxlen);
+int ossl_zzc_ec_mul(const EC_GROUP *group, EC_POINT *r, const BIGNUM *g_scalar, size_t num,
+                    const EC_POINT *points[], const BIGNUM *scalars[], BN_CTX *ctx);
+int ossl_zzc_mod_exp(BIGNUM *rr, const BIGNUM *a, const BIGNUM *p, const BIGNUM *m, int consttime);
