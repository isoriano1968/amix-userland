--- a/freeglut-3.4.0/src/fg_init.c
+++ b/freeglut-3.4.0/src/fg_init.c
@@ -333,6 +333,18 @@
  * Perform initialization. This usually happens on the program startup
  * and restarting after glutMainLoop termination...
  */
+/* AMIX: glutInit for a program that called a GLUT function without it, as
+   GLUT 3.7 did (FREEGLUT_EXIT_IF_NOT_INITIALISED) */
+void fghAutoInit( const char *func )
+{
+    static char name[] = "glut";
+    char *argv[] = { name, NULL };
+    int argc = 1;
+
+    (void)func;
+    glutInit( &argc, argv );
+}
+
 void FGAPIENTRY glutInit( int* pargc, char** argv )
 {
