# name, version and what building and running it needs
name     library/sdl2
version  2.30.12
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
# the zz9k renderer's copy to the board (s3d.c to_board): move16 only where
# uname names a 68040/060, memcpy otherwise
cpu-allow move16=2 run-time choice: the 68040/060 burst copy, memcpy on a 68020/030
summary  SDL 2 for AMIX: libSDL2-2.0.so.0
provide  sdl2
require  x11/x11r6.3
require  library/pth
