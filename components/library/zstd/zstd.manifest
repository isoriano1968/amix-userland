# name, version and what building and running it needs
name     library/zstd
version  1.5.7
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
summary  Zstandard compression library
provide  libzstd
