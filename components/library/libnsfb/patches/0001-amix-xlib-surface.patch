+/* Convert an X keysym into a nsfb key code.
+ *
+ * Our approach is primarily to assume both codings are roughly ascii like.
+ *
+ * The Keysyms are defined in X11/keysymdef.h and our mapping for the
+ * "keyboard" keys i.e. those from code set 255 is from there
+ */
+static enum nsfb_key_code_e
+xkeysym_to_nsfbkeycode(KeySym ks)
+{
+    enum nsfb_key_code_e nsfb_key = NSFB_KEY_UNKNOWN;
+    uint8_t codeset = (ks & 0xFF00) >> 8;
+    uint8_t chrcode = ks & 0xFF;
+
+    if (ks != NoSymbol) {
+        
+        switch (codeset) {
+        case 0x00: /* Latin 1 */
+        case 0x01: /* Latin 2 */
+        case 0x02: /* Latin 3 */
+        case 0x03: /* Latin 4 */
+        case 0x04: /* Katakana */
+        case 0x05: /* Arabic */
+        case 0x06: /* Cyrillic */
+        case 0x07: /* Greek */
+        case 0x08: /* Technical */
+        case 0x0A: /* Publishing */
+        case 0x0C: /* Hebrew */
+        case 0x0D: /* Thai */
+            /* this is somewhat incomplete, but the nsfb codes are lined up on
+             * the ascii codes and x seems to have done similar 
+             */
+            nsfb_key = (enum nsfb_key_code_e)chrcode;
+            break;
+
+        case 0xFF: /* Keyboard */
+            nsfb_key = XCSKeyboardMap[chrcode];
+            break;
+        }
+    }
+
+    return nsfb_key;
+}
+
+/*
+ * A key as the system's keyboard map makes it (XLookupString: the server's
+ * keymap, Shift, AltGr, Caps Lock): a printable character comes as
+ * NSFB_KEY_UCS4 | its code point.  Anything else, and every key with Ctrl
+ * (NetSurf's shortcuts), as the key itself.
+ */
+static int
+key_code(XKeyEvent *key)
+{
+    unsigned char buf[8];
+    KeySym ks = NoSymbol;
+    long ucs = -1;
+    int n;
+
+    if (!(key->state & ControlMask)) {
+        n = XLookupString(key, (char *)buf, sizeof(buf), &ks, NULL);
+        if (n == 1)
+            ucs = buf[0];               /* Latin-1, the C locale's */
+        else if ((ks >= 0x20 && ks <= 0x7e) || (ks >= 0xa0 && ks <= 0xff))
+            ucs = ks;                   /* Latin-1 keysyms are the code points */
+        else if ((ks & 0xff000000) == 0x01000000)
+            ucs = ks & 0x00ffffff;      /* Unicode keysyms */
+        else if (ks == 0x20ac)
+            ucs = 0x20ac;               /* EuroSign */
+        if (ucs >= 0x20 && ucs != 0x7f && !(ucs >= 0x80 && ucs < 0xa0))
+            return NSFB_KEY_UCS4 | (int)ucs;
+    }
+    return xkeysym_to_nsfbkeycode(XLookupKeysym(key, 0));
+}
+
+static int
+update_window(xstate_t *xstate, int x, int y, int width, int height)
+{
+    if ((width <= 0) || (height <= 0))
+        return 0;
+
+    if (xstate->shm) {
+        XShmPutImage(xstate->display, xstate->window, xstate->gc,
+                     xstate->image, x, y, x, y, width, height, False);
+    } else {
+        XPutImage(xstate->display, xstate->window, xstate->gc,
+                  xstate->image, x, y, x, y, width, height);
+    }
+    XFlush(xstate->display);
+
+    return 0;
+}
+
+/* the software copy, then the window: NetSurf scrolls with it */
+static nsfb_plotfn_copy_t *sw_copy;
+
+static bool
+xcopy(nsfb_t *nsfb, nsfb_bbox_t *srcbox, nsfb_bbox_t *dstbox)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    struct nsfb_cursor_s *cursor = nsfb->cursor;
+    nsfb_bbox_t allbox;
+    bool ret;
+
+    nsfb_plot_add_rect(srcbox, dstbox, &allbox);
+
+    /* clear the cursor if its within the region to be altered */
+    if ((cursor != NULL) &&
+        (cursor->plotted == true) &&
+        (nsfb_plot_bbox_intersect(&allbox, &cursor->loc))) {
+        nsfb_cursor_clear(nsfb, cursor);
+    }
+
+    ret = sw_copy(nsfb, srcbox, dstbox);
+
+    if ((cursor != NULL) &&
+        (cursor->plotted == false)) {
+        nsfb_cursor_plot(nsfb, cursor);
+    }
+
+    if (xstate != NULL)
+        update_window(xstate, allbox.x0, allbox.y0,
+                      allbox.x1 - allbox.x0, allbox.y1 - allbox.y0);
+
+    return ret;
+}
+
+/* the format's software plotters, with xcopy over their copy */
+static void
+x_select_plotters(nsfb_t *nsfb)
+{
+    select_plotters(nsfb);
+    sw_copy = nsfb->plotter_fns->copy;
+    nsfb->plotter_fns->copy = xcopy;
+}
