An X surface on plain Xlib (src/surface/xlib.c), for X servers and systems
without xcb: X11R6.3 on AMIX.  It follows x.c (frame buffer in an XImage,
MIT-SHM for a local server, cursor plotted into the frame buffer) and takes
the server's visual: RGB565 on the Amiga, XRGB8888 on a 24-bit display.
The window can be resized: a new image of its size, and NSFB_EVENT_RESIZE.
Keys go through the system's keyboard map (XLookupString): a character comes
as NSFB_KEY_UCS4 | code point, a new flag in include/libnsfb_event.h.
Built when pkg-config finds x11 and xext but not xcb.  src/plot.h: AMIX is
big endian and has no endian.h.

--- a/Makefile
+++ b/Makefile
@@ -47,6 +47,8 @@
 $(eval $(call pkg_config_package_available,NSFB_SDL_AVAILABLE,sdl))
 $(eval $(call pkg_config_package_available,NSFB_XCB_AVAILABLE,$(NSFB_XCB_PKG_NAMES)))
 $(eval $(call pkg_config_package_available,NSFB_WLD_AVAILABLE,wayland-client))
+# plain Xlib (src/surface/xlib.c) where there is X but no xcb (X11R6.3 on AMIX)
+$(eval $(call pkg_config_package_available,NSFB_XLIB_AVAILABLE,x11 xext))
 
 # Flags and setup for each support library
 ifeq ($(NSFB_SDL_AVAILABLE),yes)
@@ -56,6 +58,15 @@
   REQUIRED_PKGS := $(REQUIRED_PKGS) sdl
 endif 
 
+ifneq ($(NSFB_XCB_AVAILABLE),yes)
+  ifeq ($(NSFB_XLIB_AVAILABLE),yes)
+    $(eval $(call pkg_config_package_add_flags,x11 xext,CFLAGS))
+    $(eval $(call pkg_config_package_add_flags,x11 xext,TESTCFLAGS,TESTLDFLAGS))
+
+    REQUIRED_PKGS := $(REQUIRED_PKGS) x11 xext
+  endif
+endif
+
 ifeq ($(NSFB_XCB_AVAILABLE),yes)
   # Size hint allocators were removed in xcb-icccm 0.3.0
   $(eval $(call pkg_config_package_min_version,NSFB_XCB_ICCCM_SIZE_HINTS,xcb-icccm,0.3.0))
