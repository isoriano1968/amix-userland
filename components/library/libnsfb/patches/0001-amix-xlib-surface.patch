+static int
+x_set_geometry(nsfb_t *nsfb, int width, int height, enum nsfb_format_e format)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+
+    if (xstate != NULL) {
+        /* the window was resized: a new image of its size, in the
+         * server's format whatever was asked */
+        XImage *old = xstate->image;
+        bool old_shm = xstate->shm;
+        XShmSegmentInfo old_shminfo = xstate->shminfo;
+
+        if ((width == nsfb->width) && (height == nsfb->height))
+            return 0;
+        if (create_frame(xstate, width, height) == NULL) {
+            /* no memory for it: keep the old size */
+            xstate->image = old;
+            xstate->shm = old_shm;
+            xstate->shminfo = old_shminfo;
+            return -1;
+        }
+        free_frame(xstate->display, old, old_shm, &old_shminfo);
+        nsfb->width = width;
+        nsfb->height = height;
+        nsfb->ptr = (uint8_t *)xstate->image->data;
+        nsfb->linelen = xstate->image->bytes_per_line;
+        /* the cursor's saved pixels were in the old image */
+        if (nsfb->cursor != NULL)
+            nsfb->cursor->plotted = false;
+        return 0;
+    }
+
+    nsfb->width = width;
+    nsfb->height = height;
+    nsfb->format = format;
+
+    /* select default sw plotters for format */
+    x_select_plotters(nsfb);
+
+    return 0;
+}
+
+/* the frame buffer format that is the server's visual, or NSFB_FMT_ANY */
+static enum nsfb_format_e
+visual_format(Visual *visual, int bpp)
+{
+    if (visual->class != TrueColor)
+        return NSFB_FMT_ANY;
+    if ((bpp == 16) && (visual->red_mask == 0xf800) &&
+        (visual->green_mask == 0x7e0) && (visual->blue_mask == 0x1f))
+        return NSFB_FMT_RGB565;
+    if ((bpp == 32) && (visual->red_mask == 0xff0000) &&
+        (visual->green_mask == 0xff00) && (visual->blue_mask == 0xff))
+        return NSFB_FMT_XRGB8888;
+    if ((bpp == 32) && (visual->red_mask == 0xff) &&
+        (visual->green_mask == 0xff00) && (visual->blue_mask == 0xff0000))
+        return NSFB_FMT_XBGR8888;
+    return NSFB_FMT_ANY;
+}
+
+/* bits per pixel of the server's images at this depth */
+static int
+server_bpp(Display *display, int depth)
+{
+    XPixmapFormatValues *fmts;
+    int n, i, bpp = 0;
+
+    fmts = XListPixmapFormats(display, &n);
+    if (fmts == NULL)
+        return 0;
+    for (i = 0; i < n; i++) {
+        if (fmts[i].depth == depth)
+            bpp = fmts[i].bits_per_pixel;
+    }
+    XFree(fmts);
+    return bpp;
+}
+
+static int shm_error;
+
+static int
+shm_error_handler(Display *display, XErrorEvent *error)
+{
+    (void)display;
+    (void)error;
+    shm_error = 1;
+    return 0;
+}
+
+/* an image in shared memory, when the server is on this machine */
+static XImage *
+create_shm_image(xstate_t *xstate, int width, int height)
+{
+    XImage *image;
+    int (*old_handler)(Display *, XErrorEvent *);
+    const char *dpy = DisplayString(xstate->display);
+
+    /* a remote server (ssh -X: localhost:10) cannot see our memory */
+    if ((dpy[0] != ':') && (strncmp(dpy, "unix:", 5) != 0))
+        return NULL;
+    if (getenv("NSFB_X_NOSHM") != NULL)
+        return NULL;
+    if (!XShmQueryExtension(xstate->display))
+        return NULL;
+
+    image = XShmCreateImage(xstate->display, xstate->visual, xstate->depth,
+                            ZPixmap, NULL, &xstate->shminfo, width, height);
+    if (image == NULL)
+        return NULL;
+
+    xstate->shminfo.shmid = shmget(IPC_PRIVATE,
+                                   image->bytes_per_line * image->height,
+                                   IPC_CREAT | 0600);
+    if (xstate->shminfo.shmid == -1) {
+        XDestroyImage(image);
+        return NULL;
+    }
+    xstate->shminfo.shmaddr = image->data = shmat(xstate->shminfo.shmid, 0, 0);
+    if (xstate->shminfo.shmaddr == (char *)-1) {
+        shmctl(xstate->shminfo.shmid, IPC_RMID, 0);
+        XDestroyImage(image);
+        return NULL;
+    }
+    xstate->shminfo.readOnly = False;
+
+    shm_error = 0;
+    old_handler = XSetErrorHandler(shm_error_handler);
+    XShmAttach(xstate->display, &xstate->shminfo);
+    XSync(xstate->display, False);
+    XSetErrorHandler(old_handler);
+
+    /* the server has it now, or never will: our reference can go */
+    shmctl(xstate->shminfo.shmid, IPC_RMID, 0);
+
+    if (shm_error) {
+        shmdt(xstate->shminfo.shmaddr);
+        image->data = NULL;
+        XDestroyImage(image);
+        return NULL;
+    }
+
+    return image;
+}
+
+static XImage *
+create_image(xstate_t *xstate, int width, int height, int bpp)
+{
+    XImage *image;
+    char *data;
+
+    data = calloc(1, (size_t)((width * bpp + 31) / 32) * 4 * height);
+    if (data == NULL)
+        return NULL;
+
+    image = XCreateImage(xstate->display, xstate->visual, xstate->depth,
+                         ZPixmap, 0, data, width, height, 32, 0);
+    if (image == NULL) {
+        free(data);
+        return NULL;
+    }
+
+    return image;
+}
+
+/* this machine's byte order, which the plotters write in */
+static int
+native_byte_order(void)
+{
+    const uint16_t one = 1;
+
+    return (*(const uint8_t *)&one == 1) ? LSBFirst : MSBFirst;
+}
+
+/* the frame buffer image: shared memory first, the plotters write native order */
+static XImage *
+create_frame(xstate_t *xstate, int width, int height)
+{
+    int bpp = server_bpp(xstate->display, xstate->depth);
+
+    xstate->shm = false;
+    xstate->image = create_shm_image(xstate, width, height);
+    if (xstate->image != NULL) {
+        xstate->shm = true;
+        if (xstate->image->byte_order != native_byte_order()) {
+            /* the server would read it in its own order */
+            XShmDetach(xstate->display, &xstate->shminfo);
+            shmdt(xstate->shminfo.shmaddr);
+            xstate->image->data = NULL;
+            XDestroyImage(xstate->image);
+            xstate->image = NULL;
+            xstate->shm = false;
+        }
+    }
+    if (xstate->image == NULL) {
+        xstate->image = create_image(xstate, width, height, bpp);
+        if (xstate->image != NULL) {
+            /* Xlib converts for the server in XPutImage */
+            xstate->image->byte_order = native_byte_order();
+            xstate->image->bitmap_bit_order = MSBFirst;
+        }
+    }
+    return xstate->image;
+}
+
+static void
+free_frame(Display *display, XImage *image, bool shm, XShmSegmentInfo *shminfo)
+{
+    if (shm) {
+        XShmDetach(display, shminfo);
+        XSync(display, False);
+        shmdt(shminfo->shmaddr);
+        image->data = NULL;
+    }
+    XDestroyImage(image);
+}
+
+static Cursor
+create_blank_cursor(Display *display, Window window)
+{
+    static char empty[1] = { 0 };
+    Pixmap pix;
+    XColor black;
+    Cursor cursor;
+
+    pix = XCreateBitmapFromData(display, window, empty, 1, 1);
+    memset(&black, 0, sizeof(black));
+    cursor = XCreatePixmapCursor(display, pix, pix, &black, &black, 0, 0);
+    XFreePixmap(display, pix);
+
+    return cursor;
+}
+
+static int x_initialise(nsfb_t *nsfb)
+{
+    XSetWindowAttributes attrs;
+    XSizeHints *hints;
+    xstate_t *xstate = nsfb->surface_priv;
+    enum nsfb_format_e format;
+    int bpp;
+
+    if (xstate != NULL)
+        return -1; /* already initialised */
+
+    xstate = calloc(1, sizeof(xstate_t));
+    if (xstate == NULL)
+        return -1; /* no memory */
+
+    xstate->display = XOpenDisplay(NULL);
+    if (xstate->display == NULL) {
+        fprintf(stderr, "Error opening display\n");
+        free(xstate);
+        return -1;
+    }
+    xstate->screen = DefaultScreen(xstate->display);
+    xstate->visual = DefaultVisual(xstate->display, xstate->screen);
+    xstate->depth = DefaultDepth(xstate->display, xstate->screen);
+
+    /* the frame buffer takes the server's format, whatever was asked */
+    bpp = server_bpp(xstate->display, xstate->depth);
+    format = visual_format(xstate->visual, bpp);
+    if (format == NSFB_FMT_ANY) {
+        fprintf(stderr, "Unsupported visual (depth %d, %d bpp)\n",
+                xstate->depth, bpp);
+        XCloseDisplay(xstate->display);
+        free(xstate);
+        return -1;
+    }
+    if (format != nsfb->format) {
+        nsfb->format = format;
+        x_select_plotters(nsfb);
+    }
+
+    if (create_frame(xstate, nsfb->width, nsfb->height) == NULL) {
+        fprintf(stderr, "Unable to create image\n");
+        XCloseDisplay(xstate->display);
+        free(xstate);
+        return -1;
+    }
+
+    /* ensure plotting information is stored */
+    nsfb->surface_priv = xstate;
+    nsfb->ptr = (uint8_t *)xstate->image->data;
+    nsfb->linelen = xstate->image->bytes_per_line;
+
+    /* create window */
+    attrs.background_pixel = WhitePixel(xstate->display, xstate->screen);
+    attrs.event_mask = ExposureMask | KeyPressMask | KeyReleaseMask |
+                       ButtonPressMask | ButtonReleaseMask | PointerMotionMask |
+                       StructureNotifyMask;
+    xstate->window = XCreateWindow(xstate->display,
+                                   RootWindow(xstate->display, xstate->screen),
+                                   0, 0, nsfb->width, nsfb->height, 0,
+                                   xstate->depth, InputOutput, xstate->visual,
+                                   CWBackPixel | CWEventMask, &attrs);
+    XDefineCursor(xstate->display, xstate->window,
+                  create_blank_cursor(xstate->display, xstate->window));
+
+    /* resizable, down to NetSurf's minimum */
+    hints = XAllocSizeHints();
+    if (hints != NULL) {
+        hints->flags = PMinSize;
+        hints->min_width = 300;
+        hints->min_height = 200;
+        XSetWMNormalHints(xstate->display, xstate->window, hints);
+        XFree(hints);
+    }
+    XStoreName(xstate->display, xstate->window, "NetSurf");
+    xstate->wm_delete = XInternAtom(xstate->display, "WM_DELETE_WINDOW", False);
+    XSetWMProtocols(xstate->display, xstate->window, &xstate->wm_delete, 1);
+
+    xstate->gc = XCreateGC(xstate->display, xstate->window, 0, NULL);
+
+    /* show the window */
+    XMapWindow(xstate->display, xstate->window);
+    XFlush(xstate->display);
+
+    return 0;
+}
+
+static int x_finalise(nsfb_t *nsfb)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    if (xstate == NULL)
+        return 0;
+
+    free_frame(xstate->display, xstate->image, xstate->shm, &xstate->shminfo);
+    XFreeGC(xstate->display, xstate->gc);
+    XDestroyWindow(xstate->display, xstate->window);
+
+    /* close connection to server */
+    XCloseDisplay(xstate->display);
+
+    nsfb->surface_priv = NULL;
+    nsfb->ptr = NULL;
+    free(xstate);
+
+    return 0;
+}
+
+static enum nsfb_key_code_e
+button_keycode(unsigned int button)
+{
+    switch (button) {
+    case X_BUTTON_LEFT:
+        return NSFB_KEY_MOUSE_1;
+    case X_BUTTON_MIDDLE:
+        return NSFB_KEY_MOUSE_2;
+    case X_BUTTON_RIGHT:
+        return NSFB_KEY_MOUSE_3;
+    case X_BUTTON_WHEELUP:
+        return NSFB_KEY_MOUSE_4;
+    case X_BUTTON_WHEELDOWN:
+        return NSFB_KEY_MOUSE_5;
+    }
+    return NSFB_KEY_UNKNOWN;
+}
+
+static bool x_input(nsfb_t *nsfb, nsfb_event_t *event, int timeout)
+{
+    XEvent e;
+    xstate_t *xstate = nsfb->surface_priv;
+
+    if (xstate == NULL)
+        return false;
+
+    XFlush(xstate->display);
+
+    if (XPending(xstate->display) == 0) {
+        if (timeout == 0)
+            return false; /* no event */
+        if (timeout > 0) {
+            struct pollfd pfd;
+
+            pfd.fd = ConnectionNumber(xstate->display);
+            pfd.events = POLLIN;
+            pfd.revents = 0;
+
+            if (poll(&pfd, 1, timeout) == 0) {
+                /* timeout, nothing happened */
+                event->type = NSFB_EVENT_CONTROL;
+                event->value.controlcode = NSFB_CONTROL_TIMEOUT;
+                return true;
+            }
+        }
+    }
+
+    /* blocks until an event comes; Xlib exits if the server goes */
+    XNextEvent(xstate->display, &e);
+
+    event->type = NSFB_EVENT_NONE;
+
+    switch (e.type) {
+    case Expose:
+        update_window(xstate, e.xexpose.x, e.xexpose.y,
+                      e.xexpose.width, e.xexpose.height);
+        break;
+
+    case MotionNotify:
+        event->type = NSFB_EVENT_MOVE_ABSOLUTE;
+        event->value.vector.x = e.xmotion.x;
+        event->value.vector.y = e.xmotion.y;
+        event->value.vector.z = 0;
+        break;
+
+    case ButtonPress:
+        event->type = NSFB_EVENT_KEY_DOWN;
+        event->value.keycode = button_keycode(e.xbutton.button);
+        break;
+
+    case ButtonRelease:
+        event->type = NSFB_EVENT_KEY_UP;
+        event->value.keycode = button_keycode(e.xbutton.button);
+        break;
+
+    case KeyPress:
+        event->type = NSFB_EVENT_KEY_DOWN;
+        event->value.keycode = key_code(&e.xkey);
+        break;
+
+    case KeyRelease:
+        event->type = NSFB_EVENT_KEY_UP;
+        event->value.keycode = key_code(&e.xkey);
+        break;
+
+    case ConfigureNotify:
+        /* the last of a run of them: a window manager sends many */
+        while (XCheckTypedWindowEvent(xstate->display, xstate->window,
+                                      ConfigureNotify, &e))
+            ;
+        if ((e.xconfigure.width != nsfb->width) ||
+            (e.xconfigure.height != nsfb->height)) {
+            event->type = NSFB_EVENT_RESIZE;
+            event->value.resize.w = e.xconfigure.width;
+            event->value.resize.h = e.xconfigure.height;
+        }
+        break;
+
+    case ClientMessage:
+        if ((Atom)e.xclient.data.l[0] == xstate->wm_delete) {
+            event->type = NSFB_EVENT_CONTROL;
+            event->value.controlcode = NSFB_CONTROL_QUIT;
+        }
+        break;
+    }
+
+    return true;
+}
+
+static int x_claim(nsfb_t *nsfb, nsfb_bbox_t *box)
+{
+    struct nsfb_cursor_s *cursor = nsfb->cursor;
+
+    if ((cursor != NULL) &&
+        (cursor->plotted == true) &&
+        (nsfb_plot_bbox_intersect(box, &cursor->loc))) {
+        nsfb_cursor_clear(nsfb, cursor);
+    }
+    return 0;
+}
+
+static int
+x_cursor(nsfb_t *nsfb, struct nsfb_cursor_s *cursor)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    nsfb_bbox_t redraw;
+    nsfb_bbox_t fbarea;
+
+    if ((cursor != NULL) && (cursor->plotted == true)) {
+
+        nsfb_plot_add_rect(&cursor->savloc, &cursor->loc, &redraw);
+
+        /* screen area */
+        fbarea.x0 = 0;
+        fbarea.y0 = 0;
+        fbarea.x1 = nsfb->width;
+        fbarea.y1 = nsfb->height;
+
+        nsfb_plot_clip(&fbarea, &redraw);
+
+        nsfb_cursor_clear(nsfb, cursor);
+
+        nsfb_cursor_plot(nsfb, cursor);
+
+        update_window(xstate, redraw.x0, redraw.y0,
+                      redraw.x1 - redraw.x0, redraw.y1 - redraw.y0);
+    }
+    return true;
+}
+
+static int x_update(nsfb_t *nsfb, nsfb_bbox_t *box)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    struct nsfb_cursor_s *cursor = nsfb->cursor;
+
+    if ((cursor != NULL) &&
+        (cursor->plotted == false)) {
+        nsfb_cursor_plot(nsfb, cursor);
+    }
+
+    update_window(xstate, box->x0, box->y0,
+                  box->x1 - box->x0, box->y1 - box->y0);
+
+    return 0;
+}
+
+const nsfb_surface_rtns_t x_rtns = {
+    .initialise = x_initialise,
+    .finalise = x_finalise,
+    .input = x_input,
+    .claim = x_claim,
+    .update = x_update,
+    .cursor = x_cursor,
+    .geometry = x_set_geometry,
+};
+
+NSFB_SURFACE_DEF(x, NSFB_SURFACE_X, &x_rtns)
