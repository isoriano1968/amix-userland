# name, version and what building and running it needs
name     library/ncurses
version  6.6
summary  ncurses
provide  ncurses
provide  form
provide  menu
provide  panel
file     /usr/share/terminfo
file     /usr/share/terminfo/d/dtterm
file     /usr/share/terminfo/x/xterm
file     /usr/share/terminfo/v/vt100
