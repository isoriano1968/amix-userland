file     /usr/local/bin/ntic
file     /usr/local/bin/ntoe
file     /usr/local/bin/ntput
file     /usr/local/bin/ntset
file     /usr/local/include/curses.h
file     /usr/local/include/eti.h
file     /usr/local/include/form.h
file     /usr/local/include/menu.h
file     /usr/local/include/ncurses.h
file     /usr/local/include/ncurses_dll.h
file     /usr/local/include/panel.h
file     /usr/local/include/term.h
file     /usr/local/include/term_entry.h
file     /usr/local/include/termcap.h
file     /usr/local/include/unctrl.h
file     /usr/local/lib/libcurses.so
file     /usr/local/lib/libform.so
file     /usr/local/lib/libform.so.6
file     /usr/local/lib/libmenu.so
file     /usr/local/lib/libmenu.so.6
file     /usr/local/lib/libncurses.so
file     /usr/local/lib/libncurses.so.6
file     /usr/local/lib/libpanel.so
file     /usr/local/lib/libpanel.so.6
file     /usr/local/lib/pkgconfig/form.pc
