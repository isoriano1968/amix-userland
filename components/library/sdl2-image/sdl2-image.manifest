# name, version and what building and running it needs
name     library/sdl2-image
version  2.8.12
summary  SDL2_image: BMP, GIF, ILBM, PCX, PNG, JPEG, PNM, TGA, XPM, QOI for SDL 2
provide  SDL2_image
require  library/sdl2
require  library/libpng
require  library/libjpeg
require  library/zlib
file     /usr/local/lib/libSDL2_image-2.0.so.0
file     /usr/local/lib/libSDL2_image.so
file     /usr/local/include/SDL2/SDL_image.h
file     /usr/local/lib/pkgconfig/SDL2_image.pc
