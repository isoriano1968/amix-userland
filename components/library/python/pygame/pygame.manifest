# name, version and what building and running it needs
name     library/python/pygame
version  2.5.8
summary  pygame-ce: SDL 2 games and multimedia for Python 3 (no mixer, no midi; font via freetype)
require  runtime/python3
require  library/sdl2
require  library/sdl2-image
require  library/freetype
require  library/python/numpy
file     /usr/local/lib/python3.11/site-packages/pygame/__init__.py
file     /usr/local/lib/python3.11/site-packages/pygame/base.cpython-311.so
file     /usr/local/lib/python3.11/site-packages/pygame/surface.cpython-311.so
file     /usr/local/lib/python3.11/site-packages/pygame/imageext.cpython-311.so
file     /usr/local/lib/python3.11/site-packages/pygame/_freetype.cpython-311.so
file     /usr/local/lib/python3.11/site-packages/pygame/font.py
