--- a/quickjs-libc.c
+++ b/quickjs-libc.c
@@ -93,6 +93,91 @@
 #include "list.h"
 #include "quickjs-libc.h"
 
+#if defined(__amix__)
+/* AMIX (SVR4.0, 1991): what POSIX added later, from the calls it has */
+#include <utime.h>
+#include <sys/times.h>
+typedef void (*sighandler_t)(int);
+extern char **environ;
+#ifndef RTLD_LOCAL
+#define RTLD_LOCAL 0
+#endif
+struct timespec {
+    time_t tv_sec;
+    long tv_nsec;
+};
+static int nanosleep(const struct timespec *ts, struct timespec *rem)
+{
+    (void)rem;
+    return poll(NULL, 0, (int)(ts->tv_sec * 1000 + ts->tv_nsec / 1000000)) < 0 ? -1 : 0;
+}
+struct rusage {
+    struct timeval ru_utime, ru_stime;
+};
+#define RUSAGE_SELF 0
+static int getrusage(int who, struct rusage *ru)
+{
+    struct tms t;
+    long hz = sysconf(_SC_CLK_TCK);
+
+    (void)who;
+    if (times(&t) == (clock_t)-1 || hz <= 0)
+        return -1;
+    ru->ru_utime.tv_sec = t.tms_utime / hz;
+    ru->ru_utime.tv_usec = (t.tms_utime % hz) * (1000000 / hz);
+    ru->ru_stime.tv_sec = t.tms_stime / hz;
+    ru->ru_stime.tv_usec = (t.tms_stime % hz) * (1000000 / hz);
+    return 0;
+}
+static int setenv(const char *name, const char *value, int overwrite)
+{
+    char *s;
+
+    if (!overwrite && getenv(name))
+        return 0;
+    s = malloc(strlen(name) + strlen(value) + 2); /* putenv keeps it */
+    if (!s)
+        return -1;
+    sprintf(s, "%s=%s", name, value);
+    return putenv(s);
+}
+static int unsetenv(const char *name)
+{
+    size_t l = strlen(name);
+    char **e, **f;
+
+    for (e = environ; *e; ) {
+        if (!strncmp(*e, name, l) && (*e)[l] == '=') {
+            for (f = e; *f; f++)
+                f[0] = f[1];
+        } else {
+            e++;
+        }
+    }
+    return 0;
+}
+static int mkstemp(char *tmpl)
+{
+    if (!mktemp(tmpl) || !*tmpl)
+        return -1;
+    return open(tmpl, O_RDWR | O_CREAT | O_EXCL, 0600);
+}
+static char *mkdtemp(char *tmpl)
+{
+    if (!mktemp(tmpl) || !*tmpl)
+        return NULL;
+    return mkdir(tmpl, 0700) ? NULL : tmpl;
+}
+static int utimes(const char *path, const struct timeval tv[2])
+{
+    struct utimbuf u;
+
+    u.actime = tv[0].tv_sec;
+    u.modtime = tv[1].tv_sec;
+    return utime(path, &u);
+}
