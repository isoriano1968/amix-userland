index 58d1f3d..180ce95 100644
--- a/libretro/core/libretro-core.cpp
+++ b/libretro/core/libretro-core.cpp
@@ -327,6 +327,10 @@ void zip_uncompress(char *in, char *out, char *lastfile)
 
 
 
+#ifdef AMIX_C1
+extern "C" const char *c1uae_config_line(int i);
+#endif
+
 void update_prefs_retrocfg(struct uae_prefs * prefs)
 {
 
@@ -901,6 +905,24 @@ void update_prefs_retrocfg(struct uae_prefs * prefs)
       if (strcmp(var.value, "off") == 0) prefs->fast_copper = 0;
    }
 
+#ifdef AMIX_C1
+   /* the AMIX front end's own settings, as uae config lines (Kickstart,
+      DF0-DF3, hard files, CPU, memory): after the model's defaults, so
+      they win (c1uae.c) */
+   {
+      const char *line;
+      int i;
+
+      for (i = 0; (line = c1uae_config_line(i)) != NULL; i++) {
+         TCHAR tmp[MAX_DPATH * 2];
+
+         strncpy(tmp, line, sizeof(tmp) - 1);
+         tmp[sizeof(tmp) - 1] = 0;
+         cfgfile_parse_line(prefs, tmp, 0);
+      }
+   }
+#endif
+
    set_config_changed();
 
 }
