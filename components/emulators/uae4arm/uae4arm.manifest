# name, version and what building and running it needs
name     emulators/uae4arm
version  fc1cb90
summary  Amiga emulator (uae4arm) on the Z3660's ARM core 1, run from AMIX by c1uae
require  library/zlib
file     /root/z3660ARMCores/z3660ARM_Core_uae.bin
file     /opt/amix/bin/c1uae
file     /opt/uae/bench/c1bench.adf
file     /opt/uae/bench/coremark.060
file     /opt/uae/bench/coremark.000
