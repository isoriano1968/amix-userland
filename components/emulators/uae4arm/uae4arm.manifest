# name, version and what building and running it needs
name     emulators/uae4arm
version  fc1cb90
# the 68020..68060 baseline for AMIX's c1uae; /opt/uae/bench/coremark.060 is
# a benchmark the emulated Amiga runs (an emulated 68060), never AMIX itself
cpu      68020
cpu-skip /opt/uae/bench/coremark.060 a benchmark for the emulated Amiga's 68060, not AMIX code
summary  Amiga emulator (uae4arm) on the Z3660's ARM core 1, run from AMIX by c1uae
# runs on the Z3660's ARM core 1: pkg and the installer leave it off a
# machine without the board (amix-hw)
hw       z3660-core1
require  library/zlib
# libamixc99.so.1 (gcc 14's specs make objects that call C99 functions NEED it)
require  library/amixc99 >= 2
file     /root/z3660ARMCores/z3660ARM_Core_uae.bin
file     /opt/amix/bin/c1uae
file     /opt/uae/bench/c1bench.adf
file     /opt/uae/bench/coremark.060
file     /opt/uae/bench/coremark.000
