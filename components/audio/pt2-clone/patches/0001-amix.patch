diff --git a/src/pt2_paula_native.c b/src/pt2_paula_native.c
new file mode 100644
index 0000000..fd1227a
--- /dev/null
+++ b/src/pt2_paula_native.c
@@ -0,0 +1,260 @@
+/* AMIX: play through Paula itself (/dev/paula, the AMIX 040/060 port's
+** native Paula driver) instead of mixing.
+**
+** The replayer keeps running exactly as before, and its Paula register
+** writes still update the emulator (the visuals, MOD2WAV and the sampler
+** need it), but they are also recorded and handed to the kernel, one batch
+** per replayer tick; CIA-A timer B applies one batch per tick at the song's
+** tempo and Paula plays the samples from chip RAM.  The audio callback
+** runs as before, paced by the clock (sdl2-amix's null audio), so the
+** replayer stays ahead of the kernel's queue by about one callback.
+**
+** The samples are copied to the driver's chip-RAM area in a compact
+** layout (pt2 keeps them maxSampleLength apart) and copied again when the
+** layout changes, for another module, and when playback starts (edits).
+**
+** PT2_PAULA=0 mixes as before.  Without /dev/paula the mixer is used too,
+** and when the sound goes to the Z3660's HDMI (core 1: sdl2-amix).
+*/
+
+#ifdef __amix__
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <SDL2/SDL.h>
+#include "pt2_header.h"
+#include "pt2_structs.h"
+#include "pt2_paula.h"
+#include "pt2_paula_native.h"
+#include "paula.h"
+
+bool paulaNativeActive;
+
+static int pfd = -1;
+static struct paula_tick cur;		// the batch being recorded
+static struct paula_tick pend[32];	// pushed while the kernel's queue was full
+static int npend;
+
+static struct
+{
+	const int8_t *start;
+	uint32_t len, chipOff;
+} map[MOD_SAMPLES];
+static module_t *mapSong;
+static int8_t *mapData;
+static uint32_t mapSig, area;
+static int lastBPM = -1;
+static bool wasPlaying;
+
+static bool recording(void)
+{
+	return paulaNativeActive && !editor.mod2WavOngoing && !editor.pat2SmpOngoing;
+}
+
+bool paulaNativeOpen(void)
+{
+	const char *e = getenv("PT2_PAULA");
+
+	if (e != NULL && atoi(e) == 0)
+		return false;
+	if (SDL_AMIX_HdmiAudio()) // the HDMI plays what is mixed
+		return false;
+
+	pfd = open("/dev/paula", O_RDWR);
+	if (pfd < 0)
+		return false;
+
+	paulaNativeActive = true;
+	SDL_AMIX_SetNullAudio(1);
+	fprintf(stderr, "pt2: playing through /dev/paula (PT2_PAULA=0: mix)\n");
+	return true;
+}
+
+static uint32_t layoutSig(void)
+{
+	uint32_t h = 2166136261u;
+
+	for (int32_t i = 0; i < MOD_SAMPLES; i++)
+	{
+		const moduleSample_t *s = &song->samples[i];
+		h = (h ^ (uint32_t)s->offset) * 16777619u;
+		h = (h ^ (uint32_t)s->length) * 16777619u;
+	}
+
+	return h;
+}
+
+static void upload(void)
+{
+	uint32_t total = 0;
+
+	for (int32_t i = 0; i < MOD_SAMPLES; i++)
+	{
+		const moduleSample_t *s = &song->samples[i];
+
+		map[i].start = song->sampleData + s->offset;
+		map[i].len = s->length > 0 ? (uint32_t)s->length : 0;
+		map[i].chipOff = total;
+		if (total + map[i].len > PAULA_MAXAREA)
+		{
+			fprintf(stderr, "pt2: samples beyond %ld bytes of chip RAM stay silent\n", (long)PAULA_MAXAREA);
+			map[i].len = 0;
+		}
+		total += (map[i].len + 1) & ~1u;
+	}
+	if (total < 2)
+		total = 2;
+
+	if (total > area)	// a bigger area (this stops the channels)
+	{
+		if (ioctl(pfd, PAULA_SETUP, (char *)(uintptr_t)total) < 0)
+		{
+			fprintf(stderr, "pt2: /dev/paula: no %u bytes of chip RAM: %s\n", total, strerror(errno));
+			area = 0;
+			return;
+		}
+		area = total;
+	}
+
+	for (int32_t i = 0; i < MOD_SAMPLES; i++)
+	{
+		struct paula_load ld;
+
+		if (map[i].len == 0)
+			continue;
+		ld.off = map[i].chipOff;
+		ld.len = map[i].len;
+		ld.data = (char *)map[i].start;
+		ioctl(pfd, PAULA_LOAD, (char *)&ld);
+	}
+
+	mapSong = song;
+	mapData = song->sampleData;
+	mapSig = layoutSig();
+}
+
+static unsigned long chipOffset(const int8_t *p)
+{
+	if (p == NULL || area == 0)
+		return PAULA_NULLOFF;
+
+	for (int32_t i = 0; i < MOD_SAMPLES; i++)
+	{
+		if (map[i].len > 0 && p >= map[i].start && p < map[i].start + map[i].len)
+			return map[i].chipOff + (unsigned long)(p - map[i].start);
+	}
+
+	return PAULA_NULLOFF;	// the null sample, or nothing we know
+}
+
+static void record(int op, int ch, uint16_t val, unsigned long off)
+{
+	if (cur.nops >= PAULA_MAXOPS)
+		return;
+
+	struct paula_op *o = &cur.op[cur.nops++];
+	o->op = (unsigned char)op;
+	o->ch = (unsigned char)ch;
+	o->val = val;
+	o->off = off;
+}
+
+void paulaNativeWriteByte(uint32_t address, uint8_t data8)
+{
+	if (recording() && address == 0xBFE001)
+		record(PO_LED, 0, (data8 & 2) ? 1 : 0, 0);
+}
+
+void paulaNativeWriteWord(uint32_t address, uint16_t data16)
+{
+	if (!recording())
+		return;
+
+	if (address == 0xDFF096)
+	{
+		record(PO_DMA, 0, data16 & 0x800F, 0);
+		return;
+	}
+
+	if (address < 0xDFF0A0 || address > 0xDFF0DF)
+		return;
+
+	const int ch = (int)((address - 0xDFF0A0) >> 4);
+	switch (address & 15)
+	{
+		case 4: record(PO_LEN, ch, data16, 0); break;
+		case 6: record(PO_PER, ch, data16, 0); break;
+		case 8:
+		{
+			uint16_t vol = data16 & 127;
+			record(PO_VOL, ch, vol > 64 ? 64 : vol, 0);
+		}
+		break;
+
+		default: break;
+	}
+}
+
+void paulaNativeWritePtr(uint32_t address, const int8_t *ptr)
+{
+	if (!recording() || address < 0xDFF0A0 || address > 0xDFF0DF || (address & 15) != 0)
+		return;
+
+	record(PO_LC, (int)((address - 0xDFF0A0) >> 4), 0, chipOffset(ptr));
+}
+
+static bool push(struct paula_tick *t)
+{
+	return ioctl(pfd, PAULA_PUSH, (char *)t) == 0;
+}
+
+// before the replayer's tick: the samples where Paula finds them, the tempo
+void paulaNativeTickBegin(void)
+{
+	if (!recording())
+		return;
+
+	if (song != NULL)
+	{
+		const bool startPlaying = editor.songPlaying && !wasPlaying;
+
+		wasPlaying = editor.songPlaying;
+		if (song != mapSong || song->sampleData != mapData || layoutSig() != mapSig || startPlaying)
+			upload();
+
+		if (song->currBPM != lastBPM && song->currBPM >= 32 && song->currBPM <= 255)
+		{
+			lastBPM = song->currBPM;
+			record(PO_TEMPO, 0, (uint16_t)lastBPM, 0);
+		}
+	}
+}
+
+// after it: the tick's writes (and any made since the last tick) to the kernel
+void paulaNativeTickEnd(void)
+{
+	if (!recording())
+		return;
+
+	while (npend > 0 && push(&pend[0]))	// first what waited for room
+	{
+		memmove(&pend[0], &pend[1], (size_t)(--npend) * sizeof (pend[0]));
+	}
+
+	if (npend > 0 || !push(&cur))
+	{
+		if (npend < (int)(sizeof (pend) / sizeof (pend[0])))
+			pend[npend++] = cur;	// else dropped: the queue is far ahead
+	}
+
+	cur.nops = 0;
+}
+
+#endif
