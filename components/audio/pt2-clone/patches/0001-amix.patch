+#ifdef __amix__
+/* nextSample() without BLEP: the DMA fetch and the held sample point */
+static inline void nextSampleInt(paulaVoice_t *v)
+{
+	if (v->sampleCounter == 0)
+	{
+		if (!v->sampleJustStarted)
+		{
+			if (--v->lengthCounter == 0)
+			{
+				v->lengthCounter = v->storedLength;
+				v->location = v->storedLocation;
+			}
+		}
+
+		v->sampleJustStarted = false;
+
+		v->AUD_DAT[0] = *v->location++;
+		v->AUD_DAT[1] = *v->location++;
+		v->sampleCounter = 2;
+	}
+
+	v->iSample = v->AUD_DAT[0] * v->iStoredVol; // -128..127 * 0..64
+	v->AUD_DAT[0] = v->AUD_DAT[1];
+	v->sampleCounter--;
+}
+
+/* The AMIX mixer: Paula's voices in integers, sample * volume summed into
+** iOutL/iOutR (-16384..16256 each, the float mixer's range * 8192).  No
+** BLEP, no A500/A1200 RC filters: the sound goes out as 8 bits at 27.7 kHz,
+** and the float mixer took 16-19 us an output sample on the 68060, half of
+** real time.  The same DMA stepping as paulaGenerateSamples(); a held sample
+** point is added over the whole run of output samples it lasts. */
+void paulaGenerateSamplesInt(int32_t *iOutL, int32_t *iOutR, int32_t numSamples)
+{
+	int32_t *iMixBufSelect[PAULA_VOICES];
+
+	if (numSamples <= 0)
+		return;
+
+	iMixBufSelect[0] = iOutL;
+	iMixBufSelect[1] = iOutR;
+	iMixBufSelect[2] = iOutR;
+	iMixBufSelect[3] = iOutL;
+
+	memset(iOutL, 0, numSamples * sizeof (int32_t));
+	memset(iOutR, 0, numSamples * sizeof (int32_t));
+
+	paulaVoice_t *v = paula;
+	for (int32_t i = 0; i < PAULA_VOICES; i++, v++)
+	{
+		if (!v->active || v->location == NULL || v->storedLocation == NULL)
+			continue;
+
+		int32_t *iMix = iMixBufSelect[i];
+		int32_t j = 0;
+		while (j < numSamples)
+		{
+			if (v->nextSampleStage)
+			{
+				v->nextSampleStage = false;
+				nextSampleInt(v);
+			}
+
+			// output samples until the phase passes 1.0
+			int32_t k = numSamples - j;
+			const uint32_t rem = 65536 - v->phase16;
+			if (v->delta16 > 0)
+			{
+				const uint32_t steps = (rem + v->delta16 - 1) / v->delta16;
+				if (steps < (uint32_t)k)
+					k = (int32_t)steps;
+			}
+
+			const int32_t s = v->iSample;
+			if (s != 0)
+			{
+				int32_t *p = iMix + j;
+				for (int32_t m = k; m > 0; m--)
+					*p++ += s;
+			}
+			j += k;
+			v->phase16 += (uint32_t)k * v->delta16;
+
+			while (v->phase16 >= 65536)
+			{
+				v->phase16 -= 65536;
+				refetchPeriod(v);
+				if (v->phase16 >= 65536)
+				{
+					v->nextSampleStage = false;
+					nextSampleInt(v);
+				}
+			}
+		}
+	}
+}
+#endif
