diff --git a/src/pt2_visuals.h b/src/pt2_visuals.h
index 182f30e..1b0a488 100644
--- a/src/pt2_visuals.h
+++ b/src/pt2_visuals.h
@@ -4,6 +4,23 @@
 #include <stdbool.h>
 #include "pt2_header.h"
 #include "pt2_hpc.h"
+#include <string.h>
+
+/* Rows of video.frameBuffer drawn since the last frame went out.  On AMIX the
+** SDL layer (sdl2-amix) compares only these against what is on the screen:
+** memory there is slow (~17 MB/s), and comparing the whole frame cost more
+** than drawing it.  Every place that writes video.frameBuffer marks its rows. */
+#ifdef __amix__
+extern uint8_t videoDirtyRows[SCREEN_H];
+static inline void markDirtyRows(int32_t y, int32_t h)
+{
+	if (y < 0) { h += y; y = 0; }
+	if (y + h > SCREEN_H) h = SCREEN_H - y;
+	if (h > 0) memset(&videoDirtyRows[y], 1, h);
+}
+#else
+#define markDirtyRows(y, h) ((void)0)
+#endif
 
