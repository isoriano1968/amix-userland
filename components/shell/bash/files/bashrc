# /etc/bash/bashrc -- the system-wide settings of interactive bash on AMIX
# (shell/bash).  bash reads it for every interactive shell that is not a
# login shell; the skeleton ~/.bash_profile (/etc/skel) reads it for login
# shells too.  Your own changes here survive package updates; additions of
# your own are best put in /etc/bash/bashrc.d/NAME.sh, read at the end.

# a directory to the front or back of PATH (MANPATH), only when it is there
# and not in it yet: a shell started from a shell does not grow PATH
__amix_add() {
	eval "__amix_v=\$$1"
	case ":$__amix_v:" in *":$3:"*) return 0 ;; esac
	[ -d "$3" ] || return 0
	if [ "$2" = front ]; then
		eval "$1=\"$3\${__amix_v:+:\$__amix_v}\""
	else
		eval "$1=\"\${__amix_v:+\$__amix_v:}$3\""
	fi
}

# GNU first (bash, sed, grep, tar...), then X11R6.3, CDE, what is installed
# in /usr/local, the AMIX applications, and AMIX's own directories after
for __amix_d in /opt/amix/bin /usr/local/bin /usr/dt/bin /usr/x11r6/bin /usr/gnu/bin; do
	__amix_add PATH front "$__amix_d"
done
for __amix_d in /usr/bin /usr/sbin /sbin /usr/ccs/bin; do
	__amix_add PATH back "$__amix_d"
done
export PATH

for __amix_d in /usr/gnu/share/man /usr/local/man /usr/local/share/man /usr/x11r6/man \
    /usr/dt/man /usr/share/man /usr/man; do
	__amix_add MANPATH back "$__amix_d"
done
[ -n "$MANPATH" ] && export MANPATH

# a terminal bash can drive when none was set
case "$TERM" in
""|unknown|network) TERM=vt100; export TERM ;;
esac

# user@host:directory$ (# for root)
PS1='\u@\h:\w\$ '

# local additions
for __amix_d in /etc/bash/bashrc.d/*.sh; do
	[ -r "$__amix_d" ] && . "$__amix_d"
done
unset __amix_d __amix_v
unset -f __amix_add
