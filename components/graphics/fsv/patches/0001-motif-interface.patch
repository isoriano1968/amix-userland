+/* glib.h -- the part of GLib 1.2 that fsv uses, for the Motif build.
+ * Lists, n-ary trees, memory and string chunks, a few string helpers. */
+
+#ifndef FSV_MINI_GLIB_H
+#define FSV_MINI_GLIB_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <float.h>
+#include <limits.h>
+
+typedef char gchar;
+typedef int gint;
+typedef unsigned int guint;
+typedef unsigned char guint8;
+typedef long long gint64;
+typedef int gboolean;
+typedef void *gpointer;
+typedef const void *gconstpointer;
+typedef int (*GCompareFunc)(gconstpointer a, gconstpointer b);
+
+#ifndef TRUE
+#define TRUE 1
+#endif
+#ifndef FALSE
+#define FALSE 0
+#endif
+#ifndef MIN
+#define MIN(a, b) (((a) < (b)) ? (a) : (b))
+#endif
+#ifndef MAX
+#define MAX(a, b) (((a) > (b)) ? (a) : (b))
+#endif
+#ifndef ABS
+#define ABS(a) (((a) < 0) ? -(a) : (a))
+#endif
+#ifndef CLAMP
+#define CLAMP(x, lo, hi) (((x) > (hi)) ? (hi) : (((x) < (lo)) ? (lo) : (x)))
+#endif
+
+void g_log_fail(const char *file, int line, const char *what);
+#ifdef G_DISABLE_ASSERT
+#define g_assert(e) ((void)0)
+#define g_assert_not_reached() ((void)0)
+#else
+#define g_assert(e) ((e) ? (void)0 : g_log_fail(__FILE__, __LINE__, #e))
+#define g_assert_not_reached() g_log_fail(__FILE__, __LINE__, "not reached")
+#endif
+#define g_return_if_fail(e) do { if (!(e)) return; } while (0)
+void g_warning(const char *fmt, ...);
+void g_message(const char *fmt, ...);
+
+#define g_free(p) free(p)
+char *g_strdup(const char *s);
+char *g_dirname(const char *path);     /* newly allocated */
+const char *g_basename(const char *path);
+
+/* Doubly linked lists */
+typedef struct _GList GList;
+struct _GList {
+	gpointer data;
+	GList *next;
+	GList *prev;
+};
+typedef GList GSList;
+GList *g_list_append(GList *list, gpointer data);
+GList *g_list_prepend(GList *list, gpointer data);
+GList *g_list_insert_before(GList *list, GList *sibling, gpointer data);
+GList *g_list_remove(GList *list, gconstpointer data);
+GList *g_list_find(GList *list, gconstpointer data);
+GList *g_list_find_custom(GList *list, gconstpointer data, GCompareFunc func);
+GList *g_list_last(GList *list);
+guint g_list_length(GList *list);
+GList *g_list_sort(GList *list, GCompareFunc func);
+void g_list_free(GList *list);
+
+/* N-ary trees */
+typedef struct _GNode GNode;
+struct _GNode {
+	gpointer data;
+	GNode *next;
+	GNode *prev;
+	GNode *parent;
+	GNode *children;
+};
+#define G_NODE_IS_ROOT(n) ((n)->parent == NULL && (n)->prev == NULL && (n)->next == NULL)
+#define G_NODE_IS_LEAF(n) ((n)->children == NULL)
+GNode *g_node_new(gpointer data);
+GNode *g_node_append_data(GNode *parent, gpointer data);
+GNode *g_node_prepend_data(GNode *parent, gpointer data);
+void g_node_unlink(GNode *node);
+void g_node_destroy(GNode *root);
+guint g_node_depth(GNode *node);
+gboolean g_node_is_ancestor(GNode *node, GNode *descendant);
+
+/* Fixed-size allocations, freed all at once */
+typedef struct _GMemChunk GMemChunk;
+#define G_ALLOC_ONLY 1
+#define G_ALLOC_AND_FREE 2
+#define g_mem_chunk_create(type, pre, kind) g_mem_chunk_new(#type, sizeof(type), sizeof(type) * (pre), kind)
+GMemChunk *g_mem_chunk_new(const char *name, int atom_size, int area_size, int kind);
+gpointer g_mem_chunk_alloc(GMemChunk *chunk);
+void g_mem_chunk_reset(GMemChunk *chunk);
+void g_mem_chunk_info(void);
+void g_blow_chunks(void);
+void g_mem_profile(void);
+
+/* Strings, freed all at once */
+typedef struct _GStringChunk GStringChunk;
+GStringChunk *g_string_chunk_new(int size);
+char *g_string_chunk_insert(GStringChunk *chunk, const char *s);
+void g_string_chunk_free(GStringChunk *chunk);
+
+#endif
