+/* A notebook page: a form, with its major tab */
+static Widget
+notebook_page_add( Widget notebook_w, const char *tab_label, int page )
+{
+	Widget page_w;
+	XmString xs;
+
+	page_w = XtVaCreateManagedWidget( "page", xmFormWidgetClass, notebook_w,
+		XmNnotebookChildType, XmPAGE, XmNpageNumber, page,
+		XmNmarginWidth, 8, XmNmarginHeight, 8, XmNverticalSpacing, 6, NULL );
+	xs = XmStringCreateLocalized( (char *)tab_label );
+	XtVaCreateManagedWidget( "tab", xmPushButtonWidgetClass, notebook_w,
+		XmNnotebookChildType, XmMAJOR_TAB, XmNpageNumber, page, XmNlabelString, xs, NULL );
+	XmStringFree( xs );
+	return page_w;
+}
+
