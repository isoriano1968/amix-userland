+	xs_title = XmStringCreateLocalized( (char *)title );
+	xs_text = XmStringCreateLocalized( (char *)init_text );
+	n = gui_shell_args( args );
+	XtSetArg( args[n], XmNdialogTitle, xs_title ); n++;
+	XtSetArg( args[n], XmNtextString, xs_text ); n++;
+	XtSetArg( args[n], XmNselectionLabelString, xs_title ); n++;
+	XtSetArg( args[n], XmNdialogStyle, XmDIALOG_FULL_APPLICATION_MODAL ); n++;
+	prompt_w = XmCreatePromptDialog( parent_w != NULL ? parent_w : gui_toplevel, "prompt", args, n );
+	XmStringFree( xs_title );
+	XmStringFree( xs_text );
+	XtUnmanageChild( XmSelectionBoxGetChild( prompt_w, XmDIALOG_HELP_BUTTON ) );
+	XtAddCallback( prompt_w, XmNokCallback, entry_ok_cb, e );
+	XtAddCallback( prompt_w, XmNcancelCallback, entry_cancel_cb, e );
+	XtAddCallback( prompt_w, XmNdestroyCallback, entry_destroy_cb, e );
+	XtManageChild( prompt_w );
