+static Widget
+notebook_add( Widget parent_w )
+{
+	Widget notebook_w, scroller_w;
+
+	notebook_w = XtVaCreateManagedWidget( "notebook", xmNotebookWidgetClass, parent_w,
+		XmNbindingType, XmNONE, XmNbackPagePlacement, XmBOTTOM_RIGHT,
+		XmNorientation, XmHORIZONTAL, XmNfirstPageNumber, 1, NULL );
+	/* No page scroller: the tabs are enough */
+	scroller_w = XtNameToWidget( notebook_w, "PageScroller" );
+	if (scroller_w != NULL)
+		XtUnmanageChild( scroller_w );
+	return notebook_w;
 }
 
 
