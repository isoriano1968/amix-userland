+void
+gui_init( int *argc, char **argv )
+{
+	int gl_attribs[] = { GLX_RGBA, GLX_RED_SIZE, 1, GLX_GREEN_SIZE, 1, GLX_BLUE_SIZE, 1,
+			     GLX_DEPTH_SIZE, 1, GLX_DOUBLEBUFFER, None };
