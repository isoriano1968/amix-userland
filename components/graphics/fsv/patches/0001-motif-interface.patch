-	/* Restore original state once the window is destroyed */
-	gtk_signal_connect( GTK_OBJECT(window_w), "destroy", GTK_SIGNAL_FUNC(window_unmodalize), parent_window_w );
+	XtVaGetValues( w, XmNuserData, &func, XmNwidth, &width, XmNheight, &height, NULL );
+	if (func == NULL || !XtIsRealized( w ) || width < 2)
+		return;
+	gc = XCreateGC( XtDisplay(w), XtWindow(w), 0, NULL );
+	for (x = 0; x < width; x++) {
+		color = (*func)( (double)x / (double)(width - 1) );
+		XSetForeground( XtDisplay(w), gc, rgb_pixel( &color ) );
+		XDrawLine( XtDisplay(w), XtWindow(w), gc, x, 0, x, height - 1 );
+	}
+	XFreeGC( XtDisplay(w), gc );
 }
 
 
