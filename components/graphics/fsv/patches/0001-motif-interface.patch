+++ b/fsv-4ef9040fcf14cddd52d79dad87a80355fc885602/src/glib-mini.c
@@ -0,0 +1,448 @@
+/* glib-mini.c -- the GLib subset in glib.h */
+
+#include <stdarg.h>
+#include "glib.h"
+
+static void *
+must(void *p)
+{
+	if (p == NULL) {
+		fprintf(stderr, "fsv: out of memory\n");
+		exit(1);
+	}
+	return p;
+}
+
+void
+g_log_fail(const char *file, int line, const char *what)
+{
+	fprintf(stderr, "fsv: %s:%d: assertion failed: %s\n", file, line, what);
+	abort();
+}
+
+void
+g_warning(const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	fprintf(stderr, "fsv warning: ");
+	vfprintf(stderr, fmt, ap);
+	fprintf(stderr, "\n");
+	va_end(ap);
+}
+
+void
+g_message(const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	fprintf(stderr, "\n");
+	va_end(ap);
+}
+
+char *
+g_strdup(const char *s)
+{
+	return s == NULL ? NULL : strcpy(must(malloc(strlen(s) + 1)), s);
+}
+
+char *
+g_dirname(const char *path)
+{
+	const char *e = strrchr(path, '/');
+	char *d;
+
+	if (e == NULL)
+		return g_strdup(".");
+	while (e > path && e[-1] == '/')
+		e--;
+	if (e == path)
+		return g_strdup("/");
+	d = must(malloc(e - path + 1));
+	memcpy(d, path, e - path);
+	d[e - path] = '\0';
+	return d;
+}
+
+const char *
+g_basename(const char *path)
+{
+	const char *e = strrchr(path, '/');
+
+	return e != NULL ? e + 1 : path;
+}
+
+/**** Lists ****/
+
+static GList *
+list_new(gpointer data)
+{
+	GList *l = must(malloc(sizeof(GList)));
+
+	l->data = data;
+	l->next = l->prev = NULL;
+	return l;
+}
+
+GList *
+g_list_last(GList *list)
+{
+	if (list != NULL)
+		while (list->next != NULL)
+			list = list->next;
+	return list;
+}
+
+GList *
+g_list_append(GList *list, gpointer data)
+{
+	GList *n = list_new(data), *last = g_list_last(list);
+
+	if (last == NULL)
+		return n;
+	last->next = n;
+	n->prev = last;
+	return list;
+}
+
+GList *
+g_list_prepend(GList *list, gpointer data)
+{
+	GList *n = list_new(data);
+
+	n->next = list;
+	if (list != NULL) {
+		n->prev = list->prev;
+		if (list->prev != NULL)
+			list->prev->next = n;
+		list->prev = n;
+	}
+	return n;
+}
+
+GList *
+g_list_insert_before(GList *list, GList *sibling, gpointer data)
+{
+	GList *n;
+
+	if (list == NULL || sibling == NULL)
+		return g_list_append(list, data);
+	n = list_new(data);
+	n->next = sibling;
+	n->prev = sibling->prev;
+	sibling->prev = n;
+	if (n->prev != NULL) {
+		n->prev->next = n;
+		return list;
+	}
+	return n;
+}
+
+GList *
+g_list_remove(GList *list, gconstpointer data)
+{
+	GList *l = list;
+
+	while (l != NULL && l->data != data)
+		l = l->next;
+	if (l == NULL)
+		return list;
+	if (l->prev != NULL)
+		l->prev->next = l->next;
+	if (l->next != NULL)
+		l->next->prev = l->prev;
+	if (l == list)
+		list = l->next;
+	free(l);
+	return list;
+}
+
+GList *
+g_list_find(GList *list, gconstpointer data)
+{
+	while (list != NULL && list->data != data)
+		list = list->next;
+	return list;
+}
+
+GList *
+g_list_find_custom(GList *list, gconstpointer data, GCompareFunc func)
+{
+	while (list != NULL && func(list->data, data) != 0)
+		list = list->next;
+	return list;
+}
+
+guint
+g_list_length(GList *list)
+{
+	guint n = 0;
+
+	for (; list != NULL; list = list->next)
+		n++;
+	return n;
+}
+
+static GList *
+list_merge(GList *a, GList *b, GCompareFunc func)
+{
+	GList head, *t = &head, *prev = NULL;
+
+	while (a != NULL && b != NULL) {
+		if (func(a->data, b->data) <= 0) {
+			t->next = a;
+			a = a->next;
+		}
+		else {
+			t->next = b;
+			b = b->next;
+		}
+		t = t->next;
+		t->prev = prev;
+		prev = t;
+	}
+	t->next = a != NULL ? a : b;
+	if (t->next != NULL)
+		t->next->prev = t;
+	head.next->prev = NULL;
+	return head.next;
+}
+
+/* merge sort, stable like GLib's */
+GList *
+g_list_sort(GList *list, GCompareFunc func)
+{
+	GList *slow, *fast, *second;
+
+	if (list == NULL || list->next == NULL)
+		return list;
+	slow = list;
+	fast = list->next;
+	while (fast != NULL && fast->next != NULL) {
+		slow = slow->next;
+		fast = fast->next->next;
+	}
+	second = slow->next;
+	slow->next = NULL;
+	second->prev = NULL;
+	return list_merge(g_list_sort(list, func), g_list_sort(second, func), func);
+}
+
+void
+g_list_free(GList *list)
+{
+	GList *n;
+
+	while (list != NULL) {
+		n = list->next;
+		free(list);
+		list = n;
+	}
+}
+
+/**** Trees: nodes come from blocks, one per file scanned ****/
+
+#define NODES_PER_BLOCK 1024
+static GNode *free_nodes;
+
+GNode *
+g_node_new(gpointer data)
+{
+	GNode *n;
+	int i;
+
+	if (free_nodes == NULL) {
+		n = must(malloc(NODES_PER_BLOCK * sizeof(GNode)));
+		for (i = 0; i < NODES_PER_BLOCK; i++) {
+			n[i].next = free_nodes;
+			free_nodes = &n[i];
+		}
+	}
+	n = free_nodes;
+	free_nodes = n->next;
+	memset(n, 0, sizeof(GNode));
+	n->data = data;
+	return n;
+}
+
+GNode *
+g_node_append_data(GNode *parent, gpointer data)
+{
+	GNode *n = g_node_new(data), *c;
+
+	n->parent = parent;
+	if (parent->children == NULL)
+		parent->children = n;
+	else {
+		for (c = parent->children; c->next != NULL; c = c->next)
+			;
+		c->next = n;
+		n->prev = c;
+	}
+	return n;
+}
+
+GNode *
+g_node_prepend_data(GNode *parent, gpointer data)
+{
+	GNode *n = g_node_new(data);
+
+	n->parent = parent;
+	n->next = parent->children;
+	if (n->next != NULL)
+		n->next->prev = n;
+	parent->children = n;
+	return n;
+}
+
+void
+g_node_unlink(GNode *node)
+{
+	if (node->prev != NULL)
+		node->prev->next = node->next;
+	else if (node->parent != NULL)
+		node->parent->children = node->next;
+	if (node->next != NULL)
+		node->next->prev = node->prev;
+	node->parent = node->next = node->prev = NULL;
+}
+
+static void
+nodes_free(GNode *n)
+{
+	GNode *next;
+
+	while (n != NULL) {
+		next = n->next;
+		nodes_free(n->children);
+		n->next = free_nodes;
+		free_nodes = n;
+		n = next;
+	}
+}
+
+void
+g_node_destroy(GNode *root)
+{
+	if (root->parent != NULL)
+		g_node_unlink(root);
+	nodes_free(root->children);
+	root->next = free_nodes;
+	free_nodes = root;
+}
+
+guint
+g_node_depth(GNode *node)
+{
+	guint d = 0;
+
+	for (; node != NULL; node = node->parent)
+		d++;
+	return d;
+}
+
+gboolean
+g_node_is_ancestor(GNode *node, GNode *descendant)
+{
+	for (descendant = descendant->parent; descendant != NULL; descendant = descendant->parent)
+		if (descendant == node)
+			return TRUE;
+	return FALSE;
+}
+
+/**** Memory chunks ****/
+
+struct _GMemChunk {
+	int atom, area;
+	char **blocks;
+	int nblocks, used;      /* atoms used in the last block */
+};
+
+GMemChunk *
+g_mem_chunk_new(const char *name, int atom_size, int area_size, int kind)
+{
+	GMemChunk *c = must(calloc(1, sizeof(GMemChunk)));
+
+	(void)name;
+	(void)kind;
+	c->atom = (atom_size + 7) & ~7;
+	c->area = MAX(area_size / c->atom, 1) * 16;     /* fewer, larger blocks */
+	c->used = c->area;
+	return c;
+}
+
+gpointer
+g_mem_chunk_alloc(GMemChunk *c)
+{
+	if (c->used == c->area) {
+		c->blocks = must(realloc(c->blocks, (c->nblocks + 1) * sizeof(char *)));
+		c->blocks[c->nblocks++] = must(malloc((size_t)c->atom * c->area));
+		c->used = 0;
+	}
+	return c->blocks[c->nblocks - 1] + (size_t)c->atom * c->used++;
+}
+
+void
+g_mem_chunk_reset(GMemChunk *c)
+{
+	int i;
+
+	for (i = 0; i < c->nblocks; i++)
+		free(c->blocks[i]);
+	free(c->blocks);
+	c->blocks = NULL;
+	c->nblocks = 0;
+	c->used = c->area;
+}
+
+void g_mem_chunk_info(void) { }
+void g_blow_chunks(void) { }
+void g_mem_profile(void) { }
+
+/**** String chunks ****/
+
+struct _GStringChunk {
+	char **blocks;
+	int nblocks, size, used;
+};
+
+GStringChunk *
+g_string_chunk_new(int size)
+{
+	GStringChunk *c = must(calloc(1, sizeof(GStringChunk)));
+
+	c->size = MAX(size, 4096);
+	c->used = c->size;
+	return c;
+}
+
+char *
+g_string_chunk_insert(GStringChunk *c, const char *s)
+{
+	int n = strlen(s) + 1;
+	char *p;
+
+	if (n > c->size - c->used) {
+		c->blocks = must(realloc(c->blocks, (c->nblocks + 1) * sizeof(char *)));
+		c->blocks[c->nblocks++] = must(malloc(MAX(n, c->size)));
+		c->used = 0;
+	}
+	p = c->blocks[c->nblocks - 1] + c->used;
+	memcpy(p, s, n);
+	c->used += n;
+	return p;
+}
+
+void
+g_string_chunk_free(GStringChunk *c)
+{
+	int i;
+
+	for (i = 0; i < c->nblocks; i++)
+		free(c->blocks[i]);
+	free(c->blocks);
+	free(c);
+}
diff --git a/fsv-4ef9040fcf14cddd52d79dad87a80355fc885602/src/glib.h b/fsv-4ef9040fcf14cddd52d79dad87a80355fc885602/src/glib.h
