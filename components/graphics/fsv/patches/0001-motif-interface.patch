-change_root_cb( const char *dir )
-{
+change_root_ok_cb( Widget w, XtPointer data, XtPointer call )
+{
+	XmFileSelectionBoxCallbackStruct *cbs = (XmFileSelectionBoxCallbackStruct *)call;
+	struct stat st;
+	char *dir, *p;
+
+	dir = XmStringUnparse( cbs->value, NULL, XmCHARSET_TEXT, XmCHARSET_TEXT, NULL, 0, XmOUTPUT_ALL );
+	/* A file named by mistake: its directory */
+	if (stat( dir, &st ) == 0 && !S_ISDIR(st.st_mode)) {
+		p = strrchr( dir, '/' );
+		if (p != NULL && p > dir)
+			*p = '\0';
+	}
+	XtDestroyWidget( XtParent(w) );
 	if (globals.fsv_mode != FSV_SPLASH)
 		fsv_load( dir );
+	XtFree( dir );
 }
 
 
