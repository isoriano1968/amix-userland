+	gui_display = XtOpenDisplay( gui_app, NULL, "fsv", "Fsv", NULL, 0, argc, argv );
+	if (gui_display == NULL)
+		quit( _("fsv: cannot open the display") );
+	scr = DefaultScreen( gui_display );
+
+	if (!glXQueryExtension( gui_display, NULL, NULL ))
+		quit( _("fsv requires OpenGL support.") );
+	/* The screen's own visual if GL can draw in it: then every window,
+	 * menus included, shares one visual and colormap */
+	gui_gl_visual = default_visual_if_gl( scr );
+	if (gui_gl_visual == NULL)
+		gui_gl_visual = glXChooseVisual( gui_display, scr, gl_attribs );
+	if (gui_gl_visual == NULL)
+		quit( _("fsv: no double-buffered RGB visual with a depth buffer") );
+	if (gui_gl_visual->visualid == XVisualIDFromVisual( DefaultVisual( gui_display, scr ) ))
+		gui_colormap = DefaultColormap( gui_display, scr );
+	else
+		gui_colormap = XCreateColormap( gui_display, RootWindow( gui_display, scr ), gui_gl_visual->visual, AllocNone );
 
