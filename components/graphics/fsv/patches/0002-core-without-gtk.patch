+/* The sky of fsn on IRIX: black overhead, green at the horizon, black
+ * ground below it */
+static void
+draw_sky( void )
+{
+	glPushAttrib( GL_ENABLE_BIT | GL_DEPTH_BUFFER_BIT | GL_LIGHTING_BIT );
+	glDisable( GL_LIGHTING );
+	glDisable( GL_DEPTH_TEST );
+	glDisable( GL_TEXTURE_2D );
+	glDisable( GL_CULL_FACE );
+	glDepthMask( GL_FALSE );
+	glShadeModel( GL_SMOOTH );
+	glMatrixMode( GL_PROJECTION );
+	glPushMatrix( );
+	glLoadIdentity( );
+	glMatrixMode( GL_MODELVIEW );
+	glPushMatrix( );
+	glLoadIdentity( );
+	glBegin( GL_QUAD_STRIP );
+	glColor3f( 0.0, 0.0, 0.0 );
+	glVertex2d( -1.0, 1.0 );
+	glVertex2d( 1.0, 1.0 );
+	glColor3f( 0.098, 0.369, 0.188 );	/* #195E30 */
+	glVertex2d( -1.0, 0.1 );
+	glVertex2d( 1.0, 0.1 );
+	glColor3f( 0.0, 0.0, 0.0 );
+	glVertex2d( -1.0, -0.15 );
+	glVertex2d( 1.0, -0.15 );
+	glVertex2d( -1.0, -1.0 );
+	glVertex2d( 1.0, -1.0 );
+	glEnd( );
+	glPopMatrix( );
+	glMatrixMode( GL_PROJECTION );
+	glPopMatrix( );
+	glMatrixMode( GL_MODELVIEW );
+	glPopAttrib( );
+}
