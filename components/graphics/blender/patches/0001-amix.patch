diff --git a/intern/ghost/intern/GHOST_WindowX11.cpp b/intern/ghost/intern/GHOST_WindowX11.cpp
index 1310d11..44fc0c9 100755
--- a/intern/ghost/intern/GHOST_WindowX11.cpp
+++ b/intern/ghost/intern/GHOST_WindowX11.cpp
@@ -503,6 +503,12 @@ GHOST_WindowX11::
 		if (m_context == s_firstContext) {
 			s_firstContext = NULL;
 		}
+		/* release it first if it is current: Mesa 3.1's glXDestroyContext
+		   leaves its current-context pointer dangling, and the next GL call
+		   (closing Blender's render window) jumps through freed memory */
+		if (glXGetCurrentContext() == m_context) {
+			glXMakeCurrent(m_display, None, NULL);
+		}
 		glXDestroyContext(m_display, m_context);
 	}
 	XDestroyWindow(m_display, m_window);
