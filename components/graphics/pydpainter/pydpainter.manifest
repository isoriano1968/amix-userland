file     /usr/local/share/pydpainter/libs/gifwriter.py
file     /usr/local/share/pydpainter/libs/hotkey.py
file     /usr/local/share/pydpainter/libs/layer.py
file     /usr/local/share/pydpainter/libs/layertools.py
file     /usr/local/share/pydpainter/libs/menubar.py
file     /usr/local/share/pydpainter/libs/menureq.py
file     /usr/local/share/pydpainter/libs/menus.py
file     /usr/local/share/pydpainter/libs/minitools.py
