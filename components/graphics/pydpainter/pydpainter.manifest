# name, version and what building and running it needs
name     graphics/pydpainter
version  2.2.1
summary  PyDPainter: Deluxe Paint clone in Python 3 and pygame
require  runtime/python3
require  library/python/pygame
require  library/python/numpy
require  library/sdl2
require  library/sdl2-image
require  library/freetype
require  x11/x11r6.3
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/PyDPainter
file     /etc/dt/appconfig/icons/C/PyDPainter.l.pm
file     /etc/dt/appconfig/icons/C/PyDPainter.m.pm
file     /etc/dt/appconfig/icons/C/PyDPainter.t.pm
file     /etc/dt/appconfig/types/C/pydpainter.dt
file     /usr/local/bin/pydpainter
file     /usr/local/share/pydpainter/PyDPainter.py
file     /usr/local/share/pydpainter/data/FreeSans.ttf
file     /usr/local/share/pydpainter/data/FreeSansBold.ttf
file     /usr/local/share/pydpainter/data/animtools.png
file     /usr/local/share/pydpainter/data/crng_arrows.png
file     /usr/local/share/pydpainter/data/cursors.png
file     /usr/local/share/pydpainter/data/ghosting.png
file     /usr/local/share/pydpainter/data/half_dots.png
file     /usr/local/share/pydpainter/data/halfnumbers.png
file     /usr/local/share/pydpainter/data/icon.png
file     /usr/local/share/pydpainter/data/jewel32.png
file     /usr/local/share/pydpainter/data/layertools.png
file     /usr/local/share/pydpainter/data/logo.png
file     /usr/local/share/pydpainter/data/minitools.png
file     /usr/local/share/pydpainter/data/palettearrows.png
file     /usr/local/share/pydpainter/data/quarter_dots.png
file     /usr/local/share/pydpainter/data/smooth_example.png
file     /usr/local/share/pydpainter/data/tools.png
file     /usr/local/share/pydpainter/gif2numpy/LICENSE
file     /usr/local/share/pydpainter/gif2numpy/README.md
file     /usr/local/share/pydpainter/gif2numpy/gif_decode.py
file     /usr/local/share/pydpainter/libs/animation.py
file     /usr/local/share/pydpainter/libs/animtools.py
file     /usr/local/share/pydpainter/libs/clipboard.py
