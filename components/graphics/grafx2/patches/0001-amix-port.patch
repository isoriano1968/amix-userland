AMIX: no free-memory call (default size), SVR4 mount table (getmntent on
/etc/mnttab), config in ~/.grafx2, the installed bin directory when argv[0]
has none, and getcwd(NULL, 0), which allocates only on glibc.

diff --git a/src/io.c b/src/io.c
index 074445b..c6c5d49 100644
--- a/src/io.c
+++ b/src/io.c
@@ -1073,7 +1073,13 @@ char * Get_current_directory(char * buf, word * * unicode, size_t size)
   free(cur_dir);
   return buf;
 #else
-  char * ret = getcwd(buf, size);
+  char * ret;
+#if defined(__amix__)
+  // SVR4's getcwd() allocates the buffer only when it is given a size
+  if (buf == NULL && size == 0)
+    size = 1024;
+#endif
+  ret = getcwd(buf, size);
 #if !defined (__amigaos__)
   if (ret == NULL)
     GFX2_Log(GFX2_ERROR, "getcwd(%p, %lu) failed !\n", buf, (unsigned long)size);
diff --git a/src/mountlist.c b/src/mountlist.c
index 0db7bb5..9af8176 100644
--- a/src/mountlist.c
+++ b/src/mountlist.c
@@ -45,6 +45,8 @@
     #warning "Your platform is missing some specific code here ! please check and fix :)"
 #elif defined(__SWITCH__)
     // Nothing much to do
+#elif defined(__amix__)
+    #define MOUNTED_GETMNTENT2
 #else
     #define MOUNTED_GETMNTENT1
 #endif
@@ -704,10 +706,10 @@ read_file_system_list (bool need_fs_type)
       {
         while ((ret = getmntent (fp, &mnt)) == 0)
           {
-            me = xmalloc (sizeof *me);
-            me->me_devname = xstrdup (mnt.mnt_special);
-            me->me_mountdir = xstrdup (mnt.mnt_mountp);
-            me->me_type = xstrdup (mnt.mnt_fstype);
+            me = malloc (sizeof *me);
+            me->me_devname = strdup (mnt.mnt_special);
+            me->me_mountdir = strdup (mnt.mnt_mountp);
+            me->me_type = strdup (mnt.mnt_fstype);
             me->me_type_malloced = 1;
             me->me_dummy = MNT_IGNORE (&mnt) != 0;
             me->me_remote = ME_REMOTE (me->me_devname, me->me_type);
