+/*
+ * Any TrueColor visual, not only 32 bits in the PC's byte order: the pixel
+ * value of each palette entry from the visual's masks (16 bits on AMIX's
+ * Xzz9000), the image in this machine's byte order (Xlib swaps it for a
+ * server with the other one).
+ */
+static unsigned long X11_rmask, X11_gmask, X11_bmask;
+static unsigned long X11_palpix[256];
+
+static unsigned long X11_channel(byte v, unsigned long mask)
+{
+  int shift = 0, bits = 0;
+  unsigned long m = mask;
+  if (m == 0) return 0;
+  while (!(m & 1)) { m >>= 1; shift++; }
+  while (m & 1) { m >>= 1; bits++; }
+  if (bits < 8)
+    return ((unsigned long)v >> (8 - bits)) << shift;
+  return ((unsigned long)v << (bits - 8)) << shift;
+}
+
+static unsigned long X11_pixel(byte r, byte g, byte b)
+{
+  return X11_channel(r, X11_rmask) | X11_channel(g, X11_gmask) | X11_channel(b, X11_bmask);
+}
+
+static XImage * X11_new_image(Visual * visual, int depth, int w, int h)
+{
+  static const unsigned short one = 1;
+  XImage * img = XCreateImage(X11_display, visual, depth, ZPixmap, 0, NULL, w, h, 32, 0);
+  if (img == NULL) return NULL;
+  img->data = malloc((size_t)img->bytes_per_line * h);
+  if (img->data == NULL) { XDestroyImage(img); return NULL; }
+  memset(img->data, 0, (size_t)img->bytes_per_line * h);
+  // the image in our own byte order: Xlib converts it for the server
+  img->byte_order = *(const unsigned char *)&one ? LSBFirst : MSBFirst;
+  return img;
+}
+
+static void X11_update_palpix(void)
+{
+  int i;
+  for (i = 0; i < 256; i++)
+    X11_palpix[i] = X11_pixel(screen->palette[i].R, screen->palette[i].G, screen->palette[i].B);
+}
