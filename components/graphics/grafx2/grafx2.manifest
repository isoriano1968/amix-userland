# name, version and what building and running it needs
name     graphics/grafx2
version  2.9
# the 68020..68060 baseline, tools/amix-cpu-scan clean
cpu      68020
summary  Grafx2: 256-colour pixel art paint program inspired by Deluxe Paint, X11 front end
require  x11/x11r6.3
require  library/libpng
require  library/zlib
require  library/amixc99
file     /etc/dt/appconfig/appmanager/C/Desktop_Apps/Grafx2
file     /etc/dt/appconfig/icons/C/Grafx2.l.pm
file     /etc/dt/appconfig/icons/C/Grafx2.m.pm
file     /etc/dt/appconfig/icons/C/Grafx2.t.pm
file     /etc/dt/appconfig/types/C/grafx2.dt
file     /usr/local/bin/grafx2
file     /usr/local/share/grafx2/fonts/5pxtinyfont.png
file     /usr/local/share/grafx2/fonts/8pxfont.png
file     /usr/local/share/grafx2/fonts/GrafX2_Black.gif
file     /usr/local/share/grafx2/fonts/GrafX2_Dark.gif
file     /usr/local/share/grafx2/fonts/PF_Arma_5__.png
file     /usr/local/share/grafx2/fonts/PF_Easta_7_.png
file     /usr/local/share/grafx2/fonts/PF_Easta_7__.png
file     /usr/local/share/grafx2/fonts/PF_Ronda_7__.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_5.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_5_.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_5__.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_5___.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_7.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_7_.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_7__.png
file     /usr/local/share/grafx2/fonts/PF_Tempesta_7___.png
file     /usr/local/share/grafx2/fonts/PF_Westa_7_.png
file     /usr/local/share/grafx2/fonts/PF_Westa_7__.png
file     /usr/local/share/grafx2/fonts/colorfont.pcx
file     /usr/local/share/grafx2/gfx2.gif
file     /usr/local/share/grafx2/gfx2.png
file     /usr/local/share/grafx2/gfx2def.ini
file     /usr/local/share/grafx2/skins/font_Classic.png
file     /usr/local/share/grafx2/skins/font_DPaint.png
file     /usr/local/share/grafx2/skins/font_Dawn.png
file     /usr/local/share/grafx2/skins/font_Fairlight.png
file     /usr/local/share/grafx2/skins/font_Fun.png
file     /usr/local/share/grafx2/skins/font_Melon.png
file     /usr/local/share/grafx2/skins/font_Seen.png
file     /usr/local/share/grafx2/skins/skin_Aurora.png
file     /usr/local/share/grafx2/skins/skin_Clax2.gif
file     /usr/local/share/grafx2/skins/skin_Clax3.gif
file     /usr/local/share/grafx2/skins/skin_Clax4.gif
file     /usr/local/share/grafx2/skins/skin_DPaint.png
file     /usr/local/share/grafx2/skins/skin_black.png
file     /usr/local/share/grafx2/skins/skin_chrisfx.png
