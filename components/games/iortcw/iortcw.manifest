# name, version and what building and running it needs
name     games/iortcw
version  438e7d4
summary  Return to Castle Wolfenstein: the whole engine and its GL on the Z3660's core 1 (wolf.sh, c1q3)
require  x11/mesa-183
require  x11/x11r6.3
require  library/lib060
build    library/dlmalloc
require  games/ioquake3
file     /opt/rtcw/wolf.sh
file     /root/z3660ARMCores/z3660ARM_Core_wolf.bin
