 static int     ZCALLBACK fclose_file_func OF((voidpf opaque, voidpf stream));
 static int     ZCALLBACK ferror_file_func OF((voidpf opaque, voidpf stream));
 
+#ifdef __amix__
+/* AMIX's stdio buffers 1 KB: the zip code reads pk3 directories a byte at a
+   time through it, so every KB is a read(2) of ~50 us plus the disk.  A
+   larger buffer for the pk3s. */
+static FILE *amix_zbuf(FILE *f)
+{
+    if (f != NULL)
+        setvbuf(f, NULL, _IOFBF, 16384);
+    return f;
+}
+#else
+#define amix_zbuf(f) (f)
+#endif
