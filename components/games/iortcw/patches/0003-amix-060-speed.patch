-static float R_RMSE( byte *in, int width, int height ) {
+#ifdef __amix__
+/*
+ * AMIX: the same root mean square error in integers, one FPU add per row,
+ * and it stops as soon as the result can no longer stay below limit (the
+ * callers only ask "below limit?").  The original costs four fabs and
+ * float conversions per channel: minutes of the 060's loading time.
+ * Returns limit or more when the texture is not below it.
+ */
+static float R_RMSE( byte *in, int width, int height, float limit ) {
+	int i, j, k;
+	int row;
+	double sum = 0.0, stop;
+
+	if ( width <= 32 || height <= 32 ) {
+		return 9999.0f;
+	}
+
+	row = width * 4;
+
+	width >>= 1;
+	height >>= 1;
+	stop = (double)limit * limit * ( (double)height * width * 4 );
+
+	for ( i = 0 ; i < height ; i++, in += row ) {
+		unsigned int rs = 0;	/* <= 512 pixels * 4 channels * 1020^2 fits */
+
+		for ( j = 0 ; j < width ; j++, in += 8 ) {
+			for ( k = 0; k < 4; k++ ) {
+				int a = in[k], b = in[4 + k], c = in[row + k], d = in[row + 4 + k];
+				int out = ( a + b + c + d ) >> 2;
+				int t = abs( out - a ) + abs( out - b ) + abs( out - c ) + abs( out - d );
+
+				rs += (unsigned int)( t * t );
+			}
+			if ( rs & 0x80000000u ) {	/* wide textures: spill early */
+				sum += rs;
+				rs = 0;
+			}
+		}
+		sum += rs;
+		if ( sum >= stop ) {
+			return limit > 9999.0f ? limit : 9999.0f;
+		}
+	}
+	return (float)sqrt( sum / ( (double)height * width * 4 ) );
+}
+#else
+static float R_RMSE( byte *in, int width, int height, float limit ) {
 	int i, j;
 	float out, rmse, rtemp;
 	int row;
