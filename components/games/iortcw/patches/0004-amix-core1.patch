AMIX: iortcw (single player) as a program for the Z3660's ARM core 1
(files/core1), bare metal: the platform block, heap defaults, 16 raw sound
streams instead of 257; the pak checks off as for the 060 build (the paks are
the user's own, reduced by amix/trimpaks.py).

diff -ruN a/code/client/snd_local.h b/code/client/snd_local.h
--- a/code/client/snd_local.h	2026-11-08 23:05:59.684012856 +0100
+++ b/code/client/snd_local.h	2026-11-08 23:05:59.696012795 +0100
@@ -226,7 +226,13 @@
 } streamingSound_t;
 
 #define	MAX_RAW_SAMPLES	16384
+#if defined(__z3660core__)
+// the Z3660's core 1: 16 streams (music and the streamed dialogue); the
+// 257 are 33 MB of its memory
+#define MAX_RAW_STREAMS 16
+#else
 #define MAX_RAW_STREAMS (MAX_CLIENTS * 2 + 1)
+#endif
 extern streamingSound_t streamingSounds[MAX_RAW_STREAMS];
 extern	portable_samplepair_t s_rawsamples[MAX_RAW_STREAMS][MAX_RAW_SAMPLES];
 extern	int		s_rawend[MAX_RAW_STREAMS];
