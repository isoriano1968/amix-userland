diff -ruN a/code/renderergl1/tr_amix_s3d.c b/code/renderergl1/tr_amix_s3d.c
--- a/code/renderergl1/tr_amix_s3d.c	1970-01-01 01:00:00.000000000 +0100
+++ b/code/renderergl1/tr_amix_s3d.c	2026-10-31 09:08:42.718543757 +0100
@@ -0,0 +1,553 @@
+/*
+ * tr_amix_s3d.c -- the GL1 renderer straight onto the Z3660's soft3D (AMIX,
+ * 2026-10-27).
+ *
+ * On soft3D (the default; MESA_SOFT3D=0 is off) Mesa already rasterizes on the board's ARM, but its
+ * general vertex pipeline is what the 68060 cannot afford: ~60 us a
+ * triangle, 8,500 triangles a frame of q3dm1.  Here R_DrawElements does the
+ * work itself for the soft3D window: the arrays tr_shade.c sets are recorded
+ * (the calls still reach Mesa, for the cases this does not handle), each
+ * surface's positions are transformed once with Mesa's current matrices and
+ * kept while the same surface is drawn again for its next shader stage,
+ * triangles go by outcodes -- out, in (straight to libs3d), or clipped
+ * against the planes they cross -- and are culled as GL would.  Mesa keeps
+ * the state: glAmixS3DBegin gives soft3D its blending, depth, texture
+ * environment and the bound texture, and says whether soft3D draws at all
+ * (otherwise Mesa does, from the same arrays).
+ *
+ * Not done here: polygon offset beyond a constant depth bias, user clip
+ * planes, texture matrices, two-sided lighting (none of which the GL1
+ * renderer's stage drawing uses).
+ */
+#define AMIX_S3D_IMPL
+#include "tr_local.h"
+#include "../../../../soft3d-amix/libs3d/s3d.h"
+
+extern int glAmixS3DBegin(void);
+extern int glAmixS3DHeight(void);
+extern int glAmixSoft3D(void);
+
+/* --- the arrays tr_shade.c sets ------------------------------------------ */
+
+typedef struct { const byte *ptr; int size, stride; } amixArray_t;
+static amixArray_t ax, at, ac;
+static qboolean tex_on, col_on;
+static byte cur_rgba[4] = { 255, 255, 255, 255 };
+static int amix_mode = -1;      /* -1 unknown, 0 Mesa, 1 soft3D direct */
+static int skip;                /* Q3_S3D_SKIP: 1 draw nothing, 2 all but s3d_tri,
+                                   3 only glAmixS3DBegin and the glGets */
+static int stats;               /* Q3_S3D_STATS=1: counts every 20 frames */
+static unsigned long st_calls, st_xform, st_reuse, st_clip, st_frames;
+static int st_frame = -1;
+static int have;                /* vertices transformed for the current arrays */
+
+static qboolean amix_direct(void)
+{
+    if (amix_mode < 0) {
+        const char *e, *d = getenv("Q3_S3D_DIRECT");
+        amix_mode = glAmixSoft3D() && !(d && atoi(d) == 0);
+        e = getenv("Q3_S3D_SKIP");
+        skip = e ? atoi(e) : 0;
+        e = getenv("Q3_S3D_STATS");
+        stats = e && atoi(e) > 0;
+        if (amix_mode)
+            ri.Printf(PRINT_ALL, "...drawing straight to soft3D (Q3_S3D_DIRECT=0: through Mesa)\n");
+    }
+    return amix_mode;
+}
+
+void amixVertexPointer(GLint size, GLenum type, GLsizei stride, const GLvoid *p)
+{
+    ax.ptr = p; ax.size = size; ax.stride = stride ? stride : size * 4;
+    have = 0;                   /* tess.xyz is refilled for every surface */
+    qglVertexPointer(size, type, stride, p);
+}
+
+void amixTexCoordPointer(GLint size, GLenum type, GLsizei stride, const GLvoid *p)
+{
+    at.ptr = p; at.size = size; at.stride = stride ? stride : size * 4;
+    qglTexCoordPointer(size, type, stride, p);
+}
+
+void amixColorPointer(GLint size, GLenum type, GLsizei stride, const GLvoid *p)
+{
+    ac.ptr = p; ac.size = size; ac.stride = stride ? stride : size;
+    qglColorPointer(size, type, stride, p);
+}
+
+void amixEnableClientState(GLenum a)
+{
+    if (a == GL_TEXTURE_COORD_ARRAY) tex_on = qtrue;
+    if (a == GL_COLOR_ARRAY) col_on = qtrue;
+    qglEnableClientState(a);
+}
+
+void amixDisableClientState(GLenum a)
+{
+    if (a == GL_TEXTURE_COORD_ARRAY) tex_on = qfalse;
+    if (a == GL_COLOR_ARRAY) col_on = qfalse;
+    qglDisableClientState(a);
+}
+
+static byte to8(float f)
+{
+    return f <= 0.0f ? 0 : f >= 1.0f ? 255 : (byte) (f * 255.0f + 0.5f);
+}
+
+void amixColor3f(GLfloat r, GLfloat g, GLfloat b)
+{
+    cur_rgba[0] = to8(r); cur_rgba[1] = to8(g); cur_rgba[2] = to8(b); cur_rgba[3] = 255;
+    qglColor3f(r, g, b);
+}
+
+void amixColor4f(GLfloat r, GLfloat g, GLfloat b, GLfloat a)
+{
+    cur_rgba[0] = to8(r); cur_rgba[1] = to8(g); cur_rgba[2] = to8(b); cur_rgba[3] = to8(a);
+    qglColor4f(r, g, b, a);
+}
+
+void amixColor4ubv(const GLubyte *v)
+{
+    cur_rgba[0] = v[0]; cur_rgba[1] = v[1]; cur_rgba[2] = v[2]; cur_rgba[3] = v[3];
+    qglColor4ubv(v);
+}
+
+/* soft3D direct: nothing for Mesa to precalculate */
+void amixLockArraysEXT(GLint first, GLsizei count)
+{
+    if (!amix_direct() && qglLockArraysEXT)
+        qglLockArraysEXT(first, count);
+}
+
+void amixUnlockArraysEXT(void)
+{
+    if (!amix_direct() && qglUnlockArraysEXT)
+        qglUnlockArraysEXT();
+}
+
+/* --- transformed vertices, kept across a surface's stages ------------------ */
+
+typedef struct { float x, y, z, w; } clip4_t;
+static clip4_t *cv;             /* clip space */
+static struct s3d_vertex *wv;   /* window space, if the vertex is inside */
+static byte *oc;                /* outcodes */
+static int cap;                 /* allocated */
+static const byte *have_xyz;
+static float have_m[16], have_vp[4], have_dr[2], have_zbias;
+
+#define OUT_L 1
+#define OUT_R 2
+#define OUT_B 4
+#define OUT_T 8
+#define OUT_N 16
+#define OUT_F 32
+
+static float m[16], vp[4], dr[2], H, zbias;
+#define TRI(a, b, c) do { if (skip != 2) emit(a, b, c); } while (0)
+
+/* --- deferred lightmap passes -------------------------------------------------
+ * Without multitexture every lightmapped surface is two passes, the texture
+ * (replace, depth written) and the lightmap (DST_COLOR x ZERO, depth LEQUAL
+ * or EQUAL, nothing written), so soft3D's state flips texture, lightmap, texture...
+ * about 120 times a frame at ~1.2 ms each in the firmware.  The opaque
+ * lightmap passes wait here, one list per state, and are drawn together
+ * before anything they could disturb: a draw that is not an opaque
+ * depth-writing one, 2D, a clear, a read-back, the swap.  Until then only
+ * opaque depth-writing surfaces are drawn, and a pixel one of them takes
+ * over (being nearer) fails the waiting pass's depth test, as it would have
+ * in order.
+ * Q3_S3D_DEFER=1 turns it on.  Off by default: on q3dm1 the additive glow
+ * stages flush the lists so often that only 117 -> 105 state changes were
+ * saved, and the frame got slower (433 -> 466 ms, 2026-10-27). */
+typedef struct {
+    struct s3d_state st;
+    struct s3d_vertex *v;
+    int n, cap;
+} deferList_t;
+#define MAXDEFER 32
+static deferList_t defer[MAXDEFER];
+static int ndefer, nqueued, defer_on = -1;
+static deferList_t *queue_to;           /* the list this draw goes to, or 0 */
+
+static void emit(const struct s3d_vertex *a, const struct s3d_vertex *b, const struct s3d_vertex *c)
+{
+    deferList_t *d = queue_to;
+    if (!d) {
+        s3d_tri_clipped(a, b, c);
+        return;
+    }
+    if (d->n + 3 > d->cap) {
+        d->cap = d->cap ? d->cap * 2 : 768;
+        d->v = (struct s3d_vertex *) realloc(d->v, d->cap * sizeof *d->v);
+    }
+    d->v[d->n++] = *a;
+    d->v[d->n++] = *b;
+    d->v[d->n++] = *c;
+    nqueued++;
+}
+
+void amixFlushDeferred(void)
+{
+    struct s3d_state was;
+    int i, k, have_was;
+
+    if (!nqueued) {
+        ndefer = 0;
+        return;
+    }
+    have_was = s3d_get_state(&was);
+    for (i = 0; i < ndefer; i++) {
+        deferList_t *d = &defer[i];
+        if (!d->n)
+            continue;
+        s3d_set_state(&d->st);
+        for (k = 0; k + 2 < d->n; k += 3)
+            s3d_tri_clipped(&d->v[k], &d->v[k + 1], &d->v[k + 2]);
+        d->n = 0;
+    }
+    ndefer = nqueued = 0;
+    if (have_was)
+        s3d_set_state(&was);
+}
+
+/* the list for this draw if it is an opaque lightmap pass, else 0 (and the
+   lists are drawn first unless this is an opaque depth-writing draw) */
+static deferList_t *defer_for(void)
+{
+    unsigned long b = glState.glStateBits;
+    unsigned long blend = b & (GLS_SRCBLEND_BITS | GLS_DSTBLEND_BITS);
+    int opaque_world = !backEnd.projection2D && tess.shader && tess.shader->sort <= SS_OPAQUE;
+    struct s3d_state st;
+    int i;
+
+    if (defer_on < 0) {
+        const char *e = getenv("Q3_S3D_DEFER");
+        defer_on = e && atoi(e) > 0;
+    }
+    if (defer_on && opaque_world && !(b & GLS_DEPTHMASK_TRUE) &&
+        !(b & GLS_DEPTHTEST_DISABLE) &&
+        (blend == (GLS_SRCBLEND_DST_COLOR | GLS_DSTBLEND_ZERO) ||
+         blend == (GLS_SRCBLEND_ZERO | GLS_DSTBLEND_SRC_COLOR)) && s3d_get_state(&st)) {
+        for (i = 0; i < ndefer; i++)
+            if (!memcmp(&defer[i].st, &st, sizeof st))
+                return &defer[i];
+        if (ndefer < MAXDEFER) {
+            defer[ndefer].st = st;
+            defer[ndefer].n = 0;
+            return &defer[ndefer++];
+        }
+        amixFlushDeferred();
+        defer[0].st = st;
+        defer[0].n = 0;
+        ndefer = 1;
+        return &defer[0];
+    }
+    if (!(opaque_world && (b & GLS_DEPTHMASK_TRUE) && !(b & GLS_DEPTHTEST_DISABLE) &&
+          !(b & GLS_DEPTHFUNC_EQUAL) && (blend == 0 || blend == (GLS_SRCBLEND_ONE | GLS_DSTBLEND_ZERO))))
+        amixFlushDeferred();
+    return NULL;
+}
+
+void amixClear(GLbitfield mask)
+{
+    amixFlushDeferred();
+    qglClear(mask);
+}
+
+void amixFinish(void)
+{
+    amixFlushDeferred();
+    qglFinish();
+}
+
+void amixReadPixels(GLint x, GLint y, GLsizei w, GLsizei h, GLenum f, GLenum t, GLvoid *p)
+{
+    amixFlushDeferred();
+    qglReadPixels(x, y, w, h, f, t, p);
+}
+
+static byte outcode(const clip4_t *c)
+{
+    byte o = 0;
+    if (c->x < -c->w) o |= OUT_L;
+    if (c->x >  c->w) o |= OUT_R;
+    if (c->y < -c->w) o |= OUT_B;
+    if (c->y >  c->w) o |= OUT_T;
+    if (c->z < -c->w) o |= OUT_N;
+    if (c->z >  c->w) o |= OUT_F;
+    return o;
+}
+
+/* clip space to soft3D's window space: y down, z 0..1 in the depth range,
+   w = 1/w; u v and colour are filled by the caller */
+static void project(const clip4_t *c, struct s3d_vertex *o)
+{
+    float iw = 1.0f / c->w;
+    o->x = vp[0] + (c->x * iw + 1.0f) * 0.5f * vp[2];
+    o->y = H - (vp[1] + (c->y * iw + 1.0f) * 0.5f * vp[3]);
+    o->z = dr[0] + (c->z * iw + 1.0f) * 0.5f * (dr[1] - dr[0]) + zbias;
+    o->w = iw;
+}
+
+static void transform(int n)
+{
+    int i;
+    const byte *p = ax.ptr;
+
+    if (n > cap) {
+        cap = n + 256;
+        cv = (clip4_t *) realloc(cv, cap * sizeof *cv);
+        wv = (struct s3d_vertex *) realloc(wv, cap * sizeof *wv);
+        oc = (byte *) realloc(oc, cap);
+    }
+    for (i = 0; i < n; i++, p += ax.stride) {
+        const float *v = (const float *) p;
+        clip4_t *c = &cv[i];
+        c->x = m[0] * v[0] + m[4] * v[1] + m[8]  * v[2] + m[12];
+        c->y = m[1] * v[0] + m[5] * v[1] + m[9]  * v[2] + m[13];
+        c->z = m[2] * v[0] + m[6] * v[1] + m[10] * v[2] + m[14];
+        c->w = m[3] * v[0] + m[7] * v[1] + m[11] * v[2] + m[15];
+        oc[i] = outcode(c);
+        if (!oc[i])
+            project(c, &wv[i]);
+    }
+    have = n;
+    have_xyz = ax.ptr;
+    Com_Memcpy(have_m, m, sizeof m);
+    Com_Memcpy(have_vp, vp, sizeof vp);
+    Com_Memcpy(have_dr, dr, sizeof dr);
+    have_zbias = zbias;
+}
+
+/* --- clipping: a polygon in clip space with its attributes ----------------- */
+
+typedef struct { float x, y, z, w, u, v, r, g, b, a; } cvert_t;
+
+static float plane_dist(const cvert_t *p, int plane)
+{
+    switch (plane) {
+    case OUT_L: return p->x + p->w;
+    case OUT_R: return p->w - p->x;
+    case OUT_B: return p->y + p->w;
+    case OUT_T: return p->w - p->y;
+    case OUT_N: return p->z + p->w;
+    default:    return p->w - p->z;
+    }
+}
+
+static int clip_poly(cvert_t *in, int n, cvert_t *out, int plane)
+{
+    int i, k = 0;
+    for (i = 0; i < n; i++) {
+        cvert_t *a = &in[i], *b = &in[(i + 1) % n];
+        float da = plane_dist(a, plane), db = plane_dist(b, plane);
+        if (da >= 0)
+            out[k++] = *a;
+        if ((da >= 0) != (db >= 0)) {
+            float t = da / (da - db);
+            cvert_t *o = &out[k++];
+            o->x = a->x + (b->x - a->x) * t; o->y = a->y + (b->y - a->y) * t;
+            o->z = a->z + (b->z - a->z) * t; o->w = a->w + (b->w - a->w) * t;
+            o->u = a->u + (b->u - a->u) * t; o->v = a->v + (b->v - a->v) * t;
+            o->r = a->r + (b->r - a->r) * t; o->g = a->g + (b->g - a->g) * t;
+            o->b = a->b + (b->b - a->b) * t; o->a = a->a + (b->a - a->a) * t;
+        }
+    }
+    return k;
+}
+
+/* --- culling ------------------------------------------------------------------ */
+
+static int cull_on, cull_front, cull_back;     /* which windings are dropped */
+
+/* area of the window-space triangle with soft3D's y down: > 0 is clockwise
+   on screen, which is counter-clockwise in GL's y-up window */
+static int culled(const struct s3d_vertex *a, const struct s3d_vertex *b, const struct s3d_vertex *c)
+{
+    float area;
+    int ccw;
+    if (!cull_on)
+        return 0;
+    area = (b->x - a->x) * (c->y - a->y) - (c->x - a->x) * (b->y - a->y);
+    ccw = area < 0.0f;          /* y down: negative = CCW in GL */
+    return ccw ? cull_front : cull_back;
+}
+
+static void attrs(struct s3d_vertex *o, int i)
+{
+    if (tex_on && at.ptr) {
+        const float *t = (const float *) (at.ptr + i * at.stride);
+        o->u = t[0];
+        o->v = t[1];
+    } else
+        o->u = o->v = 0.0f;
+    if (col_on && ac.ptr) {
+        const byte *c = ac.ptr + i * ac.stride;
+        o->r = c[0]; o->g = c[1]; o->b = c[2]; o->a = c[3];
+    } else {
+        o->r = cur_rgba[0]; o->g = cur_rgba[1]; o->b = cur_rgba[2]; o->a = cur_rgba[3];
+    }
+}
+
+/* attrs for the vertices 0..n-1 that are inside */
+static void fill_attrs(int n)
+{
+    int i;
+    const byte *t = tex_on ? at.ptr : NULL, *c = col_on ? ac.ptr : NULL;
+    unsigned long rgba = (unsigned long) cur_rgba[0] << 24 | (unsigned long) cur_rgba[1] << 16 |
+                         (unsigned long) cur_rgba[2] << 8 | cur_rgba[3];
+
+    for (i = 0; i < n; i++) {
+        struct s3d_vertex *o = &wv[i];
+        if (oc[i])
+            continue;
+        if (t) {
+            const float *f = (const float *) (t + i * at.stride);
+            o->u = f[0];
+            o->v = f[1];
+        } else
+            o->u = o->v = 0.0f;
+        /* r g b a are four bytes in a row in both (and tess's colours are
+           long-aligned) */
+        if (c)
+            *(unsigned long *) &o->r = *(const unsigned long *) (c + i * ac.stride);
+        else
+            *(unsigned long *) &o->r = rgba;
+    }
+}
+
+static void clipped_triangle(const int *idx, byte codes)
+{
+    cvert_t buf[2][16], *in = buf[0], *out = buf[1], *t;
+    struct s3d_vertex w[16];
+    int n = 3, i, plane;
+
+    for (i = 0; i < 3; i++) {
+        const clip4_t *c = &cv[idx[i]];
+        struct s3d_vertex a;
+        attrs(&a, idx[i]);
+        in[i].x = c->x; in[i].y = c->y; in[i].z = c->z; in[i].w = c->w;
+        in[i].u = a.u; in[i].v = a.v;
+        in[i].r = a.r; in[i].g = a.g; in[i].b = a.b; in[i].a = a.a;
+    }
+    for (plane = 1; plane <= OUT_F && n >= 3; plane <<= 1)
+        if (codes & plane) {
+            n = clip_poly(in, n, out, plane);
+            t = in; in = out; out = t;
+        }
+    if (n < 3)
+        return;
+    for (i = 0; i < n; i++) {
+        clip4_t c;
+        c.x = in[i].x; c.y = in[i].y; c.z = in[i].z; c.w = in[i].w;
+        if (c.w <= 0.0f)
+            return;
+        project(&c, &w[i]);
+        w[i].u = in[i].u; w[i].v = in[i].v;
+        w[i].r = (byte) in[i].r; w[i].g = (byte) in[i].g;
+        w[i].b = (byte) in[i].b; w[i].a = (byte) in[i].a;
+    }
+    if (culled(&w[0], &w[1], &w[2]))
+        return;
+    for (i = 1; i + 1 < n; i++)
+        TRI(&w[0], &w[i], &w[i + 1]);
+}
+
+/* --- the draw ------------------------------------------------------------------ */
+
+static void mat_mul(float *out, const float *a, const float *b)      /* out = a * b */
+{
+    int r, c;
+    for (c = 0; c < 4; c++)
+        for (r = 0; r < 4; r++)
+            out[c * 4 + r] = a[0 * 4 + r] * b[c * 4 + 0] + a[1 * 4 + r] * b[c * 4 + 1] +
+                             a[2 * 4 + r] * b[c * 4 + 2] + a[3 * 4 + r] * b[c * 4 + 3];
+}
+
+/* qtrue if drawn here, qfalse to let Mesa draw it */
+qboolean amix_DrawElements(int numIndexes, const glIndex_t *indexes)
+{
+    float mv[16], pr[16];
+    GLint ivp[4], face, mode;
+    int i, n = 0;
+
+    if (!amix_direct() || !ax.ptr || ax.size < 3)
+        return qfalse;
+    if (stats) {
+        if (tr.frameCount != st_frame) {
+            st_frame = tr.frameCount;
+            if (++st_frames == 20) {
+                ri.Printf(PRINT_ALL, "q3 s3d per frame: %lu calls, %lu vertices transformed, %lu reused calls, %lu clipped\n",
+                          st_calls / 20, st_xform / 20, st_reuse / 20, st_clip / 20);
+                st_calls = st_xform = st_reuse = st_clip = st_frames = 0;
+            }
+        }
+        st_calls++;
+    }
+    if (skip == 1)
+        return qtrue;
+    if (!glAmixS3DBegin()) {
+        amixFlushDeferred();
+        return qfalse;
+    }
+    queue_to = defer_for();
+
+    glGetFloatv(GL_MODELVIEW_MATRIX, mv);
+    glGetFloatv(GL_PROJECTION_MATRIX, pr);
+    mat_mul(m, pr, mv);
+    glGetIntegerv(GL_VIEWPORT, ivp);
+    vp[0] = ivp[0]; vp[1] = ivp[1]; vp[2] = ivp[2]; vp[3] = ivp[3];
+    glGetFloatv(GL_DEPTH_RANGE, dr);
+    H = (float) glAmixS3DHeight();
+    zbias = glIsEnabled(GL_POLYGON_OFFSET_FILL) ? -2.0f / 65535.0f : 0.0f;
+
+    cull_on = glIsEnabled(GL_CULL_FACE);
+    if (cull_on) {
+        glGetIntegerv(GL_CULL_FACE_MODE, &mode);
+        glGetIntegerv(GL_FRONT_FACE, &face);
+        /* "front" by GL_FRONT_FACE; ccw front unless GL_CW */
+        if (face == GL_CW) {
+            cull_front = mode == GL_BACK || mode == GL_FRONT_AND_BACK;   /* ccw is back */
+            cull_back = mode == GL_FRONT || mode == GL_FRONT_AND_BACK;
+        } else {
+            cull_front = mode == GL_FRONT || mode == GL_FRONT_AND_BACK;
+            cull_back = mode == GL_BACK || mode == GL_FRONT_AND_BACK;
+        }
+    }
+
+    if (skip == 3)
+        return qtrue;
+    for (i = 0; i < numIndexes; i++)
+        if ((int) indexes[i] >= n)
+            n = indexes[i] + 1;
+    /* the same positions under the same matrices: the surface's next stage */
+    if (!(n <= have && ax.ptr == have_xyz && !memcmp(m, have_m, sizeof m) &&
+          !memcmp(vp, have_vp, sizeof vp) && !memcmp(dr, have_dr, sizeof dr) && zbias == have_zbias))
+        transform(n), st_xform += n;
+    else
+        st_reuse++;
+
+    /* texture coordinates and colours change between stages: once a vertex */
+    fill_attrs(n);
+
+    for (i = 0; i + 2 < numIndexes; i += 3) {
+        int idx[3];
+        byte c0, c1, c2;
+        idx[0] = indexes[i]; idx[1] = indexes[i + 1]; idx[2] = indexes[i + 2];
+        c0 = oc[idx[0]]; c1 = oc[idx[1]]; c2 = oc[idx[2]];
+        if (c0 & c1 & c2)
+            continue;
+        if (c0 | c1 | c2) {
+            clipped_triangle(idx, c0 | c1 | c2);
+            st_clip++;
+            continue;
+        }
+        {
+            struct s3d_vertex *a = &wv[idx[0]], *b = &wv[idx[1]], *c = &wv[idx[2]];
+            if (culled(a, b, c))
+                continue;
+            TRI(a, b, c);
+        }
+    }
+    return qtrue;
+}
