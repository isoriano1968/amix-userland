AMIX: 060 speed-ups found with prsample in iortcw (2026-11-08)

- ioapi.c: 16 KB stdio buffer for pk3s (AMIX buffers 1 KB; the zip code reads
  directories a byte at a time)
- renderergl1 tr_local.h, tr_shade*.c: 32-bit sine-table indexes (int64_t
  conversions are libgcc software routines on the 060)
- msg.c: the message Huffman trees from a table made on the PC (amix/huffgen),
  27 s of the 060's start-up otherwise

--- a/code/qcommon/ioapi.c
+++ b/code/qcommon/ioapi.c
@@ -70,6 +70,20 @@
    voidpf stream));
 
 
+#ifdef __amix__
+/* AMIX's stdio buffers 1 KB: the zip code reads pk3 directories a byte at a
+   time through it, so every KB is a read(2) of ~50 us plus the disk.  A
+   larger buffer for the pk3s. */
+static FILE *amix_zbuf(FILE *f)
+{
+    if (f != NULL)
+        setvbuf(f, NULL, _IOFBF, 16384);
+    return f;
+}
+#else
+#define amix_zbuf(f) (f)
+#endif
+
 voidpf ZCALLBACK fopen_file_func (opaque, filename, mode)
    voidpf opaque;
    const char* filename;
@@ -87,7 +101,7 @@
         mode_fopen = "wb";
 
     if ((filename!=NULL) && (mode_fopen != NULL))
-        file = fopen(filename, mode_fopen);
+        file = amix_zbuf(fopen(filename, mode_fopen));
     return file;
 }
 
