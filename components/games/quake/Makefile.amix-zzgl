# Makefile.amix-zzgl -- GLQuake for AMIX with the GL on the Z3660's core 1
# (amix-gate firmware/core1) and the sound on the board's HDMI: glquake.zzgl.
# make -f Makefile.amix-zzgl
CC = $(HOME)/opt/m68k-amix/bin/m68k-elf-gcc
X = $(HOME)/opt/m68k-amix-sysroot/usr/x11r6/xc/exports
GATE = $(HOME)/Sources/usr-amix/amix-gate/usr/src/firmware/core1
L060 = $(abspath ../../library/lib060)
O = obj-zzgl
CFLAGS = -O2 -DNDEBUG -m68060 -ffast-math -fno-strict-aliasing -fcommon -w \
	-Wno-error=implicit-function-declaration -Wno-error=int-conversion \
	-Wno-error=incompatible-pointer-types -Wno-error=implicit-int -Wno-error=return-mismatch \
	-U__linux__ -Ulinux -D__amix__ -DSVR4 -DGLQUAKE -DAMIX -DAMIX_ZZGL \
	-I$(GATE)/src/mesa-18.3.6/include -I$(X)/include -I$(GATE)/zzgl
ZFLAGS = $(CFLAGS) -I$(GATE)/compat/amix -I$(GATE)/cores/h264bench
LIBS = -L$(X)/lib -lX11 -lsocket -lnsl -L$(L060) -lm060 -lc060 -lm

SRCS = cl_demo cl_input cl_main cl_parse cl_tent chase cmd common console crc cvar \
	gl_draw gl_mesh gl_model gl_refrag gl_rlight gl_rmain gl_rmisc gl_rsurf gl_screen \
	gl_test gl_warp host host_cmd keys menu mathlib net_dgrm net_loop net_main net_vcr \
	net_udp net_bsd pr_cmds pr_edict pr_exec r_part sbar sv_main sv_phys sv_move sv_user \
	zone view wad world cd_null sys_linux snd_dma snd_mem snd_mix snd_zzgl \
	gl_vidlinuxglx zzq_gl
OBJS = $(SRCS:%=$(O)/%.o) $(O)/zzgl_enc.o $(O)/zzgl_amix.o

glquake.zzgl: $(OBJS)
	$(CC) -m68060 -Wl,--allow-multiple-definition -o $@ $(OBJS) $(LIBS)

$(O)/zzgl_%.o: $(GATE)/zzgl/zzgl_%.c
	@mkdir -p $(O)
	$(CC) $(ZFLAGS) -c $< -o $@

$(O)/%.o: %.c
	@mkdir -p $(O)
	$(CC) $(ZFLAGS) -c $< -o $@

clean:
	rm -rf $(O) glquake.zzgl
