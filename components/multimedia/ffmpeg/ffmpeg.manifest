# name, version and what building and running it needs
name     multimedia/ffmpeg
version  4.4.8
summary  FFmpeg 4.4.8
require  library/pth
require  library/sdl2
require  x11/x11r6.3
file     /opt/ffmpeg/bin/ffmpeg
file     /opt/ffmpeg/bin/ffplay
file     /opt/vplay/vplay
file     /opt/amix/bin/ffmpeg
file     /opt/amix/bin/ffplay
file     /opt/amix/bin/vplay
