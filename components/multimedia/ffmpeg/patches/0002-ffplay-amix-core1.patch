+/*
+ * AMIX on the A3000 with the Z3660 (vplay-amix): H.264 (+ AAC) is played by
+ * the board's second ARM core when its player is there -- ffplay then opens
+ * no decoders, hands the packets over (vplay's src/zzav.c, compiled in) and
+ * keeps the window over the RTG overlay core 1 draws into; the sound is on
+ * the board's HDMI.  A seek opens core 1's player anew at the new place (an
+ * amixcast URL: the PC starts a new stream).  FFPLAY_NOARM=1: ffplay as usual.
+ */
+#define FFPLAY_ZZAV 1
+#ifdef FFPLAY_ZZAV
+#include "../../src/zzav.c"
+#include <SDL_syswm.h>        /* the X window, for its frame (zz_size) */
+static int zzav_on;
+
+/* seconds of a stream before core 1 starts: at the start a lead the stream
+   can lose in a slow stretch (AMIX takes ~280 KB/s, a 480p stream 190-250;
+   the ring, 7.75 MB, holds ~30 s at 2 Mbit/s), after a seek a short one, as
+   the user waits for it.  The window's title says how far the pre-loading is. */
+#define ZZ_LEAD 15.0
+#define ZZ_LEAD_SEEK 3.0
+#define ZZ_WAIT 40.0            /* ... or after this long, if the network is slower */
+static volatile double zz_buf_have = -1.0, zz_buf_want;   /* pre-loading: seconds in, wanted */
+static int zz_scale = 1;        /* the window's size, not fullscreen */
+static int zz_half = -1;        /* the size chosen with 1, 2 or h; -1 none yet */
+static double zz_t0, zz_c0 = -1.0;      /* a stream: where it starts in the file, its first time stamp */
+
+static double zz_goal = -1.0;   /* a seek under way: where it goes */
+
+/* where the picture is, seconds into the file */
+static double zz_pos(void)
+{
+    if (zz_goal >= 0.0)
+        return zz_goal;
+    return zz_t0 + zzav_clock() - (zz_c0 >= 0.0 ? zz_c0 : 0.0);
+}
+
+/* amixcast's stream: the same URL from t seconds on */
+static void zz_url(char *out, int n, const char *url, double t)
+{
+    const char *p = strstr(url, "&t="), *e = p ? strchr(p + 1, '&') : NULL;
+
+    snprintf(out, n, "%.*s%s&t=%d", p ? (int)(p - url) : (int)strlen(url), url, e ? e : "", (int)t);
+}
+
+/* the overlay in the middle of the window (it does not scale) */
+static void zzav_window(void)
+{
+    int x, y, w, h, ow, oh, vsc;
+
+    if (!zzav_on || !window)
+        return;
+    SDL_GetWindowPosition(window, &x, &y);
+    SDL_GetWindowSize(window, &w, &h);
+    zzav_size(&ow, &oh, &vsc);
+    zzav_place(x + (w - ow) / 2, y + (h - oh * vsc) / 2);
+}
+
+/* the window manager's frame around ours: the child of the root above it */
+static int zz_frame(Display *d, Window w, Window *frame)
+{
+    Window root, parent, *kids;
+    unsigned int n;
+
+    for (;;) {
+        if (!XQueryTree(d, w, &root, &parent, &kids, &n))
+            return 0;
+        if (kids)
+            XFree(kids);
+        if (parent == root) {
+            *frame = w;
+            return 1;
+        }
+        w = parent;
+    }
+}
+
+/* keys 1, 2 and h: the picture's size, the window with it.  dtwm leaves
+   off the frame of a window that would reach past the screen's edge, and
+   SDL knows neither the frame nor where it is: the frame, as X has it,
+   goes where the new size fits, in the same request (positionIsFrame,
+   dtwm's default, takes the position as the frame's). */
+static void zz_resize(int ow, int oh)
+{
+    SDL_SysWMinfo wm;
+
+    SDL_SetWindowFullscreen(window, 0);
+    is_full_screen = 0;
+    SDL_VERSION(&wm.version);
+    if (SDL_GetWindowWMInfo(window, &wm) && wm.subsystem == SDL_SYSWM_X11) {
+        Display *d = wm.info.x11.display;
+        Window w = wm.info.x11.window, f, root;
+        int fx, fy, cx, cy, nw, nh;
+        unsigned int fw, fh, cw, ch, bw, depth;
+
+        if (zz_frame(d, w, &f) &&
+            XGetGeometry(d, f, &root, &fx, &fy, &fw, &fh, &bw, &depth) &&
+            XGetGeometry(d, w, &root, &cx, &cy, &cw, &ch, &bw, &depth)) {
+            nw = (int)(fw - cw) + ow;           /* the frame at the new size */
+            nh = (int)(fh - ch) + oh;
+            fx = FFMAX(FFMIN(fx, DisplayWidth(d, DefaultScreen(d)) - nw), 0);
+            fy = FFMAX(FFMIN(fy, DisplayHeight(d, DefaultScreen(d)) - nh), 0);
+            XMoveResizeWindow(d, w, fx, fy, ow, oh);
+            XFlush(d);
+            return;
+        }
+    }
+    SDL_SetWindowSize(window, ow, oh);
+}
+
+static void zz_size(int half, int k)
+{
+    int ow, oh, vsc;
+
+    zz_scale = k;
+    zz_half = half;
+    zzav_half(half);
+    zzav_scale(k);
+    zzav_size(&ow, &oh, &vsc);
+    zz_resize(ow, oh * vsc);
+}
+
+/* what the title names: of a file its name, of a stream what -window_title says */
+static const char *zz_name(void)
+{
+    return window_title && strstr(window_title, "://") ? "" :
+           window_title && strrchr(window_title, '/') ? strrchr(window_title, '/') + 1 :
+           window_title ? window_title : "";
+}
+
+/* the window at once, black, while the stream opens (over the network that
+   takes seconds); its size when core 1's picture is known */
+static int zz_early;
+
+static void zz_early_window(void)
+{
+    char buf[256];
+
+    zz_early = 1;
+    snprintf(buf, sizeof buf, "Opening ...  %s", zz_name());
+    SDL_SetWindowTitle(window, buf);
+    SDL_ShowWindow(window);
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    SDL_RenderClear(renderer);
+    SDL_RenderPresent(renderer);
+}
+
+/* position and length in the window's title, once a second; of a file its
+   name, of a stream what -window_title says */
+static void zz_title(VideoState *is)
+{
+    static int shown = -1;
+    const char *name = zz_name();
+    const int t = (int)zz_pos(), d = is->ic && is->ic->duration > 0 ? (int)(is->ic->duration / AV_TIME_BASE) : 0;
+    const double have = zz_buf_have;
+    const int key = have >= 0.0 ? -2 - (int)have : t;
+    char buf[256];
+
+    if (key == shown || !window)
+        return;
+    shown = key;
+    if (have >= 0.0)            /* core 1 waits for the stream's lead */
+        snprintf(buf, sizeof buf, "Pre-loading buffer %d / %d s  %s", (int)have, (int)zz_buf_want, name);
+    else if (d)
+        snprintf(buf, sizeof buf, "%d:%02d:%02d / %d:%02d:%02d  %s", t / 3600, t / 60 % 60, t % 60,
+                 d / 3600, d / 60 % 60, d % 60, name);
+    else
+        snprintf(buf, sizeof buf, "%d:%02d:%02d  %s", t / 3600, t / 60 % 60, t % 60, name);
+    SDL_SetWindowTitle(window, buf);
+}
+
+/* amixcast's resume: FFPLAY_POSFILE names the file the position goes to,
+   "seconds length title", every 10 s and at the end; a video played to its
+   end leaves none.  FFPLAY_START: from there (a server's or a local file; the
+   PC's stream says it in its URL, t=) */
+static double zz_last = -1.0;   /* the position last known good */
+static int zz_dur, zz_ended;
+
+static void zz_save(void)
+{
+    static int saved = -1;
+    const char *f = getenv("FFPLAY_POSFILE");
+    char tmp[1100];
+    FILE *o;
+
+    if (!f || !*f || strlen(f) > 1000)
+        return;
+    if (zz_ended) {
+        unlink(f);
+        return;
+    }
+    if (zz_last < 0.0 || (int)zz_last == saved)
+        return;
+    snprintf(tmp, sizeof tmp, "%s.new", f);
+    if (!(o = fopen(tmp, "w")))
+        return;
+    fprintf(o, "%d %d %s\n", (int)zz_last, zz_dur, window_title ? window_title : "");
+    if (fclose(o) == 0 && rename(tmp, f) == 0)
+        saved = (int)zz_last;
+}
+#endif
