# amix-net: the network tools of today as one package (make-rules/meta.mk):
# OpenSSH (ssh, scp, sftp, sshd), curl and libcurl, wget, the Mozilla CA
# bundle, and zlib and OpenSSL under them.
#
# Not for the Amiga yet: network/openssh stages its plain build, while the
# Amiga runs the later ssh and sshd with zzcrypto (core 1).  Its stage must
# give that build first, or this would replace the sshd you log in with.
COMPONENT_NAME    = amix-net
COMPONENT_VERSION = 1

include ../../../make-rules/shared.mk
include ../../../make-rules/meta.mk
