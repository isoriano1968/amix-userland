# amix-dev: what serious development on the Amiga needs, as one package
# (make-rules/meta.mk): the GNU tools, pkg-config, vim and nedit, and every
# library with its headers, .pc file and link stub.  The compiler is AMIX's
# own gcc 2.7.2.3 (the gcc-2723 SVR4 package), which is not built here.
COMPONENT_NAME    = amix-dev
COMPONENT_VERSION = 1

