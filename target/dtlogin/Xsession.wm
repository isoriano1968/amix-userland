#!/bin/sh
# Xsession.wm -- dtlogin's alternative sessions: Motif (mwm), TWM, OpenLook.
#   Xsession.wm mwm|twm|olwm
# dtlogin runs this as the user instead of /usr/dt/bin/Xsession (the
# altDtStart of /etc/dt/config/C/Xresources.d/Xresources.*).  The window
# manager is the last process: leaving it ends the session.
WM=${1:-mwm}
# the user's environment as in a CDE session (PATH, SHELL, LD_LIBRARY_PATH)
[ -r $HOME/.dtprofile ] && . $HOME/.dtprofile
/opt/amix/bin/xkeymap-amiga
[ -r $HOME/.Xdefaults ] && /usr/X/bin/xrdb -merge $HOME/.Xdefaults
/usr/X/bin/xsetroot -solid '#5a7a95' 2> /dev/null
cd $HOME
case $WM in
mwm)
	/usr/X/bin/xclock -geometry 100x100-1+1 &
	/usr/X/bin/xterm -geometry 80x28+20+20 -ls &
	exec /opt/motif/mwm-opaque.sh
	;;
twm)
	/usr/X/bin/xclock -geometry 100x100-1+1 &
	/usr/X/bin/xterm -geometry 80x28+20+20 -ls &
	exec /usr/x11r6/xc/programs/twm/twm
	;;
olwm)
	# olwsm owns the workspace menu's Exit; olwm keeps running after it,
	# so olwsm is the session's last process (as in OpenWindows)
	/usr/X/bin/olwm &
	/usr/X/bin/xterm -geometry 80x28+20+20 -ls &
	exec /usr/X/bin/olwsm
	;;
esac
