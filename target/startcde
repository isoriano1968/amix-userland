#!/bin/sh
# startcde [arguments for the X starter] -- a CDE session without dtlogin:
# X with /usr/dt/config/xinitrc.amix (xhold, then CDE's Xsession).
# STARTX names the program that starts X: startx by default; on a Z3660 RTG
# with the amix-z3660rtg kit, e.g.  STARTX=/opt/amix/bin/startx-z3 startcde 1920x1080
# Session log: $HOME/.dt/startlog
XINITRC=/usr/dt/config/xinitrc.amix; export XINITRC
exec ${STARTX:-startx} "$@"
