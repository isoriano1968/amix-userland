From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:13:00 +0200
Subject: [PATCH 22/42] DtHelp: libgen regcmp path on AMIX; ImUtil.h:
 _XInitImageFuncPtrs returns void

---
 config/amix/include/X11/ImUtil.h | 2 +-
 lib/DtHelp/GlobSearch.c          | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/config/amix/include/X11/ImUtil.h b/config/amix/include/X11/ImUtil.h
index 05e8f096..30c97c8c 100644
--- a/config/amix/include/X11/ImUtil.h
+++ b/config/amix/include/X11/ImUtil.h
@@ -7,7 +7,7 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
-extern int _XInitImageFuncPtrs(XImage *);
+extern void _XInitImageFuncPtrs(XImage *);
 #ifdef __cplusplus
 }
 #endif
diff --git a/lib/DtHelp/GlobSearch.c b/lib/DtHelp/GlobSearch.c
index 02ee92cd..fc27e909 100644
--- a/lib/DtHelp/GlobSearch.c
+++ b/lib/DtHelp/GlobSearch.c
@@ -50,6 +50,9 @@
 #include <stdlib.h>  /* for MB_CUR_MAX */
 #include <unistd.h>  /* R_OK */
 #include <locale.h>  /* getlocale(), LOCALE_STATUS */
+#if defined(__amix__) && !defined(NO_REGCOMP)
+# define NO_REGCOMP	/* SVR4.0: regcmp()/regex() in libgen, no regcomp() */
+#endif
 #ifndef NO_REGEX
 # ifdef NO_REGCOMP
 #  if defined(SVR4)
