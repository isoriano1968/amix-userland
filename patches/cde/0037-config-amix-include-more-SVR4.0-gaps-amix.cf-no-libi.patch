+using namespace std;
+#endif
diff --git a/config/amix/include/iconv.h b/config/amix/include/iconv.h
new file mode 100644
index 00000000..5b394afa
--- /dev/null
+++ b/config/amix/include/iconv.h
@@ -0,0 +1,17 @@
+/*
+ * iconv.h -- AMIX has no iconv.  Every conversion fails to open, so callers
+ * take their "no converter" path (as with EUSCompat.h's AMIX stand-ins); in
+ * the C locale the only one CDE has here, nothing needs converting.
+ * Part of the AMIX port of CDE (config/cf/amix.cf); not a vendor header.
+ */
+#ifndef _AMIX_CDE_ICONV_H
+#define _AMIX_CDE_ICONV_H
+#include <sys/types.h>
+#include <errno.h>
+typedef void *iconv_t;
+static __inline__ iconv_t iconv_open(const char *to, const char *from)
+{ (void)to; (void)from; errno = EINVAL; return (iconv_t)-1; }
+static __inline__ size_t iconv(iconv_t cd, char **in, size_t *inl, char **out, size_t *outl)
+{ (void)cd; (void)in; (void)inl; (void)out; (void)outl; errno = EBADF; return (size_t)-1; }
+static __inline__ int iconv_close(iconv_t cd) { (void)cd; return 0; }
+#endif
