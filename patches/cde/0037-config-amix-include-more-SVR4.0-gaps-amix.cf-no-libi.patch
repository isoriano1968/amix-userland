diff --git a/config/amix/include/strings.h b/config/amix/include/strings.h
new file mode 100644
index 00000000..37201435
--- /dev/null
+++ b/config/amix/include/strings.h
@@ -0,0 +1,17 @@
+/*
+ * strings.h -- the BSD header AMIX (SVR4.0) lacks: <string.h> plus the
+ * case-insensitive compares, which gcc14-cross-amix's libamixc99 supplies.
+ * Part of the AMIX port of CDE (config/cf/amix.cf); not a vendor header.
+ */
+#ifndef _AMIX_CDE_STRINGS_H
+#define _AMIX_CDE_STRINGS_H
+#include <string.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int strcasecmp(const char *, const char *);
+extern int strncasecmp(const char *, const char *, size_t);
+#ifdef __cplusplus
+}
+#endif
+#endif
