new file mode 100644
index 00000000..74908f61
--- /dev/null
+++ b/config/amix/include/unistd.h
@@ -0,0 +1,18 @@
+/*
+ * unistd.h -- calls AMIX's libraries have but its headers do not declare:
+ * seteuid()/setegid() (libc) and rresvport() (libsocket).  Part of the AMIX
+ * port of CDE (config/cf/amix.cf); not a vendor header.
+ */
+#ifndef _AMIX_CDE_UNISTD_H
+#define _AMIX_CDE_UNISTD_H
+#include_next <unistd.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int seteuid(uid_t);
+extern int setegid(gid_t);
+extern int rresvport(int *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/config/amix/include/wchar.h b/config/amix/include/wchar.h
index 84c28676..30d80160 100644
--- a/config/amix/include/wchar.h
+++ b/config/amix/include/wchar.h
@@ -54,11 +54,8 @@ static __inline__ int wcswidth(const wchar_t *s, size_t n)
 
 static __inline__ wint_t fputwc(wint_t c, FILE *f) { return putc((int)c, f) == EOF ? WEOF : c; }
 static __inline__ wint_t fgetwc(FILE *f) { int c = getc(f); return c == EOF ? WEOF : (wint_t)c; }
-#ifndef putwc
-#define putwc(c, f)	fputwc((c), (f))
-#endif
-#ifndef getwc
-#define getwc(f)	fgetwc(f)
-#endif
+/* functions, not macros: callers #undef getwc to get "the libc function" */
+static __inline__ wint_t putwc(wint_t c, FILE *f) { return fputwc(c, f); }
+static __inline__ wint_t getwc(FILE *f) { return fgetwc(f); }
 
 #endif
