diff --git a/config/amix/include/fstream.h b/config/amix/include/fstream.h
new file mode 100644
index 00000000..1720c1fd
--- /dev/null
+++ b/config/amix/include/fstream.h
@@ -0,0 +1,10 @@
+/*
+ * fstream.h -- the pre-standard C++ header CDE was written against, for
+ * gcc 14's libstdc++: the standard header, its names in the global
+ * namespace.  Part of the AMIX port of CDE; not a vendor header.
