diff --git a/config/amix/include/sys/mman.h b/config/amix/include/sys/mman.h
new file mode 100644
index 00000000..7f86ac42
--- /dev/null
+++ b/config/amix/include/sys/mman.h
@@ -0,0 +1,23 @@
+/*
+ * sys/mman.h -- AMIX declares only mmap(); munmap(), mprotect() and msync()
+ * are in libc but undeclared;
+ * madvise() is not there at all.  Part of the AMIX port of CDE (config/cf/
+ * amix.cf); not a vendor header.
+ */
+#ifndef _AMIX_CDE_SYS_MMAN_H
+#define _AMIX_CDE_SYS_MMAN_H
+#include_next <sys/mman.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int munmap(void *, size_t);
+extern int mprotect(void *, size_t, int);
+extern int msync(void *, size_t, int);
+extern int memcntl(void *, size_t, int, void *, int, int);
+/* no madvise() in SVR4.0's libc: it is memcntl(MC_ADVISE) */
+static __inline__ int madvise(void *a, size_t l, int advice)
+{ return memcntl(a, l, MC_ADVISE, (void *)(long)advice, 0, 0); }
+#ifdef __cplusplus
+}
+#endif
+#endif
