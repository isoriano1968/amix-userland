Subject: [PATCH 05/42] host.def: bash runs the build's ksh scripts on the
 build host

---
 config/cf/host.def | 1 +
 1 file changed, 1 insertion(+)

diff --git a/config/cf/host.def b/config/cf/host.def
index 250a7004..170cf570 100644
--- a/config/cf/host.def
+++ b/config/cf/host.def
@@ -48,6 +48,7 @@ XCOMM host.def -- cross-building CDE for AMIX on a Linux host (read before amix.
 #define YaccCmd			bison -y
 #define MkdirHierCmd		mkdir -p
 #define MakeCmd			make
+#define KornShell		/bin/bash	/* the build's ksh scripts; the host has no ksh */
 #define DependCmd		/bin/true
 #define InstallCmd		/usr/bin/install
 
