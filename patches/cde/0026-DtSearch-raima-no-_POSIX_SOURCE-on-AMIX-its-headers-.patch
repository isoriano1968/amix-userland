From 87ff46002c6f54ead217f2a2ee4134bb54e80f8c Mon Sep 17 00:00:00 2001
From: isoriano1968 <isoriano1968@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:17:44 +0200
Subject: [PATCH 26/42] DtSearch/raima: no _POSIX_SOURCE on AMIX (its headers
 need the BSD types it hides)

---
 lib/DtSearch/raima/Imakefile | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/lib/DtSearch/raima/Imakefile b/lib/DtSearch/raima/Imakefile
index b9064281..447d0388 100644
--- a/lib/DtSearch/raima/Imakefile
+++ b/lib/DtSearch/raima/Imakefile
@@ -43,7 +43,15 @@ EXTRA_DEFINES = -DBYTE_SWAP -D_XOPEN_SOURCE
 DEFINES = DtSvcDefines \
           -DCDE_INSTALLATION_TOP=\"$(CDE_INSTALLATION_TOP)\" \
           -DCDE_CONFIGURATION_TOP=\"$(CDE_CONFIGURATION_TOP)\" \
-          -DNO_TRANS -DUNIX -DNO_CONST -D_POSIX_SOURCE 
+          -DNO_TRANS -DUNIX -DNO_CONST $(POSIX_SOURCE_DEFINE)
+
+/* AMIX (SVR4.0): its headers are inconsistent under _POSIX_SOURCE (sys/types.h
+ * hides the BSD types other system headers use); _XOPEN_SOURCE is enough there */
+#if defined(AMIXArchitecture)
+POSIX_SOURCE_DEFINE =
+#else
+POSIX_SOURCE_DEFINE = -D_POSIX_SOURCE
+#endif
 
 INCLUDES = -I.
 
-- 
2.47.3

